        function validatePhoneFields() {
            const phoneFields = ['CompanyMainPhone', 'FinancePhone', 'EventPhone', 'TrainingPhone'];
            let isValid = true;

            phoneFields.forEach(function (fieldId) {
                const phoneInput = document.getElementById(fieldId);
                const errorMessage = document.getElementById(fieldId + 'Error');

                // Reset previous validation state
                phoneInput.classList.remove('is-invalid');
                errorMessage.style.display = 'none';

                const phoneValue = phoneInput.value.trim();
                const phonePattern = /^\d{3}-\d{3}-\d{4}$/;

                // Validate only if the field has a value
                if (phoneValue && !phonePattern.test(phoneValue)) {
                    phoneInput.classList.add('is-invalid');
                    errorMessage.textContent = 'Please enter a valid phone number.';
                    errorMessage.style.display = 'block';
                    isValid = false;
                }
            });

            return isValid;
        }
