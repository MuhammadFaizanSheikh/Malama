@model Malama.Models.SubContractorViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml"; // Adjust the path to your layout file if necessary
    ViewData["Title"] = "Sub Contractor Detail";
}

<style>
    h2 {
        color: rgba(80, 90, 201, 1);
    }

    h3 {
        color: rgba(80, 90, 201, 1);
    }

    .form-label {
        font-weight: bold;
    }

    #contractsTable {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        #contractsTable th, #contractsTable td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        #contractsTable th {
            background-color: #f4f4f4;
        }

        #contractsTable tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

            #contractsTable tbody tr:hover {
                background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
            }

        #contractsTable td, #contractsTable th {
            text-align: center; /* Aligns the text in the middle of the cell */
        }

            #contractsTable td button, #contractsTable td a {
                display: inline-block; /* Makes the buttons appear side by side */
                margin-right: 5px; /* Optional: Adds space between the buttons */
            }

            #contractsTable td .button-container {
                display: flex;
                justify-content: center; /* Aligns buttons horizontally in the center */
            }

                #contractsTable td .button-container a {
                    margin-right: 5px; /* Optional: Adds space between the buttons */
                }

        #contractsTable thead th {
            background-color: rgba(120, 130, 221, 1); /* Header background color */
            color: white; /* Header text color */
            text-align: center; /* Optional: Center-align header text */
        }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }

    /* Base styles for the dropdown */
    .select2 {
        width: 100%;
        font-size: 14px;
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 5px;
        background-color: #fff;
        color: #333;
        transition: border-color 0.3s, box-shadow 0.3s;
    }
        /*
    /* Focused state */
        .select2:focus {
            border-color: #0056b3;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
        }

    /* Dropdown arrow customization */


    /* Adjust the dropdown width */
    .select2 {
        width: 100% !important; /* Ensures full-width dropdown */
    }



        /* Hover state for options */
        .select2 option:hover {
            background-color: #e6f7ff;
        }

        /* Focus state for options */
        .select2 option:focus {
            background-color: #cce5ff;
        }

        /* Disabled state */
        .select2 option:disabled {
            color: #aaa;
            background-color: #f5f5f5;
        }

    */
</style>

<body>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (TempData["ResponseMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
                var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

                Swal.fire({
                    icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                    title: '@TempData["ResponseTitle"]',
                    text: '@TempData["ResponseMessage"]',
                    confirmButtonText: 'OK',
                    confirmButtonColor: buttonColor, // Conditional button color
                    iconColor: iconColor // Conditional icon color
                });
            });
        </script>
    }

    <h2 class="text-center mb-4">@ViewData["Title"]</h2>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
            <div class="alert alert-danger">
                <strong>Validation failed!</strong>
                <ul>
                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                            <li>@modelError.ErrorMessage</li>
                }
                </ul>
            </div>
    }

    <div style="display: flex; justify-content: center; align-items: center;">
        <button class="btn btn-primary" id="addContractBtn"
                style="background-color: rgba(80, 90, 201, 1); border-color: rgba(80, 90, 201, 1);">
            Add New Sub Contractor
        </button>
    </div>
     <div id="datatableWrapper" class="datatable-wrapper">
        <table id="contractsTable" class="display">
            <thead>
                <tr>
                    <th>Company Id</th>
                    <th>Company Main Name</th>
                    <th>Company Main State</th>
                    <th>Company Main City</th>
                    <th>Company Main Zip</th>
                    <th>DAWSON Contract ID</th>
                    <th>DAWSON Contract Name</th>
                    <th>Service Type Provided</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.SubContractor != null && Model.SubContractor.Any())
                {
                    @foreach (var contract in Model.SubContractor)
                    {
                        <tr data-id="@contract.Id">
                            <td>@contract.CompanyId</td>
                            <td>@contract.CompanyMainName</td>
                            <td>@contract.CompanyMainState</td>
                            <td>@contract.CompanyMainCity</td>
                            <td>@contract.CompanyMainZip</td>
                            <td>@contract.ContractId</td>
                            <td>@contract.ContractName</td>
                            <td>@contract.ServiceTypeProvided</td>
                            <td>
                                <div class="button-container">
                                    <a href="javascript:void(0);" class="btn btn-primary edit-btn" data-id="@contract.Id" style="background-color: rgba(80, 90, 201, 1);">Edit</a>
                                    <a href="javascript:void(0);" class="btn btn-secondary view-btn" data-id="@contract.Id">View</a>
                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-body" style="display: none;">
        <form asp-action="CreateSubContracttor" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SingleSubContractor.Id" id="hiddenId" />
            <input type="hidden" name="SubmissionToken" id="SubmissionToken" value="@Guid.NewGuid()" />

        <h3 class="mt-5">Company Main:</h3>

            <!-- Row 6 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="CompanyName">Name</label>
                    <input type="text" id="CompanyMainName" class="form-control" asp-for="SingleSubContractor.CompanyMainName" placeholder="Enter Company Main Name" maxLength="50" required>
                    <span id="CompanyMainPhoneError" class="text-danger invalid-feedback" style="display: none;"></span>
                    <span asp-validation-for="SingleSubContractor.CompanyMainName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label for="CompanyId">Company ID</label>
                    <input type="text" id="CompanyId" class="form-control read-only-style" asp-for="SingleSubContractor.CompanyId" maxLength="20" placeholder="Enter Company Id" readonly required>
                    <span asp-validation-for="SingleSubContractor.CompanyId" class="text-danger"></span>
                </div>

            </div>

            <!-- Row 7 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="Address1">Address 1</label>
                    <input type="text" id="CompanyMainAddress1" class="form-control" asp-for="SingleSubContractor.CompanyMainAddress1" placeholder="Enter Company Main Address" maxLength="200" required>
                    <span asp-validation-for="SingleSubContractor.CompanyMainAddress1" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label for="Address2">Address 2</label>
                    <input type="text" id="CompanyMainAddress2" class="form-control" asp-for="SingleSubContractor.CompanyMainAddress2" placeholder="Enter Company Main Address2" maxLength="200">
                    <span asp-validation-for="SingleSubContractor.CompanyMainAddress2" class="text-danger"></span>
                </div>

            </div>

            <!-- Row 8 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="State">State</label>
                    <select id="CompanyMainState" class="form-select" asp-for="SingleSubContractor.CompanyMainState" required>
                        <!-- Options will be added here -->
                    </select>
                    <span asp-validation-for="SingleSubContractor.CompanyMainState" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label for="City">City</label>
                    <select id="CompanyMainCity" class="form-select city-dropdown" asp-for="SingleSubContractor.CompanyMainCity" required>
                        <!-- Options will be added here -->
                    </select>
                    <span asp-validation-for="SingleSubContractor.CompanyMainCity" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 9 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="Zip">Zip</label>
                    <select id="CompanyMainZip" class="form-select" asp-for="SingleSubContractor.CompanyMainZip" required>
                        <!-- Options will be added here -->
                    </select>
                    <span asp-validation-for="SingleSubContractor.CompanyMainZip" class="text-danger"></span>
                </div>
            </div>


            <!-- Row 1 -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="ContractId">Contract Name (DAWSON)</label>
                    <select id="ContractId" class="form-select select2" asp-for="SingleSubContractor.ContractId" required>
                        <!-- Options will be populated dynamically from the database -->
                    </select>
                    <span asp-validation-for="SingleSubContractor.ContractId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label for="ContractClient">Contract Client</label>
                    <input type="text" id="ContractClient" class="form-control read-only-style" readonly maxLength="20" placeholder="Enter Contract Client" required>
                    @*  <span asp-validation-for="SingleSubContractor.ContractClient" class="text-danger"></span> *@
                </div>
            </div>

            <!-- Row 2 -->
            <div class="row mb-3">

                <div class="col-md-6">
                    <label for="ContractType">Contract Type</label>
                    <input type="text" id="ContractType" class="form-control read-only-style" maxLength="20" placeholder="Enter Contract Type" readonly required>
                    @* <span asp-validation-for="SingleSubContractor.ContractType" class="text-danger"></span> *@
                </div>
                <div class="col-md-6">
                    <label for="SmallBusinessType">Small Business/Set Aside Type - if applicable</label>
                    <textarea id="SmallBusinessType" asp-for="SingleSubContractor.SmallBusinessType" class="form-control" rows="4" placeholder="Enter Business Type" placeholder="Enter Business Type" maxLength="300" required></textarea>
                    <span asp-validation-for="SingleSubContractor.SmallBusinessType" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 3 -->
            <div class="row mb-3">

                <div class="col-md-6">
                    <label for="SelectedServiceTypeProvided">Service Type Provided</label>
                    @* <input type="text" id="ContractAffiliation" class="form-control" asp-for="SingleSubContractor.ContractAffiliation" placeholder="Enter Contract Affiliation" maxLength="50" required> *@

                    <select id="ServiceTypeProvided" asp-for="SingleSubContractor.SelectedServiceTypeProvided" multiple="multiple" class="form-control" required>
                        <option value="Audiology">Audiology</option>
                        <option value="Staffing">Staffing</option>
                        <option value="Vital">Vital</option>
                    </select>

                    <span asp-validation-for="SingleSubContractor.SelectedServiceTypeProvided" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label for="ContractServiceBranch">Contract Service Branch</label>
                    <input type="text" id="ContractServiceBranch" class="form-control read-only-style" placeholder="Enter Contract Service Branch" readonly maxLength="50" required>
                    @* <span asp-validation-for="SingleSubContractor.ContractServiceBranch" class="text-danger"></span> *@
                </div>
            </div>

            <!-- Row 4 -->
            <div class="row mb-3">

                <div class="col-md-6">
                    <label for="ContractComponent">Contract Component</label>
                    <input type="text" id="ContractComponent" class="form-control read-only-style" readonly placeholder="Enter Contract Component" maxLength="20" required>
                    @* <span asp-validation-for="SingleSubContractor.ContractComponent" class="text-danger"></span> *@
                </div>
                <div class="col-md-6">
                    <label for="SolicitationNumber">Solicitation #</label>
                    <input type="text" id="SolicitationNumber" class="form-control" asp-for="SingleSubContractor.SolicitationNumber" maxLength="50" placeholder="Enter Solicitation Number" required>
                    <span asp-validation-for="SingleSubContractor.SolicitationNumber" class="text-danger"></span>
                </div>
            </div>

        <h3 class="mt-5">Company Main POC:</h3>

        <!-- Row 9 -->
        <div class="row mb-3">
    <div class="col-md-6">
        <label for="LastName">Last Name</label>
