@model ExcelFilesCompiler.Models.SubContractorInfoDto

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml"; // Adjust the path to your layout file if necessary
    ViewData["Title"] = "Sub Contractor Info";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contract Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        h2 {
            color: rgba(80, 90, 201, 1);
        }

        h3 {
            color: rgba(80, 90, 201, 1);
        }

        .form-label {
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2 class="text-center mb-4">Sub Contractor Info</h2>

        <!-- Row 1 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="ContractId" >Contract ID # (DAWSON)</label>
                <select id="ContractId" name="ContractId" class="form-select" asp-for="ContractId">
                    <!-- Options will be populated dynamically from Contract Detail table -->
                </select>
            </div>
            <div class="col-md-6">
                <label for="CompanyId" >Company ID</label>
                <input type="text" id="CompanyId" name="CompanyId" class="form-control" asp-for="CompanyId" readonly>
            </div>
        </div>

        <!-- Row 2 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="ContractClient" >Contract Client</label>
                <select id="ContractClient" name="ContractClient" class="form-select" asp-for="ContractClient">
                    <!-- Options will be added here -->
                </select>
            </div>
            <div class="col-md-6">
                <label for="ContractType" >Contract Type</label>
                <select id="ContractType" name="ContractType" class="form-select" asp-for="ContractType">
                    <!-- Options will be added here -->
                </select>
            </div>
        </div>

        <!-- Row 3 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="SmallBusinessType" >Small Business/Set Aside Type - if applicable</label>
                <select id="SmallBusinessType" name="SmallBusinessType" class="form-select" asp-for="SmallBusinessType">
                    <!-- Options will be added here -->
                </select>
            </div>
            <div class="col-md-6">
                <label for="ContractAffiliation" >Contract Affiliation of Subcontractor</label>
                <select id="ContractAffiliation" name="ContractAffiliation" class="form-select" asp-for="ContractAffiliation">
                    <!-- Options will be added here -->
                </select>
            </div>
        </div>

        <!-- Row 4 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="ContractServiceBranch" >Contract Service Branch</label>
                <select id="ContractServiceBranch" name="ContractServiceBranch" class="form-select" asp-for="ContractServiceBranch">
                    <!-- Options will be added here -->
                </select>
            </div>
            <div class="col-md-6">
                <label for="ContractComponent" >Contract Component</label>
                <select id="ContractComponent" name="ContractComponent" class="form-select" asp-for="ContractComponent">
                    <!-- Options will be added here -->
                </select>
            </div>
        </div>

        <!-- Row 5 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="SolicitationNumber" >Solicitation #</label>
                <input type="text" id="SolicitationNumber" name="SolicitationNumber" class="form-control" asp-for="SolicitationNumber">
            </div>
        </div>

        <h3 class="mt-5">Company Main:</h3>

        <!-- Row 6 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="CompanyName" >Name</label>
                <input type="text" id="CompanyName" name="CompanyName" class="form-control" asp-for="CompanyName" required>
            </div>
            <div class="col-md-6">
                <label for="Address1" >Address 1</label>
                <input type="text" id="Address1" name="Address1" class="form-control" asp-for="Address1" required>
            </div>
        </div>

        <!-- Row 7 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="Address2" >Address 2</label>
                <input type="text" id="Address2" name="Address2" class="form-control" asp-for="Address2" required>
            </div>
            <div class="col-md-6">
                <label for="City" >City</label>
                <select id="City" name="City" class="form-select" asp-for="City" required>
                    <!-- Options will be added here -->
                </select>
            </div>
        </div>

        <!-- Row 8 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="State" >State</label>
                <select id="State" name="State" class="form-select" asp-for="State" required>
                    <!-- Options will be added here -->
                </select>
            </div>
            <div class="col-md-6">
                <label for="Zip" >Zip</label>
                <select id="Zip" name="Zip" class="form-select" asp-for="Zip" required>
                    <!-- Options will be added here -->
                </select>
            </div>
        </div>

        <h3 class="mt-5">Company Main POC:</h3>

        <!-- Row 9 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="LastName" >Last Name</label>
                <input type="text" id="LastName" name="LastName" class="form-control" asp-for="LastName" required>
            </div>
            <div class="col-md-6">
                <label for="FirstName" >First Name</label>
                <input type="text" id="FirstName" name="FirstName" class="form-control" asp-for="FirstName" required>
            </div>
        </div>

        <!-- Row 10 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="Phone" >Phone</label>
                <input type="text" id="Phone" name="Phone" class="form-control" asp-for="Phone" required>
            </div>
            <div class="col-md-6">
                <label for="Email" >Email</label>
                <input type="email" id="Email" name="Email" class="form-control" asp-for="Email" required>
            </div>
        </div>

        <h3 class="mt-5">Company Finance POC:</h3>

        <!-- Row 11 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="FinanceLastName" >Last Name</label>
                <input type="text" id="FinanceLastName" name="FinanceLastName" class="form-control" asp-for="FinanceLastName" required>
            </div>
            <div class="col-md-6">
                <label for="FinanceFirstName" >First Name</label>
                <input type="text" id="FinanceFirstName" name="FinanceFirstName" class="form-control" asp-for="FinanceFirstName" required>
            </div>
        </div>

        <!-- Row 12 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="FinanceAddress1" >Address 1</label>
                <input type="text" id="FinanceAddress1" name="FinanceAddress1" class="form-control" asp-for="FinanceAddress1" required>
            </div>
            <div class="col-md-6">
                <label for="FinanceAddress2" >Address 2</label>
                <input type="text" id="FinanceAddress2" name="FinanceAddress2" class="form-control" asp-for="FinanceAddress2" required>
            </div>
        </div>

        <!-- Row 13 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="FinanceCity" >City</label>
                <select id="FinanceCity" name="FinanceCity" class="form-select" asp-for="FinanceCity" required>
                    <!-- Options will be added here -->
                </select>
            </div>
            <div class="col-md-6">
                <label for="FinanceState" >State</label>
                <select id="FinanceState" name="FinanceState" class="form-select" asp-for="FinanceState" required>
                    <!-- Options will be added here -->
                </select>
            </div>
        </div>

        <!-- Row 14 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="FinanceZip" >Zip</label>
                <select id="FinanceZip" name="FinanceZip" class="form-select" asp-for="FinanceZip" required>
                    <!-- Options will be added here -->
                </select>
            </div>
            <div class="col-md-6">
                <label for="FinancePhone" >Phone</label>
                <input type="text" id="FinancePhone" name="FinancePhone" class="form-control" asp-for="FinancePhone" required>
            </div>
        </div>

        <!-- Row 15 -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="FinanceEmail" >Email</label>
                <input type="email" id="FinanceEmail" name="FinanceEmail" class="form-control" asp-for="FinanceEmail" required>
            </div>
        </div>

        <h3>Company Event POC</h3>

        <div class="row mb-3">
            <div class="col-md-6">
            <label for="EventLastName" class="col-md-3 col-form-label">Last Name</label>
                <input type="text" id="EventLastName" name="EventLastName" class="form-control" asp-for="EventLastName" required />
            </div>
            <div class="col-md-6">
                <label for="EventFirstName" class="col-md-3 col-form-label">First Name</label>
                <input type="text" id="EventFirstName" name="EventFirstName" class="form-control" asp-for="EventFirstName" required />
            </div>
        </div>


        <div class="row mb-3">
            <div class="col-md-6">
            <label for="EventPhone" class="col-md-3 col-form-label">Phone</label>
                <input type="text" id="EventPhone" name="EventPhone" class="form-control" asp-for="EventPhone" required />
            </div>
            <div class="col-md-6">
                <label for="EventEmail" class="col-md-3 col-form-label">Email</label>
                <input type="email" id="EventEmail" name="EventEmail" class="form-control" asp-for="EventEmail" required />
            </div>
        </div>

      

        <h3>Company Training POC</h3>

        <div class="row mb-3">
            <div class="col-md-6">
            <label for="TrainingLastName" class="col-md-3 col-form-label">Last Name</label>
                <input type="text" id="TrainingLastName" name="TrainingLastName" class="form-control" asp-for="TrainingLastName" required />
            </div>
            <div class="col-md-6">
                <label for="TrainingFirstName" class="col-md-3 col-form-label">First Name</label>
                <input type="text" id="TrainingFirstName" name="TrainingFirstName" class="form-control" asp-for="TrainingFirstName" required />
            </div>
        </div>

        <div class="row mb-3">
            
        </div>

        <div class="row mb-3">
                <div class="col-md-6">
            <label for="TrainingPhone" class="col-md-3 col-form-label">Phone</label>
                <input type="text" id="TrainingPhone" name="TrainingPhone" class="form-control" asp-for="TrainingPhone" required />
            </div>
            <div class="col-md-6">
                <label for="TrainingEmail" class="col-md-3 col-form-label">Email</label>
                <input type="email" id="TrainingEmail" name="TrainingEmail" class="form-control" asp-for="TrainingEmail" required />
            </div>
        </div>


        <div class="section mb-5">
            <h3>Historical Event Information</h3>

            <div class="row mb-3">
                <div class="col-md-6">
                <label for="EventId" class="col-md-3 col-form-label">Event ID</label>
                    <input type="text" id="EventId" name="EventId" class="form-control" asp-for="EventId" />
                </div>
                <div class="col-md-6">
                    <label for="EventStatus" class="col-md-3 col-form-label">Event Status</label>
                    <input type="text" id="EventStatus" name="EventStatus" class="form-control" asp-for="EventStatus" />
                </div>
            </div>

            <div class="row mb-3">
                        <div class="col-md-6">
                <label for="EventRole" class="col-md-3 col-form-label">Event Role</label>
                    <input type="text" id="EventRole" name="EventRole" class="form-control" asp-for="EventRole" />
                </div>
                <div class="col-md-6">
                    <label for="EventCity" class="col-md-3 col-form-label">Event City</label>
                    <input type="text" id="EventCity" name="EventCity" class="form-control" asp-for="EventCity" />
                </div>
            </div>

            <div class="row mb-3">
                                <div class="col-md-6">
                <label for="EventState" class="col-md-3 col-form-label">Event State</label>
                    <input type="text" id="EventState" name="EventState" class="form-control" asp-for="EventState" />
                </div>
                <div class="col-md-6">
                    <label for="EventDate" class="col-md-3 col-form-label">Event Date</label>
                    <input type="text" id="EventDate" name="EventDate" class="form-control" asp-for="EventDate" />
                </div>
            </div>

            
        </div>
        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-success btn-lg me-2">
                <i class="bi bi-check-circle"></i> Submit
            </button>
            <button type="reset" class="btn btn-secondary btn-lg">
                <i class="bi bi-arrow-repeat"></i> Reset
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
</body>
</html>
