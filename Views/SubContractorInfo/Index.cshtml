        <span asp-validation-for="SingleSubContractor.ContractId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label for="CompanyId">Company ID</label>
                <input type="text" id="CompanyId" name="CompanyId" class="form-control read-only-style" asp-for="SingleSubContractor.CompanyId" maxLength="20" placeholder="Enter Company Id" readonly>
        <span asp-validation-for="SingleSubContractor.CompanyId" class="text-danger"></span>
    </div>
</div>

