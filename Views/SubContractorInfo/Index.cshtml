        function validateCompanyMainName() {
            var inputVal = $('#CompanyMainName').val();

            if (inputVal.replace(/[^a-zA-Z0-9]/g, "").length >= 3) {
                $('#CompanyMainPhoneError').hide(); // Hide error span
                return true; // Validation passed
            }
            else {
                $('#CompanyMainPhoneError')
                    .text('Company Main Name must be at least 3 characters.')
                    .show(); // Show error span
                return false; // Validation failed
            }
        }

        function SetCompanyId(companyName) {
            var cleanedName = companyName.replace(/[^a-zA-Z0-9]/g, ""); // Keep only alphanumeric characters
            var companyId = cleanedName.substring(0, 3).toUpperCase(); // Take the first 3 characters

            // If less than 3 valid characters, pad with 'X' or repeat existing characters
            if (companyId.length < 3) {
                companyId = companyId.padEnd(3, "X");
            }

            $("#CompanyId").val(companyId); // Set the value in CompanyId field
        }

       

