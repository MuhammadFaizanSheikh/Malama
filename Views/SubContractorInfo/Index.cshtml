<script>
    $(document).ready(function () {

        $('#contractsTable').DataTable({
            "paging": true,  // Enables pagination
            "lengthChange": true,  // Option to change number of records per page
            "searching": true,  // Enables search box
            "ordering": false,  // Enables column sorting
            "info": true,  // Shows table information (e.g., "Showing 1 to 10 of 50 entries")
            "autoWidth": true,  // Adjusts table width automatically
            "responsive": true,  // Makes the table responsive on small screens
            "language": {
                "search": "Search Contracts:"  // Customizing the search box label
            },
            "order": [[0, 'desc']]  // Set default sorting on the first column (ID) in descending order
        });


        $('#ContractId').select2({
            placeholder: 'Select a contract', // Optional placeholder
            allowClear: true                 // Allows clearing the selection
        });

        function debounce(func, delay) {
            let timer;
            return function () {
                const context = this;
                const args = arguments;
                clearTimeout(timer);
                timer = setTimeout(() => func.apply(context, args), delay);
            };
        }

        // Function to fetch and populate contracts based on search term
        function fetchContracts(searchTerm, page) {
            $.ajax({
                url: '/ContractDetails/GetContracts',
                method: 'GET',
                data: {
                    searchTerm: searchTerm,
                    page: page
                },
                success: function (response) {
                    // Populate the dropdown with the fetched contracts
                    const dropdown = $('#ContractId');
                    dropdown.empty(); // Clear current options

                    // Append new options
                    response.items.forEach(function (contract) {
                        dropdown.append(new Option(contract.text, contract.id));
                    });

                    // Optional: Update pagination if needed
                    // (you can handle pagination controls here if needed)
                },
                error: function () {
                    console.error("An error occurred while fetching contracts.");
                }
            });
        }

        // Attach the debounced function to the search input (for this example, it's assumed that you're using input inside the dropdown)
        $('#ContractId').on('input', debounce(function () {
            const searchTerm = $(this).val();  // Get the current input value
            fetchContracts(searchTerm, 1);      // Call the fetchContracts function with the search term and page 1
        }, 500)); // Adjust the delay to suit your needs (500ms delay in this case)
    });

</script>