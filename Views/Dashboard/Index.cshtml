@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="dashboard-icons">
    @if (User.IsInRole("Super Admin") || User.IsInRole("Project Manager & Program Manager"))
    {
        <a asp-controller="AccountRegistration" asp-action="Register" class="icon-box">
            <img src="/images/Admin.jpg" alt="Admin" />
            <span>Admin</span>
        </a>
    }
    <a asp-controller="Home" asp-action="Index" class="icon-box">
        <img src="/images/Report Processor.jpg" alt="Report Processor" />
        <span>Report Processor</span>
    </a>

    @* @if (User.IsInRole("Super Admin") || User.IsInRole("Project Manager & Program Manager"))
    {
        <a asp-controller="ExcelFileUploader" asp-action="Index" asp-route-userType="admin" class="icon-box">
            <img src="/images/Report Processor.jpg" alt="Malama Check In Out" />
            <span>Malama Check In Out (Admin)</span>
        </a>
    } *@

    <a asp-controller="ExcelFileUploader" asp-action="Index" asp-route-userType="admin" class="icon-box">
            <img src="/images/Report Processor.jpg" alt="Malama Check In Out" />
            <span>Malama Check In Out (Admin)</span>
        </a>


    @if (User.IsInRole("Check in/out Staff"))
    {
        <a asp-controller="ExcelFileUploader" asp-action="Index" asp-route-userType="client" class="icon-box">
            <img src="/images/Check-In.jpg" alt="Malama Check In Out" />
            <span>Malama Check In Out (Staff)</span>
        </a>
    }

    <a asp-controller="SubContractorInfo" asp-action="Index" class="icon-box">
        <img src="/images/Sub-contractorInfo.jpg" alt="Sub - Contractor Info" />
        <span>Sub - Contractor Info</span>
    </a>

    <a asp-controller="ContractDetails" asp-action="Index" class="icon-box">
        <img src="/images/ContractDetails.jpg" alt="Contract Details" />
        <span>Contract Details</span>
    </a>

    <a asp-controller="EventManagement" asp-action="Index" class="icon-box">
        <img src="/images/Event Management.png" alt="Event Management" />
        <span>Event Management</span>
    </a>

    <a asp-controller="EventStaff" asp-action="Index" class="icon-box">
        <img src="/images/Event Satff Icon.jpg" alt="Event Satff" />
        <span>Event Staff</span>
    </a>






    @if (User.IsInRole("Audiologist"))
    {
        <a asp-controller="Audiologist" asp-action="Index" class="icon-box">
            <img src="/images/Audiologist.jpg" alt="Audiologist" />
            <span>Audiologist</span>
        </a>
    }


    <a asp-controller="CaseManagement" asp-action="Index" class="icon-box">
        <img src="/images/Case Management.jpg" alt="Case Management" />
        <span>Case Management</span>
    </a>

    @{
        bool showDentalExamsLink =
        (User.IsInRole("DE- Dentist") && User.HasClaim("Attribute", "Exam")) ||
        (User.IsInRole("DE-Dental X-Ray Tech") && User.HasClaim("Attribute", "Exam")) ||
        (User.IsInRole("DE-Dental Assistant") && User.HasClaim("Attribute", "Exam")) ||
        (User.IsInRole("DE-Dental Lead") && User.HasClaim("Attribute", "Exam")) ||
        (User.IsInRole("DE-Dental Director") && User.HasClaim("Attribute", "Exam")) ||
        (User.IsInRole("DT-Treatment Coordinator") && User.HasClaim("Attribute", "Treatment")) ||
        (User.IsInRole("DT-Dentist") && User.HasClaim("Attribute", "General")) ||
        (User.IsInRole("DT-Dentist") && User.HasClaim("Attribute", "Oral Surgery")) ||
        (User.IsInRole("DT-Dentist") && User.HasClaim("Attribute", "Endo")) ||
        (User.IsInRole("DT-Dental Assistant") && User.HasClaim("Attribute", "Treatment")) ||
        (User.IsInRole("DT-Dental Director") && User.HasClaim("Attribute", "Treatment"));
    }

    @if (showDentalExamsLink)
    {
        <a asp-controller="DentalExams" asp-action="Index" class="icon-box">
            <img src="/images/Dental Exams.jpg" alt="Dental Exams" />
            <span>Dental Exams</span>
        </a>
    }


    @{
        bool showDentalTreatmentLink =
        (User.IsInRole("DE-Dental X-Ray Tech") && User.HasClaim("Attribute", "Exam")) ||
        (User.IsInRole("DE-Dental Director") && User.HasClaim("Attribute", "Exam")) ||
        (User.IsInRole("DT-Treatment Coordinator") && User.HasClaim("Attribute", "Treatment")) ||
        (User.IsInRole("DT-Dentist") && User.HasClaim("Attribute", "General")) ||
        (User.IsInRole("DT-Dentist") && User.HasClaim("Attribute", "Oral Surgery")) ||
        (User.IsInRole("DT-Dentist") && User.HasClaim("Attribute", "Endo")) ||
        (User.IsInRole("DT-Dental Assistant") && User.HasClaim("Attribute", "Treatment")) ||
        (User.IsInRole("DT-Dental Director") && User.HasClaim("Attribute", "Treatment"));
    }

    @if (showDentalTreatmentLink)
    {
        <a asp-controller="DentalTreatment" asp-action="Index" class="icon-box">
            <img src="/images/Dental Treatment.jpg" alt="Dental Treatment" />
            <span>Dental Treatment</span>
        </a>
    }

    @if (showDentalExamsLink)
    {
        <a asp-controller="DentalXRay" asp-action="Index" class="icon-box">
            <img src="/images/Dental X-Ray.jpg" alt="Dental X-Ray" />
            <span>Dental X-Ray</span>
        </a>
    }

    @if (User.IsInRole("EKG Staff"))
    {
        <a asp-controller="EKG" asp-action="Index" class="icon-box">
            <img src="/images/EKG.jpg" alt="EKG" />
            <span>EKG</span>
        </a>
    }

    @if (User.IsInRole("Audio Tech") || User.IsInRole("Audiologist"))
    {
        <a asp-controller="Hearing" asp-action="Index" class="icon-box">
            <img src="/images/Hearing.jpg" alt="Hearing" />
            <span>Hearing</span>
        </a>
    }


    @{
        bool showImmunizationRelatedForms =
        (User.IsInRole("Imm RN") && User.HasClaim("Attribute", "Imms")) ||
        (User.IsInRole("Imm RN") && User.HasClaim("Attribute", "Cold Chain Cert")) ||
        (User.IsInRole("Imm Staff") && User.HasClaim("Attribute", "Imms")) ||
        (User.IsInRole("Imm Staff") && User.HasClaim("Attribute", "Cold Chain Cert"));
    }

    @if (showImmunizationRelatedForms)
    {
        <a asp-controller="ImmunizationStation" asp-action="Index" class="icon-box">
            <img src="/images/Immunizations.jpg" alt="Immunizations" />
            <span>Immunizations</span>
        </a>
    }

    @if (showImmunizationRelatedForms)
    {
        <a asp-controller="ImmunizationVaccineInfo" asp-action="Index" class="icon-box">
            <img src="/images/Vaccine Info.png" alt="Vaccine Info" />
            <span>Vaccine Info</span>
        </a>
    }

    @if (showImmunizationRelatedForms)
    {
        <a asp-controller="Container" asp-action="Index" asp-route-eventId="" class="icon-box">
            <img src="/images/Monitor Container Temperature.png" alt="Vaccine information icon" />
            <span>Monitor Container Temperature</span>
        </a>
    }


    @if (User.IsInRole("Lab Staff") || User.IsInRole("Lab Admin"))
    {
        <a asp-controller="Labs" asp-action="Index" class="icon-box">
            <img src="/images/Labs.jpg" alt="Labs" />
            <span>Labs</span>
        </a>
    }


    @if (User.IsInRole("Optometrist"))
    {
        <a asp-controller="Optometrist" asp-action="Index" class="icon-box">
            <img src="/images/Optometrist.jpg" alt="Optometrist" />
            <span>Optometrist</span>
        </a>
    }


    @{
        bool showPanoramicDentalXRayLink =
        showDentalExamsLink &&
        (User.IsInRole("Panorex X-ray") && User.HasClaim("Attribute", "Panorex X-ray"));
    }

    @if (showPanoramicDentalXRayLink)
    {
        <a asp-controller="PanoramicDentalXRay" asp-action="Index" class="icon-box">
            <img src="/images/Panoramic Dental X-Ray.jpg" alt="Panoramic Dental X-Ray" />
            <span>Panoramic Dental X-Ray</span>
        </a>
    }


    @if (User.IsInRole("PHA-Record Review") || User.IsInRole("PHA Provider"))
    {
        <a asp-controller="RecordsReview" asp-action="Index" class="icon-box">
            <img src="/images/Records Review.jpg" alt="Records Review" />
            <span>Records Review</span>
        </a>
    }



    <a asp-controller="SelfAssessment" asp-action="Index" class="icon-box">
        <img src="/images/Self-Assessment.jpg" alt="Self-Assessment" />
        <span>Self-Assessment</span>
    </a>

    @if (User.IsInRole("Vitals Staff") || User.IsInRole("Vision Tech") || User.IsInRole("Optometrist"))
    {
        <a asp-controller="VisionScreening" asp-action="Index" class="icon-box">
            <img src="/images/Vision Screening.jpg" alt="Vision Screening" />
            <span>Vision Screening</span>
        </a>
    }


    @if (User.IsInRole("Vitals Staff"))
    {
        <a asp-controller="Vitals" asp-action="Index" class="icon-box">
            <img src="/images/Vitals.jpg" alt="Vitals" />
            <span>Vitals</span>
        </a>
    }
   
</div>
<style>
.dashboard-icons {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    padding: 20px;
}

    .icon-box {
        flex-basis: calc(20% - 20px); /* 20% width minus margin/padding */
        max-width: calc(20% - 20px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: 120px;
        background-color: #ffffff;
        border-radius: 10px;
        text-decoration: none;
        color: #333;
        margin: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

        .icon-box:hover {
            background-color: #d6e6f2;
            transform: translateY(-5px);
        }

        .icon-box img {
            width: 75px;
            height: 70px;
            margin-bottom: 10px;
        }

        .icon-box span {
            font-size: 16px;
            font-weight: bold;
        }

    .dashboard-icons {
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        padding: 20px;
    }
</style>