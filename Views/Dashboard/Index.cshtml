<style>
    .dashboard-home {
        --tile-accent: rgba(80, 90, 201, 1);
    }

    .dashboard-home-intro {
        margin-bottom: 1.25rem;
        padding: 0.25rem 0.35rem 0.5rem;
    }

    .dashboard-kicker {
        margin: 0 0 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--tile-accent);
    }

    .dashboard-title {
        margin: 0;
        font-size: clamp(1.7rem, 2.4vw, 2.15rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #1f2430;
    }

    .dashboard-subtitle {
        margin: 0.4rem 0 0;
        color: #6b7285;
        font-size: 0.98rem;
    }

    .dashboard-icons {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
        gap: 1rem;
        padding: 0.25rem 0 0.5rem;
    }

    .icon-box {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 0.85rem;
        min-height: 168px;
        padding: 1.1rem 0.9rem 1rem;
        text-decoration: none;
        color: #1f2430;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(247, 248, 252, 0.96) 100%);
        border: 1px solid rgba(31, 36, 48, 0.08);
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(21, 24, 33, 0.06);
        overflow: hidden;
        transition:
            transform 0.28s ease,
            box-shadow 0.28s ease,
            border-color 0.28s ease,
            background 0.28s ease;
        animation: tileRise 0.45s ease both;
    }

    .icon-box::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--tile-accent), transparent);
        opacity: 0;
        transition: opacity 0.28s ease;
    }

    .icon-box:hover,
    .icon-box:focus-visible {
        transform: translateY(-7px);
        border-color: rgba(80, 90, 201, 0.35);
        box-shadow:
            0 18px 36px rgba(80, 90, 201, 0.16),
            0 8px 18px rgba(21, 24, 33, 0.08);
        background: #fff;
        color: #1f2430;
        outline: none;
    }

    .icon-box:hover::before,
    .icon-box:focus-visible::before {
        opacity: 1;
    }

    .icon-media {
        width: 78px;
        height: 78px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        background:
            radial-gradient(circle at 30% 25%, rgba(80, 90, 201, 0.16), transparent 55%),
            linear-gradient(160deg, #f4f6ff 0%, #eef2fb 100%);
        border: 1px solid rgba(80, 90, 201, 0.12);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
        transition: transform 0.28s ease, box-shadow 0.28s ease;
    }

    .icon-box:hover .icon-media {
        transform: scale(1.04);
        box-shadow: 0 8px 18px rgba(80, 90, 201, 0.18);
    }

    .icon-box img {
        width: 54px;
        height: 54px;
        object-fit: contain;
        border-radius: 10px;
    }

    .icon-label {
        font-size: 0.92rem;
        font-weight: 600;
        line-height: 1.3;
        text-align: center;
        max-width: 12.5rem;
    }

    .dashboard-icons .icon-box:nth-child(1) { animation-delay: 0.02s; }
    .dashboard-icons .icon-box:nth-child(2) { animation-delay: 0.04s; }
    .dashboard-icons .icon-box:nth-child(3) { animation-delay: 0.06s; }
    .dashboard-icons .icon-box:nth-child(4) { animation-delay: 0.08s; }
    .dashboard-icons .icon-box:nth-child(5) { animation-delay: 0.10s; }
    .dashboard-icons .icon-box:nth-child(6) { animation-delay: 0.12s; }
    .dashboard-icons .icon-box:nth-child(7) { animation-delay: 0.14s; }
    .dashboard-icons .icon-box:nth-child(8) { animation-delay: 0.16s; }
    .dashboard-icons .icon-box:nth-child(n+9) { animation-delay: 0.18s; }

    @@keyframes tileRise {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 700px) {
        .dashboard-icons {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.85rem;
        }

        .icon-box {
            min-height: 150px;
            padding: 0.95rem 0.7rem;
        }

        .icon-media {
            width: 68px;
            height: 68px;
            border-radius: 16px;
        }

        .icon-box img {
            width: 46px;
            height: 46px;
        }
    }
</style>
