<style>
.dashboard-icons {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    padding: 20px;
}

    .icon-box {
        flex-basis: calc(20% - 20px); /* 20% width minus margin/padding */
        max-width: calc(20% - 20px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: 120px;
        background-color: #ffffff;
        border-radius: 10px;
        text-decoration: none;
        color: #333;
        margin: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

        .icon-box:hover {
            background-color: #d6e6f2;
            transform: translateY(-5px);
        }

        .icon-box img {
            width: 75px;
            height: 70px;
            margin-bottom: 10px;
        }

        .icon-box span {
            font-size: 16px;
            font-weight: bold;
        }

    .dashboard-icons {
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        padding: 20px;
    }
</style>