@using ExcelFilesCompiler.Controllers.Services
@using ExcelFilesCompiler.Utilities
@using Malama.Models
@using Malama.Utilities
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model DentalExamStationPageViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dental Exams";

    var sm = Model.ServiceMember;
    var questionnaire = Model.Questionnaire;
    var dentalExam = Model.DentalExam;
    var isFemale = DentalXRayStationService.IsFemale(sm);
    var canSaveDentalExam = DashboardAuthorizationHelper.HasAccess(User, "DentalExams_Save");
    // Dentist-only: review, signature, and subsequent edits. All other Dental Exam roles (assistant, Event Manager, future) share assistant-like locks.
    var isDentalExamDentist = User.IsInRole("DE- Dentist");
    var subsequentReadOnly = !isDentalExamDentist;
    var vitalStationDto = ViewBag.VitalStation as VitalStationDto ?? new VitalStationDto
    {
        ServiceMembersChildId = sm.Id,
        Status = "Pending"
    };
    var vitalsCompleted = ViewBag.VitalsCompleted as bool? ?? false;
    var showSubsequentDiseasesSection = dentalExam.QuestionnaireReviewed && dentalExam.DentistSignatureEntered;
    var serviceMemberPanoRequired = DentalXRayStationService.IsNeeded(sm?.PanoNeeded);
    var showFinalCommentsReadOnly = subsequentReadOnly && dentalExam.QuestionnaireReviewed;
    var showSignatureReadOnly = subsequentReadOnly && dentalExam.DentistSignatureEntered;
    var dentalExamOverallStatus = string.IsNullOrWhiteSpace(dentalExam.Status) ? "Pending" : dentalExam.Status;
}

<style>
    .dex-station {
        --dex-indigo: rgba(80, 90, 201, 1);
        --dex-indigo-soft: rgba(80, 90, 201, 0.12);
        --dex-indigo-mid: rgba(80, 90, 201, 0.22);
        --dex-text: #1f2430;
        --dex-muted: #6b7285;
        --dex-surface: #ffffff;
        --dex-border: rgba(31, 36, 48, 0.08);
        --dex-shadow: 0 10px 28px rgba(21, 24, 33, 0.06);
        --dex-radius: 16px;
    }

    .dex-station .btn-general {
        background: var(--dex-indigo);
        border: 1px solid var(--dex-indigo);
        color: #fff;
        border-radius: 10px;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .dex-station .btn-general:hover:not(:disabled) {
        background: rgb(60, 70, 180);
        border-color: rgb(60, 70, 180);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(80, 90, 201, 0.25);
    }

    .dex-station .btn-general:disabled {
        opacity: 0.55;
    }

    .dex-station .btn-back-confirm {
        border-radius: 10px;
        font-weight: 600;
        background: #fff;
        color: #4b5160;
        border: 1px solid rgba(31, 36, 48, 0.14);
    }

    .dex-station .btn-back-confirm:hover {
        background: #f3f4f8;
        color: #1f2430;
        border-color: rgba(31, 36, 48, 0.22);
    }

    .dex-hero {
        margin-bottom: 1.25rem;
        padding: 0.1rem 0.15rem 0.25rem;
    }

    .dex-title {
        margin: 0;
        font-size: clamp(1.45rem, 2.1vw, 1.9rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--dex-text);
    }

    .dex-panel {
        background: var(--dex-surface);
        border: 1px solid var(--dex-border);
        border-radius: var(--dex-radius);
        box-shadow: var(--dex-shadow);
        padding: 1.15rem 1.25rem 1.2rem;
        margin-bottom: 1.1rem;
    }

    .dex-panel-title {
        margin: 0 0 1rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--dex-text);
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .dex-panel-title i {
        color: var(--dex-indigo);
    }

    .dex-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem 1rem;
    }

    .dex-info-item {
        padding: 0.75rem 0.85rem;
        border-radius: 12px;
        background: linear-gradient(180deg, #f8f9fc 0%, #f3f5fa 100%);
        border: 1px solid var(--dex-border);
    }

    .dex-info-label {
        display: block;
        margin-bottom: 0.2rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--dex-muted);
    }

    .dex-info-value {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--dex-text);
        word-break: break-word;
    }

    .dex-station .form-label {
        font-size: 0.84rem;
        font-weight: 600;
        color: #4b5160;
    }

    .dex-station .form-control,
    .dex-station .form-select {
        border-radius: 10px;
        border-color: rgba(31, 36, 48, 0.12);
        min-height: 42px;
        box-shadow: none;
    }

    .dex-station .form-control:focus,
    .dex-station .form-select:focus {
        border-color: rgba(80, 90, 201, 0.55);
        box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.18);
    }

    .questionnaire-heading {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .questionnaire-heading h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--dex-indigo);
    }

    .questionnaire-toggle-switch .form-check-input {
        width: 2.75rem;
        height: 1.4rem;
        margin-top: 0;
        cursor: pointer;
    }

    .questionnaire-toggle-switch .form-check-input:checked {
        background-color: var(--dex-indigo);
        border-color: var(--dex-indigo);
    }

    .questionnaire-toggle-switch .form-check-input:focus {
        border-color: rgba(80, 90, 201, 0.5);
        box-shadow: 0 0 0 0.25rem rgba(80, 90, 201, 0.25);
    }

    .dex-notice {
        margin: 0 0 0.75rem;
        padding: 0.75rem 0.9rem;
        border-radius: 10px;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.35);
        color: #92400e;
        font-weight: 600;
    }

    .dex-notice.is-warning {
        background: rgba(217, 119, 6, 0.1);
        border-color: rgba(217, 119, 6, 0.28);
        color: #b45309;
    }

    .dex-page-save-bar {
        margin-top: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.85rem;
        padding-top: 0.85rem;
        border-top: 1px solid var(--dex-border);
        margin-bottom: 1.5rem;
    }

    .dex-page-status-wrap {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        min-width: 0;
        flex: 1 1 220px;
        max-width: 360px;
    }

    .dex-page-status-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--dex-muted);
        letter-spacing: 0.02em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .dex-page-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 104px;
        padding: 0.38rem 0.85rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .dex-page-status-pending {
        background: rgba(217, 119, 6, 0.12);
        color: #b45309;
    }

    .dex-page-status-completed {
        background: rgba(22, 163, 74, 0.14);
        color: #15803d;
    }

    .dex-footer-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: flex-end;
    }

    .read-only-style {
        background-color: #f3f5fa !important;
        pointer-events: none;
        border-color: rgba(31, 36, 48, 0.1) !important;
    }

    #DentistSignatureRoles.read-only-style {
        pointer-events: auto;
        overflow-y: auto;
        resize: none;
    }

    .condition-detail { display: none; }
    .condition-item { margin-bottom: 0.85rem; }

    .dex-station .condition-item .form-check {
        padding: 0.55rem 0.7rem;
        border-radius: 10px;
        background: #f7f8fc;
        border: 1px solid transparent;
    }

    .dex-station .condition-item .form-check:hover {
        border-color: var(--dex-indigo-mid);
    }

    .dex-station .card,
    .dex-station .xray-upload-card,
    .dex-station .xray-preview-card {
        border: 1px solid var(--dex-border) !important;
        border-radius: 14px !important;
        box-shadow: var(--dex-shadow);
        background: var(--dex-surface);
        overflow: hidden;
    }

    .dex-station .xray-upload-card .card-body {
        padding: 1rem 1.05rem 1.1rem;
    }

    .dex-station .preview-xray-file,
    .dex-station .xray-zoom-in,
    .dex-station .xray-zoom-out,
    .dex-station .xray-zoom-reset {
        border-radius: 8px;
        font-weight: 600;
    }

    .dex-station .xray-zoom-in,
    .dex-station .xray-zoom-out {
        background: var(--dex-indigo) !important;
        border-color: var(--dex-indigo) !important;
        color: #fff !important;
    }

    .dex-station .preview-xray-file,
    .dex-station .xray-zoom-reset {
        border-color: var(--dex-indigo-mid);
        color: var(--dex-indigo);
    }

    .xray-cards-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    @@media (max-width: 992px) {
        .xray-cards-row { grid-template-columns: 1fr; }
        .dex-info-grid { grid-template-columns: 1fr; }
    }

    .xray-upload-full-width { width: 100%; }
    .xray-preview-viewport-full { height: 360px; }
    .bwx-upload-mode-option { margin-bottom: 0.65rem; }

    .xray-preview-viewport {
        width: 100%;
        height: 280px;
        overflow: auto;
        border: 1px solid rgba(31, 36, 48, 0.1);
        border-radius: 12px;
        background:
            linear-gradient(45deg, #eef0f5 25%, transparent 25%),
            linear-gradient(-45deg, #eef0f5 25%, transparent 25%),
            linear-gradient(45deg, transparent 75%, #eef0f5 75%),
            linear-gradient(-45deg, transparent 75%, #eef0f5 75%);
        background-size: 20px 20px;
        background-position: 0 0, 0 10px, 10px -10px, -10px 0;
        background-color: #f4f6fa;
    }

    .xray-preview-viewport.can-pan { cursor: grab; }
    .xray-preview-viewport.can-pan.is-panning {
        cursor: grabbing;
        user-select: none;
    }

    .xray-preview-viewport img {
        display: block;
        width: 100%;
        height: auto;
        max-width: none;
        transform-origin: top left;
        -webkit-user-drag: none;
        user-select: none;
    }

    .xray-preview-card {
        border-radius: 0.5rem;
        padding: 1rem;
        background: #fdfdff;
    }

    .xray-preview-viewport-boxed {
        height: 320px;
        border-radius: 0.375rem;
    }

    #psrToothChartReferenceImage {
        width: 100%;
        max-width: 100%;
        min-height: 520px;
        max-height: 620px;
        object-fit: contain;
    }
</style>
<link rel="stylesheet" href="~/css/dental-psr-tooth-chart.css" asp-append-version="true" />

<section class="dex-station">
<div class="dex-hero">
    <h1 class="dex-title" id="page-heading">Edit Service Member at Dental Exams</h1>
</div>

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            Swal.fire({
                icon: '@TempData["ResponseStatus"]',
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor,
                iconColor: iconColor
            });
        });
    </script>
}

<form id="SaveDentalExamStation" asp-action="SaveDentalExamStation" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ServiceMembersChildId" value="@sm.Id" />
    <input type="hidden" name="DentalExamId" value="@dentalExam.Id" />
    <input type="hidden" name="GoToVitalStation" id="GoToVitalStationFlag" value="false" />

    <div class="dex-panel">
        <h2 class="dex-panel-title"><i class="fas fa-user" aria-hidden="true"></i> Personal Information</h2>
        <div class="dex-info-grid">
            <div class="dex-info-item">
                <span class="dex-info-label">Full Name</span>
                <p class="dex-info-value">@sm?.FullName</p>
            </div>
            <div class="dex-info-item">
                <span class="dex-info-label">DOD ID</span>
                <p class="dex-info-value">@sm?.DodId</p>
            </div>
            <div class="dex-info-item">
                <span class="dex-info-label">Routing Sheet Barcode</span>
                <p class="dex-info-value">@sm?.Barcode</p>
            </div>
            <div class="dex-info-item">
                <span class="dex-info-label">DOB</span>
                <p class="dex-info-value">@sm?.Dob</p>
            </div>
            <div class="dex-info-item">
                <span class="dex-info-label">Age</span>
                <p class="dex-info-value">@sm?.Age</p>
            </div>
            <div class="dex-info-item">
                <span class="dex-info-label">Sex</span>
                <p class="dex-info-value">@sm?.Sex</p>
            </div>
            <div class="dex-info-item">
                <span class="dex-info-label">DRC</span>
                <p class="dex-info-value">@sm?.Drc</p>
            </div>
        </div>
    </div>

    <div class="dex-panel">
    <div class="questionnaire-heading" id="questionnaireHeading">
        <div class="form-check form-switch questionnaire-toggle-switch mb-0">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="toggleQuestionnaireSectionSwitch"
                   aria-controls="questionnaireSection"
                   aria-expanded="false" />
        </div>
        <h3>Questionnaire</h3>
    </div>

    <div id="questionnaireSection" style="display:none;">
    @await Html.PartialAsync("~/Views/DentalXRay/_DentalXRayQuestionnaire.cshtml", questionnaire)

    @if (isFemale)
    {
        <div class="row mb-3" id="pregnancyQuestionSection">
            <div class="col-md-6 mb-3">
                <label class="form-label">12. Are you pregnant?</label>
                <select name="AreYouPregnant" id="AreYouPregnant" class="form-select" required>
                    <option value="No" selected="@(string.IsNullOrWhiteSpace(questionnaire.AreYouPregnant) || questionnaire.AreYouPregnant == "No")">No</option>
                    <option value="Yes" selected="@(questionnaire.AreYouPregnant == "Yes")">Yes</option>
                </select>
            </div>
        </div>

        <div class="row mb-4" id="pregnancyApprovalSection" style="display:none;">
            <div class="col-md-12">
                <p class="dex-notice is-warning">Approval is needed from Service Member before going to X-Ray</p>
                <select name="PregnancyApproval" id="PregnancyApproval" class="form-select">
                    <option value=""></option>
                    <option value="Approved" selected="@(questionnaire.PregnancyApproval == "Approved")">Approved</option>
                    <option value="Declined" selected="@(questionnaire.PregnancyApproval == "Declined")">Declined</option>
                </select>
            </div>
        </div>
    }

    @{
        var healthConditionsQuestionNumber = isFemale ? 13 : 12;
        var savedHealthConditions = DentalQuestionnaireService.ParseHealthConditionsJson(questionnaire.ApplicableHealthConditionsJson);
        var savedByCondition = savedHealthConditions
            .Where(h => !string.IsNullOrWhiteSpace(h.Condition))
            .ToDictionary(h => h.Condition, h => h, StringComparer.OrdinalIgnoreCase);

        bool IsConditionSelected(string condition) => savedByCondition.ContainsKey(condition);
        string GetConditionDetail(string condition) =>
            savedByCondition.TryGetValue(condition, out var item) ? item.Detail ?? "" : "";
    }
    <div class="mb-2">
            <label class="form-label fw-semibold">@healthConditionsQuestionNumber. Check the following conditions if they apply to you:</label>
            <div class="row condition-checkboxes">
                @for (var ci = 0; ci < DentalXRayQuestionnaire.HealthConditions.Length; ci++)
                {
                    var condition = DentalXRayQuestionnaire.HealthConditions[ci];
                    var isSelected = IsConditionSelected(condition);
                    var detail = GetConditionDetail(condition);
                    <div class="col-md-6 condition-item">
                        <input type="hidden" name="HealthConditionDetails[@ci].Condition" value="@condition" />
                        <div class="form-check">
                            <input class="form-check-input condition-checkbox" type="checkbox"
                                   name="ApplicableHealthConditions"
                                   value="@condition"
                                   id="condition_@ci"
                                   checked="@isSelected" />
                            <label class="form-check-label" for="condition_@ci">@condition</label>
                        </div>
                        <div class="condition-detail ms-4 mt-1">
                            <textarea name="HealthConditionDetails[@ci].Detail"
                                      class="form-control condition-detail-text"
                                      rows="3"
                                      placeholder="Please provide details">@detail</textarea>
                        </div>
                    </div>
                }
                @{
                    var otherIndex = DentalXRayQuestionnaire.HealthConditions.Length;
                    var otherCondition = DentalXRayQuestionnaire.OtherHealthCondition;
                    var otherSelected = IsConditionSelected(otherCondition);
                    var otherDetail = GetConditionDetail(otherCondition);
                }
                <div class="col-md-6 condition-item">
                    <input type="hidden" name="HealthConditionDetails[@otherIndex].Condition" value="@otherCondition" />
                    <div class="form-check">
                        <input class="form-check-input condition-checkbox" type="checkbox"
                               name="ApplicableHealthConditions"
                               value="@otherCondition"
                               id="condition_other"
                               checked="@otherSelected" />
                        <label class="form-check-label" for="condition_other">@otherCondition</label>
                    </div>
                    <div class="condition-detail ms-4 mt-1">
                        <textarea name="HealthConditionDetails[@otherIndex].Detail"
                                  class="form-control condition-detail-text"
                                  rows="3"
                                  placeholder="Please provide details">@otherDetail</textarea>
                    </div>
                </div>
            </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            @if (isDentalExamDentist)
            {
                <input type="hidden" name="QuestionnaireReviewed" value="false" />
                <div class="form-check mb-2">
                    <input class="form-check-input dental-exam-review-toggle"
                           type="checkbox"
                           name="QuestionnaireReviewed"
                           id="QuestionnaireReviewed"
                           value="true"
                           @(dentalExam.QuestionnaireReviewed ? "checked" : null) />
                    <label class="form-check-label fw-semibold" for="QuestionnaireReviewed">
                        Dental Questionnaire has been reviewed?
                    </label>
                </div>
                <div id="finalCommentsSection" style="@(dentalExam.QuestionnaireReviewed ? "" : "display:none;")">
                    <label class="form-label" for="FinalComments">Final Comments</label>
                    <textarea name="FinalComments"
                              id="FinalComments"
                              class="form-control"
                              rows="4"
                              @(dentalExam.QuestionnaireReviewed ? "required" : "")>@dentalExam.FinalComments</textarea>
                </div>
            }
            else if (showFinalCommentsReadOnly)
            {
                <input type="hidden" name="QuestionnaireReviewed" value="true" />
                <p class="fw-semibold mb-2">Dental Questionnaire has been reviewed?</p>
                <div id="finalCommentsSection">
                    <label class="form-label" for="FinalComments">Final Comments</label>
                    <textarea name="FinalComments"
                              id="FinalComments"
                              class="form-control read-only-style"
                              rows="4"
                              readonly>@dentalExam.FinalComments</textarea>
                </div>
            }
            else
            {
                <input type="hidden" name="QuestionnaireReviewed" value="@(dentalExam.QuestionnaireReviewed ? "true" : "false")" />
                @if (!string.IsNullOrWhiteSpace(dentalExam.FinalComments))
                {
                    <input type="hidden" name="FinalComments" value="@dentalExam.FinalComments" />
                }
            }
        </div>
        <div class="col-md-6">
            @if (isDentalExamDentist)
            {
                <input type="hidden" name="DentistSignatureEntered" value="false" />
                <div class="form-check mb-2">
                    <input class="form-check-input dental-exam-review-toggle"
                           type="checkbox"
                           name="DentistSignatureEntered"
                           id="DentistSignatureEntered"
                           value="true"
                           @(dentalExam.DentistSignatureEntered ? "checked" : null) />
                    <label class="form-check-label fw-semibold" for="DentistSignatureEntered">
                        Dentist Signature - Enter Your Name
                    </label>
                </div>
                <div id="dentistSignatureSection" style="@(dentalExam.DentistSignatureEntered ? "" : "display:none;")">
                    <label class="form-label" for="DentistSignatureName">Name</label>
                    <div class="row g-2 align-items-center">
                        <div class="col-md-7">
                            <input type="text"
                                   id="DentistSignatureName"
                                   class="form-control read-only-style"
                                   value="@(ViewBag.DentistSignatureDisplayName as string ?? "")"
                                   readonly
                                   @(dentalExam.DentistSignatureEntered ? "required" : null) />
                        </div>
                        <div class="col-md-5">
                            <input type="text"
                                   id="DentistSignatureDateTimeDisplay"
                                   class="form-control read-only-style"
                                   value="@(dentalExam.DentistSignatureDateTime?.ToString("MM/dd/yyyy hh:mm tt") ?? "")"
                                   placeholder="Signed date/time"
                                   readonly
                                   style="@(dentalExam.DentistSignatureDateTime.HasValue ? "" : "display:none;")" />
                        </div>
                    </div>
                    <label class="form-label mt-2" for="DentistSignatureRoles">Roles</label>
                    <textarea id="DentistSignatureRoles"
                              class="form-control read-only-style"
                              rows="3"
                              readonly>@(ViewBag.DentistSignatureRoles as string ?? "")</textarea>
                </div>
            }
            else if (showSignatureReadOnly)
            {
                <input type="hidden" name="DentistSignatureEntered" value="true" />
                <p class="fw-semibold mb-2">Dentist Signature</p>
                <div id="dentistSignatureSection">
                    <label class="form-label" for="DentistSignatureNameDisplay">Name</label>
                    <div class="row g-2 align-items-center">
                        <div class="col-md-7">
                            <input type="text"
                                   id="DentistSignatureNameDisplay"
                                   class="form-control read-only-style"
                                   value="@(ViewBag.DentistSignatureDisplayName as string ?? "")"
                                   readonly />
                        </div>
                        <div class="col-md-5">
                            <input type="text"
                                   id="DentistSignatureDateTimeDisplay"
                                   class="form-control read-only-style"
                                   value="@(dentalExam.DentistSignatureDateTime?.ToString("MM/dd/yyyy hh:mm tt") ?? "")"
                                   placeholder="Signed date/time"
                                   readonly
                                   style="@(dentalExam.DentistSignatureDateTime.HasValue ? "" : "display:none;")" />
                        </div>
                    </div>
                    <label class="form-label mt-2" for="DentistSignatureRolesDisplay">Roles</label>
                    <textarea id="DentistSignatureRolesDisplay"
                              class="form-control read-only-style"
                              rows="3"
                              readonly>@(ViewBag.DentistSignatureRoles as string ?? "")</textarea>
                </div>
            }
            else
            {
                <input type="hidden" name="DentistSignatureEntered" value="@(dentalExam.DentistSignatureEntered ? "true" : "false")" />
            }
        </div>
    </div>
        <div class="d-flex justify-content-center mt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm section-collapse-btn"
                    data-target-switch="toggleQuestionnaireSectionSwitch"
                    data-target-heading="questionnaireHeading">
                <i class="fas fa-chevron-up"></i> Collapse Questionnaire
            </button>
        </div>
    </div>
    </div>

    <div class="dex-panel">
    <div class="questionnaire-heading" id="vitalsHeading">
        <div class="form-check form-switch questionnaire-toggle-switch mb-0">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="toggleVitalsSectionSwitch"
                   aria-controls="vitalsSection"
                   aria-expanded="false" />
        </div>
        <h3>Blood Pressure (Vitals)</h3>
    </div>

    <div id="vitalsSection" style="display:none;">
    @{
        var vitalBpViewData = new ViewDataDictionary<VitalStationDto>(ViewData, vitalStationDto);
        vitalBpViewData["ShowVitalRedirect"] = !vitalsCompleted;
        vitalBpViewData["AllowVitalStationSubmit"] = canSaveDentalExam;
        vitalBpViewData["BpCountdownIdPrefix"] = "dentalExamBpCountdown";
        vitalBpViewData["VitalRecommendationContext"] = "dental exam";
        vitalBpViewData["HideSectionHeading"] = true;
    }
    @await Html.PartialAsync("_VitalStationBpSummary", vitalStationDto, vitalBpViewData)
        <div class="d-flex justify-content-center mt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm section-collapse-btn"
                    data-target-switch="toggleVitalsSectionSwitch"
                    data-target-heading="vitalsHeading">
                <i class="fas fa-chevron-up"></i> Collapse Blood Pressure (Vitals)
            </button>
        </div>
    </div>
    </div>

    <div class="dex-panel">
    <div class="questionnaire-heading" id="xrayHeading">
        <div class="form-check form-switch questionnaire-toggle-switch mb-0">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="toggleXRaySectionSwitch"
                   aria-controls="xraySection"
                   aria-expanded="false" />
        </div>
        <h3>X-Ray</h3>
    </div>

    <div id="xraySection" style="display:none;">
    @{
        var xrayViewData = new ViewDataDictionary<DentalXRayStation>(ViewData, Model.XRayStation);
        xrayViewData["ServiceMember"] = sm;
        xrayViewData["Questionnaire"] = questionnaire;
    }
    @await Html.PartialAsync("_DentalXRayStationReadOnly", Model.XRayStation, xrayViewData)
        <div class="d-flex justify-content-center mt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm section-collapse-btn"
                    data-target-switch="toggleXRaySectionSwitch"
                    data-target-heading="xrayHeading">
                <i class="fas fa-chevron-up"></i> Collapse X-Ray
            </button>
        </div>
    </div>
    </div>

    @{
        var psrViewData = new ViewDataDictionary<DentalSharedClinicalViewModel>(ViewData, Model.SharedClinical);
        psrViewData["TobaccoDisplay"] = DentalExamTobaccoDisplayHelper.FormatFromQuestionnaire(questionnaire);
        psrViewData["RequirePsrFields"] = false;
        psrViewData["XRayStation"] = Model.XRayStation;
        psrViewData["SubsequentReadOnly"] = subsequentReadOnly;
    }
    <div id="subsequentDiseasesSection"
         class="dex-panel @(subsequentReadOnly ? "subsequent-readonly-mode" : null)"
         data-subsequent-readonly="@(subsequentReadOnly ? "true" : "false")"
         style="@(showSubsequentDiseasesSection ? "" : "display:none;")">
        <div class="questionnaire-heading" id="subsequentDiseasesHeading">
            <div class="form-check form-switch questionnaire-toggle-switch mb-0">
                <input class="form-check-input"
                       type="checkbox"
                       role="switch"
                       id="toggleSubsequentDiseasesSectionSwitch"
                       aria-controls="subsequentDiseasesContent"
                       aria-expanded="false" />
            </div>
            <h3 class="mb-0">Subsequent diseases and abnormalities</h3>
        </div>

        <div id="subsequentDiseasesContent" style="display:none;">
            @await Html.PartialAsync("_DentalExamPsrSection", Model.SharedClinical, psrViewData)
            @{
                var findingsViewData = new ViewDataDictionary<DentalSharedClinicalViewModel>(ViewData, Model.SharedClinical);
                findingsViewData["XRayStation"] = Model.XRayStation;
                findingsViewData["SubsequentReadOnly"] = subsequentReadOnly;
                findingsViewData["CurrentUserId"] = ViewBag.CurrentUserId as string ?? string.Empty;
                findingsViewData["CurrentUserDisplayName"] = ViewBag.CurrentUserDisplayName as string ?? string.Empty;
                findingsViewData["ExaminerNamesByUserId"] = ViewBag.ExaminerNamesByUserId as Dictionary<string, string>
                    ?? new Dictionary<string, string>();
            }
            @await Html.PartialAsync("_DentalFindingsSection", Model.SharedClinical, findingsViewData)
            @{
                var denClassViewData = new ViewDataDictionary<DentalSharedClinicalViewModel>(ViewData, Model.SharedClinical);
                denClassViewData["ServiceMemberPanoRequired"] = serviceMemberPanoRequired;
                denClassViewData["SubsequentReadOnly"] = subsequentReadOnly;
            }
            @await Html.PartialAsync("_DentalExamDenClassSection", Model.SharedClinical, denClassViewData)

            <div class="d-flex justify-content-center mt-3">
                <button type="button" class="btn btn-outline-secondary btn-sm section-collapse-btn"
                        data-target-switch="toggleSubsequentDiseasesSectionSwitch"
                        data-target-heading="subsequentDiseasesHeading">
                    <i class="fas fa-chevron-up"></i> Collapse Subsequent diseases and abnormalities
                </button>
            </div>
        </div>
    </div>

    <div class="dex-page-save-bar">
        <div class="dex-page-status-wrap">
            <span class="dex-page-status-label">Status</span>
            <span id="DentalExamStatusBadge"
                  class="dex-page-status @(string.Equals(dentalExamOverallStatus, "Completed", StringComparison.OrdinalIgnoreCase) ? "dex-page-status-completed" : "dex-page-status-pending")"
                  role="status"
                  aria-live="polite">@dentalExamOverallStatus</span>
            <input type="hidden" name="Status" id="DentalExamStatusHidden" value="@dentalExamOverallStatus" />
        </div>
        <div class="dex-footer-actions">
            <button type="submit" class="btn btn-general btn-lg" @(canSaveDentalExam ? "" : "disabled")>
                <i class="fas fa-check-circle" aria-hidden="true"></i> Save
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg btn-back-confirm">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Back
            </a>
        </div>
    </div>
</form>
</section>

<script src="~/js/dental-psr-tooth-chart.js" asp-append-version="true"></script>
<script>
    const IS_FEMALE = @Json.Serialize(isFemale);
    const IS_DENTAL_EXAM_DENTIST = @Json.Serialize(isDentalExamDentist);
    const SUBSEQUENT_SECTION_UNLOCKED = @Json.Serialize(showSubsequentDiseasesSection);
    const SUBSEQUENT_READONLY = @Json.Serialize(subsequentReadOnly);
    let goToVitalStationClicked = false;

    function isGoToVitalStationSubmit(submitter) {
        return goToVitalStationClicked || (submitter && submitter.name === "GoToVitalStation");
    }

    function toggleQuestionnaireDetail(selectEl) {
        const $select = $(selectEl);
        const target = $select.data("detail");
        if (!target) return;
        const $detail = $(target);
        const $textarea = $detail.find("textarea");
        if ($select.val() === "Yes") {
            $detail.show();
            $textarea.prop("required", true);
        } else {
            $detail.hide();
            $textarea.prop("required", false).val("");
        }
    }

    function toggleTobaccoSection() {
        const isYes = $("#UseTobaccoOrVape").val() === "Yes";
        const $section = $("#tobaccoDetailsSection");
        $section.toggle(isYes);
        $section.find(".tobacco-used-select").prop("required", isYes);
        if (!isYes) {
            $section.find(".tobacco-used-select").val("No");
            $section.find(".tobacco-type-detail").hide();
            $section.find(".tobacco-frequency-input").prop("required", false).val("");
        } else {
            $(".tobacco-used-select").each(function () {
                toggleTobaccoTypeDetail(this);
            });
        }
    }

    function toggleTobaccoTypeDetail(selectEl) {
        const $select = $(selectEl);
        const index = $select.data("index");
        const $detail = $("#tobaccoTypeDetail_" + index);
        const $inputs = $detail.find(".tobacco-frequency-input");
        if ($("#UseTobaccoOrVape").val() !== "Yes") {
            $detail.hide();
            $inputs.prop("required", false);
            return;
        }
        if ($select.val() === "Yes") {
            $detail.show();
            $inputs.prop("required", true);
        } else {
            $detail.hide();
            $inputs.prop("required", false).val("");
        }
    }

    function toggleConditionDetail(checkboxEl) {
        const $item = $(checkboxEl).closest(".condition-item");
        const $detail = $item.find(".condition-detail");
        const $textarea = $detail.find("textarea");
        if ($(checkboxEl).is(":checked")) {
            $detail.show();
        } else {
            $detail.hide();
            $textarea.val("");
        }
    }

    function initConditionToggles() {
        $(".condition-checkbox").each(function () {
            toggleConditionDetail(this);
        });
    }

    function togglePregnancyFlow() {
        if (!IS_FEMALE) {
            toggleXRayReadOnlyVisibility();
            return;
        }

        const pregnant = $("#AreYouPregnant").val();
        $("#pregnancyApprovalSection").hide();
        $("#PregnancyApproval").prop("required", false);

        if (pregnant === "Yes") {
            $("#pregnancyApprovalSection").show();
            $("#PregnancyApproval").prop("required", true);
        }

        toggleXRayReadOnlyVisibility();
    }

    function toggleXRayReadOnlyVisibility() {
        const $section = $("#xrayStationReadOnlySection");
        if (!$section.length) {
            return;
        }

        if (!IS_FEMALE) {
            $section.show();
            return;
        }

        const pregnant = $("#AreYouPregnant").val();
        $section.hide();

        if (pregnant === "Yes") {
            if ($("#PregnancyApproval").val() === "Approved") {
                $section.show();
            }
        } else if (pregnant === "No") {
            $section.show();
        }
    }

    function isSubsequentDiseasesSectionActive() {
        if (!IS_DENTAL_EXAM_DENTIST) {
            return SUBSEQUENT_SECTION_UNLOCKED;
        }

        const reviewed = $("#QuestionnaireReviewed").length
            ? $("#QuestionnaireReviewed").is(":checked")
            : false;
        const signed = $("#DentistSignatureEntered").length
            ? $("#DentistSignatureEntered").is(":checked")
            : false;
        return reviewed && signed;
    }

    function applySubsequentReadOnlyMode() {
        if (!SUBSEQUENT_READONLY) {
            return;
        }

        const $section = $("#subsequentDiseasesSection");
        if (!$section.length) {
            return;
        }

        $section.find("input, select, textarea, button").each(function () {
            const $el = $(this);
            if ($el.closest(".xray-preview-widget").length) {
                return;
            }
            if ($el.attr("id") === "FindingsJson") {
                return;
            }
            if ($el.hasClass("edit-finding-btn") || $el.attr("id") === "cancelFindingFormBtn") {
                return;
            }
            if ($el.is("input:checkbox, input:radio, select, button")) {
                $el.prop("disabled", true);
            } else {
                $el.prop("readonly", true).addClass("read-only-style");
            }
        });

        $("#addNewFindingBtn").hide();
        $("#addFindingToListBtn").hide();
        $("#psrInteractiveToothChart").attr("data-readonly", "true");
    }

    function toggleDenClassCommentsRequired() {
        const hasSelection = $("input.den-class-radio:checked").length > 0;
        $("#DenClassReasonComments").prop("required", hasSelection);
        updateDentalExamOverallStatus();
    }

    function setDenClassFieldsRequired(required) {
        toggleDenClassCommentsRequired();
    }

    function isPsrComplete() {
        if (!isSubsequentDiseasesSectionActive()) {
            return false;
        }

        const scoreOptions = @Json.Serialize(DentalExamPsr.ScoreOptions);
        const sextantValues = [
            $("#PsrUpperRight").val(),
            $("#PsrUpperAnterior").val(),
            $("#PsrUpperLeft").val(),
            $("#PsrLowerRight").val(),
            $("#PsrLowerAnterior").val(),
            $("#PsrLowerLeft").val()
        ];

        for (const value of sextantValues) {
            if (!value || !scoreOptions.includes(value)) {
                return false;
            }
        }

        if (!$("input[name='PsrCarrierRisk']:checked").val()) {
            return false;
        }

        const softTissuesWnl = $("input[name='SoftTissuesWnl']:checked").val();
        if (!softTissuesWnl) {
            return false;
        }

        if (softTissuesWnl === @Json.Serialize(DentalExamPsr.SoftTissuesWnlNo)
            && !$("#SoftTissuesConditionDetail").val()?.trim()) {
            return false;
        }

        return true;
    }

    function isDenClassComplete() {
        if (!isSubsequentDiseasesSectionActive()) {
            return false;
        }

        if (!$("input[name='DenClass']:checked").val()) {
            return false;
        }

        return !!$("#DenClassReasonComments").val()?.trim();
    }

    function updateDentalExamOverallStatus() {
        const status = isSubsequentDiseasesSectionActive() && isPsrComplete() && isDenClassComplete()
            ? "Completed"
            : "Pending";
        const completed = status === "Completed";

        $("#DentalExamStatusHidden").val(status);
        $("#DentalExamStatusBadge")
            .text(status)
            .toggleClass("dex-page-status-completed", completed)
            .toggleClass("dex-page-status-pending", !completed);
    }

    function setPsrFieldsRequired(required) {
        $(".psr-sextant-select").prop("required", false);
        $("input[name='PsrCarrierRisk']").prop("required", false);
        $("input.soft-tissues-wnl-radio").prop("required", false);
        $("#SoftTissuesConditionDetail").prop("required", false);
        updateDentalExamOverallStatus();
    }

    function toggleSubsequentDiseasesSection() {
        const active = isSubsequentDiseasesSectionActive();
        $("#subsequentDiseasesSection").toggle(active);
        if (!active) {
            $("#toggleSubsequentDiseasesSectionSwitch").prop("checked", false).attr("aria-expanded", "false");
            $("#subsequentDiseasesContent").hide();
            $("#togglePsrSectionSwitch, #toggleDentalFindingsSectionSwitch, #toggleDenClassSectionSwitch, #togglePanoXraySectionSwitch")
                .prop("checked", false)
                .attr("aria-expanded", "false");
            $("#psrContentSection, #dentalFindingsContentSection, #denClassContentSection, #panoXrayContentSection").hide();
        }
        setPsrFieldsRequired(active);
        setDenClassFieldsRequired(active);
        updateDentalExamOverallStatus();
    }

    function toggleSoftTissuesDetail() {
        const psrActive = isSubsequentDiseasesSectionActive();
        const isNotWnl = $("input[name='SoftTissuesWnl']:checked").val() === @Json.Serialize(DentalExamPsr.SoftTissuesWnlNo);
        const $section = $("#softTissuesConditionSection");
        const $textarea = $("#SoftTissuesConditionDetail");
        if (psrActive && isNotWnl) {
            $section.show();
        } else {
            $section.hide();
            if (!isNotWnl) {
                $textarea.val("");
            }
        }
        $textarea.prop("required", false);
        updateDentalExamOverallStatus();
    }

    function updatePsrTobaccoDisplay() {
        const useTobacco = $("#UseTobaccoOrVape").val();
        if (useTobacco !== "Yes") {
            $("#psrTobaccoDisplay").text("No");
            return;
        }

        const usedTypes = [];
        $(".tobacco-used-select").each(function () {
            if ($(this).val() === "Yes") {
                const type = $(this).closest(".tobacco-type-row").find("input[name*='.Type']").val();
                if (type) {
                    usedTypes.push(type);
                }
            }
        });

        $("#psrTobaccoDisplay").text(usedTypes.length ? "Yes (" + usedTypes.join(", ") + ")" : "Yes");
    }

    function toggleQuestionnaireReviewFields() {
        if (!$("#QuestionnaireReviewed").length) {
            return;
        }
        const reviewed = $("#QuestionnaireReviewed").is(":checked");
        const $commentsSection = $("#finalCommentsSection");
        const $comments = $("#FinalComments");
        $commentsSection.toggle(reviewed);
        $comments.prop("required", reviewed);
        toggleSubsequentDiseasesSection();
    }

    function toggleDentistSignatureFields() {
        if (!$("#DentistSignatureEntered").length) {
            return;
        }
        const signed = $("#DentistSignatureEntered").is(":checked");
        const $signatureSection = $("#dentistSignatureSection");
        const $name = $("#DentistSignatureName");
        $signatureSection.toggle(signed);
        $name.prop("required", signed);
        toggleSubsequentDiseasesSection();
    }

    function initDentalExamReviewFields() {
        toggleQuestionnaireReviewFields();
        toggleDentistSignatureFields();
        toggleSubsequentDiseasesSection();
        applySubsequentReadOnlyMode();
    }

    function isPsrToothUsedInDentalFindings(toothNumber) {
        const tooth = parseInt(toothNumber, 10);
        if (isNaN(tooth)) {
            return false;
        }
        if (typeof window.getDentalFindingUsedPermanentTeeth !== "function") {
            return false;
        }
        const used = window.getDentalFindingUsedPermanentTeeth() || [];
        return used.indexOf(tooth) >= 0;
    }

    function showPsrToothUsedInFindingMessage(toothNumber) {
        Swal.fire(
            "Cannot select missing tooth",
            "Tooth " + toothNumber + " is already used in a Dental Finding.",
            "warning"
        );
    }

    function setFindingReadonlyToothSelected(toothNumber, selected) {
        const tooth = String(toothNumber);
        const $chart = $("#findingReadonlyToothChart");
        if (!$chart.length) {
            return;
        }

        const $input = $("#findingToothCheck_" + tooth);
        const $btn = $chart.find('.psr-tooth-image-btn[data-tooth="' + tooth + '"]');
        const $img = $btn.find(".psr-tooth-img");

        $input.prop("checked", !!selected);
        $btn.attr("aria-pressed", selected ? "true" : "false");
        if ($img.length) {
            $img.attr("src", selected ? $img.attr("data-selected") : $img.attr("data-normal"));
        }
    }

    function syncFindingReadonlyToothChartFromPsr() {
        const $findingChart = $("#findingReadonlyToothChart");
        if (!$findingChart.length) {
            return;
        }

        $("#psrInteractiveToothChart .psr-tooth-input").each(function () {
            setFindingReadonlyToothSelected($(this).attr("data-tooth"), $(this).is(":checked"));
        });
    }

    function initPsrToothChart() {
        const $chart = $("#psrInteractiveToothChart");
        if (!$chart.length || typeof window.DentalPsrToothChart === "undefined") {
            return;
        }

        if (SUBSEQUENT_READONLY) {
            $chart.attr("data-readonly", "true");
        }

        const editable = $chart.attr("data-readonly") !== "true" && !SUBSEQUENT_READONLY;

        DentalPsrToothChart.init({
            chartSelector: "#psrInteractiveToothChart",
            editable: editable,
            isToothBlocked: isPsrToothUsedInDentalFindings,
            onBlocked: showPsrToothUsedInFindingMessage,
            onSelectionChanged: function (toothNumber, selected) {
                setFindingReadonlyToothSelected(toothNumber, selected);
                if (typeof window.refreshDentalFindingToothOptions === "function") {
                    window.refreshDentalFindingToothOptions();
                }
            }
        });

        syncFindingReadonlyToothChartFromPsr();
        if (typeof window.refreshDentalFindingToothOptions === "function") {
            window.refreshDentalFindingToothOptions();
        }
    }

    function initPsrSection() {
        toggleSoftTissuesDetail();
        updatePsrTobaccoDisplay();
        initPsrToothChart();
    }

    function initQuestionnaireToggles() {
        $(".dental-q-detail-toggle").each(function () {
            toggleQuestionnaireDetail(this);
        });
        toggleTobaccoSection();
        initConditionToggles();
        togglePregnancyFlow();
        initPsrSection();
        initDentalExamReviewFields();
    }

    function toggleQuestionnaireSectionFromSwitch() {
        const isOn = $("#toggleQuestionnaireSectionSwitch").is(":checked");
        const $section = $("#questionnaireSection");

        if (isOn) {
            $section.slideDown(200);
        } else {
            $section.slideUp(200);
        }

        $("#toggleQuestionnaireSectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleVitalsSectionFromSwitch() {
        const isOn = $("#toggleVitalsSectionSwitch").is(":checked");
        const $section = $("#vitalsSection");

        if (isOn) {
            $section.slideDown(200);
        } else {
            $section.slideUp(200);
        }

        $("#toggleVitalsSectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleXRaySectionFromSwitch() {
        const isOn = $("#toggleXRaySectionSwitch").is(":checked");
        const $section = $("#xraySection");

        if (isOn) {
            $section.slideDown(200);
        } else {
            $section.slideUp(200);
        }

        $("#toggleXRaySectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleSectionFromSwitch(switchSelector, sectionSelector) {
        const isOn = $(switchSelector).is(":checked");
        const $section = $(sectionSelector);

        if (isOn) {
            $section.slideDown(200);
        } else {
            $section.slideUp(200);
        }

        $(switchSelector).attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleSubsequentDiseasesContentFromSwitch() {
        toggleSectionFromSwitch("#toggleSubsequentDiseasesSectionSwitch", "#subsequentDiseasesContent");
    }

    function togglePsrSectionFromSwitch() {
        toggleSectionFromSwitch("#togglePsrSectionSwitch", "#psrContentSection");
    }

    function toggleDentalFindingsSectionFromSwitch() {
        toggleSectionFromSwitch("#toggleDentalFindingsSectionSwitch", "#dentalFindingsContentSection");
    }

    function toggleDenClassSectionFromSwitch() {
        toggleSectionFromSwitch("#toggleDenClassSectionSwitch", "#denClassContentSection");
    }

    function togglePanoXraySectionFromSwitch() {
        toggleSectionFromSwitch("#togglePanoXraySectionSwitch", "#panoXrayContentSection");
    }

    const XRAY_ZOOM_STEP = 25;
    const XRAY_ZOOM_MIN = 50;
    const XRAY_ZOOM_MAX = 300;
    const xrayZoomLevels = {};
    const xrayPanState = {
        active: false,
        viewport: null,
        startX: 0,
        startY: 0,
        scrollLeft: 0,
        scrollTop: 0
    };

    function setXRayZoom(prefix, level) {
        const previewImg = document.getElementById(prefix + "_previewImg");
        const zoomLabel = document.getElementById(prefix + "_zoomLevel");
        if (!previewImg || !zoomLabel) return;

        const clamped = Math.max(XRAY_ZOOM_MIN, Math.min(XRAY_ZOOM_MAX, level));
        xrayZoomLevels[prefix] = clamped;
        previewImg.style.width = clamped + "%";
        previewImg.style.height = "auto";
        previewImg.style.transform = "";
        previewImg.draggable = false;
        zoomLabel.textContent = clamped + "%";
        requestAnimationFrame(function () {
            updateXRayPanAvailability(prefix);
        });
    }

    function updateXRayPanAvailability(prefix) {
        const viewport = document.getElementById(prefix + "_previewViewport");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (!viewport) return;

        const canPan = !!previewImg?.src &&
            (viewport.scrollWidth > viewport.clientWidth + 1 ||
             viewport.scrollHeight > viewport.clientHeight + 1);

        viewport.classList.toggle("can-pan", canPan);
        viewport.title = canPan ? "Click and drag to move the image" : "";
    }

    function startXRayPan(clientX, clientY, viewport) {
        xrayPanState.active = true;
        xrayPanState.viewport = viewport;
        xrayPanState.startX = clientX;
        xrayPanState.startY = clientY;
        xrayPanState.scrollLeft = viewport.scrollLeft;
        xrayPanState.scrollTop = viewport.scrollTop;
        viewport.classList.add("is-panning");
    }

    function moveXRayPan(clientX, clientY) {
        if (!xrayPanState.active || !xrayPanState.viewport) return;
        const dx = clientX - xrayPanState.startX;
        const dy = clientY - xrayPanState.startY;
        xrayPanState.viewport.scrollLeft = xrayPanState.scrollLeft - dx;
        xrayPanState.viewport.scrollTop = xrayPanState.scrollTop - dy;
    }

    function endXRayPan() {
        if (!xrayPanState.active) return;
        xrayPanState.viewport?.classList.remove("is-panning");
        xrayPanState.active = false;
        xrayPanState.viewport = null;
    }

    const XRAY_DOWNLOAD_URL = "/DentalExams/DownloadXRayImage";

    function updateXRayPreview(prefix) {
        const previewSection = document.getElementById(prefix + "_previewSection");
        const previewImg = document.getElementById(prefix + "_previewImg");
        const status = document.getElementById(prefix + "_fileStatus");
        if (!previewSection || !previewImg || !status) return;

        const fileName = (status.dataset.existingFilename || "").trim();
        const downloadPrefix = status.dataset.downloadPrefix || prefix;
        let src = "";

        if (fileName) {
            src = XRAY_DOWNLOAD_URL + "?prefix=" + encodeURIComponent(downloadPrefix) + "&fileName=" + encodeURIComponent(fileName);
        }

        if (src) {
            previewImg.onload = function () {
                setXRayZoom(prefix, xrayZoomLevels[prefix] || 100);
                updateXRayPanAvailability(prefix);
            };
            previewImg.onerror = function () {
                previewSection.style.display = "none";
            };
            previewImg.src = src;
            previewSection.style.display = "block";
            if (previewImg.complete) {
                setXRayZoom(prefix, xrayZoomLevels[prefix] || 100);
                updateXRayPanAvailability(prefix);
            }
        } else {
            previewImg.removeAttribute("src");
            previewSection.style.display = "none";
        }
    }

    function openXRayPreview(prefix) {
        const status = document.getElementById(prefix + "_fileStatus");
        if (!status) return;

        const fileName = (status.dataset.existingFilename || "").trim();
        const downloadPrefix = status.dataset.downloadPrefix || prefix;
        if (!fileName) return;

        updateXRayPreview(prefix);
        const url = XRAY_DOWNLOAD_URL + "?prefix=" + encodeURIComponent(downloadPrefix) + "&fileName=" + encodeURIComponent(fileName);
        window.open(url, "_blank");
    }

    function initReadOnlyXRayPreviews() {
        $("#xraySection .preview-xray-file").each(function () {
            const prefix = this.getAttribute("data-prefix");
            if (prefix) {
                updateXRayPreview(prefix);
            }
        });
    }

    $(document).ready(function () {
        initQuestionnaireToggles();
        initReadOnlyXRayPreviews();
        toggleDenClassCommentsRequired();
        updateDentalExamOverallStatus();

        $("#toggleQuestionnaireSectionSwitch").on("change", toggleQuestionnaireSectionFromSwitch);
        $("#toggleVitalsSectionSwitch").on("change", toggleVitalsSectionFromSwitch);
        $("#toggleXRaySectionSwitch").on("change", toggleXRaySectionFromSwitch);
        $("#toggleSubsequentDiseasesSectionSwitch").on("change", toggleSubsequentDiseasesContentFromSwitch);
        $("#togglePsrSectionSwitch").on("change", togglePsrSectionFromSwitch);
        $("#toggleDentalFindingsSectionSwitch").on("change", toggleDentalFindingsSectionFromSwitch);
        $("#toggleDenClassSectionSwitch").on("change", toggleDenClassSectionFromSwitch);
        $("#togglePanoXraySectionSwitch").on("change", togglePanoXraySectionFromSwitch);

        $(document).on("click", ".section-collapse-btn", function () {
            const switchId = $(this).data("target-switch");
            const headingId = $(this).data("target-heading");
            const $switch = $("#" + switchId);

            $switch.prop("checked", false).trigger("change");

            const $heading = $("#" + headingId);
            if ($heading.length) {
                $("html, body").animate({
                    scrollTop: $heading.offset().top - 80
                }, 300);
            }
        });

        $(".dental-q-detail-toggle").on("change", function () {
            toggleQuestionnaireDetail(this);
        });
        $("#UseTobaccoOrVape").on("change", function () {
            toggleTobaccoSection();
            updatePsrTobaccoDisplay();
        });
        $(document).on("change", ".tobacco-used-select", function () {
            toggleTobaccoTypeDetail(this);
            updatePsrTobaccoDisplay();
        });
        $(document).on("change", ".soft-tissues-wnl-radio", toggleSoftTissuesDetail);
        $(document).on("change input", ".psr-sextant-select, input[name='PsrCarrierRisk'], #SoftTissuesConditionDetail", updateDentalExamOverallStatus);
        $(document).on("change input", "input.den-class-radio, #DenClassReasonComments", function () {
            toggleDenClassCommentsRequired();
        });
        $("#QuestionnaireReviewed").on("change", toggleQuestionnaireReviewFields);
        $("#DentistSignatureEntered").on("change", toggleDentistSignatureFields);
        $(document).on("change", ".condition-checkbox", function () {
            toggleConditionDetail(this);
        });
        $("#AreYouPregnant, #PregnancyApproval").on("change", togglePregnancyFlow);

        $(document).on("click", "#goToVitalStationBtn", function () {
            goToVitalStationClicked = true;
            $("#GoToVitalStationFlag").val("true");
        });

        $(document).on("click", "#SaveDentalExamStation button[type='submit']:not(#goToVitalStationBtn)", function () {
            goToVitalStationClicked = false;
            $("#GoToVitalStationFlag").val("false");
        });

        $("#SaveDentalExamStation").on("submit", function (e) {
            const submitter = e.originalEvent && e.originalEvent.submitter;
            if (isGoToVitalStationSubmit(submitter)) {
                $("#GoToVitalStationFlag").val("true");
                return true;
            }

            goToVitalStationClicked = false;
            $("#GoToVitalStationFlag").val("false");
            updateDentalExamOverallStatus();
        });

        $(document).on("click", "#xraySection .preview-xray-file", function () {
            const prefix = this.getAttribute("data-prefix");
            if (prefix) {
                openXRayPreview(prefix);
            }
        });

        $(document).on("click", ".xray-zoom-in", function () {
            const prefix = $(this).data("prefix");
            setXRayZoom(prefix, (xrayZoomLevels[prefix] || 100) + XRAY_ZOOM_STEP);
        });

        $(document).on("click", ".xray-zoom-out", function () {
            const prefix = $(this).data("prefix");
            setXRayZoom(prefix, (xrayZoomLevels[prefix] || 100) - XRAY_ZOOM_STEP);
        });

        $(document).on("click", ".xray-zoom-reset", function () {
            setXRayZoom($(this).data("prefix"), 100);
        });

        $(document).on("mousedown", ".xray-preview-viewport.can-pan", function (e) {
            if (e.button !== 0) return;
            startXRayPan(e.clientX, e.clientY, this);
        });

        $(document).on("mousemove", function (e) {
            moveXRayPan(e.clientX, e.clientY);
        });

        $(document).on("mouseup mouseleave", function () {
            endXRayPan();
        });

        initXrayPreviewWidgets();
    });

    const xrayPreviewUrls = {};

    function clearXrayPreviewInstance(prefix) {
        const previewSection = document.getElementById(prefix + "_previewSection");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (previewImg) { previewImg.removeAttribute("src"); }
        if (previewSection) { previewSection.style.display = "none"; }
        xrayPreviewUrls[prefix] = "";
        $("#" + prefix + "_fileNameDisplay").text("");
        $("#" + prefix + "_emptyMsg").show();
    }

    function showXrayPreviewInstance(prefix, downloadPrefix, fileName, label) {
        const previewSection = document.getElementById(prefix + "_previewSection");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (!previewSection || !previewImg || !fileName || !downloadPrefix) {
            clearXrayPreviewInstance(prefix);
            return;
        }

        const src = XRAY_DOWNLOAD_URL + "?prefix=" + encodeURIComponent(downloadPrefix) + "&fileName=" + encodeURIComponent(fileName);
        xrayPreviewUrls[prefix] = src;
        $("#" + prefix + "_fileNameDisplay").text(label || fileName);
        previewImg.onload = function () {
            setXRayZoom(prefix, 100);
            updateXRayPanAvailability(prefix);
        };
        previewImg.onerror = function () { clearXrayPreviewInstance(prefix); };
        previewImg.src = src;
        previewSection.style.display = "block";
        $("#" + prefix + "_emptyMsg").hide();
        if (previewImg.complete) {
            setXRayZoom(prefix, 100);
            updateXRayPanAvailability(prefix);
        }
    }

    function initXrayPreviewWidgets() {
        $(document).on("change", ".xray-preview-type-radio", function () {
            const prefix = $(this).closest(".xray-preview-widget").data("prefix");
            if (!prefix) { return; }
            const isBwx = this.value === "BWX";
            $("#" + prefix + "_bwxSelectWrap").toggle(isBwx);
            $("#" + prefix + "_paSelectWrap").toggle(!isBwx);
            const bwxSel = document.getElementById(prefix + "_bwxSelect");
            const paSel = document.getElementById(prefix + "_paSelect");
            if (bwxSel) { bwxSel.value = ""; }
            if (paSel) { paSel.value = ""; }
            clearXrayPreviewInstance(prefix);
        });

        $(document).on("change", ".xray-preview-image-select", function () {
            const prefix = $(this).closest(".xray-preview-widget").data("prefix");
            if (!prefix) { return; }
            const opt = this.options[this.selectedIndex];
            const fileName = opt ? opt.getAttribute("data-filename") : null;
            const downloadPrefix = opt ? opt.getAttribute("data-prefix") : null;
            const label = opt ? opt.text : null;
            if (fileName && downloadPrefix) {
                showXrayPreviewInstance(prefix, downloadPrefix, fileName, label);
            } else {
                clearXrayPreviewInstance(prefix);
            }
        });

        $(document).on("click", ".xray-preview-open-btn", function () {
            const prefix = $(this).closest(".xray-preview-widget").data("prefix");
            if (prefix && xrayPreviewUrls[prefix]) {
                window.open(xrayPreviewUrls[prefix], "_blank");
            }
        });
    }

    $('a.btn-back-confirm').on('click', async function (e) {
        e.preventDefault();
        const url = $(this).attr('href');
        const confirmed = await showYesNoModal("Are you sure you want to go back to main screen without saving changes?");
        if (confirmed) window.location.href = url;
    });
</script>
