@using ExcelFilesCompiler.Utilities
@using Malama.Models
@using System.Text.Json
@model DentalExam

@{
    var exam = Model ?? new DentalExam();
    var findingsXrayStation = ViewData["XRayStation"] as DentalXRayStation ?? new DentalXRayStation();
    var subsequentReadOnly = ViewData["SubsequentReadOnly"] as bool? ?? false;
    var currentUserId = ViewData["CurrentUserId"] as string ?? string.Empty;
    var currentUserDisplayName = ViewData["CurrentUserDisplayName"] as string ?? string.Empty;
    var examinerNamesByUserId = ViewData["ExaminerNamesByUserId"] as Dictionary<string, string>
        ?? new Dictionary<string, string>();
    var sectionTitle = ViewData["SectionTitle"] as string ?? "Dental Findings";
    var collapseLabel = ViewData["CollapseLabel"] as string ?? ("Collapse " + sectionTitle);
    var postFindingsJson = ViewData["PostFindingsJson"] as bool? ?? true;
    var showFindingAssignmentFields = ViewData["ShowFindingAssignmentFields"] as bool? ?? false;
    var eventAppointmentMinDate = ViewData["EventAppointmentMinDate"] as string ?? string.Empty;
    var eventAppointmentMaxDate = ViewData["EventAppointmentMaxDate"] as string ?? string.Empty;
    // Assignment grid: compact main columns + expand for appointment/procedure details.
    var findingsTableColspan = showFindingAssignmentFields ? 10 : 9;
    var findings = exam.Findings?
        .OrderBy(f => f.SortOrder)
        .Select(DentalFindingMapper.ToDto)
        .ToList() ?? new List<DentalFindingDto>();
    var cdtCodesByType = DentalExamCdtCodeProvider.GetCodesByDiseaseType();
    var findingsJson = JsonSerializer.Serialize(findings, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
    var cdtCodesJson = JsonSerializer.Serialize(cdtCodesByType);
    var examinerNamesJson = JsonSerializer.Serialize(examinerNamesByUserId);
}

<style>
    #dentalFindingsSection {
        --findings-indigo: rgba(80, 90, 201, 1);
        --findings-indigo-soft: rgba(80, 90, 201, 0.12);
        --findings-text: #1f2430;
        --findings-muted: #6b7285;
        --findings-border: rgba(31, 36, 48, 0.08);
        --findings-surface: #ffffff;
        --findings-panel: #fbfbfd;
    }

    #dentalFindingsSection > .questionnaire-heading h4 {
        color: var(--findings-indigo);
        font-weight: 700;
    }

    #dentalFindingsSection .findings-panel {
        border: 1px solid var(--findings-border);
        border-radius: 14px;
        background: var(--findings-panel);
        box-shadow: 0 8px 22px rgba(21, 24, 33, 0.05);
        padding: 1.1rem 1.2rem;
        max-width: 100%;
        min-width: 0;
    }

    #dentalFindingsSection .findings-table-wrap {
        border: 1px solid var(--findings-border);
        border-radius: 12px;
        background: var(--findings-surface);
        overflow-x: auto;
        max-width: 100%;
    }

    #dentalFindingsTable {
        margin: 0;
        --bs-table-bg: transparent;
        --bs-table-striped-bg: rgba(80, 90, 201, 0.04);
        --bs-table-hover-bg: rgba(80, 90, 201, 0.07);
    }

    #dentalFindingsTable thead th {
        background: rgba(80, 90, 201, 0.08);
        color: var(--findings-text);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        border-bottom: 1px solid var(--findings-border);
        white-space: nowrap;
        padding: 0.7rem 0.75rem;
    }

    #dentalFindingsTable tbody td {
        border-color: rgba(31, 36, 48, 0.06);
        color: var(--findings-text);
        font-size: 0.9rem;
        padding: 0.7rem 0.75rem;
        vertical-align: middle;
    }

    #dentalFindingsEmptyRow td {
        color: var(--findings-muted) !important;
        font-weight: 500;
        padding: 1.5rem 0.75rem !important;
    }

    #addNewFindingBtn {
        border-radius: 10px;
        font-weight: 600;
        border-color: rgba(80, 90, 201, 0.35);
        color: var(--findings-indigo);
        background: rgba(80, 90, 201, 0.06);
    }

    #addNewFindingBtn:hover {
        background: rgba(80, 90, 201, 0.14);
        border-color: var(--findings-indigo);
        color: var(--findings-indigo);
    }

    #dentalFindingFormCard {
        border: 1px solid rgba(80, 90, 201, 0.22) !important;
        border-radius: 14px !important;
        overflow: hidden;
        background: var(--findings-surface);
        box-shadow: 0 10px 24px rgba(80, 90, 201, 0.08);
    }

    #dentalFindingFormCard .card-header {
        background: rgba(80, 90, 201, 0.1) !important;
        color: var(--findings-indigo);
        border-bottom: 1px solid rgba(80, 90, 201, 0.16);
        font-weight: 700;
        padding: 0.85rem 1.1rem;
    }

    #dentalFindingFormCard .card-body {
        padding: 1.15rem 1.2rem;
    }

    #dentalFindingFormCard .form-label {
        font-weight: 600;
        color: var(--findings-text);
    }

    #dentalFindingFormCard .form-control,
    #dentalFindingFormCard .form-select {
        border-radius: 10px;
        border-color: rgba(31, 36, 48, 0.12);
    }

    #dentalFindingFormCard .form-control:focus,
    #dentalFindingFormCard .form-select:focus {
        border-color: rgba(80, 90, 201, 0.45);
        box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.18);
    }

    #dentalFindingFormCard .finding-action-btn,
    #dentalFindingsTable .finding-action-btn {
        min-width: 2rem;
        padding: 0.28rem 0.5rem;
        border-radius: 8px;
    }

    #dentalFindingFormCard .finding-action-btn i,
    #dentalFindingsTable .finding-action-btn i {
        pointer-events: none;
    }

    #dentalFindingsTable .finding-action-btn.btn-outline-primary {
        border-color: rgba(80, 90, 201, 0.3);
        color: var(--findings-indigo);
    }

    #dentalFindingsTable .finding-action-btn.btn-outline-primary:hover {
        background: rgba(80, 90, 201, 0.12);
        border-color: var(--findings-indigo);
        color: var(--findings-indigo);
    }

    #addFindingToListBtn.btn-general {
        background: var(--findings-indigo);
        border-color: var(--findings-indigo);
        color: #fff;
        border-radius: 10px;
        font-weight: 600;
    }

    #addFindingToListBtn.btn-general:hover {
        background: rgb(60, 70, 180);
        border-color: rgb(60, 70, 180);
        color: #fff;
    }

    #cancelFindingFormBtn {
        border-radius: 10px;
        font-weight: 600;
    }

    #dentalFindingImageColumn .dental-finding-image-wrap {
        min-height: 0;
        padding: 0.85rem;
        background: #fff;
        border: 1px solid var(--findings-border) !important;
        border-radius: 12px !important;
    }

    #findingReadonlyToothChart.psr-tooth-chart-readonly {
        pointer-events: none;
        user-select: none;
    }

    #findingReadonlyToothChart.psr-tooth-chart-readonly .psr-tooth-image-btn,
    #findingReadonlyToothChart.psr-tooth-chart-readonly .psr-tooth-check-label {
        cursor: default;
    }

    .finding-classification-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.78rem;
        padding: 0.28em 0.7em;
        border-radius: 999px;
        letter-spacing: 0.02em;
        min-width: 4.5rem;
    }

    .finding-class-2 {
        background: rgba(22, 163, 74, 0.12);
        color: #15803d;
    }

    .finding-class-3 {
        background: rgba(220, 53, 69, 0.12);
        color: #b42318;
    }

    .finding-external-examiner {
        display: inline-block;
        font-weight: 700;
        color: #b45309;
    }

    .finding-external-examiner-meta {
        color: #92400e;
    }

    #dentalFindingsTable .finding-expand-btn {
        width: 2rem;
        height: 2rem;
        padding: 0;
        border-radius: 8px;
        border-color: rgba(80, 90, 201, 0.28);
        color: var(--findings-indigo);
        background: rgba(80, 90, 201, 0.06);
        line-height: 1;
    }

    #dentalFindingsTable .finding-expand-btn:hover,
    #dentalFindingsTable .finding-expand-btn[aria-expanded="true"] {
        background: rgba(80, 90, 201, 0.14);
        border-color: var(--findings-indigo);
        color: var(--findings-indigo);
    }

    #dentalFindingsTable .finding-expand-btn i {
        transition: transform 0.18s ease;
        font-size: 0.75rem;
    }

    #dentalFindingsTable .finding-expand-btn[aria-expanded="true"] i {
        transform: rotate(90deg);
    }

    #dentalFindingsTable tr.finding-detail-row > td {
        background: rgba(80, 90, 201, 0.04);
        padding: 0;
        border-top: 0;
    }

    #dentalFindingsTable .finding-detail-panel {
        padding: 0.85rem 1rem 1rem 2.75rem;
    }

    #dentalFindingsTable .finding-detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.75rem 1.25rem;
    }

    #dentalFindingsTable .finding-detail-item {
        min-width: 0;
    }

    #dentalFindingsTable .finding-detail-item.is-wide {
        grid-column: 1 / -1;
    }

    #dentalFindingsTable .finding-detail-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--findings-muted);
        margin-bottom: 0.2rem;
    }

    #dentalFindingsTable .finding-detail-value {
        color: var(--findings-text);
        font-size: 0.88rem;
        word-break: break-word;
    }

    #dentalFindingsTable tr.finding-main-row.is-expanded {
        --bs-table-bg: rgba(80, 90, 201, 0.06);
        --bs-table-striped-bg: rgba(80, 90, 201, 0.06);
        --bs-table-hover-bg: rgba(80, 90, 201, 0.08);
    }

    #dentalFindingsTable .finding-cdt-cell {
        max-width: 150px;
    }

    #dentalFindingsTable .finding-cdt-codes {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #dentalFindingsTable .finding-cdt-notes {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        white-space: normal;
        line-height: 1.25;
        max-width: 150px;
    }

    #dentalFindingsSection .finding-assignment-fields {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(31, 36, 48, 0.08);
    }

    #dentalFindingsSection .finding-treatment-required {
        margin-top: 1rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--findings-border);
        border-radius: 12px;
        background: var(--findings-surface);
    }

    #dentalFindingsSection .finding-treatment-required .form-label {
        font-weight: 600;
        color: var(--findings-text);
    }

    #dentalFindingsSection .finding-treatment-required .form-check-label {
        font-weight: 600;
        color: var(--findings-text);
    }

    #dentalFindingsSection .finding-treatment-required .form-check-input:checked {
        background-color: var(--findings-indigo);
        border-color: var(--findings-indigo);
    }

    #dentalFindingsSection .section-collapse-btn {
        border-radius: 999px;
        font-weight: 600;
    }
</style>

<div class="mb-4" id="dentalFindingsSection">
    <div class="questionnaire-heading" id="dentalFindingsHeading">
        <div class="form-check form-switch questionnaire-toggle-switch mb-0">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="toggleDentalFindingsSectionSwitch"
                   aria-controls="dentalFindingsContentSection"
                   aria-expanded="false" />
        </div>
        <h4 class="mb-0">@sectionTitle</h4>
    </div>

    <div id="dentalFindingsContentSection" style="display:none;">
        <div class="findings-panel">
        @if (postFindingsJson)
        {
            <input type="hidden" name="FindingsJson" id="FindingsJson" value="@findingsJson" />
        }
        else
        {
            <input type="hidden" id="FindingsJson" value="@findingsJson" />
        }

        <div class="table-responsive findings-table-wrap mb-3">
            <table class="table table-striped table-hover align-middle mb-0" id="dentalFindingsTable">
                <thead>
                    <tr>
                        @if (showFindingAssignmentFields)
                        {
                            <th style="width: 44px;" aria-label="Expand"></th>
                            <th style="width: 60px;">S.No</th>
                            <th style="width: 110px;">Affected Tooth</th>
                            <th style="width: 120px;">Affected Surface(s)</th>
                            <th style="width: 150px;">Disease / Condition Type</th>
                            <th style="width: 120px;">Classification</th>
                            <th style="width: 150px;">CDT Code / CDT Notes</th>
                            <th style="width: 140px;">Examiner</th>
                            <th style="width: 130px;">Assigned Dentist</th>
                            <th style="width: 100px;">Action</th>
                        }
                        else
                        {
                            <th style="width: 60px;">S.No</th>
                            <th style="width: 110px;">Affected Tooth</th>
                            <th style="width: 140px;">Affected Surface(s)</th>
                            <th style="width: 160px;">Disease / Condition Type</th>
                            <th style="width: 180px;">Classification</th>
                            <th>CDT Codes, Codes Notes</th>
                            <th>Description / Details</th>
                            <th style="width: 180px;">Examiner</th>
                            <th style="width: 100px;">Action</th>
                        }
                    </tr>
                </thead>
                <tbody id="dentalFindingsTableBody">
                    <tr id="dentalFindingsEmptyRow">
                        <td colspan="@findingsTableColspan" class="text-center py-4">No findings added yet.</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <button type="button" class="btn btn-outline-primary mb-3" id="addNewFindingBtn" style="@(subsequentReadOnly ? "display:none;" : null)">
            <i class="fas fa-plus-circle"></i> Add New Finding
        </button>

        <div id="dentalFindingFormCard" class="card mb-0" style="display:none;">
            <div class="card-header" id="dentalFindingFormTitle">Add Finding</div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="findingDiseaseType">Disease / Condition Type</label>
                                <select id="findingDiseaseType" class="form-select">
                                    <option value=""></option>
                                    @foreach (var diseaseType in DentalFindingConstants.DiseaseConditionTypes)
                                    {
                                        <option value="@diseaseType">@diseaseType</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="findingAffectedTooth">Affected Tooth</label>
                                <select id="findingAffectedTooth" class="form-select"></select>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="findingPrimaryTooth" />
                                    <label class="form-check-label" for="findingPrimaryTooth">Primary tooth</label>
                                </div>
                            </div>
                            <div class="col-6" id="findingSurfacesSection" style="display:none;">
                                <label class="form-label" for="findingAffectedSurfaces">Affected Surface(s)</label>
                                <select id="findingAffectedSurfaces" class="form-select finding-multiselect" multiple></select>
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="findingCdtCodes">CDT Code <span class="text-danger">*</span></label>
                                <select id="findingCdtCodes" class="form-select finding-multiselect" multiple></select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="findingCdtCodesNotes">Codes Notes</label>
                            <textarea id="findingCdtCodesNotes" class="form-control" rows="2" placeholder="Optional notes for selected CDT codes"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="findingDescription">Description / Details</label>
                            <textarea id="findingDescription" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="mb-0">
                            <label class="form-label d-block">Classification for selected tooth</label>
                            @for (var i = 0; i < DentalFindingConstants.Classifications.Length; i++)
                            {
                                var classification = DentalFindingConstants.Classifications[i];
                                <div class="form-check">
                                    <input class="form-check-input finding-classification-radio"
                                           type="radio"
                                           name="FindingClassification"
                                           id="findingClassification_@i"
                                           value="@classification" />
                                    <label class="form-check-label" for="findingClassification_@i">
                                        @classification
                                    </label>
                                </div>
                            }
                        </div>

                        @if (showFindingAssignmentFields)
                        {
                            <div class="finding-assignment-fields" id="findingAssignmentFields">
                                <div class="mb-3" id="externalExaminerNameSection">
                                    <label class="form-label" for="findingExternalExaminerName">External (Dentist) Examiner Name</label>
                                    <input type="text"
                                           id="findingExternalExaminerName"
                                           class="form-control"
                                           maxlength="200"
                                           autocomplete="off" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="findingExternalExamDateTime">Exam Date Time</label>
                                    <input type="datetime-local"
                                           id="findingExternalExamDateTime"
                                           class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="findingExternalDentistRemarks">Remarks by External Dentist</label>
                                    <textarea id="findingExternalDentistRemarks"
                                              class="form-control"
                                              rows="3"
                                              maxlength="4000"></textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="findingAssignedDentist">Assign Dentist</label>
                                    <select id="findingAssignedDentist" class="form-select">
                                        <option value=""></option>
                                        <option value="Dentist 1">Dentist 1</option>
                                        <option value="Dentist 2">Dentist 2</option>
                                        <option value="Dentist 3">Dentist 3</option>
                                        <option value="Dentist 4">Dentist 4</option>
                                    </select>
                                </div>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label" for="findingAppointmentDate">Appointment Date</label>
                                        <input type="text"
                                               id="findingAppointmentDate"
                                               class="form-control"
                                               placeholder="MM/DD/YYYY"
                                               autocomplete="off" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="findingAppointmentStartTime">Start Time</label>
                                        <input type="text"
                                               id="findingAppointmentStartTime"
                                               class="form-control"
                                               placeholder="hh:mm AM"
                                               autocomplete="off" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="findingAppointmentDuration">Duration</label>
                                        <select id="findingAppointmentDuration" class="form-select">
                                            <option value=""></option>
                                            <option value="15 min">15 min</option>
                                            <option value="30 min">30 min</option>
                                            <option value="45 min">45 min</option>
                                            <option value="1 hr">1 hr</option>
                                            <option value="1 hr 15 min">1 hr 15 min</option>
                                            <option value="1 hr 30 min">1 hr 30 min</option>
                                            <option value="1 hr 45 min">1 hr 45 min</option>
                                            <option value="2 hr">2 hr</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="finding-treatment-required mb-0"
                                     role="group"
                                     aria-labelledby="findingDentalTreatmentRequiredLabel">
                                    <span class="form-label d-block mb-2" id="findingDentalTreatmentRequiredLabel">Dental Treatment is required</span>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="FindingDentalTreatmentRequired"
                                               id="findingDentalTreatmentRequiredYes"
                                               value="Yes"
                                               checked />
                                        <label class="form-check-label" for="findingDentalTreatmentRequiredYes">YES</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="FindingDentalTreatmentRequired"
                                               id="findingDentalTreatmentRequiredNo"
                                               value="No" />
                                        <label class="form-check-label" for="findingDentalTreatmentRequiredNo">NO</label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-6" id="dentalFindingImageColumn">
                        @await Html.PartialAsync("~/Views/DentalExams/_DentalExamXrayPreview.cshtml", findingsXrayStation, new ViewDataDictionary(ViewData) { ["Prefix"] = "findingsXray" })

                        <div class="border rounded p-3 bg-light mt-3 dental-finding-image-wrap">
                            @{
                                var findingToothChartViewData = new ViewDataDictionary(ViewData)
                                {
                                    ["ToothChartId"] = "findingReadonlyToothChart",
                                    ["ToothChartTitle"] = "Selected missing teeth",
                                    ["ToothInputIdPrefix"] = "findingToothCheck_",
                                    ["ToothInputName"] = "",
                                    ["ToothChartReadonly"] = true,
                                    ["ToothChartCompact"] = false
                                };
                            }
                            @await Html.PartialAsync("~/Views/DentalExams/_DentalExamToothChart.cshtml", exam, findingToothChartViewData)
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-start gap-2 mt-4">
                    <button type="button" class="btn btn-secondary" id="cancelFindingFormBtn">@(subsequentReadOnly ? "Close" : "Cancel")</button>
                    <button type="button" class="btn btn-general" id="addFindingToListBtn" style="@(subsequentReadOnly ? "display:none;" : null)">
                        <i class="fas fa-list-ul"></i> Add to List
                    </button>
                </div>
            </div>
        </div>
        </div>

        <div class="d-flex justify-content-center mt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm section-collapse-btn"
                    data-target-switch="toggleDentalFindingsSectionSwitch"
                    data-target-heading="dentalFindingsHeading">
                <i class="fas fa-chevron-up"></i> @collapseLabel
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        const PERMANENT_TEETH = @Json.Serialize(DentalFindingConstants.PermanentTeeth);
        const PRIMARY_TEETH = @Json.Serialize(DentalFindingConstants.PrimaryTeeth);
        const PRIMARY_TO_PERMANENT = @Json.Serialize(DentalFindingConstants.PrimaryToothToPermanentNumber);
        const PERIODONTAL_SURFACES = @Json.Serialize(DentalFindingConstants.PeriodontalSurfaces);
        const RESTORATIVE_SURFACES_POSTERIOR = @Json.Serialize(DentalFindingConstants.RestorativeSurfacesPosterior);
        const RESTORATIVE_SURFACES_ANTERIOR = @Json.Serialize(DentalFindingConstants.RestorativeSurfacesAnterior);
        const CDT_CODES_BY_TYPE = @Html.Raw(cdtCodesJson);
        const FINDINGS_READ_ONLY = @Json.Serialize(subsequentReadOnly);
        const SHOW_FINDING_ASSIGNMENT_FIELDS = @Json.Serialize(showFindingAssignmentFields);
        const EVENT_APPOINTMENT_MIN_DATE = @Json.Serialize(eventAppointmentMinDate);
        const EVENT_APPOINTMENT_MAX_DATE = @Json.Serialize(eventAppointmentMaxDate);
        const FINDINGS_TABLE_COLSPAN = @Json.Serialize(findingsTableColspan);
        const CURRENT_USER_ID = @Json.Serialize(currentUserId);
        const CURRENT_USER_DISPLAY_NAME = @Json.Serialize(currentUserDisplayName);
        const examinerNamesByUserId = @Html.Raw(examinerNamesJson);

        let dentalFindings = @Html.Raw(findingsJson);
        let editingFindingIndex = null;
        let suppressRestorativeCdtReset = false;

        function escapeHtml(value) {
            return $("<div>").text(value ?? "").html();
        }

        function destroySelect2($select) {
            if ($select.hasClass("select2-hidden-accessible")) {
                $select.select2("destroy");
            }
        }

        function initMultiSelect($select, placeholder) {
            destroySelect2($select);
            $select.select2({
                placeholder: placeholder,
                width: "100%",
                closeOnSelect: false,
                allowClear: true,
                dropdownParent: $("#dentalFindingFormCard")
            });

            $select.off("select2:select.clearSearch select2:unselect.clearSearch")
                .on("select2:select.clearSearch select2:unselect.clearSearch", function () {
                    const $searchField = $select.next(".select2-container")
                        .find(".select2-search__field");
                    if ($searchField.length) {
                        $searchField.val("");
                        $searchField.trigger("input");
                    }
                });
        }

        function getSelectedValues($select) {
            const values = $select.val();
            if (!values) {
                return [];
            }
            return Array.isArray(values) ? values.filter(Boolean) : [values].filter(Boolean);
        }

        function setMultiSelectValues($select, values) {
            $select.val(values || []).trigger("change");
        }

        function getRestorativeSurfacesForTooth(tooth) {
            if (isRestorativeAnteriorTooth(tooth)) {
                return RESTORATIVE_SURFACES_ANTERIOR.slice();
            }
            if (isRestorativePosteriorTooth(tooth)) {
                return RESTORATIVE_SURFACES_POSTERIOR.slice();
            }
            return [];
        }

        // Permanent: 6-11, 22-27 | Primary: C-H, M-R
        function isRestorativeAnteriorTooth(tooth) {
            const value = (tooth || "").toString().trim();
            const n = parseInt(value, 10);
            if (!isNaN(n) && String(n) === value) {
                return (n >= 6 && n <= 11) || (n >= 22 && n <= 27);
            }
            return value.length === 1 && "CDEFGHMNOPQR".indexOf(value.toUpperCase()) >= 0;
        }

        // Permanent: 1-5, 12-21, 28-32 | Primary: A,B,I,J,K,L,S,T
        function isRestorativePosteriorTooth(tooth) {
            const value = (tooth || "").toString().trim();
            const n = parseInt(value, 10);
            if (!isNaN(n) && String(n) === value) {
                return (n >= 1 && n <= 5) || (n >= 12 && n <= 21) || (n >= 28 && n <= 32);
            }
            return value.length === 1 && "ABIJKLST".indexOf(value.toUpperCase()) >= 0;
        }

        function resolveFindingAffectedToothToPermanent(tooth, isPrimary) {
            const value = (tooth || "").toString().trim();
            if (!value) {
                return null;
            }

            if (isPrimary) {
                const permanentNumber = PRIMARY_TO_PERMANENT[value] || PRIMARY_TO_PERMANENT[value.toUpperCase()];
                return permanentNumber ? parseInt(permanentNumber, 10) : null;
            }

            const permanentNumber = parseInt(value, 10);
            return isNaN(permanentNumber) ? null : permanentNumber;
        }

        function getDentalFindingUsedPermanentTeeth() {
            const used = [];
            dentalFindings.forEach(function (finding) {
                const permanentNumber = resolveFindingAffectedToothToPermanent(
                    finding.affectedTooth,
                    !!finding.isPrimaryTooth
                );
                if (permanentNumber != null && used.indexOf(permanentNumber) < 0) {
                    used.push(permanentNumber);
                }
            });
            return used;
        }

        window.getDentalFindingUsedPermanentTeeth = getDentalFindingUsedPermanentTeeth;

        function getPsrMissingToothNumbers() {
            const missing = [];
            $("#psrInteractiveToothChart .psr-tooth-input:checked").each(function () {
                const tooth = parseInt($(this).attr("data-tooth") || $(this).val(), 10);
                if (!isNaN(tooth)) {
                    missing.push(tooth);
                }
            });
            return missing;
        }

        function isAffectedToothMissing(tooth, isPrimary) {
            const value = (tooth || "").toString().trim();
            if (!value) {
                return false;
            }

            const missing = getPsrMissingToothNumbers();
            if (!missing.length) {
                return false;
            }

            if (isPrimary) {
                const permanentNumber = PRIMARY_TO_PERMANENT[value] || PRIMARY_TO_PERMANENT[value.toUpperCase()];
                return !!permanentNumber && missing.indexOf(permanentNumber) >= 0;
            }

            const permanentNumber = parseInt(value, 10);
            return !isNaN(permanentNumber) && missing.indexOf(permanentNumber) >= 0;
        }

        function populateToothOptions() {
            const isPrimary = $("#findingPrimaryTooth").is(":checked");
            const teeth = isPrimary ? PRIMARY_TEETH : PERMANENT_TEETH;
            const current = $("#findingAffectedTooth").val();
            const $select = $("#findingAffectedTooth");
            const missing = getPsrMissingToothNumbers();
            $select.empty().append('<option value=""></option>');
            teeth.forEach(function (tooth) {
                const toothValue = String(tooth);
                let isMissing = false;
                if (isPrimary) {
                    const permanentNumber = PRIMARY_TO_PERMANENT[toothValue] || PRIMARY_TO_PERMANENT[toothValue.toUpperCase()];
                    isMissing = !!permanentNumber && missing.indexOf(permanentNumber) >= 0;
                } else {
                    const permanentNumber = parseInt(toothValue, 10);
                    isMissing = !isNaN(permanentNumber) && missing.indexOf(permanentNumber) >= 0;
                }

                const $option = $("<option>").val(toothValue);
                if (isMissing) {
                    $option.text(toothValue + " - missing tooth").prop("disabled", true);
                } else {
                    $option.text(toothValue);
                }
                $select.append($option);
            });

            if (current && teeth.map(String).indexOf(String(current)) >= 0 && !isAffectedToothMissing(current, isPrimary)) {
                $select.val(current);
            } else {
                $select.val("");
                if (current && isAffectedToothMissing(current, isPrimary)
                    && $("#findingDiseaseType").val() === "Restorative") {
                    populateSurfaceOptions([]);
                    populateCdtOptions([]);
                }
            }
        }

        window.refreshDentalFindingToothOptions = function () {
            if (!$("#findingAffectedTooth").length) {
                return;
            }
            populateToothOptions();
        };

        function populateSurfaceOptions(selectedValues) {
            const diseaseType = $("#findingDiseaseType").val();
            const $section = $("#findingSurfacesSection");
            const $select = $("#findingAffectedSurfaces");
            destroySelect2($select);
            $select.empty();

            if (diseaseType === "Periodontal") {
                PERIODONTAL_SURFACES.forEach(function (surface) {
                    $select.append($("<option>").val(surface).text(surface));
                });
                $section.show();
                initMultiSelect($select, "Select surface(s)");
                setMultiSelectValues($select, selectedValues || []);
                return;
            }

            if (diseaseType === "Restorative") {
                const surfaces = getRestorativeSurfacesForTooth($("#findingAffectedTooth").val());
                if (!surfaces.length) {
                    $section.hide();
                    setMultiSelectValues($select, []);
                    populateCdtOptions([]);
                    return;
                }

                surfaces.forEach(function (surface) {
                    $select.append($("<option>").val(surface).text(surface));
                });
                $section.show();
                initMultiSelect($select, "Select surface(s)");
                const validSelected = (selectedValues || []).filter(function (surface) {
                    return surfaces.indexOf(surface) >= 0;
                });
                setMultiSelectValues($select, validSelected);
                populateCdtOptions(getSelectedValues($("#findingCdtCodes")));
                return;
            }

            $section.hide();
            setMultiSelectValues($select, []);
        }

        function getRestorativeCdtCodes(tooth, surfaceCount) {
            if (!surfaceCount || surfaceCount < 1) {
                return [];
            }

            const isAnterior = isRestorativeAnteriorTooth(tooth);
            const isPosterior = isRestorativePosteriorTooth(tooth);
            if (!isAnterior && !isPosterior) {
                return [];
            }

            const amalgam = surfaceCount === 1
                ? "D2140 - Amalgam-One Surface"
                : surfaceCount === 2
                    ? "D2150 - Amalgam-Two Surfaces"
                    : surfaceCount === 3
                        ? "D2160 - Amalgam-Three Surfaces"
                        : "D2161 - Amalgam-Four or More Surfaces";

            const resin = isAnterior
                ? (surfaceCount === 1
                    ? "D2330 - Resin Based Composite-One Surface, Anterior"
                    : surfaceCount === 2
                        ? "D2331 - Resin Based Composite-Two Surfaces, Anterior"
                        : surfaceCount === 3
                            ? "D2332 - Resin Based Composite-Three Surfaces, Anterior"
                            : "D2335 - Resin Based Composite-Four or More Surfaces, Anterior")
                : (surfaceCount === 1
                    ? "D2391 - Resin Based Composite-One Surface, Posterior"
                    : surfaceCount === 2
                        ? "D2392 - Resin Based Composite-Two Surfaces, Posterior"
                        : surfaceCount === 3
                            ? "D2393 - Resin Based Composite-Three Surfaces, Posterior"
                            : "D2394 - Resin Based Composite-Four or More Surfaces, Posterior");

            return [amalgam, resin];
        }

        function populateCdtOptions(selectedValues) {
            const diseaseType = $("#findingDiseaseType").val();
            const $select = $("#findingCdtCodes");
            destroySelect2($select);
            $select.empty();

            let codes = CDT_CODES_BY_TYPE[diseaseType] || [];
            if (diseaseType === "Restorative") {
                codes = getRestorativeCdtCodes(
                    $("#findingAffectedTooth").val(),
                    getSelectedValues($("#findingAffectedSurfaces")).length
                );
            }

            codes.forEach(function (code) {
                $select.append($("<option>").val(code).text(code));
            });

            initMultiSelect($select, "Select CDT code(s)");
            if (selectedValues && selectedValues.length) {
                const valid = selectedValues.filter(function (code) { return codes.indexOf(code) >= 0; });
                setMultiSelectValues($select, valid);
            } else {
                setMultiSelectValues($select, []);
            }
        }

        function clearFindingForm() {
            editingFindingIndex = null;
            $("#dentalFindingFormTitle").text("Add Finding");
            $("#addFindingToListBtn").html('<i class="fas fa-list-ul"></i> Add to List');
            $("#findingPrimaryTooth").prop("checked", false).prop("disabled", false);
            $("#findingDiseaseType").val("");
            populateToothOptions();
            $("#findingAffectedTooth").val("");
            populateSurfaceOptions([]);
            populateCdtOptions([]);
            $("#findingCdtCodesNotes").val("");
            $("#findingDescription").val("");
            $("input[name='FindingClassification']").prop("checked", false);
            clearFindingAssignmentFields();
            toggleExternalExaminerNameVisibility(null);
        }

        function clearFindingAssignmentFields() {
            if (!SHOW_FINDING_ASSIGNMENT_FIELDS) {
                return;
            }
            $("#findingExternalExaminerName").val("");
            $("#findingExternalExamDateTime").val("");
            $("#findingExternalDentistRemarks").val("");
            $("#findingAssignedDentist").val("");
            if (appointmentDatePicker) {
                appointmentDatePicker.clear();
            } else {
                $("#findingAppointmentDate").val("");
            }
            if (appointmentStartTimePicker) {
                appointmentStartTimePicker.clear();
            } else {
                $("#findingAppointmentStartTime").val("");
            }
            $("#findingAppointmentDuration").val("");
            $("#findingDentalTreatmentRequiredYes").prop("checked", true);
            $("#findingDentalTreatmentRequiredNo").prop("checked", false);
        }

        let appointmentDatePicker = null;
        let appointmentStartTimePicker = null;

        function initAppointmentPickers() {
            if (!SHOW_FINDING_ASSIGNMENT_FIELDS || typeof flatpickr === "undefined") {
                return;
            }

            const dateOptions = {
                altInput: true,
                altFormat: "m/d/Y",
                dateFormat: "Y-m-d",
                allowInput: true
            };
            if (EVENT_APPOINTMENT_MIN_DATE) {
                dateOptions.minDate = EVENT_APPOINTMENT_MIN_DATE;
            }
            if (EVENT_APPOINTMENT_MAX_DATE) {
                dateOptions.maxDate = EVENT_APPOINTMENT_MAX_DATE;
            }

            if (!appointmentDatePicker && $("#findingAppointmentDate").length) {
                appointmentDatePicker = flatpickr("#findingAppointmentDate", dateOptions);
            }
            if (!appointmentStartTimePicker && $("#findingAppointmentStartTime").length) {
                appointmentStartTimePicker = flatpickr("#findingAppointmentStartTime", {
                    enableTime: true,
                    noCalendar: true,
                    dateFormat: "h:i K",
                    time_24hr: false,
                    allowInput: true
                });
            }
        }

        function isDentalExamOriginFinding(finding) {
            return !!(finding && finding.id > 0 && !((finding.externalExaminerName || "").toString().trim()));
        }

        function toggleExternalExaminerNameVisibility(finding) {
            if (!SHOW_FINDING_ASSIGNMENT_FIELDS) {
                return;
            }
            const $section = $("#externalExaminerNameSection");
            if (!$section.length) {
                return;
            }
            const isAdd = editingFindingIndex == null;
            const showName = isAdd || !isDentalExamOriginFinding(finding);
            $section.toggle(showName);
            if (!showName) {
                $("#findingExternalExaminerName").val("");
            }
        }

        function toDateTimeLocalValue(value) {
            if (!value) {
                return "";
            }
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) {
                return "";
            }
            const pad = function (n) { return String(n).padStart(2, "0"); };
            return date.getFullYear() + "-" + pad(date.getMonth() + 1) + "-" + pad(date.getDate())
                + "T" + pad(date.getHours()) + ":" + pad(date.getMinutes());
        }

        function fromDateTimeLocalValue(value) {
            const raw = (value || "").toString().trim();
            if (!raw) {
                return null;
            }
            const date = new Date(raw);
            if (Number.isNaN(date.getTime())) {
                return null;
            }
            return date.toISOString();
        }

        function showFindingForm(preserveSelections) {
            const surfacesToRestore = preserveSelections && preserveSelections.affectedSurfaces
                ? preserveSelections.affectedSurfaces.slice()
                : null;
            const cdtCodesToRestore = preserveSelections && preserveSelections.cdtCodes
                ? preserveSelections.cdtCodes.slice()
                : null;

            $("#dentalFindingFormCard").slideDown(200, function () {
                const surfaces = surfacesToRestore || getSelectedValues($("#findingAffectedSurfaces"));
                const cdtCodes = cdtCodesToRestore || getSelectedValues($("#findingCdtCodes"));
                suppressRestorativeCdtReset = true;
                try {
                    populateSurfaceOptions(surfaces);
                    populateCdtOptions(cdtCodes);
                } finally {
                    suppressRestorativeCdtReset = false;
                }
                initAppointmentPickers();
                applyFindingFormReadOnly();
            });
        }

        function hideFindingForm() {
            destroySelect2($("#findingAffectedSurfaces"));
            destroySelect2($("#findingCdtCodes"));
            $("#dentalFindingFormCard").slideUp(200);
            clearFindingForm();
        }

        function validateFindingForm() {
            const finding = readFindingForm();
            if (!finding.affectedTooth) {
                Swal.fire("Invalid Data", "Affected Tooth is required.", "warning");
                return null;
            }
            if (isAffectedToothMissing(finding.affectedTooth, !!finding.isPrimaryTooth)) {
                Swal.fire("Invalid Data", "Affected Tooth cannot be a missing tooth selected in PSR.", "warning");
                return null;
            }
            if (!finding.diseaseConditionType) {
                Swal.fire("Invalid Data", "Disease / Condition Type is required.", "warning");
                return null;
            }
            if (finding.diseaseConditionType === "Periodontal") {
                if (!finding.affectedSurfaces || finding.affectedSurfaces.length === 0) {
                    Swal.fire("Invalid Data", "Affected Surface(s) are required for the selected Disease / Condition Type.", "warning");
                    return null;
                }
            }

            if (finding.diseaseConditionType === "Restorative") {
                const allowedSurfaces = getRestorativeSurfacesForTooth(finding.affectedTooth);
                if (!allowedSurfaces.length) {
                    Swal.fire("Invalid Data", "For Restorative findings, select a valid permanent (1-32) or primary tooth to choose Affected Surface(s).", "warning");
                    return null;
                }
                if (!finding.affectedSurfaces || finding.affectedSurfaces.length === 0) {
                    Swal.fire("Invalid Data", "Affected Surface(s) are required for the selected Disease / Condition Type.", "warning");
                    return null;
                }
            }
            if (!finding.classification) {
                Swal.fire("Invalid Data", "Classification is required.", "warning");
                return null;
            }
            if (!finding.cdtCodes || finding.cdtCodes.length === 0) {
                Swal.fire("Invalid Data", "CDT Code is required.", "warning");
                return null;
            }
            return finding;
        }

        function readFindingForm() {
            const existing = editingFindingIndex != null ? dentalFindings[editingFindingIndex] : null;
            const assignmentEnabled = SHOW_FINDING_ASSIGNMENT_FIELDS;
            const showExternalName = assignmentEnabled
                && (editingFindingIndex == null || !isDentalExamOriginFinding(existing));

            return {
                id: existing ? (existing.id || 0) : 0,
                isPrimaryTooth: $("#findingPrimaryTooth").is(":checked"),
                affectedTooth: $("#findingAffectedTooth").val() || "",
                diseaseConditionType: $("#findingDiseaseType").val() || "",
                affectedSurfaces: getSelectedValues($("#findingAffectedSurfaces")),
                cdtCodes: getSelectedValues($("#findingCdtCodes")),
                cdtCodesNotes: $("#findingCdtCodesNotes").val()?.trim() || "",
                descriptionDetails: $("#findingDescription").val()?.trim() || "",
                classification: $("input[name='FindingClassification']:checked").val() || "",
                sortOrder: editingFindingIndex != null ? editingFindingIndex : dentalFindings.length,
                examinationAddedBy: existing ? (existing.examinationAddedBy || null) : null,
                examinationAddedOn: existing ? (existing.examinationAddedOn || null) : null,
                examinationUpdatedBy: existing ? (existing.examinationUpdatedBy || null) : null,
                examinationUpdatedOn: existing ? (existing.examinationUpdatedOn || null) : null,
                externalExaminerName: showExternalName
                    ? ($("#findingExternalExaminerName").val()?.trim() || "")
                    : (existing ? (existing.externalExaminerName || "") : ""),
                externalExamDateTime: assignmentEnabled
                    ? fromDateTimeLocalValue($("#findingExternalExamDateTime").val())
                    : (existing ? (existing.externalExamDateTime || null) : null),
                externalDentistRemarks: assignmentEnabled
                    ? ($("#findingExternalDentistRemarks").val()?.trim() || "")
                    : (existing ? (existing.externalDentistRemarks || "") : ""),
                assignedDentist: assignmentEnabled
                    ? ($("#findingAssignedDentist").val() || "")
                    : (existing ? (existing.assignedDentist || "") : ""),
                appointmentDate: assignmentEnabled
                    ? ($("#findingAppointmentDate").val() || "")
                    : (existing ? (existing.appointmentDate || "") : ""),
                appointmentStartTime: assignmentEnabled
                    ? ($("#findingAppointmentStartTime").val() || "")
                    : (existing ? (existing.appointmentStartTime || "") : ""),
                appointmentDuration: assignmentEnabled
                    ? ($("#findingAppointmentDuration").val() || "")
                    : (existing ? (existing.appointmentDuration || "") : ""),
                dentalTreatmentRequired: assignmentEnabled
                    ? ($("input[name='FindingDentalTreatmentRequired']:checked").val() || "Yes")
                    : (existing ? (existing.dentalTreatmentRequired || "Yes") : "Yes"),
                procedureStatus: existing ? (existing.procedureStatus || "") : "",
                procedureDateTime: existing ? (existing.procedureDateTime || "") : ""
            };
        }

        function writeFindingForm(finding) {
            $("#findingDiseaseType").val(finding.diseaseConditionType || "");
            $("#findingPrimaryTooth").prop("checked", !!finding.isPrimaryTooth).prop("disabled", false);
            $("#findingAffectedTooth").val(finding.affectedTooth || "");
            populateToothOptions();
            suppressRestorativeCdtReset = true;
            try {
                populateSurfaceOptions(finding.affectedSurfaces || []);
                populateCdtOptions(finding.cdtCodes || []);
            } finally {
                suppressRestorativeCdtReset = false;
            }
            $("#findingCdtCodesNotes").val(finding.cdtCodesNotes || "");
            $("#findingDescription").val(finding.descriptionDetails || "");
            $("input[name='FindingClassification']").each(function () {
                $(this).prop("checked", $(this).val() === (finding.classification || ""));
            });

            if (SHOW_FINDING_ASSIGNMENT_FIELDS) {
                initAppointmentPickers();
                $("#findingExternalExaminerName").val(finding.externalExaminerName || "");
                $("#findingExternalExamDateTime").val(toDateTimeLocalValue(finding.externalExamDateTime));
                $("#findingExternalDentistRemarks").val(finding.externalDentistRemarks || "");
                $("#findingAssignedDentist").val(finding.assignedDentist || "");
                if (appointmentDatePicker) {
                    if (finding.appointmentDate) {
                        appointmentDatePicker.setDate(finding.appointmentDate, true);
                    } else {
                        appointmentDatePicker.clear();
                    }
                } else {
                    $("#findingAppointmentDate").val(finding.appointmentDate || "");
                }
                if (appointmentStartTimePicker) {
                    if (finding.appointmentStartTime) {
                        appointmentStartTimePicker.setDate(finding.appointmentStartTime, true);
                    } else {
                        appointmentStartTimePicker.clear();
                    }
                } else {
                    $("#findingAppointmentStartTime").val(finding.appointmentStartTime || "");
                }
                $("#findingAppointmentDuration").val(finding.appointmentDuration || "");
                const treatmentRequired = (finding.dentalTreatmentRequired || "Yes") === "No" ? "No" : "Yes";
                $("input[name='FindingDentalTreatmentRequired']").prop("checked", false);
                $("input[name='FindingDentalTreatmentRequired'][value='" + treatmentRequired + "']").prop("checked", true);
                toggleExternalExaminerNameVisibility(finding);
            }
        }

        function formatClassificationBadge(classification) {
            if (!classification) {
                return "-";
            }

            if (classification.indexOf("Class 2") === 0) {
                return "<span class='badge finding-classification-badge finding-class-2'>Class 2</span>";
            }

            if (classification.indexOf("Class 3") === 0) {
                return "<span class='badge finding-classification-badge finding-class-3'>Class 3</span>";
            }

            return escapeHtml(classification);
        }

        function formatCdtCodeForDisplay(code) {
            const value = (code || "").toString().trim();
            if (!value) {
                return "";
            }
            const separatorIndex = value.indexOf(" - ");
            return separatorIndex >= 0 ? value.substring(0, separatorIndex).trim() : value;
        }

        function formatCdtCodesForDisplay(codes) {
            const list = (codes || [])
                .map(formatCdtCodeForDisplay)
                .filter(Boolean);
            return list.length ? list.join("; ") : "-";
        }

        function syncFindingsJson() {
            const normalized = dentalFindings.map(function (item, index) {
                return {
                    id: item.id || 0,
                    isPrimaryTooth: !!item.isPrimaryTooth,
                    affectedTooth: item.affectedTooth || "",
                    diseaseConditionType: item.diseaseConditionType || "",
                    affectedSurfaces: item.affectedSurfaces || [],
                    cdtCodes: item.cdtCodes || [],
                    cdtCodesNotes: item.cdtCodesNotes || "",
                    descriptionDetails: item.descriptionDetails || "",
                    classification: item.classification || "",
                    sortOrder: index,
                    examinationAddedBy: item.examinationAddedBy || null,
                    examinationAddedOn: item.examinationAddedOn || null,
                    examinationUpdatedBy: item.examinationUpdatedBy || null,
                    examinationUpdatedOn: item.examinationUpdatedOn || null,
                    externalExaminerName: item.externalExaminerName || "",
                    externalExamDateTime: item.externalExamDateTime || null,
                    externalDentistRemarks: item.externalDentistRemarks || "",
                    assignedDentist: item.assignedDentist || "",
                    appointmentDate: item.appointmentDate || "",
                    appointmentStartTime: item.appointmentStartTime || "",
                    appointmentDuration: item.appointmentDuration || "",
                    dentalTreatmentRequired: item.dentalTreatmentRequired || "Yes",
                    procedureStatus: item.procedureStatus || "",
                    procedureDateTime: item.procedureDateTime || ""
                };
            });
            $("#FindingsJson").val(JSON.stringify(normalized));
        }

        function formatExaminerDateTime(value) {
            if (!value) {
                return "";
            }
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) {
                return escapeHtml(String(value));
            }
            return escapeHtml(date.toLocaleString(undefined, {
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
                hour: "2-digit",
                minute: "2-digit"
            }));
        }

        function formatExaminerDetail(finding) {
            const externalName = (finding.externalExaminerName || "").toString().trim();
            if (externalName) {
                const whenHtml = finding.externalExamDateTime
                    ? ("<div class='small finding-external-examiner-meta'>" + formatExaminerDateTime(finding.externalExamDateTime) + "</div>")
                    : "";
                return "<span class='finding-external-examiner'>" + escapeHtml(externalName) + "</span>" + whenHtml;
            }

            const userId = finding.examinationUpdatedBy || finding.examinationAddedBy;
            const when = finding.examinationUpdatedOn || finding.examinationAddedOn;
            if (!userId && !when) {
                return "-";
            }

            const name = (userId && examinerNamesByUserId[userId])
                ? examinerNamesByUserId[userId]
                : (userId === CURRENT_USER_ID ? CURRENT_USER_DISPLAY_NAME : "");
            const nameHtml = name ? escapeHtml(name) : "-";
            const whenHtml = when ? ("<div class='small text-muted'>" + formatExaminerDateTime(when) + "</div>") : "";
            return nameHtml + whenHtml;
        }

        function stampExaminerOnFinding(finding, isEdit) {
            const nowIso = new Date().toISOString();
            if (CURRENT_USER_ID) {
                examinerNamesByUserId[CURRENT_USER_ID] = CURRENT_USER_DISPLAY_NAME || examinerNamesByUserId[CURRENT_USER_ID] || "";
            }

            if (isEdit) {
                finding.examinationUpdatedBy = CURRENT_USER_ID || null;
                finding.examinationUpdatedOn = nowIso;
                if (!finding.examinationAddedBy) {
                    finding.examinationAddedBy = CURRENT_USER_ID || null;
                    finding.examinationAddedOn = nowIso;
                }
            } else {
                finding.examinationAddedBy = CURRENT_USER_ID || null;
                finding.examinationAddedOn = nowIso;
                finding.examinationUpdatedBy = null;
                finding.examinationUpdatedOn = null;
            }
            return finding;
        }

        function renderFindingsTable() {
            const $tbody = $("#dentalFindingsTableBody");
            $tbody.empty();

            if (!dentalFindings.length) {
                $tbody.append(
                    '<tr id="dentalFindingsEmptyRow"><td colspan="' + FINDINGS_TABLE_COLSPAN + '" class="text-center text-muted py-4">No findings added yet.</td></tr>'
                );
                syncFindingsJson();
                return;
            }

            dentalFindings.forEach(function (finding, index) {
                const surfaces = (finding.affectedSurfaces || []).join(", ") || "-";
                const cdtCodes = formatCdtCodesForDisplay(finding.cdtCodes);
                const cdtCodesFull = (finding.cdtCodes || []).join("; ");
                const codesNotes = finding.cdtCodesNotes ? "<div class='small text-muted mt-1'>" + escapeHtml(finding.cdtCodesNotes) + "</div>" : "";
                const toothLabel = finding.affectedTooth + (finding.isPrimaryTooth ? " (Primary)" : "");
                const classificationBadge = formatClassificationBadge(finding.classification);
                const description = finding.descriptionDetails ? escapeHtml(finding.descriptionDetails) : "-";
                const examinerDetail = formatExaminerDetail(finding);

                const actionButtons = FINDINGS_READ_ONLY
                    ? ("<button type='button' class='btn btn-sm btn-outline-primary me-1 finding-action-btn edit-finding-btn' data-index='" + index + "' title='View'><i class='fas fa-eye' aria-hidden='true'></i><span class='visually-hidden'>View</span></button>")
                    : ("<button type='button' class='btn btn-sm btn-outline-primary me-1 finding-action-btn edit-finding-btn' data-index='" + index + "' title='Edit'><i class='fas fa-edit' aria-hidden='true'></i><span class='visually-hidden'>Edit</span></button>" +
                       "<button type='button' class='btn btn-sm btn-outline-danger finding-action-btn delete-finding-btn' data-index='" + index + "' title='Delete'><i class='fas fa-trash-alt' aria-hidden='true'></i><span class='visually-hidden'>Delete</span></button>");

                if (SHOW_FINDING_ASSIGNMENT_FIELDS) {
                    const detailId = "findingDetail_" + index;
                    const expandBtn =
                        "<button type='button' class='btn btn-sm finding-expand-btn' data-index='" + index + "' " +
                        "aria-expanded='false' aria-controls='" + detailId + "' title='Show details'>" +
                        "<i class='fas fa-chevron-right' aria-hidden='true'></i>" +
                        "<span class='visually-hidden'>Show details</span></button>";

                    const cdtTitle = [cdtCodesFull, finding.cdtCodesNotes || ""].filter(Boolean).join(" — ");
                    const cdtNotesHtml = finding.cdtCodesNotes
                        ? "<div class='small text-muted mt-1 finding-cdt-notes' title='" + escapeHtml(finding.cdtCodesNotes) + "'>" + escapeHtml(finding.cdtCodesNotes) + "</div>"
                        : "";
                    const cdtCell =
                        "<td class='finding-cdt-cell'>" +
                        "<div class='finding-cdt-codes' title='" + escapeHtml(cdtTitle) + "'>" + escapeHtml(cdtCodes) + "</div>" +
                        cdtNotesHtml +
                        "</td>";

                    const detailPanel =
                        "<div class='finding-detail-panel' id='" + detailId + "'>" +
                        "<div class='finding-detail-grid'>" +
                        buildFindingDetailItem("Appointment Date", escapeHtml(formatAppointmentDateForDisplay(finding.appointmentDate))) +
                        buildFindingDetailItem("Start Time", escapeHtml(finding.appointmentStartTime || "-")) +
                        buildFindingDetailItem("Duration", escapeHtml(finding.appointmentDuration || "-")) +
                        buildFindingDetailItem("Dental Treatment is required", escapeHtml(finding.dentalTreatmentRequired || "Yes")) +
                        buildFindingDetailItem("Procedure Status", escapeHtml(finding.procedureStatus || "")) +
                        buildFindingDetailItem("Procedure Date/Time", escapeHtml(finding.procedureDateTime || "")) +
                        "</div></div>";

                    $tbody.append(
                        "<tr class='finding-main-row' data-finding-index='" + index + "'>" +
                        "<td class='text-center'>" + expandBtn + "</td>" +
                        "<td>" + (index + 1) + "</td>" +
                        "<td>" + escapeHtml(toothLabel) + "</td>" +
                        "<td>" + escapeHtml(surfaces) + "</td>" +
                        "<td>" + escapeHtml(finding.diseaseConditionType || "-") + "</td>" +
                        "<td>" + classificationBadge + "</td>" +
                        cdtCell +
                        "<td>" + examinerDetail + "</td>" +
                        "<td>" + escapeHtml(finding.assignedDentist || "-") + "</td>" +
                        "<td class='text-nowrap'>" + actionButtons + "</td>" +
                        "</tr>" +
                        "<tr class='finding-detail-row' data-finding-index='" + index + "' style='display:none;'>" +
                        "<td colspan='" + FINDINGS_TABLE_COLSPAN + "'>" + detailPanel + "</td>" +
                        "</tr>"
                    );
                    return;
                }

                $tbody.append(
                    "<tr data-finding-index='" + index + "'>" +
                    "<td>" + (index + 1) + "</td>" +
                    "<td>" + escapeHtml(toothLabel) + "</td>" +
                    "<td>" + escapeHtml(surfaces) + "</td>" +
                    "<td>" + escapeHtml(finding.diseaseConditionType || "-") + "</td>" +
                    "<td>" + classificationBadge + "</td>" +
                    "<td><div title='" + escapeHtml(cdtCodesFull) + "'>" + escapeHtml(cdtCodes) + "</div>" + codesNotes + "</td>" +
                    "<td>" + description + "</td>" +
                    "<td>" + examinerDetail + "</td>" +
                    "<td class='text-nowrap'>" + actionButtons + "</td>" +
                    "</tr>"
                );
            });

            syncFindingsJson();
        }

        function buildFindingDetailItem(label, valueHtml, isWide) {
            return "<div class='finding-detail-item" + (isWide ? " is-wide" : "") + "'>" +
                "<span class='finding-detail-label'>" + escapeHtml(label) + "</span>" +
                "<div class='finding-detail-value'>" + (valueHtml || "-") + "</div>" +
                "</div>";
        }

        function toggleFindingDetailRow(index) {
            const $main = $("#dentalFindingsTableBody tr.finding-main-row[data-finding-index='" + index + "']");
            const $detail = $("#dentalFindingsTableBody tr.finding-detail-row[data-finding-index='" + index + "']");
            const $btn = $main.find(".finding-expand-btn");
            const $panel = $detail.find(".finding-detail-panel");
            if (!$detail.length || !$btn.length) {
                return;
            }

            const willExpand = !$main.hasClass("is-expanded");
            $main.toggleClass("is-expanded", willExpand);
            $btn.attr("aria-expanded", willExpand ? "true" : "false");
            $btn.attr("title", willExpand ? "Hide details" : "Show details");
            $btn.find(".visually-hidden").text(willExpand ? "Hide details" : "Show details");
            if (willExpand) {
                $detail.show();
                $panel.hide().stop(true, true).slideDown(160);
            } else {
                $panel.stop(true, true).slideUp(160, function () {
                    $detail.hide();
                });
            }
        }

        function formatAppointmentDateForDisplay(value) {
            if (!value) {
                return "-";
            }
            const raw = value.toString();
            if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) {
                const parts = raw.split("-");
                return parts[1] + "/" + parts[2] + "/" + parts[0];
            }
            return raw;
        }

        function addOrUpdateFinding() {
            const finding = validateFindingForm();
            if (!finding) {
                return;
            }

            const isEdit = editingFindingIndex != null;
            stampExaminerOnFinding(finding, isEdit);

            if (isEdit) {
                dentalFindings[editingFindingIndex] = finding;
            } else {
                dentalFindings.push(finding);
            }

            renderFindingsTable();
            hideFindingForm();
        }

        function editFinding(index) {
            const finding = dentalFindings[index];
            if (!finding) {
                return;
            }

            editingFindingIndex = index;
            $("#dentalFindingFormTitle").text(FINDINGS_READ_ONLY ? "View Finding" : "Edit Finding");
            if (!FINDINGS_READ_ONLY) {
                $("#addFindingToListBtn").html('<i class="fas fa-check-circle"></i> Update Finding');
            }
            writeFindingForm(finding);
            applyFindingFormReadOnly();
            showFindingForm({
                affectedSurfaces: finding.affectedSurfaces || [],
                cdtCodes: finding.cdtCodes || []
            });

            $("html, body").animate({
                scrollTop: $("#dentalFindingFormCard").offset().top - 80
            }, 300);
        }

        function applyFindingFormReadOnly() {
            if (!FINDINGS_READ_ONLY) {
                return;
            }

            $("#dentalFindingFormCard").find("input, select, textarea, button").each(function () {
                const $el = $(this);
                if ($el.closest(".xray-preview-widget").length) {
                    return;
                }
                if ($el.closest("#findingReadonlyToothChart").length) {
                    $el.prop("disabled", true);
                    return;
                }
                if ($el.attr("id") === "cancelFindingFormBtn") {
                    $el.prop("disabled", false);
                    return;
                }
                if ($el.is("input:checkbox, input:radio, select, button")) {
                    $el.prop("disabled", true);
                } else {
                    $el.prop("readonly", true).addClass("read-only-style");
                }
            });
        }

        function deleteFinding(index) {
            Swal.fire({
                title: "Delete finding?",
                text: "This finding will be removed from the list.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Delete",
                confirmButtonColor: "#dc3545"
            }).then(function (result) {
                if (!result.isConfirmed) {
                    return;
                }

                dentalFindings.splice(index, 1);
                if (editingFindingIndex === index) {
                    hideFindingForm();
                } else if (editingFindingIndex != null && editingFindingIndex > index) {
                    editingFindingIndex -= 1;
                }
                renderFindingsTable();
            });
        }

        window.initDentalFindingsSection = function () {
            populateToothOptions();
            initAppointmentPickers();
            renderFindingsTable();
        };

        $(document).ready(function () {
            initDentalFindingsSection();

            $("#addNewFindingBtn").on("click", function () {
                if (FINDINGS_READ_ONLY) {
                    return;
                }
                clearFindingForm();
                showFindingForm();
                $("html, body").animate({
                    scrollTop: $("#dentalFindingFormCard").offset().top - 80
                }, 300);
            });

            $("#cancelFindingFormBtn").on("click", hideFindingForm);
            $("#addFindingToListBtn").on("click", function () {
                if (FINDINGS_READ_ONLY) {
                    return;
                }
                addOrUpdateFinding();
            });
            $("#findingPrimaryTooth").on("change", function () {
                populateToothOptions();
                if ($("#findingDiseaseType").val() === "Restorative") {
                    populateSurfaceOptions([]);
                }
            });
            $("#findingAffectedTooth").on("change", function () {
                if ($("#findingDiseaseType").val() === "Restorative") {
                    populateSurfaceOptions([]);
                }
            });
            $(document).on("change", "#findingAffectedSurfaces", function () {
                if (suppressRestorativeCdtReset) {
                    return;
                }
                if ($("#findingDiseaseType").val() === "Restorative") {
                    populateCdtOptions([]);
                }
            });
            $("#findingDiseaseType").on("change", function () {
                populateToothOptions();
                populateSurfaceOptions([]);
                populateCdtOptions([]);
            });

            $(document).on("click", ".edit-finding-btn", function () {
                editFinding(parseInt($(this).data("index"), 10));
            });

            $(document).on("click", ".delete-finding-btn", function () {
                deleteFinding(parseInt($(this).data("index"), 10));
            });

            $(document).on("click", ".finding-expand-btn", function (e) {
                e.preventDefault();
                e.stopPropagation();
                toggleFindingDetailRow(parseInt($(this).data("index"), 10));
            });

            $("#SaveDentalExamStation").on("submit", function () {
                syncFindingsJson();
            });
        });
    })();
</script>
