@using ExcelFilesCompiler.Utilities
@using Malama.Models
@model DentalExam

@{
    var exam = Model ?? new DentalExam();
    var tobaccoDisplay = ViewData["TobaccoDisplay"] as string ?? "No";
    var requirePsrFields = ViewData["RequirePsrFields"] as bool? ?? false;
    var showSoftTissuesDetail = string.Equals(exam.SoftTissuesWnl, DentalExamPsr.SoftTissuesWnlNo, StringComparison.OrdinalIgnoreCase);
    var psrRequiredAttr = requirePsrFields ? "required" : "";
    var softTissuesDetailRequiredAttr = requirePsrFields && showSoftTissuesDetail ? "required" : "";

    var xrayStation = ViewData["XRayStation"] as DentalXRayStation ?? new DentalXRayStation();

    var bwxUploadMode = xrayStation.BwxUploadMode;
    if (string.IsNullOrWhiteSpace(bwxUploadMode))
    {
        if (!string.IsNullOrWhiteSpace(xrayStation.BwxConsolidatedFileName))
        {
            bwxUploadMode = BwxUploadMode.Consolidated;
        }
        else if (!string.IsNullOrWhiteSpace(xrayStation.BwLeftMolarFileName)
            || !string.IsNullOrWhiteSpace(xrayStation.BwLeftPremolarFileName)
            || !string.IsNullOrWhiteSpace(xrayStation.BwRightMolarFileName)
            || !string.IsNullOrWhiteSpace(xrayStation.BwRightPremolarFileName))
        {
            bwxUploadMode = BwxUploadMode.Separate;
        }
    }

    var bwxImageOptions = new List<(string Label, string DownloadPrefix, string FileName)>();
    if (bwxUploadMode == BwxUploadMode.Consolidated && !string.IsNullOrWhiteSpace(xrayStation.BwxConsolidatedFileName))
    {
        bwxImageOptions.Add(("Consolidated BWX", "bwx_consolidated", xrayStation.BwxConsolidatedFileName));
    }
    else if (bwxUploadMode == BwxUploadMode.Separate)
    {
        if (!string.IsNullOrWhiteSpace(xrayStation.BwLeftMolarFileName))
        {
            bwxImageOptions.Add(("BW Left Molar", "bwx_left_molar", xrayStation.BwLeftMolarFileName));
        }
        if (!string.IsNullOrWhiteSpace(xrayStation.BwRightMolarFileName))
        {
            bwxImageOptions.Add(("BW Right Molar", "bwx_right_molar", xrayStation.BwRightMolarFileName));
        }
        if (!string.IsNullOrWhiteSpace(xrayStation.BwLeftPremolarFileName))
        {
            bwxImageOptions.Add(("BW Left Premolar", "bwx_left_premolar", xrayStation.BwLeftPremolarFileName));
        }
        if (!string.IsNullOrWhiteSpace(xrayStation.BwRightPremolarFileName))
        {
            bwxImageOptions.Add(("BW Right Premolar", "bwx_right_premolar", xrayStation.BwRightPremolarFileName));
        }
    }

    var paImageOptions = xrayStation.PaImages?
        .Where(p => !string.IsNullOrWhiteSpace(p.FileName))
        .OrderBy(p => p.SortOrder)
        .ToList() ?? new List<DentalXRayPaImage>();

    var hasBwxImages = bwxImageOptions.Any();
    var hasPaImages = paImageOptions.Any();
}
<h3 class="mb-4">Subsequent diseases and abnormalities</h3>

<div class="card mb-4">
    <div class="card-header fw-bold" style="background-color: rgba(120, 130, 221, 0.15); color: rgba(80, 90, 201, 1);">
        Periodontal Screening and Recording (PSR)
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="PsrUpperRight">Upper Right</label>
                        <select name="PsrUpperRight" id="PsrUpperRight" class="form-select psr-sextant-select" @psrRequiredAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrUpperRight == score)">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="PsrUpperAnterior">Upper Anterior</label>
                        <select name="PsrUpperAnterior" id="PsrUpperAnterior" class="form-select psr-sextant-select" @psrRequiredAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrUpperAnterior == score)">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="PsrUpperLeft">Upper Left</label>
                        <select name="PsrUpperLeft" id="PsrUpperLeft" class="form-select psr-sextant-select" @psrRequiredAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrUpperLeft == score)">@score</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="PsrLowerRight">Lower Right</label>
                        <select name="PsrLowerRight" id="PsrLowerRight" class="form-select psr-sextant-select" @psrRequiredAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrLowerRight == score)">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="PsrLowerAnterior">Lower Anterior</label>
                        <select name="PsrLowerAnterior" id="PsrLowerAnterior" class="form-select psr-sextant-select" @psrRequiredAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrLowerAnterior == score)">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="PsrLowerLeft">Lower Left</label>
                        <select name="PsrLowerLeft" id="PsrLowerLeft" class="form-select psr-sextant-select" @psrRequiredAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrLowerLeft == score)">@score</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <p class="fw-semibold mb-2">Codes:</p>
                    <div class="small">
                        <div class="row">
                            <div class="col-sm-6">
                                <p class="mb-1">0 = Healthy</p>
                                <p class="mb-1">1 = Bleeding</p>
                                <p class="mb-1">2 = Calculus / Defective Margin</p>
                            </div>
                            <div class="col-sm-6">
                                <p class="mb-1">3 = Pocket 3.5 - 5.5 mm</p>
                                <p class="mb-1">4 = Pocket &gt; 5.5 mm</p>
                                <p class="mb-1">* = Furcation / Mobility</p>
                                <p class="mb-0">X = Edentulous Sextant</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Carrier Risk</label>
                    @foreach (var risk in DentalExamPsr.CarrierRiskOptions)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input"
                                   type="radio"
                                   name="PsrCarrierRisk"
                                   id="PsrCarrierRisk_@risk"
                                   value="@risk"
                                   checked="@(string.Equals(exam.PsrCarrierRisk, risk, StringComparison.OrdinalIgnoreCase))"
                                   @psrRequiredAttr />
                            <label class="form-check-label" for="PsrCarrierRisk_@risk">@risk</label>
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <p class="mb-0">
                        <span class="fw-bold">Tobacco:</span>
                        <span id="psrTobaccoDisplay">@tobaccoDisplay</span>
                    </p>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Soft Tissues WNL (Includes oral CA Screening)</label>
                    <div class="form-check">
                        <input class="form-check-input soft-tissues-wnl-radio"
                               type="radio"
                               name="SoftTissuesWnl"
                               id="SoftTissuesWnl_Yes"
                               value="@DentalExamPsr.SoftTissuesWnlYes"
                               checked="@(string.Equals(exam.SoftTissuesWnl, DentalExamPsr.SoftTissuesWnlYes, StringComparison.OrdinalIgnoreCase))"
                               @psrRequiredAttr />
                        <label class="form-check-label" for="SoftTissuesWnl_Yes">@DentalExamPsr.SoftTissuesWnlYes</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input soft-tissues-wnl-radio"
                               type="radio"
                               name="SoftTissuesWnl"
                               id="SoftTissuesWnl_No"
                               value="@DentalExamPsr.SoftTissuesWnlNo"
                               checked="@(string.Equals(exam.SoftTissuesWnl, DentalExamPsr.SoftTissuesWnlNo, StringComparison.OrdinalIgnoreCase))"
                               @psrRequiredAttr />
                        <label class="form-check-label" for="SoftTissuesWnl_No">@DentalExamPsr.SoftTissuesWnlNo</label>
                    </div>
                </div>

                <div id="softTissuesConditionSection" style="@(showSoftTissuesDetail ? "" : "display:none;")">
                    <label class="form-label" for="SoftTissuesConditionDetail">Describe Condition not within normal limits:</label>
                    <textarea name="SoftTissuesConditionDetail"
                              id="SoftTissuesConditionDetail"
                              class="form-control"
                              rows="4"
                              @softTissuesDetailRequiredAttr>@exam.SoftTissuesConditionDetail</textarea>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="psr-xray-preview-card">
                    <p class="fw-semibold mb-2">X-Ray Preview</p>

                    <div class="mb-3">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input psr-xray-type-radio"
                                   type="radio"
                                   name="PsrXrayType"
                                   id="PsrXrayType_BWX"
                                   value="BWX"
                                   @(hasBwxImages ? "" : "disabled") />
                            <label class="form-check-label" for="PsrXrayType_BWX">BWX</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input psr-xray-type-radio"
                                   type="radio"
                                   name="PsrXrayType"
                                   id="PsrXrayType_PA"
                                   value="PA"
                                   @(hasPaImages ? "" : "disabled") />
                            <label class="form-check-label" for="PsrXrayType_PA">PA</label>
                        </div>
                    </div>

                    <div class="mb-3" id="psrXrayBwxSelectWrap" style="display:none;">
                        <label class="form-label" for="psrXrayBwxSelect">Select BWX image</label>
                        <select class="form-select psr-xray-image-select" id="psrXrayBwxSelect">
                            <option value="">-- Select --</option>
                            @foreach (var option in bwxImageOptions)
                            {
                                <option value="@option.FileName"
                                        data-filename="@option.FileName"
                                        data-prefix="@option.DownloadPrefix">@option.Label</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3" id="psrXrayPaSelectWrap" style="display:none;">
                        <label class="form-label" for="psrXrayPaSelect">Select PA image</label>
                        <select class="form-select psr-xray-image-select" id="psrXrayPaSelect">
                            <option value="">-- Select --</option>
                            @for (var i = 0; i < paImageOptions.Count; i++)
                            {
                                var pa = paImageOptions[i];
                                <option value="@pa.FileName"
                                        data-filename="@pa.FileName"
                                        data-prefix="pa_tooth">PA of tooth @(i + 1)</option>
                            }
                        </select>
                    </div>

                    <p class="text-muted small" id="psrXrayEmptyMsg">Select an X-Ray type and image to preview.</p>

                    <div class="psr-xray-preview-panel" id="psrXray_previewSection" style="display:none;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="small text-muted" id="psrXray_fileNameDisplay"></span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="psrXrayPreviewBtn">
                                Preview
                            </button>
                        </div>
                        <div class="psr-xray-preview-viewport xray-preview-viewport" id="psrXray_previewViewport">
                            <img id="psrXray_previewImg" alt="X-Ray preview" />
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2 mb-1">
                            <button type="button" class="btn btn-sm btn-primary xray-zoom-in" data-prefix="psrXray">
                                <i class="bi bi-zoom-in"></i> ZOOM IN
                            </button>
                            <button type="button" class="btn btn-sm btn-primary xray-zoom-out" data-prefix="psrXray">
                                <i class="bi bi-zoom-out"></i> ZOOM OUT
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary xray-zoom-reset" data-prefix="psrXray">
                                <i class="bi bi-arrow-counterclockwise"></i> RESET
                            </button>
                        </div>
                        <p class="mb-0 small">Zoom Level: <span id="psrXray_zoomLevel" class="text-primary fw-semibold">100%</span></p>
                    </div>
                </div>

                <div class="mt-3" id="psrToothChartImageColumn">
                    <div class="border rounded p-3 bg-light d-flex flex-column justify-content-center align-items-center text-center psr-tooth-chart-image-wrap">
                        <img src="~/images/dental-tooth-chart-reference.png"
                             id="psrToothChartReferenceImage"
                             alt="Dental tooth chart reference"
                             class="img-fluid mb-2" />
                        <div class="small text-muted">Universal numbering reference (1-32)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
