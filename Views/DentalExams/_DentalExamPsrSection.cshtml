@using ExcelFilesCompiler.Utilities
@using Malama.Models
@model DentalExam

@{
    var exam = Model ?? new DentalExam();
    var tobaccoDisplay = ViewData["TobaccoDisplay"] as string ?? "No";
    var requirePsrFields = ViewData["RequirePsrFields"] as bool? ?? false;
    var subsequentReadOnly = ViewData["SubsequentReadOnly"] as bool? ?? false;
    var showSoftTissuesDetail = string.Equals(exam.SoftTissuesWnl, DentalExamPsr.SoftTissuesWnlNo, StringComparison.OrdinalIgnoreCase);
    var psrRequiredAttr = requirePsrFields && !subsequentReadOnly ? "required" : "";
    var softTissuesDetailRequiredAttr = requirePsrFields && showSoftTissuesDetail && !subsequentReadOnly ? "required" : "";
    var psrDisabledAttr = subsequentReadOnly ? "disabled" : null;

    var xrayStation = ViewData["XRayStation"] as DentalXRayStation ?? new DentalXRayStation();
}

<div class="mb-4" id="psrSection">
    <div class="questionnaire-heading" id="psrSectionHeading">
        <div class="form-check form-switch questionnaire-toggle-switch mb-0">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="togglePsrSectionSwitch"
                   aria-controls="psrContentSection"
                   aria-expanded="false" />
        </div>
        <h4 class="mb-0" style="color: rgba(80, 90, 201, 1);">Periodontal Screening and Recording (PSR)</h4>
    </div>

    <div id="psrContentSection" style="display:none;">
        <div class="card mb-0">
            <div class="card-body">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="PsrUpperRight">Upper Right</label>
                        <select name="PsrUpperRight" id="PsrUpperRight" class="form-select psr-sextant-select" @psrRequiredAttr @psrDisabledAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrUpperRight == score)">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="PsrUpperAnterior">Upper Anterior</label>
                        <select name="PsrUpperAnterior" id="PsrUpperAnterior" class="form-select psr-sextant-select" @psrRequiredAttr @psrDisabledAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrUpperAnterior == score)">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="PsrUpperLeft">Upper Left</label>
                        <select name="PsrUpperLeft" id="PsrUpperLeft" class="form-select psr-sextant-select" @psrRequiredAttr @psrDisabledAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrUpperLeft == score)">@score</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="PsrLowerRight">Lower Right</label>
                        <select name="PsrLowerRight" id="PsrLowerRight" class="form-select psr-sextant-select" @psrRequiredAttr @psrDisabledAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrLowerRight == score)">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="PsrLowerAnterior">Lower Anterior</label>
                        <select name="PsrLowerAnterior" id="PsrLowerAnterior" class="form-select psr-sextant-select" @psrRequiredAttr @psrDisabledAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrLowerAnterior == score)">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="PsrLowerLeft">Lower Left</label>
                        <select name="PsrLowerLeft" id="PsrLowerLeft" class="form-select psr-sextant-select" @psrRequiredAttr @psrDisabledAttr>
                            <option value=""></option>
                            @foreach (var score in DentalExamPsr.ScoreOptions)
                            {
                                <option value="@score" selected="@(exam.PsrLowerLeft == score)">@score</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <p class="fw-semibold mb-2">Codes:</p>
                    <div class="small">
                        <div class="row">
                            <div class="col-sm-6">
                                <p class="mb-1">0 = Healthy</p>
                                <p class="mb-1">1 = Bleeding</p>
                                <p class="mb-1">2 = Calculus / Defective Margin</p>
                            </div>
                            <div class="col-sm-6">
                                <p class="mb-1">3 = Pocket 3.5 - 5.5 mm</p>
                                <p class="mb-1">4 = Pocket &gt; 5.5 mm</p>
                                <p class="mb-1">* = Furcation / Mobility</p>
                                <p class="mb-0">X = Edentulous Sextant</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Caries Risk</label>
                    @foreach (var risk in DentalExamPsr.CarrierRiskOptions)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input"
                                   type="radio"
                                   name="PsrCarrierRisk"
                                   id="PsrCarrierRisk_@risk"
                                   value="@risk"
                                   checked="@(string.Equals(exam.PsrCarrierRisk, risk, StringComparison.OrdinalIgnoreCase))"
                                   @psrRequiredAttr @psrDisabledAttr />
                            <label class="form-check-label" for="PsrCarrierRisk_@risk">@risk</label>
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <p class="mb-0">
                        <span class="fw-bold">Tobacco:</span>
                        <span id="psrTobaccoDisplay">@tobaccoDisplay</span>
                    </p>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Soft Tissues WNL (Includes oral CA Screening)</label>
                    <div class="form-check">
                        <input class="form-check-input soft-tissues-wnl-radio"
                               type="radio"
                               name="SoftTissuesWnl"
                               id="SoftTissuesWnl_Yes"
                               value="@DentalExamPsr.SoftTissuesWnlYes"
                               checked="@(string.Equals(exam.SoftTissuesWnl, DentalExamPsr.SoftTissuesWnlYes, StringComparison.OrdinalIgnoreCase))"
                               @psrRequiredAttr @psrDisabledAttr />
                        <label class="form-check-label" for="SoftTissuesWnl_Yes">@DentalExamPsr.SoftTissuesWnlYes</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input soft-tissues-wnl-radio"
                               type="radio"
                               name="SoftTissuesWnl"
                               id="SoftTissuesWnl_No"
                               value="@DentalExamPsr.SoftTissuesWnlNo"
                               checked="@(string.Equals(exam.SoftTissuesWnl, DentalExamPsr.SoftTissuesWnlNo, StringComparison.OrdinalIgnoreCase))"
                               @psrRequiredAttr @psrDisabledAttr />
                        <label class="form-check-label" for="SoftTissuesWnl_No">@DentalExamPsr.SoftTissuesWnlNo</label>
                    </div>
                </div>

                <div id="softTissuesConditionSection" style="@(showSoftTissuesDetail ? "" : "display:none;")">
                    <label class="form-label" for="SoftTissuesConditionDetail">Describe Condition not within normal limits:</label>
                    <textarea name="SoftTissuesConditionDetail"
                              id="SoftTissuesConditionDetail"
                              class="form-control @(subsequentReadOnly ? "read-only-style" : null)"
                              rows="4"
                              @(subsequentReadOnly ? "readonly" : null)
                              @softTissuesDetailRequiredAttr>@exam.SoftTissuesConditionDetail</textarea>
                </div>
            </div>

            <div class="col-lg-6">
                @await Html.PartialAsync("~/Views/DentalExams/_DentalExamXrayPreview.cshtml", xrayStation, new ViewDataDictionary(ViewData) { ["Prefix"] = "psrXray" })

                <div class="mt-3" id="psrToothChartImageColumn">
                    <div class="border rounded p-3 bg-white psr-tooth-chart-image-wrap">
                        @await Html.PartialAsync("~/Views/DentalExams/_DentalExamToothChart.cshtml", exam)
                    </div>
                </div>
            </div>
        </div>
            </div>
        </div>

        <div class="d-flex justify-content-center mt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm section-collapse-btn"
                    data-target-switch="togglePsrSectionSwitch"
                    data-target-heading="psrSectionHeading">
                <i class="fas fa-chevron-up"></i> Collapse Periodontal Screening and Recording (PSR)
            </button>
        </div>
    </div>
</div>
