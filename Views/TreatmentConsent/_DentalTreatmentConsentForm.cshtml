@* Dental Treatment Consent form — staff text fields + SM signature pens. *@
@{
    var patientName = ViewData["PatientFullName"] as string ?? "";
    var patientDob = ViewData["PatientDob"] as string ?? "";
    var dentistName = ViewData["DentalTreatmentDentistName"] as string ?? "";
    var dentistDisplay = string.IsNullOrWhiteSpace(dentistName) ? "____________________" : dentistName;
}

<div class="tcn-consent-form" id="dentalTreatmentConsentForm">
    <h3 class="tcn-consent-form-title">CONSENT FOR DENTAL TREATMENT</h3>

    <div class="tcn-consent-identity-line">
        <span class="tcn-consent-identity-label">Patient’s Name</span>
        <span class="tcn-consent-identity-blank">@patientName</span>
        <span class="tcn-consent-identity-label">Birth Date</span>
        <span class="tcn-consent-identity-blank tcn-consent-identity-blank-dob">@patientDob</span>
    </div>

    <p class="tcn-consent-intro">
        Please read and initial the items checked below. Then read and sign the section at the bottom of the form.
    </p>

    <div class="tcn-consent-item">
        <div class="tcn-consent-item-head">
            <label class="tcn-item-check">
                <input type="checkbox" name="dtc_item1_mark" value="true" aria-label="Select item 1" />
            </label>
            <h4>1. TREATMENT TO BE PERFORMED</h4>
        </div>
        <p>I understand that I am having the following work done:</p>
        <div class="tcn-treatment-checks">
            <label class="tcn-treatment-check">
                <input type="checkbox" name="dtc_fillings" value="true" />
                <span>Fillings</span>
            </label>
            <label class="tcn-treatment-check">
                <input type="checkbox" name="dtc_crowns" value="true" />
                <span>Stainless Steel Crowns</span>
            </label>
            <label class="tcn-treatment-check">
                <input type="checkbox" name="dtc_extractions" value="true" />
                <span>Extracted</span>
            </label>
            <label class="tcn-treatment-check">
                <input type="checkbox" name="dtc_impacted" value="true" />
                <span>Impacted Teeth Removed</span>
            </label>
            <label class="tcn-treatment-check">
                <input type="checkbox" name="dtc_root_canal" value="true" />
                <span>Root Canal(s)</span>
            </label>
            <label class="tcn-treatment-check">
                <input type="checkbox" name="dtc_fmd" value="true" />
                <span>FMD</span>
            </label>
            <label class="tcn-treatment-check">
                <input type="checkbox" name="dtc_other_treatment" id="dtcOtherTreatmentCheck" value="true" />
                <span>Other</span>
            </label>
        </div>
        <div class="tcn-other-treatment-detail" id="dtcOtherTreatmentDetail" hidden>
            <label class="tcn-consent-label" for="dtcOtherTreatmentText">Other treatment</label>
            <textarea id="dtcOtherTreatmentText"
                      name="dtc_other_treatment_text"
                      class="form-control tcn-other-treatment-text"
                      rows="3"
                      placeholder="Describe other treatment"></textarea>
        </div>
        <div class="tcn-initials-row">
            <span>(Initials</span>
            <input type="text"
                   id="dtcItem1Initials"
                   name="dtc_item1_initials"
                   class="form-control tcn-initials-input"
                   maxlength="2"
                   autocomplete="off"
                   aria-label="Item 1 initials" />
            <span>)</span>
        </div>
    </div>

    <div class="tcn-consent-item">
        <div class="tcn-consent-item-head">
            <label class="tcn-item-check">
                <input type="checkbox" name="dtc_item2_mark" value="true" aria-label="Select item 2" />
            </label>
            <h4>2. DRUGS AND MEDICATION</h4>
        </div>
        <p>
            I understand that antibiotics and analgesics and other medications can cause allergic reactions causing redness and swelling
            of tissues, pain, itching, vomiting, and/or anaphylactic shock (severe allergic reaction).
        </p>
        <div class="tcn-initials-row">
            <span>(Initials</span>
            <input type="text"
                   id="dtcItem2Initials"
                   name="dtc_item2_initials"
                   class="form-control tcn-initials-input"
                   maxlength="2"
                   autocomplete="off"
                   aria-label="Item 2 initials" />
            <span>)</span>
        </div>
    </div>

    <div class="tcn-consent-item">
        <div class="tcn-consent-item-head">
            <label class="tcn-item-check">
                <input type="checkbox" name="dtc_item3_mark" value="true" aria-label="Select item 3" />
            </label>
            <h4>3. REMOVAL OF TEETH</h4>
        </div>
        <p>
            Alternatives to removal have been explained to me (root canal therapy, crowns, periodontal surgery, etc.) and I authorize
            Dr. <strong id="dtcRemovalDoctorText" class="tcn-consent-autofill-value">@dentistDisplay</strong>
        </p>
        <p class="mt-2 mb-1">to remove the following teeth:</p>
        <div class="mb-2">
            <input type="text"
                   id="dtcRemovalTeethText"
                   name="dtc_removal_teeth"
                   class="form-control tcn-teeth-digits-input"
                   inputmode="numeric"
                   maxlength="2"
                   autocomplete="off"
                   placeholder="00"
                   aria-label="Teeth to remove" />
        </div>
        <p class="mt-2">
            I understand removing teeth does not always remove all the infection, if present, and it may be necessary to have further treatment.
            I understand the risks involved in having teeth removed, some of which are pain, swelling, spread of infection, dry socket,
            fractured jaw, loss of feeling in my teeth, lips, tongue, and surrounding tissue (paresthesia). Paresthesia can last for an
            indefinite period of time (days or months). I understand I may need further treatment by a specialist or even hospitalization if
            complications arise during or following treatment, the cost of which is my responsibility. I also understand that tooth replacements
            may not be covered by the program and are my responsibility.
        </p>
        <div class="tcn-initials-row">
            <span>(Initials</span>
            <input type="text"
                   id="dtcItem3Initials"
                   name="dtc_item3_initials"
                   class="form-control tcn-initials-input"
                   maxlength="2"
                   autocomplete="off"
                   aria-label="Item 3 initials" />
            <span>)</span>
        </div>
    </div>

    <div class="tcn-consent-item">
        <div class="tcn-consent-item-head">
            <label class="tcn-item-check">
                <input type="checkbox" name="dtc_item4_mark" value="true" aria-label="Select item 4" />
            </label>
            <h4>4. ENDODONTIC TREATMENT</h4>
        </div>
        <p>
            I realize there is no guarantee that the root canal treatment will save my tooth, that complications can occur from the
            treatment, and occasionally metal objects are cemented in the tooth or extended through the root, which does not
            necessarily affect the success of the treatment. I understand that occasionally additional surgical procedures may be
            necessary following root canal treatment (apicoectomy).
        </p>
        <div class="tcn-initials-row">
            <span>(Initials</span>
            <input type="text"
                   id="dtcItem4Initials"
                   name="dtc_item4_initials"
                   class="form-control tcn-initials-input"
                   maxlength="2"
                   autocomplete="off"
                   aria-label="Item 4 initials" />
            <span>)</span>
        </div>
    </div>

    <div class="tcn-consent-item">
        <div class="tcn-consent-item-head">
            <label class="tcn-item-check">
                <input type="checkbox" name="dtc_item5_mark" value="true" aria-label="Select item 5" />
            </label>
            <h4>5. SECTIONING OF BRIDGE/REMOVAL OF CROWN</h4>
        </div>
        <p>
            I understand that if a bridge must be sectioned (cut in half) or a crown removed in order to complete my treatment this does
            not obligate DAWSON to provide a new crown or bridge.
        </p>
        <div class="tcn-initials-row">
            <span>(Initials</span>
            <input type="text"
                   id="dtcItem5Initials"
                   name="dtc_item5_initials"
                   class="form-control tcn-initials-input"
                   maxlength="2"
                   autocomplete="off"
                   aria-label="Item 5 initials" />
            <span>)</span>
        </div>
    </div>

    <div class="tcn-consent-item">
        <div class="tcn-consent-item-head">
            <label class="tcn-item-check">
                <input type="checkbox" name="dtc_item6_mark" value="true" aria-label="Select item 6" />
            </label>
            <h4>6. OTHER</h4>
        </div>
        <p>Please describe any situation not listed above that requires consent.</p>
        <div class="mb-2">
            <textarea id="dtcOtherSituationText"
                      name="dtc_other_situation"
                      class="form-control tcn-dtc-other-situation-text"
                      rows="4"
                      placeholder="Describe other situation requiring consent"></textarea>
        </div>
        <div class="tcn-initials-row">
            <span>(Initials</span>
            <input type="text"
                   id="dtcItem6Initials"
                   name="dtc_item6_initials"
                   class="form-control tcn-initials-input"
                   maxlength="2"
                   autocomplete="off"
                   aria-label="Item 6 initials" />
            <span>)</span>
        </div>
    </div>

    <div class="tcn-consent-closing">
        <p>
            I understand that during treatment it may be necessary to change or add procedures because of conditions found while working on
            teeth that were not discovered during the examination, the most common being root canal therapy following routine restorative
            procedures. I also understand that dentistry is not an exact science and that, therefore, reputable practitioners cannot guarantee
            results. I acknowledge that no guarantee or assurance has been made to me by anyone regarding dental treatment that I have
            requested and authorized for myself. I have had full opportunity to discuss and ask questions regarding the dental treatment, and
            questions have been answered to my satisfaction.
        </p>
        <p class="tcn-consent-emergency">
            In the event of an emergency, contact your State Dental Case Manager and/or dial 911
        </p>
    </div>

    <div class="tcn-signature-grid">
        <div class="tcn-signature-block">
            <label class="tcn-consent-label tcn-consent-label-signature-long">Signature of Patient, Parent, Guardian, or Personal Representative</label>
            <div class="tcn-pen-pad tcn-pen-pad-signature" data-pen-pad="dtc_patient_signature" data-pen-size="signature">
                <canvas aria-label="Patient signature"></canvas>
                <button type="button" class="tcn-pen-clear" data-pen-clear>Clear</button>
            </div>
            <label class="tcn-consent-label mt-2">Date</label>
            <input type="text"
                   class="form-control tcn-readonly-input"
                   value="@ViewData["ConsentDate"]"
                   readonly
                   tabindex="-1" />
        </div>
        <div class="tcn-signature-block">
            <label class="tcn-consent-label">Signature of DDS</label>
            <div class="tcn-pen-pad tcn-pen-pad-signature" data-pen-pad="dtc_dds_signature" data-pen-size="signature">
                <canvas aria-label="DDS signature"></canvas>
                <button type="button" class="tcn-pen-clear" data-pen-clear>Clear</button>
            </div>
            <label class="tcn-consent-label mt-2">Date</label>
            <input type="text"
                   class="form-control tcn-readonly-input"
                   value="@ViewData["ConsentDate"]"
                   readonly
                   tabindex="-1" />
        </div>
    </div>
</div>
