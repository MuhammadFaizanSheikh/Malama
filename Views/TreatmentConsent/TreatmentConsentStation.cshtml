@using ExcelFilesCompiler.Controllers.Services
@using ExcelFilesCompiler.Utilities
@using Malama.Models
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model Malama.Models.TreatmentConsentStationViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Treatment Consent";
    var sm = Model.ServiceMember;
    var questionnaire = Model.Questionnaire;
    var isFemale = DentalXRayStationService.IsFemale(sm);
    var consentDateDisplay = DateTime.Now.ToString("MM/dd/yyyy");
    var isSmMode = ViewBag.IsTreatmentConsentSmMode as bool? == true;
}

<style>
    .tcn-station {
        --tcn-indigo: rgba(80, 90, 201, 1);
        --tcn-indigo-soft: rgba(80, 90, 201, 0.12);
        --tcn-text: #1f2430;
        --tcn-muted: #6b7285;
        --tcn-surface: #ffffff;
        --tcn-border: rgba(31, 36, 48, 0.08);
        --tcn-shadow: 0 10px 28px rgba(21, 24, 33, 0.06);
        --tcn-radius: 16px;
    }

    .tcn-station .tcn-title {
        margin: 0 0 1.1rem;
        font-size: clamp(1.45rem, 2vw, 1.85rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--tcn-text);
    }

    .tcn-station .tcn-panel {
        background: var(--tcn-surface);
        border: 1px solid var(--tcn-border);
        border-radius: var(--tcn-radius);
        box-shadow: var(--tcn-shadow);
        padding: 1.15rem 1.25rem 1.25rem;
        margin-bottom: 1.15rem;
    }

    .tcn-station .tcn-panel-title {
        margin: 0 0 0.95rem;
        font-size: 1rem;
        font-weight: 700;
        color: var(--tcn-text);
    }

    .tcn-station .tcn-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem 1.25rem;
    }

    .tcn-station .tcn-info-label {
        display: block;
        margin-bottom: 0.2rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--tcn-muted);
    }

    .tcn-station .tcn-info-value {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--tcn-text);
        word-break: break-word;
    }

    .tcn-station .nav-tabs {
        border-bottom: 1px solid rgba(80, 90, 201, 0.25);
        gap: 0.35rem;
    }

    .tcn-station .nav-tabs .nav-link {
        border: 1px solid transparent;
        border-radius: 10px 10px 0 0;
        color: var(--tcn-muted);
        font-weight: 600;
        padding: 0.7rem 1rem;
    }

    .tcn-station .nav-tabs .nav-link:hover {
        border-color: rgba(80, 90, 201, 0.18);
        color: var(--tcn-indigo);
    }

    .tcn-station .nav-tabs .nav-link.active {
        background: var(--tcn-indigo-soft);
        border-color: rgba(80, 90, 201, 0.28) rgba(80, 90, 201, 0.28) transparent;
        color: var(--tcn-indigo);
    }

    .tcn-station .tab-content {
        border: 1px solid var(--tcn-border);
        border-top: none;
        border-radius: 0 0 var(--tcn-radius) var(--tcn-radius);
        background: #fff;
        padding: 1.15rem 1.2rem 1.35rem;
        min-height: 220px;
    }

    .tcn-station .tcn-empty-tab {
        min-height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--tcn-muted);
        font-size: 0.95rem;
    }

    .tcn-station .questionnaire-heading {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .tcn-station .questionnaire-heading h3 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--tcn-text);
    }

    .tcn-station .questionnaire-toggle-switch .form-check-input {
        width: 2.4rem;
        height: 1.25rem;
        cursor: pointer;
    }

    .tcn-station .questionnaire-toggle-switch .form-check-input:checked {
        background-color: var(--tcn-indigo);
        border-color: var(--tcn-indigo);
    }

    .tcn-station .condition-detail {
        display: none;
    }

    .tcn-station .tcn-notice {
        color: #b45309;
        font-weight: 700;
        margin-bottom: 0.65rem;
    }

    .tcn-station .tcn-consent-form {
        color: var(--tcn-text);
        line-height: 1.55;
    }

    .tcn-station .tcn-consent-form-title {
        margin: 0 0 1rem;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-align: center;
        color: var(--tcn-text);
    }

    .tcn-station .tcn-consent-intro,
    .tcn-station .tcn-consent-item p,
    .tcn-station .tcn-consent-closing p,
    .tcn-station .tcn-consent-auth p,
    .tcn-station .tcn-consent-section li {
        font-size: 0.95rem;
        color: #2a3140;
    }

    .tcn-station .tcn-consent-item,
    .tcn-station .tcn-consent-section,
    .tcn-station .tcn-consent-auth {
        margin-bottom: 1.15rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid rgba(31, 36, 48, 0.08);
    }

    .tcn-station .tcn-consent-item-head {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 0.55rem;
    }

    .tcn-station .tcn-item-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        margin: 0;
        cursor: pointer;
    }

    .tcn-station .tcn-item-check input[type="checkbox"] {
        width: 1.45rem;
        height: 1.45rem;
        margin: 0;
        accent-color: rgba(80, 90, 201, 1);
        cursor: pointer;
    }

    .tcn-station .tcn-treatment-checks {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem 1.1rem;
        margin: 0.35rem 0 0.65rem;
    }

    .tcn-station .tcn-treatment-check {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin: 0;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
    }

    .tcn-station .tcn-treatment-check input[type="checkbox"] {
        width: 1.2rem;
        height: 1.2rem;
        margin: 0;
        accent-color: rgba(80, 90, 201, 1);
        cursor: pointer;
        flex: 0 0 auto;
    }

    .tcn-station .tcn-other-treatment-detail {
        margin: 0 0 0.75rem;
    }

    .tcn-station .tcn-other-treatment-text {
        min-height: 5.5rem;
        resize: vertical;
    }

    .tcn-station.tcn-fields-locked .tcn-item-check,
    .tcn-station.tcn-fields-locked .tcn-treatment-check {
        cursor: not-allowed;
        opacity: 0.85;
    }

    .tcn-station .tcn-consent-item-head h4,
    .tcn-station .tcn-consent-section h4 {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 800;
        letter-spacing: 0.01em;
    }

    .tcn-station .tcn-consent-label {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--tcn-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .tcn-station .tcn-consent-label-signature-long {
        white-space: nowrap;
        width: max-content;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tcn-station .tcn-signature-block:has(.tcn-consent-label-signature-long) {
        max-width: none;
    }

    .tcn-station .tcn-consent-row-split {
        display: grid;
        grid-template-columns: minmax(180px, 320px) minmax(140px, 220px);
        gap: 1rem;
        margin-bottom: 1rem;
        align-items: end;
        justify-content: start;
    }

    .tcn-station .tcn-consent-field-name .tcn-pen-pad-line {
        height: 48px;
        max-width: 320px;
    }

    .tcn-station .tcn-readonly-input {
        min-height: 48px;
        background: #f3f4f8;
        border-radius: 10px;
        font-weight: 600;
    }

    .tcn-station .tcn-consent-autofill-value {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--tcn-text);
        word-break: break-word;
    }

    .tcn-station .tcn-consent-identity-line {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.45rem 0.65rem;
        margin-bottom: 1rem;
        font-size: 0.98rem;
        color: #2a3140;
    }

    .tcn-station .tcn-consent-identity-label {
        font-weight: 700;
        white-space: nowrap;
    }

    .tcn-station .tcn-consent-identity-blank {
        flex: 0 1 240px;
        min-width: 140px;
        max-width: 240px;
        border-bottom: 1.5px solid #1f2430;
        padding: 0 0.35rem 0.15rem;
        font-weight: 700;
        color: var(--tcn-text);
        word-break: break-word;
    }

    .tcn-station .tcn-consent-identity-blank-dob {
        flex: 0 1 140px;
        min-width: 110px;
        max-width: 140px;
    }

    .tcn-station .tcn-consent-treatment-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin: 0.75rem 0 0.35rem;
    }

    .tcn-station .tcn-consent-inline-blanks {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem 0.85rem;
        margin: 0.55rem 0 0.35rem;
        line-height: 1.7;
        font-size: 0.95rem;
        color: #2a3140;
    }

    .tcn-station .tcn-inline-blank-pair {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        white-space: nowrap;
    }

    .tcn-station .tcn-inline-blank-pair-other {
        flex: 1 1 180px;
        min-width: 140px;
    }

    .tcn-station .tcn-pen-pad-underline {
        position: relative;
        display: inline-block;
        width: 72px;
        height: 28px;
        vertical-align: middle;
        border: none;
        border-bottom: 1.5px solid #1f2430;
        border-radius: 0;
        background: transparent;
        overflow: visible;
    }

    .tcn-station .tcn-pen-pad-underline canvas {
        background: transparent;
    }

    .tcn-station .tcn-pen-pad-underline-wide {
        width: 140px;
        flex: 1 1 auto;
        min-width: 100px;
    }

    .tcn-station .tcn-pen-pad-underline .tcn-pen-clear {
        top: -2px;
        right: -2px;
        padding: 0.18rem 0.35rem;
        font-size: 0.58rem;
        opacity: 0.75;
    }

    .tcn-station .tcn-treatment-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.65rem;
        font-weight: 600;
    }

    .tcn-station .tcn-treatment-option-wide .tcn-pen-pad-line {
        flex: 1 1 auto;
        width: auto;
        min-width: 160px;
    }

    .tcn-station .tcn-initials-row {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 0.65rem;
        font-weight: 600;
    }

    .tcn-station .tcn-consent-letter-list {
        margin: 0.35rem 0 0 1.1rem;
        padding: 0;
    }

    .tcn-station .tcn-consent-letter-list li {
        margin-bottom: 0.4rem;
    }

    .tcn-station .tcn-consent-emergency {
        font-weight: 700;
        color: #b45309;
    }

    .tcn-station .tcn-signature-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 1rem;
        justify-items: start;
    }

    .tcn-station .tcn-signature-block {
        width: 100%;
        max-width: 280px;
    }

    .tcn-station .tcn-pen-pad-signature {
        width: 100%;
        max-width: 280px;
        height: 72px;
    }

    .tcn-station .tcn-pen-pad {
        position: relative;
        background: #fff;
        border: 1.5px dashed rgba(80, 90, 201, 0.45);
        border-radius: 10px;
        overflow: hidden;
        touch-action: none;
    }

    .tcn-station .tcn-pen-pad canvas {
        display: block;
        width: 100%;
        height: 100%;
        cursor: crosshair;
        touch-action: none;
        background: linear-gradient(180deg, rgba(80, 90, 201, 0.03), rgba(255, 255, 255, 0.9));
    }

    .tcn-station .tcn-pen-pad-line { height: 56px; }
    .tcn-station .tcn-pen-pad-teeth-numbers {
        width: 280px;
        max-width: 100%;
        height: 44px;
        margin-bottom: 0.35rem;
    }
    .tcn-station .tcn-pen-pad-doctor-names {
        width: 320px;
        max-width: 100%;
        height: 44px;
        margin-bottom: 0.35rem;
    }
    .tcn-station .tcn-pen-pad-check,
    .tcn-station .tcn-pen-pad-mini { width: 88px; height: 44px; flex: 0 0 auto; }
    .tcn-station .tcn-pen-pad-initials {
        width: 160px;
        height: 72px;
        flex: 0 0 auto;
    }
    .tcn-station .tcn-pen-pad-block { height: 110px; }
    .tcn-station .tcn-pen-pad-signature { height: 72px; max-width: 280px; }

    .tcn-station .tcn-pen-clear {
        position: absolute;
        top: 4px;
        right: 4px;
        z-index: 2;
        border: none;
        border-radius: 999px;
        background: rgba(31, 36, 48, 0.78);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 700;
        line-height: 1;
        padding: 0.28rem 0.5rem;
    }

    .tcn-station .tcn-pen-clear:hover {
        background: rgba(31, 36, 48, 0.92);
    }

    .tcn-station .tcn-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .tcn-station .tcn-title {
        margin-bottom: 0;
    }

    .tcn-station .tcn-toolbar-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
    }

    .tcn-station .btn-tcn-start,
    .tcn-station .btn-tcn-unlock {
        border-radius: 10px;
        font-weight: 700;
        padding: 0.55rem 1.05rem;
        border: 1px solid transparent;
    }

    .tcn-station .btn-tcn-start {
        background: var(--tcn-indigo);
        border-color: var(--tcn-indigo);
        color: #fff;
    }

    .tcn-station .btn-tcn-start:hover {
        background: rgb(60, 70, 180);
        color: #fff;
    }

    .tcn-station .btn-tcn-unlock {
        background: #fff;
        border-color: rgba(180, 83, 9, 0.45);
        color: #b45309;
    }

    .tcn-station .btn-tcn-unlock:hover {
        background: rgba(180, 83, 9, 0.08);
        color: #b45309;
    }

    .tcn-station.tcn-fields-locked .tab-content input,
    .tcn-station.tcn-fields-locked .tab-content select,
    .tcn-station.tcn-fields-locked .tab-content textarea,
    .tcn-station.tcn-fields-locked .tab-content button[data-pen-clear] {
        pointer-events: none;
        cursor: not-allowed;
    }

    .tcn-station.tcn-fields-locked .tab-content input,
    .tcn-station.tcn-fields-locked .tab-content select,
    .tcn-station.tcn-fields-locked .tab-content textarea {
        background-color: #f3f4f8 !important;
        opacity: 0.92;
    }

    .tcn-station.tcn-fields-locked .tcn-pen-pad,
    .tcn-station .tcn-pen-pad.is-disabled {
        opacity: 0.72;
        background: #f7f8fb;
    }

    .tcn-station.tcn-fields-locked .tcn-pen-pad canvas,
    .tcn-station .tcn-pen-pad.is-disabled canvas {
        cursor: not-allowed !important;
        pointer-events: none !important;
    }

    .tcn-station.tcn-fields-locked .tcn-pen-clear,
    .tcn-station .tcn-pen-pad.is-disabled .tcn-pen-clear {
        display: none;
    }

    @@media (max-width: 900px) {
        .tcn-station .tcn-info-grid,
        .tcn-station .tcn-consent-row-split,
        .tcn-station .tcn-signature-grid,
        .tcn-station .tcn-consent-treatment-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="tcn-station @(isSmMode ? "" : "tcn-fields-locked")" data-sm-mode="@(isSmMode ? "true" : "false")" data-sm-id="@sm.Id">
    @Html.AntiForgeryToken()

    <div class="tcn-toolbar">
        <h1 class="tcn-title">Treatment Consent</h1>
        <div class="tcn-toolbar-actions">
            <button type="button" id="tcnStaffUnlockBtn" class="btn btn-tcn-unlock" style="@(isSmMode ? null : "display:none")">
                <i class="fas fa-lock-open" aria-hidden="true"></i> Staff Unlock
            </button>
            <button type="button" id="tcnStartSmModeBtn" class="btn btn-tcn-start" style="@(isSmMode ? "display:none" : null)">
                <i class="fas fa-play" aria-hidden="true"></i> Start
            </button>
        </div>
    </div>

    @if (TempData["ResponseMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
                var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

                Swal.fire({
                    icon: '@TempData["ResponseStatus"]',
                    title: '@TempData["ResponseTitle"]',
                    text: '@TempData["ResponseMessage"]',
                    confirmButtonText: 'OK',
                    confirmButtonColor: buttonColor,
                    iconColor: iconColor
                });
            });
        </script>
    }

    <div class="tcn-panel">
        <h2 class="tcn-panel-title"><i class="fas fa-user" aria-hidden="true"></i> Personal Information</h2>
        <div class="tcn-info-grid">
            <div>
                <span class="tcn-info-label">Full Name</span>
                <p class="tcn-info-value">@sm?.FullName</p>
            </div>
            <div>
                <span class="tcn-info-label">DOB</span>
                <p class="tcn-info-value">@sm?.Dob</p>
            </div>
            <div>
                <span class="tcn-info-label">Barcode</span>
                <p class="tcn-info-value">@sm?.Barcode</p>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs" id="treatmentConsentTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="da5570-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#da5570Pane"
                    type="button"
                    role="tab"
                    aria-controls="da5570Pane"
                    aria-selected="true">
                DA5570 Form
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="oralSurgery-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#oralSurgeryPane"
                    type="button"
                    role="tab"
                    aria-controls="oralSurgeryPane"
                    aria-selected="false">
                Oral Surgery Form
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="dentalTreatmentConsent-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#dentalTreatmentConsentPane"
                    type="button"
                    role="tab"
                    aria-controls="dentalTreatmentConsentPane"
                    aria-selected="false">
                Dental Treatment Consent
            </button>
        </li>
    </ul>

    <div class="tab-content" id="treatmentConsentTabContent">
        <div class="tab-pane fade show active" id="da5570Pane" role="tabpanel" aria-labelledby="da5570-tab">
            <h3 class="mb-3">Questionnaire</h3>

            <div id="da5570QuestionnaireSection">
                @await Html.PartialAsync("~/Views/DentalXRay/_DentalXRayQuestionnaire.cshtml", questionnaire)

                @if (isFemale)
                {
                    <div class="row mb-3" id="pregnancyQuestionSection">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">12. Are you pregnant?</label>
                            <select name="AreYouPregnant" id="AreYouPregnant" class="form-select">
                                <option value="No" selected="@(string.IsNullOrWhiteSpace(questionnaire.AreYouPregnant) || questionnaire.AreYouPregnant == "No")">No</option>
                                <option value="Yes" selected="@(questionnaire.AreYouPregnant == "Yes")">Yes</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-4" id="pregnancyApprovalSection" style="display:none;">
                        <div class="col-md-12">
                            <p class="tcn-notice">Approval is needed from Service Member before going to X-Ray</p>
                            <select name="PregnancyApproval" id="PregnancyApproval" class="form-select">
                                <option value=""></option>
                                <option value="Approved" selected="@(questionnaire.PregnancyApproval == "Approved")">Approved</option>
                                <option value="Declined" selected="@(questionnaire.PregnancyApproval == "Declined")">Declined</option>
                            </select>
                        </div>
                    </div>
                }

                @{
                    var healthConditionsQuestionNumber = isFemale ? 13 : 12;
                    var savedHealthConditions = DentalQuestionnaireService.ParseHealthConditionsJson(questionnaire.ApplicableHealthConditionsJson);
                    var savedByCondition = savedHealthConditions
                        .Where(h => !string.IsNullOrWhiteSpace(h.Condition))
                        .ToDictionary(h => h.Condition, h => h, StringComparer.OrdinalIgnoreCase);

                    bool IsConditionSelected(string condition) => savedByCondition.ContainsKey(condition);
                    string GetConditionDetail(string condition) =>
                        savedByCondition.TryGetValue(condition, out var item) ? item.Detail ?? "" : "";
                }
                <div class="mb-2">
                    <label class="form-label fw-semibold">@healthConditionsQuestionNumber. Check the following conditions if they apply to you:</label>
                    <div class="row condition-checkboxes">
                        @for (var ci = 0; ci < DentalXRayQuestionnaire.HealthConditions.Length; ci++)
                        {
                            var condition = DentalXRayQuestionnaire.HealthConditions[ci];
                            var isSelected = IsConditionSelected(condition);
                            var detail = GetConditionDetail(condition);
                            <div class="col-md-6 condition-item">
                                <input type="hidden" name="HealthConditionDetails[@ci].Condition" value="@condition" />
                                <div class="form-check">
                                    <input class="form-check-input condition-checkbox" type="checkbox"
                                           name="ApplicableHealthConditions"
                                           value="@condition"
                                           id="condition_@ci"
                                           checked="@isSelected" />
                                    <label class="form-check-label" for="condition_@ci">@condition</label>
                                </div>
                                <div class="condition-detail ms-4 mt-1">
                                    <textarea name="HealthConditionDetails[@ci].Detail"
                                              class="form-control condition-detail-text"
                                              rows="3"
                                              placeholder="Please provide details">@detail</textarea>
                                </div>
                            </div>
                        }
                        @{
                            var otherIndex = DentalXRayQuestionnaire.HealthConditions.Length;
                            var otherCondition = DentalXRayQuestionnaire.OtherHealthCondition;
                            var otherSelected = IsConditionSelected(otherCondition);
                            var otherDetail = GetConditionDetail(otherCondition);
                        }
                        <div class="col-md-6 condition-item">
                            <input type="hidden" name="HealthConditionDetails[@otherIndex].Condition" value="@otherCondition" />
                            <div class="form-check">
                                <input class="form-check-input condition-checkbox" type="checkbox"
                                       name="ApplicableHealthConditions"
                                       value="@otherCondition"
                                       id="condition_other"
                                       checked="@otherSelected" />
                                <label class="form-check-label" for="condition_other">@otherCondition</label>
                            </div>
                            <div class="condition-detail ms-4 mt-1">
                                <textarea name="HealthConditionDetails[@otherIndex].Detail"
                                          class="form-control condition-detail-text"
                                          rows="3"
                                          placeholder="Please provide details">@otherDetail</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="oralSurgeryPane" role="tabpanel" aria-labelledby="oralSurgery-tab">
            @{
                var oralSurgeryViewData = new ViewDataDictionary(ViewData);
                oralSurgeryViewData["ConsentDate"] = consentDateDisplay;
            }
            @await Html.PartialAsync(
                "~/Views/TreatmentConsent/_OralSurgeryConsentForm.cshtml",
                null,
                oralSurgeryViewData)
        </div>

        <div class="tab-pane fade" id="dentalTreatmentConsentPane" role="tabpanel" aria-labelledby="dentalTreatmentConsent-tab">
            @{
                var treatmentConsentViewData = new ViewDataDictionary(ViewData);
                treatmentConsentViewData["PatientFullName"] = sm?.FullName ?? string.Empty;
                treatmentConsentViewData["PatientDob"] = sm?.Dob ?? string.Empty;
                treatmentConsentViewData["ConsentDate"] = consentDateDisplay;
            }
            @await Html.PartialAsync(
                "~/Views/TreatmentConsent/_DentalTreatmentConsentForm.cshtml",
                null,
                treatmentConsentViewData)
        </div>
    </div>
</section>

<script src="~/js/treatment-consent-pen-pads.js" asp-append-version="true"></script>
<script>
    const IS_FEMALE = @Json.Serialize(isFemale);

    function toggleQuestionnaireDetail(selectEl) {
        const $select = $(selectEl);
        const target = $select.data("detail");
        if (!target) return;
        const $detail = $(target);
        const $textarea = $detail.find("textarea");
        if ($select.val() === "Yes") {
            $detail.show();
            $textarea.prop("required", true);
        } else {
            $detail.hide();
            $textarea.prop("required", false).val("");
        }
    }

    function toggleTobaccoSection() {
        const isYes = $("#UseTobaccoOrVape").val() === "Yes";
        const $section = $("#tobaccoDetailsSection");
        $section.toggle(isYes);
        $section.find(".tobacco-used-select").prop("required", isYes);
        if (!isYes) {
            $section.find(".tobacco-used-select").val("No");
            $section.find(".tobacco-type-detail").hide();
            $section.find(".tobacco-frequency-input").prop("required", false).val("");
        } else {
            $(".tobacco-used-select").each(function () {
                toggleTobaccoTypeDetail(this);
            });
        }
    }

    function toggleTobaccoTypeDetail(selectEl) {
        const $select = $(selectEl);
        const index = $select.data("index");
        const $detail = $("#tobaccoTypeDetail_" + index);
        const $inputs = $detail.find(".tobacco-frequency-input");
        if ($("#UseTobaccoOrVape").val() !== "Yes") {
            $detail.hide();
            $inputs.prop("required", false);
            return;
        }
        if ($select.val() === "Yes") {
            $detail.show();
            $inputs.prop("required", true);
        } else {
            $detail.hide();
            $inputs.prop("required", false).val("");
        }
    }

    function toggleConditionDetail(checkboxEl) {
        const $item = $(checkboxEl).closest(".condition-item");
        const $detail = $item.find(".condition-detail");
        const $textarea = $detail.find("textarea");
        if ($(checkboxEl).is(":checked")) {
            $detail.show();
        } else {
            $detail.hide();
            $textarea.val("");
        }
    }

    function initConditionToggles() {
        $(".condition-checkbox").each(function () {
            toggleConditionDetail(this);
        });
    }

    function togglePregnancyFlow() {
        if (!IS_FEMALE) {
            return;
        }

        const pregnant = $("#AreYouPregnant").val();
        $("#pregnancyApprovalSection").hide();
        $("#PregnancyApproval").prop("required", false);

        if (pregnant === "Yes") {
            $("#pregnancyApprovalSection").show();
            $("#PregnancyApproval").prop("required", true);
        }
    }

    function initQuestionnaireToggles() {
        $(".dental-q-detail-toggle").each(function () {
            toggleQuestionnaireDetail(this);
        });
        toggleTobaccoSection();
        initConditionToggles();
        togglePregnancyFlow();
    }

    $(document).ready(function () {
        initQuestionnaireToggles();

        $(document).on("change", ".dental-q-detail-toggle", function () {
            toggleQuestionnaireDetail(this);
        });
        $(document).on("change", "#UseTobaccoOrVape", toggleTobaccoSection);
        $(document).on("change", ".tobacco-used-select", function () {
            toggleTobaccoTypeDetail(this);
        });
        $(document).on("change", ".condition-checkbox", function () {
            toggleConditionDetail(this);
        });
        $("#AreYouPregnant, #PregnancyApproval").on("change", togglePregnancyFlow);

        let isSmModeActive = @Json.Serialize(isSmMode);
        const SM_CHILD_ID = @Json.Serialize(sm.Id);
        const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
        const $startBtn = $("#tcnStartSmModeBtn");
        const $unlockBtn = $("#tcnStaffUnlockBtn");
        const $station = $(".tcn-station");

        function applyFormFieldsLock(isWritable) {
            $station.toggleClass("tcn-fields-locked", !isWritable);

            $station.find(".tab-content").find("input, select, textarea").each(function () {
                const $el = $(this);
                if ($el.hasClass("tcn-readonly-input") || $el.attr("readonly") === "readonly" && $el.hasClass("tcn-readonly-input")) {
                    return;
                }
                // Keep anti-forgery and other non-form controls alone; only lock editable fields.
                if ($el.attr("name") === "__RequestVerificationToken") {
                    return;
                }
                $el.prop("disabled", !isWritable);
            });

            if (window.TreatmentConsentPenPads && typeof window.TreatmentConsentPenPads.setAllEnabled === "function") {
                window.TreatmentConsentPenPads.setAllEnabled(penPads, isWritable);
            }
        }

        function setSmModeUi(active) {
            isSmModeActive = !!active;
            document.body.classList.toggle("tcn-sm-mode-lock", isSmModeActive);
            $station.attr("data-sm-mode", isSmModeActive ? "true" : "false");
            $unlockBtn.toggle(isSmModeActive);
            $startBtn.toggle(!isSmModeActive);
            applyFormFieldsLock(isSmModeActive);
        }

        const penPads = window.TreatmentConsentPenPads
            ? window.TreatmentConsentPenPads.initAll(document.querySelector(".tcn-station"), { enabled: isSmModeActive })
            : {};

        applyFormFieldsLock(isSmModeActive);

        (function wireDentalTreatmentOtherToggle() {
            const otherCheck = document.getElementById("dtcOtherTreatmentCheck");
            const otherDetail = document.getElementById("dtcOtherTreatmentDetail");
            const otherText = document.getElementById("dtcOtherTreatmentText");
            if (!otherCheck || !otherDetail) {
                return;
            }

            function syncOtherDetail() {
                const show = otherCheck.checked;
                otherDetail.hidden = !show;
                if (!show && otherText) {
                    otherText.value = "";
                }
            }

            otherCheck.addEventListener("change", syncOtherDetail);
            syncOtherDetail();
        })();

        function resizeVisiblePenPads(paneEl) {
            if (window.TreatmentConsentPenPads && typeof window.TreatmentConsentPenPads.resizePadsIn === "function") {
                window.TreatmentConsentPenPads.resizePadsIn(penPads, paneEl || document.querySelector(".tcn-station .tab-pane.active"));
                return;
            }

            Object.keys(penPads).forEach(function (key) {
                if (penPads[key] && typeof penPads[key].resize === "function") {
                    penPads[key].resize();
                }
            });
        }

        // Only resize pads in the newly shown tab (hidden canvases are 0x0 and must not be reset).
        document.querySelectorAll('#treatmentConsentTabs button[data-bs-toggle="tab"]').forEach(function (tabBtn) {
            tabBtn.addEventListener("shown.bs.tab", function (event) {
                const targetSelector = event.target.getAttribute("data-bs-target");
                const paneEl = targetSelector ? document.querySelector(targetSelector) : null;
                window.setTimeout(function () {
                    resizeVisiblePenPads(paneEl);
                }, 30);
            });
        });

        function getAntiforgeryHeaders() {
            return {
                "Content-Type": "application/json",
                "RequestVerificationToken": antiforgeryToken,
                "X-XSRF-TOKEN": antiforgeryToken,
                "X-Requested-With": "XMLHttpRequest"
            };
        }

        async function enterFullscreenIfPossible() {
            try {
                const el = document.documentElement;
                if (el.requestFullscreen) {
                    await el.requestFullscreen();
                } else if (el.webkitRequestFullscreen) {
                    el.webkitRequestFullscreen();
                }
            } catch (e) {
                // Fullscreen may be blocked by browser policy; SM mode still works.
            }
        }

        async function exitFullscreenIfPossible() {
            if (!document.fullscreenElement || !document.exitFullscreen) {
                return;
            }
            try {
                await document.exitFullscreen();
            } catch (e) {
                /* ignore */
            }
        }

        function onSmModePopState() {
            if (!isSmModeActive) {
                return;
            }
            history.pushState({ tcnSmLock: true }, "", window.location.href);
            Swal.fire({
                icon: "info",
                title: "Locked",
                text: "Service member mode is active. Ask staff to unlock.",
                confirmButtonColor: "rgba(80, 90, 201, 1)"
            });
        }

        let historyTrapInstalled = false;
        function trapHistoryWhileSmMode() {
            if (!isSmModeActive) {
                return;
            }

            history.pushState({ tcnSmLock: true }, "", window.location.href);
            if (!historyTrapInstalled) {
                window.addEventListener("popstate", onSmModePopState);
                historyTrapInstalled = true;
            }
        }

        $("#tcnStartSmModeBtn").on("click", async function () {
            const confirm = await Swal.fire({
                title: "Start service member mode?",
                text: "Menu and other pages will lock. Hand the tablet to the service member after starting.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Start",
                cancelButtonText: "Cancel",
                confirmButtonColor: "rgba(80, 90, 201, 1)"
            });

            if (!confirm.isConfirmed) {
                return;
            }

            try {
                const response = await fetch("@Url.Action("StartSmMode", "TreatmentConsent")", {
                    method: "POST",
                    headers: getAntiforgeryHeaders(),
                    body: JSON.stringify({ serviceMembersChildId: SM_CHILD_ID })
                });
                const data = await response.json();
                if (!data.success) {
                    Swal.fire("Unable to start", data.message || "Please try again.", "error");
                    return;
                }

                await enterFullscreenIfPossible();
                // Soft-start so any already-drawn ink is kept (no full page reload).
                setSmModeUi(true);
                trapHistoryWhileSmMode();
            } catch (e) {
                Swal.fire("Error", "Unable to start service member mode.", "error");
            }
        });

        $("#tcnStaffUnlockBtn").on("click", async function () {
            const result = await Swal.fire({
                title: "Staff Unlock",
                html: '<p class="mb-2">Enter your account password to unlock.</p>'
                    + '<input id="tcnUnlockPassword" type="password" class="swal2-input" placeholder="Password" autocomplete="current-password" />',
                showCancelButton: true,
                confirmButtonText: "Unlock",
                cancelButtonText: "Cancel",
                confirmButtonColor: "rgba(80, 90, 201, 1)",
                focusConfirm: false,
                preConfirm: function () {
                    const password = (document.getElementById("tcnUnlockPassword")?.value || "").trim();
                    if (!password) {
                        Swal.showValidationMessage("Password is required.");
                        return false;
                    }
                    return password;
                }
            });

            if (!result.isConfirmed || !result.value) {
                return;
            }

            try {
                const response = await fetch("@Url.Action("UnlockSmMode", "TreatmentConsent")", {
                    method: "POST",
                    headers: getAntiforgeryHeaders(),
                    body: JSON.stringify({ password: result.value })
                });
                const data = await response.json();
                if (!data.success) {
                    Swal.fire("Unlock failed", data.message || "Incorrect password.", "error");
                    return;
                }

                await exitFullscreenIfPossible();
                // Soft-unlock: keep pen ink / form answers; do not reload the page.
                setSmModeUi(false);
            } catch (e) {
                Swal.fire("Error", "Unable to unlock service member mode.", "error");
            }
        });

        trapHistoryWhileSmMode();
    });
</script>
