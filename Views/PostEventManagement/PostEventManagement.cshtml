@using Malama.Utilities
@model Malama.Models.PostEventManagementDto

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Add Immunization Screening";
}

<style>
    #page-heading {
        text-align: center;
        margin: 20px auto;
    }

    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white; /* ensures text is visible */
    }

        .btn-general:hover {
            background-color: rgba(60, 70, 180, 1); /* slightly darker on hover */
            border-color: rgba(60, 70, 180, 1);
            color: white;
        }

        .btn-general:focus,
        .btn-general:active {
            box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.5);
            outline: none;
        }

    .button-container {
        gap: 15px;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    table {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        #postEventTable {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }
    
    #postEventTable th,
    #postEventTable td {
        border: 1px solid #ddd !important;
        padding: 8px;
        text-align: center;
    }
    
    #postEventTable thead th {
        background-color: rgba(120, 130, 221, 1) !important;
        color: white;
        text-align: center;
    }
    
    #postEventTable tbody tr {
        background-color: rgba(240, 245, 255, 1);
    }
    
    #postEventTable tbody tr:hover {
        background-color: rgba(245, 250, 255, 1);
    }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }
</style>

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

            Swal.fire({
                icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor, // Conditional button color
                iconColor: iconColor // Conditional icon color
            });
        });
    </script>
}

<h2 id="page-heading">Post Event Management</h2>
<form asp-action="PostEventManagement" method="post">
<div class="container-fluid">

    <!-- Top Right Dropdown -->
    <input type="hidden" name="SubmissionToken" id="SubmissionToken" value="@Guid.NewGuid()" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EventManagementId" />
        <input type="hidden" asp-for="EventID" />
        <div class="d-flex justify-content-between align-items-center mb-3">

            <!-- Left side: Event ID -->
            <div>
                <label class="form-label me-2 fw-bold" style="font-size: 1.2rem;">
                    Event ID :
                </label>
                <span class="form-label me-2" style="font-size: 1.2rem;">
                    @ViewBag.EventID
                </span>
            </div>

            <!-- Right side: Dropdown -->
            <div class="d-flex align-items-center">
                <label class="me-2 mb-0">Post Event Status :</label>
                <select class="form-control w-auto" asp-for="PostEventStatus">
                    <option value="Post event processing">Post event processing</option>
                    <option value="Complete">Complete</option>
                </select>
            </div>

        </div>

    <!-- Tabs -->
   <ul class="nav nav-tabs" id="postEventTabs">
        <li class="nav-item">
            <a class="nav-link active"
               data-bs-toggle="tab"
               href="#tab1"
               style="color:black; font-weight:bold;">
               Event Specific Details
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               data-bs-toggle="tab"
               href="#tab2"
               style="color:black; font-weight:bold;">
               Event Service Details
            </a>
        </li>
    </ul>
    <div class="tab-content mt-3">

        <!-- ================= TAB 1 ================= -->
        <div class="tab-pane fade show active" id="tab1">

            <h3 class="mb-3">Event Specific Details</h3>

            <div class="row">

        <!-- LEFT COLUMN -->
        <div class="col-md-6">

            <p><strong>Sub Event ID Number :</strong> @Model.SubEventID</p>
            <input type="hidden" asp-for="SubEventID" />

            <p><strong>Contract Name :</strong> @Model.ContractDetails?.ContractName</p>
            <input type="hidden" asp-for="ContractDetails.ContractName" />

            <p><strong>Contract Id :</strong> @Model.ContractDetails?.ContractID</p>
            <input type="hidden" asp-for="ContractDetails.ContractID" />

            <p><strong>Dawson Service Branch :</strong> @Model.ContractDetails?.ContractServiceBranch</p>
            <input type="hidden" asp-for="ContractDetails.ContractServiceBranch" />

            <p><strong>Contract Client :</strong> @Model.ContractDetails?.ContractClient</p>
            <input type="hidden" asp-for="ContractDetails.ContractClient" />

            <p><strong>Site ID :</strong> @Model.ContractDetails?.SiteId</p>
            <input type="hidden" asp-for="ContractDetails.SiteId" />

            <p><strong>Event Address 1 :</strong> @Model.EventAddress1</p>
            <input type="hidden" asp-for="EventAddress1" />

            <p><strong>Event Address 2 :</strong> @Model.EventAddress2</p>
            <input type="hidden" asp-for="EventAddress2" />

            <p><strong>Event Zip Code :</strong> @Model.EventZipCode</p>
            <input type="hidden" asp-for="EventZipCode" />

            <p><strong>MOB Date :</strong> @Model.MOBDate?.ToString("MM-dd-yyyy")</p>
            <input type="hidden" asp-for="MOBDate" />

            <p><strong>Regarding Site Notes :</strong> @Model.RegardingSites</p>
            <input type="hidden" asp-for="RegardingSites" />

                        <p><strong>Event Start Date :</strong> @Model.EventStartDateUtcForDisplay.ToString("MM-dd-yyyy")</p>
                        <input type="hidden" asp-for="EventStartDateUtcForDisplay" />

                        <p><strong>Event End Date :</strong> @Model.EventEndDateUtcForDisplay.ToString("MM-dd-yyyy")</p>
                        <input type="hidden" asp-for="EventEndDateUtcForDisplay" />

        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-md-6">

            <p><strong>Contract Agency :</strong> @Model.ContractDetails?.ContractAgency</p>
            <input type="hidden" asp-for="ContractDetails.ContractAgency" />

            <p><strong>Contract Component :</strong> @Model.ContractDetails?.ContractComponent</p>
            <input type="hidden" asp-for="ContractDetails.ContractComponent" />

            <p><strong>Client Name :</strong> @Model.ContractDetails?.ClientName</p>
            <input type="hidden" asp-for="ContractDetails.ClientName" />

            <p><strong>Contract Type :</strong> @Model.ContractDetails?.ContractType</p>
            <input type="hidden" asp-for="ContractDetails.ContractType" />

            <p><strong>Contract End :</strong> @Model.ContractDetails?.ContractEndDate.ToString("MM-dd-yyyy")</p>
            <input type="hidden" asp-for="ContractDetails.ContractEndDate" />

            <p><strong>Contract Start :</strong> @Model.ContractDetails?.ContractStartDate.ToString("MM-dd-yyyy")</p>
            <input type="hidden" asp-for="ContractDetails.ContractStartDate" />

            <p><strong>Dawson Project Manager :</strong> @Model.ContractDetails?.DawsonProjectManagerFirstName</p>
            <input type="hidden" asp-for="ContractDetails.DawsonProjectManagerFirstName" />

            <p><strong>Event City :</strong> @Model.EventCity</p>
            <input type="hidden" asp-for="EventCity" />

            <p><strong>Event State :</strong> @Model.EventState</p>
            <input type="hidden" asp-for="EventState" />

            <p><strong>Event Timezone :</strong> @Model.Timezone</p>
            <input type="hidden" asp-for="Timezone" />

            <p><strong>Taskforce :</strong> @Model.TaskForce</p>
            <input type="hidden" asp-for="TaskForce" />

            <p><strong>Event Help Line :</strong> @Model.EventHelpLine</p>
            <input type="hidden" asp-for="EventHelpLine" />

        </div>

    </div>

            <hr />

            <!-- ================= FORM SECTION ================= -->
            <div class="row mt-3">

                <!-- LEFT COLUMN -->
                <div class="col-md-6">

                    <div class="form-group mb-3">
                        <label>Number of Service Member Completed</label>
                            <input type="text" class="form-control" asp-for="TotalServiceMember" readonly />
                    </div>

                    <div class="form-group mb-3">
                        <label>Actual Event Start Date</label>
                        <input type="text" id="EventStartDateUtc" class="form-control" placeholder="MM/DD/YYYY" asp-for="EventStartDateUtc" value="@Model.EventStartDateUtc.ToString("yyyy-MM-dd")"/>
                    </div>
                </div>

                <!-- RIGHT COLUMN -->
                <div class="col-md-6">

                    <!-- Spacer for alignment -->
                    <div class="form-group mb-3" style="visibility:hidden;">
                        <label>Spacer</label>
                        <input class="form-control" />
                    </div>

                    <div class="form-group mb-3">
                        <label>Actual Event End Date</label>
                            <input type="text" id="EventEndDateUtc" class="form-control" placeholder="MM/DD/YYYY" asp-for="EventEndDateUtc" value="@Model.EventEndDateUtc.ToString("yyyy-MM-dd")" />
                    </div>

                </div>

            </div>

            <!-- ================= DAY WISE TIME SECTION ================= -->

            <div id="dayWiseTimeContainer" class="mt-4">

                @if (Model.PostEventStartEndTimeDayWiseDto != null && Model.PostEventStartEndTimeDayWiseDto.Any())
                {
                    for (int i = 0; i < Model.PostEventStartEndTimeDayWiseDto.Count; i++)
                    {
                        <div class="row mb-3">

                            <!-- LEFT: Start Time -->
                            <div class="col-md-6">
                                <label>
                                    Actual Day @Model.PostEventStartEndTimeDayWiseDto[i].EventDay Start Time
                                </label>

                                <input type="hidden" name="PostEventStartEndTimeDayWiseDto[@i].Id" value="@Model.PostEventStartEndTimeDayWiseDto[i].Id" />

                                <input type="text"
                                       class="form-control timepicker"
                                       id="StartTime_@i"
                                       name="PostEventStartEndTimeDayWiseDto[@i].EventStartTime"
                                       value="@(Model.PostEventStartEndTimeDayWiseDto[i].EventStartTime?.ToString(@"hh\:mm"))" />

                                <!-- Hidden fields -->
                                <input type="hidden"
                                       name="PostEventStartEndTimeDayWiseDto[@i].Id"
                                       value="@Model.PostEventStartEndTimeDayWiseDto[i].Id" />

                                <input type="hidden"
                                       name="PostEventStartEndTimeDayWiseDto[@i].EventDay"
                                       value="@Model.PostEventStartEndTimeDayWiseDto[i].EventDay" />
                            </div>

                            <!-- RIGHT: End Time -->
                            <div class="col-md-6">
                                <label>
                                    Actual Day @Model.PostEventStartEndTimeDayWiseDto[i].EventDay End Time
                                </label>

                                <input type="text"
                                       class="form-control timepicker"
                                       id="EndTime_@i"
                                       name="PostEventStartEndTimeDayWiseDto[@i].EventEndTime"
                                       value="@(Model.PostEventStartEndTimeDayWiseDto[i].EventEndTime?.ToString(@"hh\:mm"))" />
                            </div>

                        </div>
                    }
                }
                else
                {
                    <p>No day-wise data available</p>
                }

            </div>

            <div class="row mt-3">
                <div class="form-group mb-3">
                    <label>Post Event Notes</label>
                    <textarea class="form-control" rows="4" asp-for="PostEventNotes"></textarea>
                </div>
                </div>

        </div>

        <!-- ================= TAB 2 (EMPTY FOR NOW) ================= -->
            <div class="tab-pane fade" id="tab2">

                <h5 class="mb-3">Event Services</h5>

                <div class="table-responsive">
                    <table id="postEventTable" class="table table-bordered">

                        <thead class="table-light">
                            <tr>
                                <th>Event Services</th>
                                <th>DAWSON Final Pre-Event Numbers</th>
                                <th>Post Event Numbers</th>
                                <th>Completed</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.EventServices != null && Model.EventServices.Any())
                            {
                                for (int i = 0; i < Model.EventServices.Count; i++)
                                {
                                    <tr>
                                        <!-- Event Service (Label) -->
                                        <td>
                                            @Model.EventServices[i].EventService

                                            <input type="hidden"
                                                   name="EventServices[@i].EventServiceDetailId"
                                                   value="@Model.EventServices[i].EventServiceDetailId" />

                                            <input type="hidden"
                                                   name="EventServices[@i].Id"
                                                   value="@Model.EventServices[i].Id" />

                                            <input type="hidden"
                                                   name="EventServices[@i].EventService"
                                                   value="@Model.EventServices[i].EventService" />
                                        </td>

                                        <!-- Final Pre Event Numbers -->
                                    <td class="text-center">
                                        <input type="text"
                                               class="form-control text-center"
                                               name="EventServices[@i].FinalPreEventConfirmedNumbers"
                                               value="@Model.EventServices[i].FinalPreEventConfirmedNumbers"
                                               readonly />
                                    </td>

                                        <!-- Post Event Numbers -->
                                    <td class="text-center">
                                            <input type="text"
                                            class="form-control text-center post-event-number"
                                            name="EventServices[@i].PostEventNumbers"
                                            value="@Model.EventServices[i].PostEventNumbers" />
                                        </td>

                                        <!-- Completed Checkbox -->
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   name="EventServices[@i].Completed"
                                                   value="true"
                                            @(Model.EventServices[i].Completed ? "checked" : "") />

                                            <!-- Hidden for unchecked -->
                                            <input type="hidden"
                                                   name="EventServices[@i].Completed"
                                                   value="false" />
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">
                                        No event services available
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
                    <button id="submitBtn" type="submit" class="btn btn-success btn-lg me-3" @(DashboardAuthorizationHelper.HasAccess(User, "PostEventManagement_Save") ? "" : "disabled")>
                    <i class="bi bi-check-circle"></i> Save
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg btn-back-confirm">
                    <i class="bi bi-arrow-left"></i> Back
                </a>

            </div>
</div>
</form>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Initialize Flatpickr
        const startPicker = flatpickr("#EventStartDateUtc", { altInput: true, altFormat: 'm/d/Y', dateFormat: 'Y-m-d', allowInput: true, onChange: generateDayWiseFields });
        const endPicker = flatpickr("#EventEndDateUtc", { altInput: true, altFormat: 'm/d/Y', dateFormat: 'Y-m-d', allowInput: true, onChange: generateDayWiseFields });
        flatpickr(".timepicker", { enableTime: true, noCalendar: true, time_24hr: true, dateFormat: "H:i" });

        function checkTabCompletion() {

            let tab1Complete = true;
            let tab2Complete = true;

            // ---------------- TAB 1 ----------------
            $('#tab1 input[type="text"], #tab1 textarea').each(function () {

                const $this = $(this);

                // Skip spacer (visibility:hidden container)
                if ($this.closest('[style*="visibility:hidden"]').length) return;

                // Handle Flatpickr visible inputs
                if ($this.hasClass('flatpickr-input')) {
                    if ($this.val().trim() === "") {
                        tab1Complete = false;
                        return false;
                    } else {
                        $this.css('border', '');
                    }
                    return;
                }

                // Normal text inputs & textarea
                if ($this.val().trim() === "") {
                    tab1Complete = false;
                    return false;
                } else {
                    $this.css('border', '');
                }
            });

            // Extra safety for Flatpickr actual values
            function isFlatpickrFilled(selector) {
                const fp = document.querySelector(selector)?._flatpickr;
                return fp && fp.selectedDates.length > 0;
            }

            if (!isFlatpickrFilled('#EventStartDateUtc') ||
                !isFlatpickrFilled('#EventEndDateUtc')) {

                tab1Complete = false;
            }

            // ---------------- TAB 2 ----------------

            // Post Event Numbers (text inputs only)
            $('#tab2 input[name*="PostEventNumbers"]').each(function () {

                const $this = $(this);

                if ($this.val().trim() === "") {
                    tab2Complete = false;
                    return false;
                } else {
                    $this.css('border', '');
                }
            });

            // Each row must have checkbox checked
            $('#tab2 tbody tr').each(function () {

                const $checkbox = $(this).find('input[type="checkbox"]');

                if ($checkbox.length && !$checkbox.is(':checked')) {
                    tab2Complete = false;
                    return false;
                }
            });

            $('#postEventTabs a[href="#tab1"]')
                .css('background-color', tab1Complete ? '#28a745' : '');

            $('#postEventTabs a[href="#tab2"]')
                .css('background-color', tab2Complete ? '#28a745' : '');

            // ---------------- UPDATE DROPDOWN ----------------
            const statusDropdown = $('#PostEventStatus');

            if (tab1Complete && tab2Complete) {
            
                // enable option
                statusDropdown.find('option[value="Complete"]').prop('disabled', false);
            
                // optional: auto-set
                statusDropdown.val('Complete');
            
            } else {
            
                // disable option
                statusDropdown.find('option[value="Complete"]').prop('disabled', true);
            debugger;
                statusDropdown.val('Post event processing');
                @* if (statusDropdown.val() === 'Complete') {
                    
                } *@
            }
        }

       $('#tab1 input[type="text"], #tab1 textarea, #tab2 input').on('input change', checkTabCompletion);

        // -------- Force initial evaluation after everything is rendered --------
        setTimeout(function() {
            checkTabCompletion(); // ensures pre-filled textareas and Flatpickr altInputs are detected
        }, 200);


        $('a.btn-back-confirm').on('click', async function (e) {
            e.preventDefault();

            const url = $(this).attr('href');

            const confirmed = await showYesNoModal(
                "Are you sure you want to go back to main screen without saving changes?"
            );

            if (!confirmed) {
                return;
            }

            window.location.href = url;
        });

        function generateDayWiseFields() {
            const startDate = startPicker.selectedDates[0];
            const endDate = endPicker.selectedDates[0];

            if (!startDate || !endDate) return;

            const container = $('#dayWiseTimeContainer');
            container.empty();

            // Calculate days
            const diffTime = endDate - startDate;
            const days = Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1;

            // Max 14 days validation
            if (days > 14) {
                alert('Maximum allowed duration is 14 days');
                return;
            }

            for (let i = 0; i < days; i++) {

                const currentDate = new Date(startDate);
                currentDate.setDate(startDate.getDate() + i);

                const formattedDay = currentDate.toLocaleDateString();

                const html = `
                    <div class="row mb-3">

                        <div class="col-md-6">
                            <label>Day ${i + 1} Start Time</label>

                            <input type="text"
                                class="form-control timepicker"
                                name="PostEventStartEndTimeDayWiseDto[${i}].EventStartTime" />

                            <input type="hidden"
                                name="PostEventStartEndTimeDayWiseDto[${i}].EventDay"
                                value="${i + 1}" />
                        </div>

                        <div class="col-md-6">
                            <label>Day ${i + 1} End Time</label>

                            <input type="text"
                                class="form-control timepicker"
                                name="PostEventStartEndTimeDayWiseDto[${i}].EventEndTime" />
                        </div>

                    </div>
                `;

                container.append(html);
            }

            // Re-initialize timepickers
            flatpickr(".timepicker", {
                enableTime: true,
                noCalendar: true,
                time_24hr: true,
                dateFormat: "H:i"
            });
        }

        function restrictNumberInput(element, maxDigits, maxValue) {

            let value = $(element).val();
        
            // Remove non-digits
            value = value.replace(/\D/g, '');
        
            // Limit digits
            if (value.length > maxDigits) {
                value = value.slice(0, maxDigits);
            }
        
            // Enforce max value
            if (value && parseInt(value) > maxValue) {
                value = maxValue.toString();
            }
        
            $(element).val(value);
        }

        $('#TotalServiceMember').on('input', function () {
            restrictNumberInput(this, 5, 99999);
        });
        
        $(document).on('input', '.post-event-number', function () {
            restrictNumberInput(this, 5, 99999);
        });
    });
</script>

