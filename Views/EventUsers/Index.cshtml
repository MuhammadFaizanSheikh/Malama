@using Malama.Models
@model EventUsersViewModel

@{
    ViewData["Title"] = "Event Users";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Event Users</h5>
        </div>

        <div class="card-body">

            <!-- Event Dropdown -->
            @if (!User.IsInRole("Event Manager"))
            {
                <form method="get">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Select Event</label>
                            <select name="eventId" class="form-select" onchange="this.form.submit()">
                                <option value="">-- Select Event --</option>
                                @foreach (var evt in Model.Events)
                                {
                                    <option value="@evt.EventId"
                                            selected="@(Model.SelectedEventId == evt.EventId)">
                                        @evt.EventName
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </form>
            }

            <!-- Show table only if event selected -->
            @if (Model.SelectedEventId.HasValue)
            {
                
<div class="card p-3 mb-4">
    <h5 class="text-center">Search Event Users</h5>

    <div class="container">
        <div class="row g-2">

            <div class="col-md-3">
                <input type="text" id="filterEmail" class="form-control" placeholder="Email">
            </div>

            <div class="col-md-3">
                <input type="text" id="filterPrimaryRole" class="form-control" placeholder="Primary Role">
            </div>

             <div class="col-md-3">
                <input type="text" id="filterPrimaryStation" class="form-control" placeholder="Primary Station">
            </div>

            <div class="col-md-3">
                <input type="text" id="filterSecondaryRole" class="form-control" placeholder="Secondary Role">
            </div>

            <div class="col-md-3">
                <input type="text" id="filterSecondaryStation" class="form-control" placeholder="Secondary Station">
            </div>

            <div class="col-md-3">
                <input type="text" id="filterAttribute" class="form-control" placeholder="Attribute">
            </div>

            <div class="col-12 text-center mt-2">
                <button id="searchEventUsersBtn" type="button" class="btn btn-primary px-4">Search</button>
                <button id="resetEventUsersFiltersBtn" type="button" class="btn btn-secondary px-4 ms-2">Reset Filters</button>
            </div>

        </div>
    </div>
</div>
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Primary Roles</th>
                            <th>Primary Station</th>
                            <th>Secondary Roles</th>
                            <th>Secondary Station</th>
                            <th>Attributes</th>
                            <th>Detail Summary Acces</th>
                            <th style="width:340px;">Allowed Pages & Permissions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Users.Any())
                        {
                            foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td class="email-cell">@user.Email</td>
                                    <td class="primaryrole-cell">
                                        <div style="display:flex; flex-wrap:wrap;">
                                            @foreach (var r in user.PrimaryRole.Split(','))
                                            {
                                                var roleTrimmed = r.Trim();
                                                var roleColor = "#6c757d"; // One common color for all roles

                                                <span style="background-color:@roleColor; color:white; padding:0.25rem 0.5rem; border-radius:0.25rem; margin-right:0.25rem; margin-bottom:0.25rem; font-size:0.85rem;">
                                                    @roleTrimmed
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="primarystation-cell">@user.PrimaryStation</td>

                                    <td class="secondaryrole-cell">
                                        <div style="display:flex; flex-wrap:wrap;">
                                            @foreach (var r in user.SecondaryRole.Split(','))
                                            {
                                                var roleTrimmed = r.Trim();
                                                var roleColor = "#6c757d"; // One common color for all roles

                                                <span style="background-color:@roleColor; color:white; padding:0.25rem 0.5rem; border-radius:0.25rem; margin-right:0.25rem; margin-bottom:0.25rem; font-size:0.85rem;">
                                                    @roleTrimmed
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <td class="secondarystation-cell">@user.SecondaryStation</td>
                                    <td class="attribute-cell">
                                        <div style="display:flex; flex-wrap:wrap;">
                                            @foreach (var a in user.Attributes?.Split(',') ?? new string[] { })
                                            {
                                                var attributeTrimmed = a.Trim();

                                                var attributeColor = attributeTrimmed switch
                                                {
                                                    "Exam" => "#0d6efd",              // Blue
                                                    "Treatment" => "#198754",         // Green
                                                    "General" => "#6f42c1",           // Purple
                                                    "Oral Surgery" => "#dc3545",      // Red
                                                    "Endo" => "#fd7e14",              // Orange
                                                    "Cold Chain Cert" => "#20c997",   // Teal
                                                    "Imms" => "#0dcaf0",              // Cyan
                                                    "Panorex X-ray" => "#6610f2",     // Indigo
                                                    "CanAccessProfile" => "#6c757d",  // Gray
                                                    _ => "#6c757d"                    // Default gray
                                                };

                                                <span style="background-color:@attributeColor; color:white; padding:0.25rem 0.5rem; border-radius:0.25rem; margin-right:0.25rem; margin-bottom:0.25rem; font-size:0.85rem;">
                                                    @attributeTrimmed
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <td style="width:120px;">
                                        @{
                                            var hasAccess = user.DetailSummaryAccess;
                                            var detailSummaryBadgeColor = hasAccess ? "#198754" : "#dc3545"; // Green for Yes, Red for No
                                            var displayText = hasAccess ? "Yes" : "No";
                                        }

                                        <span style="background-color:@detailSummaryBadgeColor; color:white; padding:0.25rem 0.6rem; border-radius:0.25rem; font-size:0.85rem;">
                                            @displayText
                                        </span>
                                    </td>

                                    <td>
                                        <table style="width:100%; border-collapse:collapse;">
                                            <tbody>
                                                @foreach (Malama.Models.UserPagePermissionDto allowedPage in user.AllowedPages)
                                                {
                                                    var access = allowedPage.Access;

                                                    string badgeText;
                                                    string badgeColor;

                                                    if (access.HasFlag(PageAccessLevel.Add) && access.HasFlag(PageAccessLevel.Update))
                                                    {
                                                        badgeText = "View, Add & Update";
                                                        badgeColor = "#28a745"; // Green
                                                    }
                                                    else if (access.HasFlag(PageAccessLevel.Add))
                                                    {
                                                        badgeText = access.HasFlag(PageAccessLevel.View)
                                                        ? "View & Add"
                                                        : "Add Only";

                                                        badgeColor = "#17a2b8"; // Blue
                                                    }
                                                    else if (access.HasFlag(PageAccessLevel.Update))
                                                    {
                                                        badgeText = access.HasFlag(PageAccessLevel.View)
                                                        ? "View & Update"
                                                        : "Update Only";

                                                        badgeColor = "#007bff"; // Dark Blue
                                                    }
                                                    else if (access.HasFlag(PageAccessLevel.View))
                                                    {
                                                        badgeText = "View-Only";
                                                        badgeColor = "#fd7e14"; // Orange
                                                    }
                                                    else
                                                    {
                                                        badgeText = "No Access";
                                                        badgeColor = "#6c757d"; // Gray
                                                    }

                                                    <tr>
                                                        <td style="padding:4px 6px; border-bottom:1px solid #e9ecef;">
                                                            @allowedPage.PageName
                                                        </td>

                                                        <td style="padding:4px 6px; border-bottom:1px solid #e9ecef; text-align:right;">
                                                            <span style="
background-color:@badgeColor;
color:white;
padding:0.15rem 0.6rem;
border-radius:0.25rem;
font-size:0.75rem;
display:inline-block;
min-width:110px;
text-align:center;
white-space:nowrap;">
                                                                @badgeText
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    No users found for selected event
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    </div>
</div>
<script>

document.getElementById("searchEventUsersBtn")?.addEventListener("click", function () {

    let email = document.getElementById("filterEmail").value.toLowerCase();
    let primaryRole = document.getElementById("filterPrimaryRole").value.toLowerCase();
    let secondaryRole = document.getElementById("filterSecondaryRole").value.toLowerCase();
    let primaryStation = document.getElementById("filterPrimaryStation").value.toLowerCase();
    let secondaryStation = document.getElementById("filterSecondaryStation").value.toLowerCase();
    let attribute = document.getElementById("filterAttribute").value.toLowerCase();

    let rows = document.querySelectorAll("table tbody tr");

    rows.forEach(row => {

        let emailText = row.querySelector(".email-cell")?.innerText.toLowerCase() || "";
        let primaryRoleText = row.querySelector(".primaryrole-cell")?.innerText.toLowerCase() || "";
        let secondaryRoleText = row.querySelector(".secondaryrole-cell")?.innerText.toLowerCase() || "";
        let primaryStationText = row.querySelector(".primarystation-cell")?.innerText.toLowerCase() || "";
        let secondaryStationText = row.querySelector(".secondarystation-cell")?.innerText.toLowerCase() || "";
        let attributeText = row.querySelector(".attribute-cell")?.innerText.toLowerCase() || "";

        let match =
            (email === "" || emailText.includes(email)) &&
            (primaryRole === "" || primaryRoleText.includes(primaryRole)) &&
            (secondaryRole === "" || secondaryRoleText.includes(secondaryRole)) &&
            (primaryStation === "" || primaryStationText.includes(primaryStation)) &&
            (secondaryStation === "" || secondaryStationText.includes(secondaryStation)) &&
            (attribute === "" || attributeText.includes(attribute));

        row.style.display = match ? "" : "none";

    });

});

document.getElementById("resetEventUsersFiltersBtn")?.addEventListener("click", function () {

    document.getElementById("filterEmail").value = "";
    document.getElementById("filterPrimaryRole").value = "";
    document.getElementById("filterSecondaryRole").value = "";
    document.getElementById("filterPrimaryStation").value = "";
    document.getElementById("filterSecondaryStation").value = "";
    document.getElementById("filterAttribute").value = "";

    let rows = document.querySelectorAll("table tbody tr");

    rows.forEach(row => {
        row.style.display = "";
    });

});

</script>