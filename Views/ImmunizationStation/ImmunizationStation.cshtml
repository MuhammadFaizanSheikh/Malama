                            <option value="Excused">Excused</option>
                            <option value="Proof of Service">Proof of Service</option>
                        </select>
                    </div>
                    <div class="col-md-4 vaccine-excused-comments" style="display:none;">
                        <label>Comments / Authorization</label>
                        <textarea asp-for="HepBReasonExcusedComments" class="form-control excused-textarea" rows="3"></textarea>
                    </div>
                    <div class="col-md-2 vaccine-completed" style="display:none;">
                        <label>Manufacturer</label>
                        <select asp-for="HepBManufacturer" class="form-control manufacturer-dropdown" data-selected="@Model.HepBManufacturer">
                            <option value="" selected>-- Select Manufacturer --</option>
                        </select>
                    </div>

                    <div class="col-md-2 vaccine-completed" style="display:none;">
                        <label>Dose</label>
                        <input type="text" class="form-control dose-input" readonly />
                    </div>

