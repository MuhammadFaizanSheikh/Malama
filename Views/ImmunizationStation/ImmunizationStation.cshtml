@model Malama.Models.ImmunizationStation

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Add Immunization Screening";
    var selectedEventId = ViewBag.EventId;
    
}

<style>
    #page-heading {
        text-align: center;
        margin: 20px auto;
    }

    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white; /* ensures text is visible */
    }

        .btn-general:hover {
            background-color: rgba(60, 70, 180, 1); /* slightly darker on hover */
            border-color: rgba(60, 70, 180, 1);
            color: white;
        }

        .btn-general:focus,
        .btn-general:active {
            box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.5);
            outline: none;
        }

    .button-container {
        gap: 15px;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    table {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        table th,
        table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center; /* Aligns the text in the middle of the cell */
        }

        table th {
            background-color: #f4f4f4;
        }

        table tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

            table tbody tr:hover {
                background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
            }

        table td button,
        table td a {
            display: inline-block; /* Makes the buttons appear side by side */
            margin-right: 5px; /* Optional: Adds space between the buttons */
        }

        table td .button-container {
            display: flex;
            justify-content: center; /* Aligns buttons horizontally in the center */
        }

            table td .button-container a {
                margin-right: 5px; /* Optional: Adds space between the buttons */
            }

        table thead th {
            background-color: rgba(120, 130, 221, 1); /* Header background color */
            color: white; /* Header text color */
            text-align: center; /* Center-align header text */
        }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }
</style>

<h2 id="page-heading">Edit Service Member at Immunization Station</h2>
@if (selectedEventId != null && !string.IsNullOrEmpty(selectedEventId.ToString()))
{
    <h2 id="page-heading">Event ID : @selectedEventId</h2>
}

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

            Swal.fire({
                icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor, // Conditional button color
                iconColor: iconColor // Conditional icon color
            });
        });
    </script>
}

<form asp-action="SaveImmunization" asp-route-eventIdForRedirection="@Model.FileData.EventId" method="post">
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.FileDataId)
    <!-- Link to parent contract -->
    @* <input type="hidden" asp-for="FileDataId" /> *@

    <h3 class="mb-4">Personal Information</h3>
    <div class="card mb-4">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <p><span class="fw-bold">Full Name:</span> @Model.FileData?.FullName</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">DOD ID:</span> @Model.FileData?.DodId</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">Routing Sheet Barcode:</span> @Model.FileData?.Barcode</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <p><span class="fw-bold">DOB:</span> @Model.FileData?.Dob</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">Age:</span> @Model.FileData?.Age</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">Sex:</span> @Model.FileData?.Sex</p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    

    <h3 class="mb-4">Questionnaires :</h3>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">1. Are you sick today?</label>
            <select asp-for="IsSickToday" class="form-select reason-toggle question-toggle" data-target="IsSickTodayReason">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">2. Do you have allergies to medication, food, a vaccine component, or latex?</label>
            <select asp-for="HasAllergiesToMedicationFoodVaccineOrLatex" class="form-select reason-toggle question-toggle" data-target="HasAllergiesReason">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">3. Have you ever had a serious reaction after receiving a vaccination?</label>
            <select asp-for="HadSeriousReactionAfterVaccination" class="form-select reason-toggle question-toggle" data-target="SeriousReactionReason">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">4. Do you have a long-term health problem with heart disease, lung disease, asthma, kidney disease, metabolic disease (e.g. diabetes), anemia, or other blood disorder?</label>
            <select asp-for="HasLongTermHealthProblem" class="form-select reason-toggle question-toggle" data-target="LongTermHealthProblemReason">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
    </div>


    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">5. Do you have cancer, leukemia, HIV/AIDS, or any other immune system problem?</label>
            <select asp-for="HasCancerOrImmuneSystemProblem" class="form-select reason-toggle question-toggle" data-target="CancerOrImmuneSystemReason">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">6. In the past 3 months, have you taken medications that weaken your immune system, such as cortisone, prednisone, other steroids, or anticancer drugs, or have you had radiation treatments?</label>
            <select asp-for="TookImmuneSuppressingMedicationRecently" class="form-select reason-toggle question-toggle" data-target="ImmuneSuppressionReason">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
    </div>


    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">7. Have you had a seizure or a brain or other nervous system problem?</label>
            <select asp-for="HadSeizureOrNervousSystemProblem" class="form-select reason-toggle question-toggle" data-target="SeizureReason">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">8. During the past year, have you received a transfusion of blood or blood products, or been given immune (gamma) globulin or an antiviral drug?</label>
            <select asp-for="HadBloodTransfusionOrAntiviralInPastYear" class="form-select reason-toggle question-toggle" data-target="BloodTransfusionReason">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
    </div>


    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">9. For women: are you pregnant or is there a chance you could become pregnant during the next month?</label>
            <select asp-for="IsPregnantOrCouldBePregnant" data-question="9" class="form-select pregnancy-toggle question-toggle" data-target="PregnancyCheckboxWrapper">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>

            <div id="PregnancyCheckboxWrapper" style="display:none;" class="mt-2">
                <input type="checkbox" asp-for="PregnancyCheckboxSelected" class="form-check-input pregnancy-checkbox" id="PregnancyCheckboxSelected"/>
                <label class="form-check-label" for="PregnancyCheckboxSelected">Pregnancy test completed</label>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">10. Have you received any vaccine in the past 4 weeks?</label>
            <select asp-for="ReceivedVaccineInPast4Weeks" class="form-select reason-toggle question-toggle" data-target="ReceivedVaccineReason">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
    </div>
    <hr class="my-4" />
    <h3 class="mb-4">Required Immunization(s) :</h3>
    <div id="immunization-section">

        @if (string.Equals(Model.FileData.HepB?.Trim(), "NEEDED", StringComparison.OrdinalIgnoreCase))
