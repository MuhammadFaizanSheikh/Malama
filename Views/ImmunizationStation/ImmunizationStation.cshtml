                        <label>Unit</label>
                        <input type="text" class="form-control unit-input" readonly />
                    </div>

                    <div class="col-md-2 vaccine-completed" style="display:none;">
                        <label>Lot No</label>
                        <select asp-for="HepBLotNo" class="form-control lot-dropdown" data-selected="@Model.HepBLotNo">
                            <option value="" selected>-- Select Lot No --</option>
                        </select>
                    </div>

                    <div class="col-md-2 vaccine-completed" style="display:none;">
                        <label>Expiration Date</label>
