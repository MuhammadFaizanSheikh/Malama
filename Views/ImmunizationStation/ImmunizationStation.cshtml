<script>


    document.addEventListener("DOMContentLoaded", function () {
        // Handle Yes/YesWithReason questions
        document.querySelectorAll(".reason-toggle").forEach(function (dropdown) {
            const targetId = dropdown.getAttribute("data-target");
            const target = document.getElementById(targetId);

            function toggleReason() {
                if (!target) return;

                if (dropdown.value === "Yes with reason") {
                    target.style.display = "block";
                    target.setAttribute("required", "required"); // make required
                } else {
                    target.style.display = "none";
                    target.removeAttribute("required"); // remove required
                    target.value = ""; // reset if hidden
                }
            }

            // Init on page load
            toggleReason();

            // On change
            dropdown.addEventListener("change", toggleReason);
        });

        // Pregnancy handling
        document.querySelectorAll(".pregnancy-toggle").forEach(function (dropdown) {
            const targetId = dropdown.getAttribute("data-target");
            const wrapper = document.getElementById(targetId);
            const checkbox = wrapper.querySelector("input[type='checkbox']");

            function togglePregnancy() {
                if (dropdown.value === "Yes") {
                    wrapper.style.display = "block";
                } else {
                    wrapper.style.display = "none";
                    checkbox.checked = false;
                }
            }

            // Init on page load
            togglePregnancy();

            // On change
            dropdown.addEventListener("change", togglePregnancy);
        });

        // Vaccine handling (already working fine)
        document.querySelectorAll(".vaccine-block").forEach(function (block) {
            const statusDropdown = block.querySelector(".vaccine-status");
            const reasonDiv = block.querySelector(".vaccine-reason");
            const completedDivs = block.querySelectorAll(".vaccine-completed");

            function toggleFields() {
                const value = statusDropdown.value;

                // Reset all
                reasonDiv.style.display = "none";

                const reasonSelect = reasonDiv.querySelector("select");
                if (reasonSelect) {
                    //reasonSelect.value = "";                // ✅ clears selected value
                    reasonSelect.removeAttribute("required");
                }

                completedDivs.forEach(div => {
                    div.style.display = "none";
                    const input = div.querySelector("select, input");
                    input.removeAttribute("required");
                    //input.value = "";
                });

                if (value === "Not Completed") {
                    reasonDiv.style.display = "block";
                    reasonDiv.querySelector("select").setAttribute("required", "required");

                    completedDivs.forEach(div => {
                        const input = div.querySelector("select, input");
                        if (input) input.value = "";
                    });
                }

                if (value === "Completed") {
                    completedDivs.forEach(div => {
                        div.style.display = "block";
                        const input = div.querySelector("select, input");
                        input.setAttribute("required", "required");
                    });

                    if (reasonSelect) reasonSelect.value = "";
                }

                updateOverallStatus();
            }

            // Init on page load
            toggleFields();

            // Listen to change
            statusDropdown.addEventListener("change", toggleFields);
        });

        function updateOverallStatus() {
            const allDropdowns = document.querySelectorAll(".vaccine-status");
            const overallDropdown = document.getElementById("Status");

            // Check if all vaccine status dropdowns are filled
            const allFilled = Array.from(allDropdowns).every(d => d.value && d.value !== "");

            if (allFilled) {
                overallDropdown.value = "Completed";
            } else {
                overallDropdown.value = "Pending";
            }
        }

        // Immunization visibility evaluation on load and on changes
        function evaluateImmunizationVisibility() {
            debugger;
            const immunizationSection = document.getElementById("immunization-section");
            const questionDropdowns = document.querySelectorAll(".question-toggle");
            const statusDropdown = document.querySelector("select[name='Status']");
            let hideImmunization = false;

            questionDropdowns.forEach(function (dropdown) {
                const qNumber = dropdown.getAttribute("data-question");
                if (dropdown.value === "Yes") {
                    if (qNumber === "9") {
                        const pregnancyWrapper = document.getElementById(dropdown.getAttribute("data-target"));
                        const checkbox = pregnancyWrapper.querySelector("input[type='checkbox']");
                        if (!checkbox.checked) {
                            hideImmunization = true;
                        }
                    } else {
                        hideImmunization = true;
                    }
                }
            });

            if (hideImmunization) {
                immunizationSection.style.display = "none";

                // ✅ Clear all inputs in immunization section
                const inputs = immunizationSection.querySelectorAll("input, select, textarea");
                inputs.forEach(el => {
                    if (el.tagName === "SELECT") {
                        el.selectedIndex = 0; // reset to first option
                    } else if (el.type === "checkbox" || el.type === "radio") {
                        el.checked = false;
                    } else {
                        el.value = "";
                    }
                });

                @* // ✅ Handle status separately
                if (statusDropdown) {
                    statusDropdown.value = "Pending";
                    statusDropdown.disabled = true; // disable so user can't change
                } *@
            } else {
                immunizationSection.style.display = "block";
                @* if (statusDropdown) {
                    statusDropdown.disabled = false;
                    if (statusDropdown.value === "Not given") {
                        statusDropdown.value = "Pending"; // reset if it was Not given
                    }
                } *@
            }
        }

        // Init on load
        evaluateImmunizationVisibility();

        // Hook all question dropdowns and pregnancy checkbox
        document.querySelectorAll(".question-toggle").forEach(d => {
            d.addEventListener("change", evaluateImmunizationVisibility);
        });
        document.querySelectorAll(".pregnancy-checkbox").forEach(c => {
            c.addEventListener("change", evaluateImmunizationVisibility);
        });
    });

</script>


