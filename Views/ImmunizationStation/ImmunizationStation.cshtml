                            <option value="">Select Body Part</option>
                        </select>
                    </div>
                    <div class="col-md-2 vaccine-completed bodypart-other" style="display:none;">
                        <label>Body Part (Other)</label>
                        <input type="text" asp-for="HepBBodyPartOther" class="form-control" placeholder="Enter other body part" />
                    </div>
                    <!-- Site -->
                    <div class="col-md-2 vaccine-completed" style="display:none;">
                        <label>Site</label>
                        <select asp-for="HepBSite" class="form-control">
                            <option value="">Select Site</option>
                            <option value="Left">Left</option>
                            <option value="Right">Right</option>
