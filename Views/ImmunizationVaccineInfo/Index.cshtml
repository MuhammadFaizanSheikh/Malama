@model Malama.Models.ImmunizationVaccineViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml"; // Adjust the path to your layout file if necessary
    ViewData["Title"] = "Immunization Inventory";
}

<style>
    #page-heading {
        text-align: center;
        margin: 20px auto;
    }

    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white; /* ensures text is visible */
    }

        .btn-general:hover {
            background-color: rgba(60, 70, 180, 1); /* slightly darker on hover */
            border-color: rgba(60, 70, 180, 1);
            color: white;
        }

        .btn-general:focus,
        .btn-general:active {
            box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.5);
            outline: none;
        }

    .button-container {
        gap: 15px;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    table {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        table th,
        table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center; /* Aligns the text in the middle of the cell */
        }

        table th {
            background-color: #f4f4f4;
        }

        table tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

            table tbody tr:hover {
                background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
            }

        table td button,
        table td a {
            display: inline-block; /* Makes the buttons appear side by side */
            margin-right: 5px; /* Optional: Adds space between the buttons */
        }

        table td .button-container {
            display: flex;
            justify-content: center; /* Aligns buttons horizontally in the center */
        }

            table td .button-container a {
                margin-right: 5px; /* Optional: Adds space between the buttons */
            }

        table thead th {
            background-color: rgba(120, 130, 221, 1); /* Header background color */
            color: white; /* Header text color */
            text-align: center; /* Center-align header text */
        }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }
</style>


<h2 id="page-heading">Immunization Inventory</h2>


@* @if (ViewBag.EventIdList != null)
{
    <form method="get" asp-action="GetVaccineEntriesByEventId">
        <select id="eventIdDropdown" name="eventId" class="form-control" onchange="this.form.submit()">
            <option value="">-- Select Event --</option>
            @foreach (var item in ViewBag.EventIdList as List<SelectListItem>)
            {
                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
            }
        </select>
    </form>
} *@

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

            Swal.fire({
                icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor, // Conditional button color
                iconColor: iconColor // Conditional icon color
            });
        });
    </script>
}

@if (Model != null && Model.ListOfImmunizationVaccineInfo != null)
{
    <h2 id="page-heading">Event ID : @Model.EventId</h2>
    <div id="vaccineTableDiv">
        <div class="card p-3 mb-4">
            <div class="container">
                <div class="row g-2">
                    <!-- First Row -->
                    <div class="col-md-3">
                        <label for="filterVaccine" class="form-label">Vaccine</label>
                        <input type="text" id="filterVaccine" class="form-control" placeholder="Vaccine">

                    </div>
                    <div class="col-md-3">
                        <label for="filterManufacturer" class="form-label">Manufacturer</label>
                        <input type="text" id="filterManufacturer" class="form-control" placeholder="Manufacturer">

                    </div>
                   
                    <!-- Search Button (Centered) -->
                    <div class="col-12 text-center mt-3">
                        <button id="searchStaffBtn" type="button" class="btn btn-general">Search</button>
                        <button id="resetFiltersBtn" type="button" class="btn btn-general">Reset Filters</button>
                    </div>
                </div>
            </div>
        </div>


        <div id="datatableWrapper" class="datatable-wrapper">
            <table id="contractsTable" class="display">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>ImmunizationType</th>
                        <th>Vaccine</th>
                        <th>Manufacturer</th>
                        <th>Lot Number</th>
                        <th>Expiration</th>
                        <th>Starting Doses</th>
                        <th>Final Doses</th>
                        <th>Container Name</th>
                        <th>Inventory Added By</th>
                        <th>Inventory Added at</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.ListOfImmunizationVaccineInfo)
                    {
                        <tr>
                            <td>
                                <a asp-action="GetImmunizationVaccineInfoById" asp-route-immunizationId="@c.Id" class="btn btn-primary edit-btn" style="background-color: rgba(80, 90, 201, 1);">Edit</a>
                            </td>
                            <td>@c.ImmunizationType</td>
                            <td>@c.Vaccine</td>
                            <td>@c.Manufacturer</td>
                            <td>@Html.Raw(c.LotNumber)</td>
                            <td>@Html.Raw(c.Expiration)</td>
                            <td>@c.StartingDoses</td>
                            <td>@c.FinalDoses</td>
                            <td>@c.ContainerName</td>
                            <td>@c.AddedBy</td>
                            <td>@c.AddedOn.ToString("MM/dd/yyyy hh:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-center mt-4 pb-4">
        <a asp-action="AddNewVaccine" asp-route-eventId="@Model.EventId" class="btn btn-general" id="addInventoryBtn">Add Inventory</a>

    </div>
}
<div id="vaccineFormDiv">
    @if (Model != null && Model.SingleImmunizationVaccineInfo != null)
    {
        <h2 id="page-heading">Event ID : @Model.EventId</h2>
        <form asp-action="SaveVaccineEntry" method="post">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.SingleImmunizationVaccineInfo.Id)
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleImmunizationVaccineInfo.EventId" class="form-label">Event ID</label>
                    <input asp-for="SingleImmunizationVaccineInfo.EventId" class="form-control" readonly placeholder="Event ID" required />
                    <span asp-validation-for="SingleImmunizationVaccineInfo.EventId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleImmunizationVaccineInfo.EventDate" class="form-label">Immunization Entry Date</label>
                    <input asp-for="SingleImmunizationVaccineInfo.EventDate"
                           class="form-control"
                           type="date"
                           value="@(Model.SingleImmunizationVaccineInfo.EventDate != DateTime.MinValue
               ? Model.SingleImmunizationVaccineInfo.EventDate.ToString("yyyy-MM-dd")
               : string.Empty)"
                           required />

                    <span asp-validation-for="SingleImmunizationVaccineInfo.EventDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleImmunizationVaccineInfo.ImmunizationType" class="form-label">Immunization Type</label>
                    <select asp-for="SingleImmunizationVaccineInfo.ImmunizationType" id="immunizationType" class="form-select" required>
                        <option value="">Select Immunization Type</option>
                        <option>HepB</option>
                        <option>Flu</option>
                        <option>MMR</option>
                        <option>HepA</option>
                        <option>Tet/Tdap</option>
                        <option>Varicella</option>
                    </select>
                    <span asp-validation-for="SingleImmunizationVaccineInfo.ImmunizationType" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleImmunizationVaccineInfo.Vaccine" class="form-label">Vaccine</label>
                    <select asp-for="SingleImmunizationVaccineInfo.Vaccine" id="vaccine" class="form-control" required></select>
                    <span asp-validation-for="SingleImmunizationVaccineInfo.Vaccine" class="text-danger"></span>
                </div>
                
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleImmunizationVaccineInfo.Manufacturer" class="form-label">Manufacturer</label>
                    <select asp-for="SingleImmunizationVaccineInfo.Manufacturer" id="manufacturer" class="form-control" readonly required></select>
                    <span asp-validation-for="SingleImmunizationVaccineInfo.Manufacturer" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Dose</label>
                    <input asp-for="SingleImmunizationVaccineInfo.Dose" id="dose" value="@Model.SingleImmunizationVaccineInfo.Dose"
                           class="form-control" placeholder="Enter dose" readonly required />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Unit</label>
                    <input asp-for="SingleImmunizationVaccineInfo.Unit" id="unit" value="@Model.SingleImmunizationVaccineInfo.Unit"
                           class="form-control" placeholder="Enter Unit" readonly required />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleImmunizationVaccineInfo.StartingDoses" class="form-label">Starting Doses</label>
                    <input asp-for="SingleImmunizationVaccineInfo.StartingDoses" type="number" class="form-control" placeholder="Enter starting doses" required />
                    <span asp-validation-for="SingleImmunizationVaccineInfo.StartingDoses" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleImmunizationVaccineInfo.FinalDoses" class="form-label">Final Doses</label>
                    <input asp-for="SingleImmunizationVaccineInfo.FinalDoses" type="number" class="form-control" placeholder="Enter final doses" />
                </div>
            </div>

            <h4>Lots</h4>
            <div id="lotsContainer">

                @{
                    var lots = Model.SingleImmunizationVaccineInfo.Lots;
                    if (lots == null || !lots.Any())
                    {
                        lots = new List<ImmunizationVaccineLotEntry> { new ImmunizationVaccineLotEntry() };
                    }
                }

                @for (int i = 0; i < lots.Count; i++)
                {
                    <div class="row mb-3 lot-row align-items-end">
                        <!-- Lot Number -->
                        <div class="col-md-3">
                            <label class="form-label">Lot Number</label>
                            <input type="text"
                                   name="SingleImmunizationVaccineInfo.Lots[@i].LotNumber"
                                   value="@lots[i].LotNumber"
                                   class="form-control"
                                   placeholder="Enter lot number"
                                   required />
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="SingleImmunizationVaccineInfo.Lots[@i].LotNumber"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <!-- Expiration -->
                        <div class="col-md-3">
                            <label class="form-label">Expiration</label>
                            <input type="date"
                                   name="SingleImmunizationVaccineInfo.Lots[@i].Expiration"
                                   value="@(lots[i].Expiration != default(DateTime) ? lots[i].Expiration.ToString("yyyy-MM-dd") : string.Empty)"
                                   class="form-control"
                                   required />
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="SingleImmunizationVaccineInfo.Lots[@i].Expiration"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <!-- Container -->
                        <div class="col-md-3">
                            <label class="form-label">Select Container</label>
                            <select name="SingleImmunizationVaccineInfo.Lots[@i].ContainerId"
                                    class="form-control"
                                    required>
                                <option value="">Select Container</option>
                                @if (ViewBag.ContainerList != null)
                                {
                                    foreach (var c in ViewBag.ContainerList as List<SelectListItem>)
                                    {
                                        <option value="@c.Value" selected="@(c.Value == lots[i].ContainerId.ToString() ? "selected" : null)">
                                            @c.Text
                                        </option>
                                    }
                                }
                            </select>
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="SingleImmunizationVaccineInfo.Lots[@i].ContainerId"
                                  data-valmsg-replace="true"></span>
                        </div>
                    </div>
                }





            </div>

            <button type="button" id="addLotBtn" class="btn btn-general">Add another Lot</button>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" id="submitBtn" class="btn btn-success btn-lg me-3" name="action" value="Add">
                    <i class="bi bi-check-circle"></i> Submit
                </button>
                <button type="reset" id="resetBtn" class="btn btn-secondary btn-lg me-3">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg me-3" id="backToTableBtn">Back</a>

            </div>
        </form>

    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // --- Add Inventory button ---
        const addInventoryBtn = document.getElementById("addInventoryBtn");
        if (addInventoryBtn) {
            addInventoryBtn.addEventListener("click", function () {
                const eventDropdown = document.getElementById("eventIdDropdown");
                const selectedEvent = eventDropdown ? eventDropdown.value : "";

                const eventInput = document.querySelector("[name='SingleImmunizationVaccineInfo.EventId']");
                if (eventInput) eventInput.value = selectedEvent;
            });
        }

        // --- Back button ---
        const backBtn = document.getElementById("backToTableBtn");
        if (backBtn) {
            backBtn.addEventListener("click", function () {
                const tableDiv = document.getElementById("vaccineTableDiv");
                const formDiv = document.getElementById("vaccineFormDiv");
                const inventoryBtn = document.getElementById("addInventoryBtn");

                if (formDiv) formDiv.style.display = "none";
                if (tableDiv) tableDiv.style.display = "block";
                if (inventoryBtn) inventoryBtn.style.display = "block";
            });
        }

        // --- Add Lot button ---
        const addLotBtn = document.getElementById("addLotBtn");
        const maxLots = 5;
        if (addLotBtn) {
            addLotBtn.addEventListener("click", function () {
                const container = document.getElementById("lotsContainer");
                const lotRows = container.querySelectorAll(".lot-row");
                const nextIndex = lotRows.length;

                if (nextIndex >= maxLots) {
                    alert("Maximum 5 lots allowed.");
                    return;
                }

                const row = document.createElement("div");
                row.className = "row mb-3 lot-row align-items-end";

                row.innerHTML = `
                <div class="col-md-3">
                    <label class="form-label">Lot Number</label>
                    <input name="SingleImmunizationVaccineInfo.Lots[${nextIndex}].LotNumber"
                           class="form-control" placeholder="Enter lot number" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Expiration</label>
                    <input name="SingleImmunizationVaccineInfo.Lots[${nextIndex}].Expiration"
                           type="date" class="form-control" required />
                </div>
    @if (ViewBag.ContainerList != null && (ViewBag.ContainerList as List<SelectListItem>).Any())
    {
                <div class="col-md-3">
                <label class="form-label">Select Container</label>
                        <select name="SingleImmunizationVaccineInfo.Lots[${nextIndex}].ContainerId"
                        class="form-control" required>
                    <option value="">Select Container</option>
                            @foreach (var container in ViewBag.ContainerList as List<SelectListItem>)
                            {
                                <option value="@container.Value">@container.Text</option>
                            }
                </select>
            </div>
    }
            `;
                container.appendChild(row);
            });
        }

        // --- Vaccine Data ---
        const vaccineData = {
            "HepA": [
                { name: "Havrix", manufacturer: "GlaxoSmithKline", dose: "0.5", unit: "ml" },
                { name: "Vaqta", manufacturer: "Merck", dose: "1", unit: "ml" }
            ],
            "HepB": [
                { name: "Engerix-B", manufacturer: "GlaxoSmithKline", dose: "0.5", unit: "ml" },
                { name: "Engerix-B", manufacturer: "GlaxoSmithKline", dose: "1", unit: "ml" },
                { name: "Recombivax HB", manufacturer: "Merck", dose: "1", unit: "ml" },
                { name: "Heplisav-B", manufacturer: "Dynavax Technologies", dose: "0.5", unit: "ml" }
            ],
            "Flu": [
                { name: "Afluria", manufacturer: "Seqirus", dose: "0.5", unit: "ml" },
                { name: "Fluarix", manufacturer: "GlaxoSmithKline", dose: "0.5", unit: "ml" },
                { name: "Flublok", manufacturer: "Sanofi", dose: "0.5", unit: "ml" },
                { name: "Flucelvax", manufacturer: "Seqirus", dose: "0.5", unit: "ml" },
                { name: "FluLaval", manufacturer: "GlaxoSmithKline", dose: "0.5", unit: "ml" },
                { name: "FluMist", manufacturer: "Medimmune", dose: "0.2", unit: "ml" },
                { name: "Fluzone", manufacturer: "Sanofi", dose: "0.5", unit: "ml" }
            ],
            "MMR": [
                { name: "M-M-R II", manufacturer: "Merck", dose: "0.5", unit: "ml" },
                { name: "Priorix", manufacturer: "GlaxoSmithKline", dose: "0.5", unit: "ml" }
            ],
            "Tet/Tdap": [
                { name: "Boostrix", manufacturer: "GlaxoSmithKline", dose: "0.5", unit: "ml" },
                { name: "Adacel", manufacturer: "Sanofi", dose: "0.5", unit: "ml" }
            ],
            "Varicella": [
                { name: "Varivax", manufacturer: "Merck", dose: "0.5", unit: "ml" }
            ]
        };


        const immunizationSelect = document.getElementById('immunizationType');
        const vaccineSelect = document.getElementById('vaccine');
        const manufacturerSelect = document.getElementById('manufacturer');
        let doseField = document.getElementById('dose');
        const unitField = document.getElementById('unit');

        // --- Populate vaccines by type ---
        // function populateVaccines(type) {
        //     vaccineSelect.innerHTML = '<option value="">Select Vaccine</option>';
        //     manufacturerSelect.innerHTML = '<option value="">Select Manufacturer</option>';
        //     resetDoseField();
        //     unitField.value = "";

        //     if (!type || !vaccineData[type]) return;

        //     // Create a Set of unique vaccine names
        //     const uniqueNames = [...new Set(vaccineData[type].map(v => v.name))];

        //     uniqueNames.forEach(name => {
        //         const opt = new Option(name, name);
        //         vaccineSelect.appendChild(opt);
        //     });
        // }

        // --- Populate vaccines by type ---
        // now accepts optional second arg: selectedVaccine
        function populateVaccines(type, selectedVaccine = "", selectedManufacturer = "", selectedDose = "", selectedUnit = "") {
            vaccineSelect.innerHTML = '<option value="">Select Vaccine</option>';
            manufacturerSelect.innerHTML = '<option value="">Select Manufacturer</option>';
            resetDoseField();
            unitField.value = "";

            if (!type || !vaccineData[type]) return;

            // Create a Set of unique vaccine names
            const uniqueNames = [...new Set(vaccineData[type].map(v => v.name))];

            uniqueNames.forEach(name => {
                const opt = new Option(name, name);
                vaccineSelect.appendChild(opt);
            });

            // If we’re in edit mode
            if (selectedVaccine) {
                vaccineSelect.value = selectedVaccine;

                // Use small delay to let DOM settle before triggering next step
                setTimeout(() => {
                    handleVaccineSelection.call(vaccineSelect);

                    // Wait a bit more for Engerix-type vaccines (DOM replacement)
                    setTimeout(() => {
                        // Set manufacturer if provided
                        if (selectedManufacturer) {
                            manufacturerSelect.value = selectedManufacturer;
                        }

                        // Re-fetch doseField in case it was replaced with <select>
                        doseField = document.getElementById('dose');

                        if (doseField) {
                            if (doseField.tagName.toLowerCase() === 'select') {
                                // Multi-dose case (Engerix)
                                doseField.value = selectedDose;

                                // Trigger change to update unit
                                const evt = new Event('change', { bubbles: true });
                                doseField.dispatchEvent(evt);
                            } else {
                                // Single-dose case
                                doseField.value = selectedDose;
                            }
                        }

                        if (selectedUnit) {
                            unitField.value = selectedUnit;
                            unitField.readOnly = true;
                        }
                    }, 100);
                }, 0);
            }
        }



        // --- Reset dose field back to readonly input ---
        function resetDoseField() {
            const container = doseField.parentElement;
            if (doseField.tagName.toLowerCase() === 'select') {
                const newInput = document.createElement('input');
                newInput.type = 'text';
                newInput.id = 'dose';
                newInput.name = 'dose';
                newInput.className = 'form-control';
                newInput.readOnly = true;
                container.replaceChild(newInput, doseField);
                doseField = newInput; // update reference
            }
            doseField.value = "";
            doseField.readOnly = true;
            doseField.required = false;
        }

        // --- When vaccine selected ---
        function handleVaccineSelection() {
            const type = immunizationSelect.value;
            const vaccineName = this.value;

            if (!type || !vaccineName) return;

            const matchingVaccines = vaccineData[type]?.filter(v => v.name === vaccineName);
            if (!matchingVaccines?.length) return;

            // Reset first to ensure correct state
            resetDoseField();

            // If only one version (single dose)
            if (matchingVaccines.length === 1) {
                const v = matchingVaccines[0];
                manufacturerSelect.innerHTML = `<option value="${v.manufacturer}">${v.manufacturer}</option>`;
                manufacturerSelect.value = v.manufacturer;

                doseField.value = v.dose;
                doseField.readOnly = true;
                doseField.required = false;

                unitField.value = v.unit;
                unitField.readOnly = true;
            }
            // If multiple doses exist
            else {
                manufacturerSelect.innerHTML = `<option value="${matchingVaccines[0].manufacturer}">
                                                ${matchingVaccines[0].manufacturer}
                                            </option>`;

                doseField.outerHTML = `
                <select id="dose" name="SingleImmunizationVaccineInfo.Dose"
                        class="form-control" required>
                    <option value="">Select Dose</option>
                    ${matchingVaccines.map(v =>
                    `<option value="${v.dose}">${v.dose} ${v.unit}</option>`
                ).join('')}
                </select>
            `;
                doseField = document.getElementById('dose'); // update reference

                // Handle dose change
                doseField.addEventListener('change', function () {
                    const selected = matchingVaccines.find(v => v.dose === this.value);
                    if (selected) {
                        unitField.value = selected.unit;
                        unitField.readOnly = true;
                    }
                });
            }
        }

        // --- Events ---
        immunizationSelect.addEventListener('change', function () {
            populateVaccines(this.value);
        });

        vaccineSelect.addEventListener('change', handleVaccineSelection);


        // --- Prefill for Edit Mode ---
        const selectedType = @Html.Raw(Json.Serialize(Model?.SingleImmunizationVaccineInfo?.ImmunizationType ?? ""));
        const selectedVaccine = @Html.Raw(Json.Serialize(Model?.SingleImmunizationVaccineInfo?.Vaccine ?? ""));
        const selectedManufacturer = @Html.Raw(Json.Serialize(Model?.SingleImmunizationVaccineInfo?.Manufacturer ?? ""));
        const selectedDose = @Html.Raw(Json.Serialize(Model?.SingleImmunizationVaccineInfo?.Dose));
        const selectedUnit = @Html.Raw(Json.Serialize(Model?.SingleImmunizationVaccineInfo?.Unit ?? ""));

        if (selectedType && selectedVaccine) {
            immunizationSelect.value = selectedType;
            populateVaccines(selectedType, selectedVaccine, selectedManufacturer, selectedDose, selectedUnit);
        }

    }); // END DOMContentLoaded

    // --- Search button (outside) ---
    $('#searchStaffBtn').on('click', function () {
        const vaccine = $('#filterVaccine').val().trim().toLowerCase();
        const manufacturer = $('#filterManufacturer').val().trim().toLowerCase();
        const contractsTable = $('#contractsTable').DataTable();

        contractsTable.columns().search('');

        if (vaccine) contractsTable.column(2).search(vaccine, true, false, true);
        if (manufacturer) contractsTable.column(3).search(manufacturer, true, false, true);

        contractsTable.draw();
    });

    $('#resetFiltersBtn').on('click', function () {
    // Clear filter input fields
    $('#filterVaccine').val('');
    $('#filterManufacturer').val('');

    // Reset DataTable searches
    const contractsTable = $('#contractsTable').DataTable();
    contractsTable.search('').columns().search('').draw();
});

</script>

