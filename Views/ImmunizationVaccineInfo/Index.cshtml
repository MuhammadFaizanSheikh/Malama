@model Malama.Models.ImmunizationVaccineViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml"; // Adjust the path to your layout file if necessary
    ViewData["Title"] = "Immunization Inventory";
}

<style>
    #page-heading {
        text-align: center;
        margin: 20px auto;
    }

    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white; /* ensures text is visible */
    }

        .btn-general:hover {
            background-color: rgba(60, 70, 180, 1); /* slightly darker on hover */
            border-color: rgba(60, 70, 180, 1);
            color: white;
        }

        .btn-general:focus,
        .btn-general:active {
            box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.5);
            outline: none;
        }

    .button-container {
        gap: 15px;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    table {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        table th,
        table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center; /* Aligns the text in the middle of the cell */
        }

        table th {
            background-color: #f4f4f4;
        }

        table tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

            table tbody tr:hover {
                background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
            }

        table td button,
        table td a {
            display: inline-block; /* Makes the buttons appear side by side */
            margin-right: 5px; /* Optional: Adds space between the buttons */
        }

        table td .button-container {
            display: flex;
            justify-content: center; /* Aligns buttons horizontally in the center */
        }

            table td .button-container a {
                margin-right: 5px; /* Optional: Adds space between the buttons */
            }

        table thead th {
            background-color: rgba(120, 130, 221, 1); /* Header background color */
            color: white; /* Header text color */
            text-align: center; /* Center-align header text */
        }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }
</style>


<h2 id="page-heading" >Immunization Station</h2>

@if (ViewBag.EventIdList != null)
{
<form method="get" asp-action="GetEventData">
    <select id="eventIdDropdown" name="eventId" class="form-control" onchange="this.form.submit()">
        <option value="">-- Select Event --</option>
        @foreach (var item in ViewBag.EventIdList as List<SelectListItem>)
        {
            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
        }
    </select>
</form>
}

@if (Model != null && Model.ListOfImmunizationVaccineInfo.Any())
{
<div class="card p-3 mb-4">
    <div class="container">
        <div class="row g-2">
            <!-- First Row -->
            <div class="col-md-3">
                <label for="filterBarcode" class="form-label">Client</label>
                    <input type="text" id="filterBarcode" class="form-control" placeholder="Client">

            </div>
            <div class="col-md-3">
                <label for="filterFullName" class="form-label">Vaccine</label>
                    <input type="text" id="filterFullName" class="form-control" placeholder="Vaccine">

            </div>
            <div class="col-md-3">
                <label for="filterDodId" class="form-label">Manufacturer</label>
                    <input type="text" id="filterDodId" class="form-control" placeholder="Manufacturer">

            </div>
            <div class="col-md-3">
                <label for="filterDob" class="form-label">Lot Number</label>
                    <input type="date" id="filterDob" class="form-control" placeholder="Lot Number">
            </div>
            <!-- Search Button (Centered) -->
            <div class="col-12 text-center mt-3">
                <button id="searchStaffBtn" type="button" class="btn btn-general">Search</button>
                <button id="resetFiltersBtn" type="button" class="btn btn-general">Reset Filters</button>
            </div>
        </div>
    </div>
</div>
 

<div id="datatableWrapper" class="datatable-wrapper">
    <table id="contractsTable" class="display">
    <thead>
        <tr>
            <th>Action</th>
            <th>Client</th>
            <th>Event Location</th>
            <th>Vaccine</th>
            <th>Manufacturer</th>
            @* <th>Lot Number</th>
            <th>Expiration</th> *@
            <th>Starting Doses</th>
            <th>Final Doses</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.ListOfImmunizationVaccineInfo)
        {
            <tr>
                <td>
                        <a asp-action="ImmunizationVaccineInfo" asp-route-immunizationId="@c.Id" asp-route-fileDataId="@c.Id" class="btn btn-primary edit-btn" style="background-color: rgba(80, 90, 201, 1);">Edit</a>
                </td>
                        <td>@c.Client</td>
                        <td>@c.EventLocation</td>
                        <td>@c.Vaccine</td>
                        <td>@c.Manufacturer</td>
                        @* <td>@c.LotNumber</td>
                        <td>@c.Expiration</td> *@
                        <td>@c.StartingDoses</td>
                        <td>@c.FinalDoses</td>
            </tr>
        }
    </tbody>
</table>
</div>
}

@if (Model != null)
{
<form asp-action="SaveVaccineEntry" method="post">
    @Html.AntiForgeryToken()

    <div class="row mb-3">
        <div class="col-md-4">
            <label asp-for="SingleImmunizationVaccineInfo.Client" class="form-label"></label>
            <input asp-for="SingleImmunizationVaccineInfo.Client" class="form-control" />
            <span asp-validation-for="SingleImmunizationVaccineInfo.Client" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="SingleImmunizationVaccineInfo.EventId" class="form-label"></label>
            <input asp-for="SingleImmunizationVaccineInfo.EventId" class="form-control" readonly />
            <span asp-validation-for="SingleImmunizationVaccineInfo.EventId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="SingleImmunizationVaccineInfo.EventLocation" class="form-label"></label>
            <input asp-for="SingleImmunizationVaccineInfo.EventLocation" class="form-control" />
            <span asp-validation-for="SingleImmunizationVaccineInfo.EventLocation" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label asp-for="SingleImmunizationVaccineInfo.EventDate" class="form-label"></label>
            <input asp-for="SingleImmunizationVaccineInfo.EventDate" type="date" class="form-control" />
            <span asp-validation-for="SingleImmunizationVaccineInfo.EventDate" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="SingleImmunizationVaccineInfo.Vaccine" class="form-label"></label>
            <input asp-for="SingleImmunizationVaccineInfo.Vaccine" class="form-control" />
            <span asp-validation-for="SingleImmunizationVaccineInfo.Vaccine" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="SingleImmunizationVaccineInfo.Manufacturer" class="form-label"></label>
            <input asp-for="SingleImmunizationVaccineInfo.Manufacturer" class="form-control" />
            <span asp-validation-for="SingleImmunizationVaccineInfo.Manufacturer" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label asp-for="SingleImmunizationVaccineInfo.StartingDoses" class="form-label"></label>
            <input asp-for="SingleImmunizationVaccineInfo.StartingDoses" type="number" class="form-control" />
            <span asp-validation-for="SingleImmunizationVaccineInfo.StartingDoses" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="SingleImmunizationVaccineInfo.FinalDoses" class="form-label"></label>
            <input asp-for="SingleImmunizationVaccineInfo.FinalDoses" type="number" class="form-control" />
            <span asp-validation-for="SingleImmunizationVaccineInfo.FinalDoses" class="text-danger"></span>
        </div>
    </div>

    <h4>Lots</h4>
    <div id="lotsContainer">
        <!-- Existing lots will render here -->
        @for (int i = 0; i < Model.SingleImmunizationVaccineInfo.Lots.Count; i++)
        {
            <div class="row mb-2 lot-row">
                <div class="col-md-4">
                    <label asp-for="@Model.SingleImmunizationVaccineInfo.Lots[i].LotNumber" class="form-label"></label>
                    <input asp-for="@Model.SingleImmunizationVaccineInfo.Lots[i].LotNumber" class="form-control" />
                    <span asp-validation-for="@Model.SingleImmunizationVaccineInfo.Lots[i].LotNumber" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="@Model.SingleImmunizationVaccineInfo.Lots[i].Expiration" class="form-label"></label>
                    <input asp-for="@Model.SingleImmunizationVaccineInfo.Lots[i].Expiration" type="date" class="form-control" />
                    <span asp-validation-for="@Model.SingleImmunizationVaccineInfo.Lots[i].Expiration" class="text-danger"></span>
                </div>
            </div>
        }
    </div>

    <button type="button" id="addLotBtn" class="btn btn-secondary">Add another Lot</button>
    <small class="text-muted d-block">Maximum 5 lots allowed.</small>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
}
<script>
    $('#searchStaffBtn').on('click', function () {
        var barcode = $('#filterBarcode').val().trim().toLowerCase();
        var fullName = $('#filterFullName').val().trim().toLowerCase();
        var dodId = $('#filterDodId').val().trim();
        var dob = $('#filterDob').val();
        var last4Ssn = $('#filterLast4Ssn').val().trim();
        var status = $('#filterStatus').val().trim().toLowerCase();

        var contractsTable = $('#contractsTable').DataTable();

        // Clear previous searches
        contractsTable.columns().search('');

        if (barcode) {
            contractsTable.column(8).search(barcode, true, false, true);
        }

        if (fullName) {
            const escapedFullName = fullName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            contractsTable.column(3).search(escapedFullName, true, false, true);
        }

        if (dodId) {
            contractsTable.column(5).search('^' + dodId + '$', true, false);
        }

        if (dob) {
            contractsTable.column(7).search(formatDateToMMDDYYYY(dob));
        }

        if (last4Ssn) {
            contractsTable.column(4).search('^' + last4Ssn + '$', true, false);
        }

        if (status) {
            contractsTable.column(1).search(status, true, false, true);
        }

        contractsTable.draw();
        // $('#contractsTable').DataTable().destroy();

        // var contractsTable = $('#contractsTable').DataTable({
        //     searching: false,   // no default search box
        //     paging: false,       // keep pagination
        //     info: false,         // keep "Showing 1 to N of X entries"
        //     lengthChange: false,  // show "Show 10/25/50" dropdown (optional)
        //         columnDefs: [
        //         { className: "text-center", targets: "_all" }  // all columns centered
        //     ],
        //     ordering: false
        // });

    });

    function formatDateToMMDDYYYY(dateString) {
        const [year, month, day] = dateString.split('-'); // Split the yyyy/mm/dd format
        return `${month}/${day}/${year}`; // Return as mm/dd/yyyy
    }

    function resetAllFilters() {
        

        // Clear all input and select fields
        $('#filterBarcode').val('');
        $('#filterFullName').val('');
        $('#filterDodId').val('');
        $('#filterDob').val('');
        $('#filterLast4Ssn').val('');
        $('#filterStatus').val('');
        var previewTable = $('#contractsTable').DataTable();
        previewTable.columns().search('');
        previewTable.search('').draw();
        
    }
    // Reset button
    document.getElementById("resetFiltersBtn").addEventListener("click", function () {
        resetAllFilters();
    });

    function allowOnlyDigits(input) {
        // Allow only digits
        input.value = input.value.replace(/\D/g, '');
    }

</script>
