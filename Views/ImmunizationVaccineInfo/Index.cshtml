<script>
    document.addEventListener("DOMContentLoaded", function () {

        // --- Add Inventory button ---
        const addInventoryBtn = document.getElementById("addInventoryBtn");
        if (addInventoryBtn) {
            addInventoryBtn.addEventListener("click", function () {
                const eventDropdown = document.getElementById("eventIdDropdown");
                const selectedEvent = eventDropdown ? eventDropdown.value : "";

                const eventInput = document.querySelector("[name='SingleImmunizationVaccineInfo.EventId']");
                if (eventInput) eventInput.value = selectedEvent;
            });
        }

        // --- Back button ---
        const backBtn = document.getElementById("backToTableBtn");
        if (backBtn) {
            backBtn.addEventListener("click", function () {
                const tableDiv = document.getElementById("vaccineTableDiv");
                const formDiv = document.getElementById("vaccineFormDiv");
                const inventoryBtn = document.getElementById("addInventoryBtn");

                if (formDiv) formDiv.style.display = "none";
                if (tableDiv) tableDiv.style.display = "block";
                if (inventoryBtn) inventoryBtn.style.display = "block";
            });
        }

        // --- Add Lot button ---
        const addLotBtn = document.getElementById("addLotBtn");
        const maxLots = 5;
        if (addLotBtn) {
            addLotBtn.addEventListener("click", function () {
                const container = document.getElementById("lotsContainer");
                const lotRows = container.querySelectorAll(".lot-row");
                const nextIndex = lotRows.length;

                if (nextIndex >= maxLots) {
                    alert("Maximum 5 lots allowed.");
                    return;
                }

                const row = document.createElement("div");
                row.className = "row mb-2 lot-row";
                row.innerHTML = `
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Lot Number</label>
                        <input name="SingleImmunizationVaccineInfo.Lots[${nextIndex}].LotNumber"
                               placeholder="Enter lot number" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Expiration</label>
                        <input name="SingleImmunizationVaccineInfo.Lots[${nextIndex}].Expiration"
                               type="date" class="form-control" required />
                    </div>`;
                container.appendChild(row);
            });
        }

        // --- Vaccine Data ---
        const vaccineData = {
            "HepA": [
                { name: "Havrix", manufacturer: "GlaxoSmithKline" },
                { name: "Vaqta", manufacturer: "Merck" }
            ],
            "HepB": [
                { name: "Engerix-B", manufacturer: "GlaxoSmithKline" },
                { name: "Recombivax HB", manufacturer: "Merck" },
                { name: "Heplisav-B", manufacturer: "Dynavax Technologies" }
            ],
            "Flu": [
                { name: "Afluria", manufacturer: "Seqirus" },
                { name: "Fluad", manufacturer: "Seqirus" },
                { name: "Fluarix", manufacturer: "GlaxoSmithKline" },
                { name: "Flublok", manufacturer: "Sanofi" },
                { name: "Flucelvax", manufacturer: "Seqirus" },
                { name: "FluLaval", manufacturer: "GlaxoSmithKline" },
                { name: "FluMist", manufacturer: "Medimmune" },
                { name: "Fluzone", manufacturer: "Sanofi" },
                { name: "Fluzone High-Dose", manufacturer: "Sanofi" }
            ],
            "MMR": [
                { name: "M-M-R II", manufacturer: "Merck" },
                { name: "Priorix", manufacturer: "GlaxoSmithKline" }
            ],
            "Tet/Tdap": [
                { name: "Boostrix", manufacturer: "GlaxoSmithKline" },
                { name: "Adacel", manufacturer: "Sanofi" }
            ],
            "Varicella": [
                { name: "Varivax", manufacturer: "Merck" }
            ]
        };

        const immunizationSelect = document.getElementById('immunizationType');
        const vaccineSelect = document.getElementById('vaccine');
        const manufacturerSelect = document.getElementById('manufacturer');

        // --- Helper Functions ---
        function populateVaccines(type, selectedVaccine = '') {
            vaccineSelect.innerHTML = '<option value="">Select Vaccine</option>';

            if (type && vaccineData[type]) {
                vaccineData[type].forEach(v => {
                    const opt = new Option(v.name, v.name);
                    vaccineSelect.appendChild(opt);
                });
                if (selectedVaccine) {
                    vaccineSelect.value = selectedVaccine;
                    populateManufacturer(type, selectedVaccine);
                }
            }
        }

        function populateManufacturer(type, vaccine) {
            const selectedObj = vaccineData[type]?.find(v => v.name === vaccine);
            if (selectedObj) {
                const opt = new Option(selectedObj.manufacturer, selectedObj.manufacturer);
                manufacturerSelect.appendChild(opt);
                manufacturerSelect.value = selectedObj.manufacturer;
            }
        }

        // --- Events ---
        immunizationSelect.addEventListener('change', function () {
            populateVaccines(this.value);
        });

        vaccineSelect.addEventListener('change', function () {
            populateManufacturer(immunizationSelect.value, this.value);
        });

        // --- Prefill for Edit Mode ---
        const selectedType = @Html.Raw(Json.Serialize(Model?.SingleImmunizationVaccineInfo?.ImmunizationType ?? ""));
        const selectedVaccine = @Html.Raw(Json.Serialize(Model?.SingleImmunizationVaccineInfo?.Vaccine ?? ""));


        if (selectedType) {
            immunizationSelect.value = selectedType;
            populateVaccines(selectedType, selectedVaccine);
        }

    }); // END DOMContentLoaded

    // --- Search button (outside) ---
    $('#searchStaffBtn').on('click', function () {
        const vaccine = $('#filterVaccine').val().trim().toLowerCase();
        const manufacturer = $('#filterManufacturer').val().trim().toLowerCase();
        const contractsTable = $('#contractsTable').DataTable();

        contractsTable.columns().search('');

        if (vaccine) contractsTable.column(1).search(vaccine, true, false, true);
        if (manufacturer) contractsTable.column(2).search(manufacturer, true, false, true);

        contractsTable.draw();
    });
</script>

