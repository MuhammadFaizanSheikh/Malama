@model Malama.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    body {
        background-color: rgba(80, 90, 201, 0.1);
        height: 100vh;
        align-items: center;
        justify-content: center;
        margin: 0;
    }

    h2 {
        color: rgba(80, 90, 201, 1);
        text-align: center;
        margin-bottom: 20px;
    }

    .form-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
    }

    /* Shared sizing for both buttons */
    /* Shared sizing for both buttons */
    .btn-theme,
    .btn-action {
        width: 100%;
        height: 40px;
        padding: 10px;
        font-size: 16px;
        border-radius: 5px;
    }

    /* Register button color */
    .btn-theme {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white;
    }

        .btn-theme:hover {
            background-color: rgba(80, 90, 201, 0.8);
            border-color: rgba(80, 90, 201, 0.8);
        }

    /* Delete button color */
    .btn-danger.btn-action {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
    }

        .btn-danger.btn-action:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }



    #loadingIndicator {
        display: none;
    }

    .form-control {
        font-size: 16px;
        height: 40px; /* Adjust height */
    }

        .form-control option {
            font-size: 16px; /* Adjust font size inside dropdown */
        }

    /* Base styles for the dropdown */
    .select2 {
        width: 100%;
        font-size: 14px;
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 5px;
        background-color: #fff;
        color: #333;
        transition: border-color 0.3s, box-shadow 0.3s;
    }
        /*
        /* Focused state */
        .select2:focus {
            border-color: #0056b3;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
        }

    /* Dropdown arrow customization */


    /* Adjust the dropdown width */
    .select2 {
        width: 100% !important; /* Ensures full-width dropdown */
    }



        /* Hover state for options */
        .select2 option:hover {
            background-color: #e6f7ff;
        }

        /* Focus state for options */
        .select2 option:focus {
            background-color: #cce5ff;
        }

        /* Disabled state */
        .select2 option:disabled {
            color: #aaa;
            background-color: #f5f5f5;
        }
</style>
<div class="form-container">
    <h2>Create User</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            $(document).ready(function () {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: '@TempData["SuccessMessage"]',
                    timer: 2500,
                    showConfirmButton: false
                });
            });
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            $(document).ready(function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: '@TempData["ErrorMessage"]'
                });
            });
        </script>
    }



    <form method="post" asp-action="Register" id="registrationForm" autocomplete="off">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <input type="hidden" id="UserId" name="Id" value="" />

        <div class="form-group" id="emailGroup">
            <label asp-for="Email" class="font-weight-bold"></label>
            <input asp-for="Email" class="form-control" placeholder="Enter your email" autocomplete="off" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group" id="passwordGroup">
            <label asp-for="Password" class="font-weight-bold"></label>
            <div class="input-group">
                <input asp-for="Password" type="text" class="form-control" placeholder="Enter your password" autocomplete="off" required />
                <div class="input-group-append">
                    <button type="button" class="btn btn-secondary" id="generatePasswordBtn">Auto Generate Password</button>
                </div>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        @foreach (var role in (List<SelectListItem>)ViewData["Roles"])
        {
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input role-checkbox"
                       id="role_@role.Value"
                       name="SelectedRoles"
                       value="@role.Text" /> <!-- Use Name here -->
                <label class="form-check-label" for="role_@role.Value">
                    @role.Text
                </label>
            </div>
        }

        <!-- MUST BE OUTSIDE FOREACH -->
        <div class="form-group d-none ml-4 mt-2" id="eventSelection">
            <label class="font-weight-bold">Select Event(s)</label>
            <select id="SelectedEventIds" name="SelectedEventIds" multiple class="form-control">
                @foreach (var evt in (List<SelectListItem>)ViewData["Events"])
                {
                    <option value="@evt.Value">@evt.Text</option>
                }
            </select>
        </div>


        <button type="submit" class="btn btn-theme mb-2" id="registerBtn">Register</button>
        <button type="button" id="deleteUserBtn" class="btn btn-danger btn-action" style="display:none;">Delete User</button>


        <div class="form-group">
            <button type="button" id="findUserBtn" class="btn btn-secondary mt-2">
                Find User
            </button>
        </div>

        <select id="userDropdown" class="form-control" style="display:none; margin-bottom: 10px;"></select>

        <div id="loadingIndicator" class="text-center mt-2">
            <span>Loading...</span>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {

        $(`#SelectedEventIds`).select2({
            placeholder: "Select options",
            allowClear: true
        });

        $("#registerBtn").click(function (event) {
            if ($("input[name='SelectedRoles']:checked").length === 0) {
                $("#roleError").show();
                event.preventDefault(); // Prevent form submission
            } else {
                $("#roleError").hide();
            }
        });

        $('#findUserBtn').click(function () {
            $.ajax({
                url: '@Url.Action("GetUsers", "AccountRegistration")',
                type: 'GET',
                success: function (data) {
                    var result = data.data;
                    $('#userDropdown').empty().append('<option value="">Select a user</option>');
                    $.each(result, function (index, user) {
                        $('#userDropdown').append(`<option value="${user.id}">${user.email}</option>`);
                    });
                    $('#userDropdown').show();
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching users:", error);
                }
            });
        });

        $('#userDropdown').change(function () {
            var userId = $(this).val();
            if (userId) {
                $.ajax({
                    url: '@Url.Action("GetUserDetails", "AccountRegistration")',
                    type: 'GET',
                    data: { userId: userId },
                    success: function (data) {

                        $('#UserId').val(data.data.id);
                        $('#emailGroup input').val(data.data.email).prop('readonly', true);
                        $('#passwordGroup input').val("********").prop('readonly', true);

                        $('input[name="SelectedRoles"]').prop('checked', false);
                        toggleEventSelection(false);
                        debugger;
                        let hasEventManager = false;

                        // ✔ CHECK ROLES
                        data.data.roles.forEach(function (role) {
                            var checkbox = $('#role_' + role.id);
                            if (checkbox.length) {
                                checkbox.prop('checked', true);

                                if (role.name === 'Event Manager') {
                                    hasEventManager = true;
                                }
                            }
                        });

                        // ✔ SHOW EVENT DROPDOWN FIRST
                        if (hasEventManager) {
                            toggleEventSelection(true);

                            // ✔ SET EVENT IDS AFTER DROPDOWN IS VISIBLE
                            if (Array.isArray(data.data.eventIds)) {
                                $('#SelectedEventIds')
                                    .val(data.data.eventIds)
                                    .trigger('change'); // important for multiselect plugins
                            }
                        }

                        // $('#registerBtn').prop('disabled', true);
                        $('#registerBtn').text("Update User");
                        $('#deleteUserBtn').show();
                        $('#userDropdown').hide();
                        $('#generatePasswordBtn').prop('disabled', true);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching user details:", error);
                    }
                });

            } else {
                $('#UserId').val('');
                $('#emailGroup input').val('').prop('readonly', false);
                $('#passwordGroup input').val('').prop('readonly', false);
                $('#generatePasswordBtn').prop('disabled', false);
                $('input[name="SelectedRoles"]').prop('checked', false);
                toggleEventSelection(false);
                $('#deleteUserBtn').hide();
            }
        });

        $('#deleteUserBtn').click(function () {
            var userId = $('#userDropdown').val();
            if (userId) {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "Do you really want to delete this user?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete!',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteUser", "AccountRegistration")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(userId),
                            success: function (response) {
                                if (response.success) {
                                    // ✅ SweetAlert success
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Deleted!',
                                        text: response.message,
                                        timer: 2500,
                                        showConfirmButton: false
                                    });

                                    // Reset the form
                                    $('#userDropdown').val("").hide();
                                    $('#deleteUserBtn').hide();
                                    $('#emailGroup input').val("").prop('readonly', false);
                                    $('#passwordGroup input').val("").prop('readonly', false);
                                    $('#roleGroup select').val("User").prop('disabled', false);
                                    $('#registerBtn').prop('disabled', false);
                                    $('#generatePasswordBtn').prop('disabled', false);
                                    $('input[name="SelectedRoles"]').prop('checked', false);
                                    $('#eventSelection').addClass('d-none');
                                    $('#SelectedEventIds').val([]).trigger('change');
                                } else {
                                    // ❌ SweetAlert error
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error!',
                                        text: response.message
                                    });
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Oops...',
                                    text: 'An unexpected error occurred while processing your request.'
                                });
                            }
                        });
                    }
                });
            }
        });


        function toggleEventSelection(isVisible) {
            const el = $('#eventSelection');
        
            el.toggleClass('d-none', !isVisible);
        
            if (!isVisible) {
                $('#SelectedEventIds').val(null).trigger('change');
            }
        }
        
        $('.role-checkbox').on('change', function () {
            // Check if ANY Event Manager checkbox is checked
            const isEventManagerChecked = $('.role-checkbox')
                .filter((_, checkbox) => $(checkbox).val() === 'Event Manager' && $(checkbox).is(':checked'))
                .length > 0;
        
            toggleEventSelection(isEventManagerChecked);
        });

        document.getElementById("generatePasswordBtn").addEventListener("click", function () {
            const passwordField = document.querySelector("#passwordGroup input");
            const generatedPassword = generatePassword(12); // Generate a password of length 12
            passwordField.value = generatedPassword;
        });

        function generatePassword(length) {
            if (length < 3) {
                throw new Error("Password length must be at least 3 to include all character types.");
            }

            const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
            const digits = "0123456789";
            const specialCharacters = "!@@#$%^&*()_+[]{}|;:',.<>?";

            // Step 1: Ensure at least one of each required character type
            const randomLetter = letters[Math.floor(Math.random() * letters.length)];
            const randomDigit = digits[Math.floor(Math.random() * digits.length)];
            const randomSpecial = specialCharacters[Math.floor(Math.random() * specialCharacters.length)];

            let password = randomLetter + randomDigit + randomSpecial;

            // Step 2: Fill the rest of the password
            const allCharacters = letters + digits + specialCharacters;
            for (let i = 3; i < length; i++) {
                const randomIndex = Math.floor(Math.random() * allCharacters.length);
                password += allCharacters[randomIndex];
            }

            // Step 3: Shuffle the password
            password = password.split('').sort(() => Math.random() - 0.5).join('');

            return password;
        }
    });

</script>