@model ExcelFilesCompiler.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register User";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Your Application Name</title>

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: rgba(80, 90, 201, 0.1);
            height: 100vh;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        h2 {
            color: rgba(80, 90, 201, 1);
            text-align: center;
            margin-bottom: 20px;
        }

        .form-container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            padding: 0 15px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-control {
            width: 100%;
            padding: 10px;
        }

        .btn-theme {
            background-color: rgba(80, 90, 201, 1);
            border-color: rgba(80, 90, 201, 1);
            color: white;
            width: 100%;
            padding: 10px;
        }

            .btn-theme:hover {
                background-color: rgba(80, 90, 201, 0.8);
                border-color: rgba(80, 90, 201, 0.8);
            }

        #loadingIndicator {
            display: none;
        }

        .form-control {
            font-size: 16px;
            height: 40px; /* Adjust height */
        }

            .form-control option {
                font-size: 16px; /* Adjust font size inside dropdown */
            }
    </style>
</head>
<body>

    <div class="form-container">
        <h2>Register</h2>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">
                @ViewBag.SuccessMessage
            </div>
        }

        <form method="post" asp-action="Register" id="registrationForm">
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <div class="form-group" id="emailGroup">
                <label asp-for="Email" class="font-weight-bold"></label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group" id="passwordGroup">
                <label asp-for="Password" class="font-weight-bold"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group" id="roleGroup">
                <label asp-for="Role" class="font-weight-bold">Role</label>
                <select asp-for="Role" class="form-control">
                    <option value="User">User</option>
                    <option value="Admin">Admin</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-theme" id="registerBtn">Register</button>

            <div class="form-group">
                <button type="button" id="findUserBtn" class="btn btn-secondary mt-2">
                    <i class="fas fa-search"></i> Find User
                </button>
            </div>

            <select id="userDropdown" class="form-control" style="display:none; margin-bottom: 10px;"></select>
            <button type="button" id="deactivateUserBtn" class="btn btn-danger" style="display:none;">Deactivate User</button>

            <div id="loadingIndicator" class="text-center mt-2">
                <span>Loading...</span>
            </div>
        </form>


        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger mt-3">
                @ViewBag.ErrorMessage
            </div>
        }
    </div>

    <!-- Bootstrap JS and dependencies (CDN) -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#findUserBtn').click(function () {
                // Show user dropdown and fetch user details
                $.ajax({
                    url: '@Url.Action("GetUsers", "AccountRegistration")',
                    type: 'GET',
                    success: function (data) {
                        $('#userDropdown').empty().append('<option value="">Select a user</option>');
                        $.each(data, function (index, user) {
                            $('#userDropdown').append(`<option value="${user.id}">${user.email}</option>`);
                        });
                        $('#userDropdown').show();
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching users:", error);
                    }
                });
            });

            $('#userDropdown').change(function () {
                var userId = $(this).val();
                if (userId) {
                    $.ajax({
                        url: '@Url.Action("GetUserDetails", "AccountRegistration")',
                        type: 'GET',
                        data: { userId: userId },
                        success: function (data) {
                            $('#emailGroup input').val(data.email).prop('readonly', true);
                            $('#passwordGroup input').val("********").prop('readonly', true); // Masked password
                            $('#roleGroup select').val(data.role).prop('readonly', true);

                            $('#deactivateUserBtn').show(); // Only show deactivate button
                        },
                        error: function (xhr, status, error) {
                            console.error("Error fetching user details:", error);
                        }
                    });
                } else {
                    $('#deactivateUserBtn').hide();
                }
            });

            $('#deactivateUserBtn').click(function () {
                var userId = $('#userDropdown').val();
                if (userId) {
                    $.ajax({
                        url: '@Url.Action("DeactivateUser", "AccountRegistration")',
                        type: 'POST',
                        data: { userId: userId },
                        success: function () {
                            $('#userDropdown').hide();
                            $('#deactivateUserBtn').hide();
                            $('#emailGroup input, #passwordGroup input, #roleGroup select').val("").prop('readonly', false);

                            // Show the success message from the server-side ViewBag without reloading
                            $('.alert-success').show().text("User has been deactivated successfully.");

                            // Optionally, clear the dropdown and reset the form to avoid unintended selections
                            $('#userDropdown').val("").hide();
                            $('#emailGroup input').val("").prop('readonly', false);
                            $('#passwordGroup input').val("").prop('readonly', false);
                            $('#roleGroup select').val("User").prop('readonly', false);
                        },
                        error: function (xhr, status, error) {
                            alert("Error deactivating user: " + error);
                        }
                    });
                }
            });
        });


    </script>


</body>
</html>
