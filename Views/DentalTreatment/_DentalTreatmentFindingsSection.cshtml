@using ExcelFilesCompiler.Utilities
@using Malama.Models
@using System.Text.Json
@model DentalExam

@{
    var exam = Model ?? new DentalExam();
    var findingsXrayStation = ViewData["XRayStation"] as DentalXRayStation ?? new DentalXRayStation();
    var examinerNamesByUserId = ViewData["ExaminerNamesByUserId"] as Dictionary<string, string>
        ?? new Dictionary<string, string>();
    var currentUserId = ViewData["CurrentUserId"] as string ?? string.Empty;
    var currentUserDisplayName = ViewData["CurrentUserDisplayName"] as string ?? string.Empty;
    var canEditTreatment = ViewData["CanEditTreatment"] as bool?
        ?? (ViewBag.IsDtDentist == true);
    var dentalTreatment = ViewData["DentalTreatment"] as DentalTreatment
        ?? ViewBag.DentalTreatment as DentalTreatment;
    var treatmentFindingsByExamFindingId = (dentalTreatment?.Findings ?? Enumerable.Empty<DentalTreatmentFinding>())
        .Where(f => DentalTreatmentFindingOrigin.IsExamOrigin(f.Origin)
            && f.DentalFindingId.HasValue
            && f.DentalFindingId.Value > 0)
        .GroupBy(f => f.DentalFindingId!.Value)
        .ToDictionary(g => g.Key, g => g.First());
    var findings = new List<DentalTreatmentFindingFormDto>();

    foreach (var f in (exam.Findings ?? Enumerable.Empty<DentalFinding>())
        .Where(f => string.Equals(
            f.Classification,
            DentalFindingConstants.ClassificationClass3,
            StringComparison.OrdinalIgnoreCase))
        .OrderBy(f => f.SortOrder))
    {
        var dto = DentalFindingMapper.ToDto(f);
        treatmentFindingsByExamFindingId.TryGetValue(f.Id, out var treatmentFinding);
        findings.Add(new DentalTreatmentFindingFormDto
        {
            Id = treatmentFinding?.Id ?? 0,
            DentalFindingId = f.Id,
            Origin = DentalTreatmentFindingOrigin.Exam,
            IsTreatmentOnly = false,
            IsPrimaryTooth = dto.IsPrimaryTooth,
            AffectedTooth = dto.AffectedTooth,
            DiseaseConditionType = dto.DiseaseConditionType,
            AffectedSurfaces = dto.AffectedSurfaces,
            CdtCodes = dto.CdtCodes,
            CdtCodesNotes = dto.CdtCodesNotes,
            DescriptionDetails = dto.DescriptionDetails,
            Classification = dto.Classification,
            SortOrder = dto.SortOrder,
            ExaminationAddedBy = dto.ExaminationAddedBy,
            ExaminationAddedOn = dto.ExaminationAddedOn,
            ExaminationUpdatedBy = dto.ExaminationUpdatedBy,
            ExaminationUpdatedOn = dto.ExaminationUpdatedOn,
            TreatmentCompleted = treatmentFinding?.TreatmentCompleted,
            PostServiceTreatment = treatmentFinding != null
                ? DentalTreatmentJson.DeserializeList(treatmentFinding.PostServiceTreatmentJson)
                : new List<string>(),
            TreatmentCdtCodes = treatmentFinding != null
                ? DentalTreatmentJson.DeserializeList(treatmentFinding.TreatmentCdtCodesJson)
                : new List<string>(),
            Reason = treatmentFinding?.Reason,
            Notes = treatmentFinding?.Notes,
            FinalDrc = treatmentFinding?.ProceduredDrc,
            DentistProfessional = treatmentFinding?.DentistProfessional,
            TreatmentStatus = treatmentFinding?.TreatmentStatus,
            TreatmentDateTime = treatmentFinding?.TreatmentDateTime,
            FindingDateTime = treatmentFinding?.FindingDateTime
        });
    }

    foreach (var treatmentFinding in (dentalTreatment?.Findings ?? Enumerable.Empty<DentalTreatmentFinding>())
        .Where(f => DentalTreatmentFindingOrigin.IsTreatmentOrigin(f.Origin)
            || ((!f.DentalFindingId.HasValue || f.DentalFindingId.Value <= 0)
                && !DentalTreatmentFindingOrigin.IsExamOrigin(f.Origin)))
        .OrderBy(f => f.SortOrder))
    {
        findings.Add(new DentalTreatmentFindingFormDto
        {
            Id = treatmentFinding.Id,
            DentalFindingId = null,
            Origin = DentalTreatmentFindingOrigin.Treatment,
            IsTreatmentOnly = true,
            IsPrimaryTooth = treatmentFinding.IsPrimaryTooth,
            AffectedTooth = treatmentFinding.AffectedTooth,
            DiseaseConditionType = treatmentFinding.DiseaseConditionType,
            AffectedSurfaces = DentalTreatmentJson.DeserializeList(treatmentFinding.PostServiceTreatmentJson),
            CdtCodes = DentalTreatmentJson.DeserializeList(treatmentFinding.TreatmentCdtCodesJson),
            Classification = DentalFindingConstants.ClassificationClass3,
            SortOrder = treatmentFinding.SortOrder,
            TreatmentCompleted = treatmentFinding.TreatmentCompleted,
            PostServiceTreatment = DentalTreatmentJson.DeserializeList(treatmentFinding.PostServiceTreatmentJson),
            TreatmentCdtCodes = DentalTreatmentJson.DeserializeList(treatmentFinding.TreatmentCdtCodesJson),
            Reason = treatmentFinding.Reason,
            Notes = treatmentFinding.Notes,
            FinalDrc = treatmentFinding.ProceduredDrc,
            DentistProfessional = treatmentFinding.DentistProfessional,
            TreatmentStatus = treatmentFinding.TreatmentStatus,
            TreatmentDateTime = treatmentFinding.TreatmentDateTime,
            FindingDateTime = treatmentFinding.FindingDateTime
        });
    }

    var cdtCodesByType = DentalExamCdtCodeProvider.GetCodesByDiseaseType();
    var findingsJson = JsonSerializer.Serialize(findings, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
    var cdtCodesJson = JsonSerializer.Serialize(cdtCodesByType);
    var examinerNamesJson = JsonSerializer.Serialize(examinerNamesByUserId);
}

<style>
