        border-radius: 0.375rem;
    }

    .finding-class-2 {
        background-color: #d4edda;
        color: #155724;
    }

    .finding-class-3 {
        background-color: #f8d7da;
        color: #721c24;
    }

    #treatmentFindingsTable {
        min-width: 1100px;
    }

    #treatmentFindingsTable .toggle-finding-treatment-detail {
