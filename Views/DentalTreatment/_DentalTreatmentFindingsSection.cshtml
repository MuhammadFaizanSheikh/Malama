    }

    .finding-treatment-detail-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.85rem;
        padding-bottom: 0.55rem;
        border-bottom: 1px solid rgba(120, 130, 221, 0.2);
    }

    .finding-treatment-detail-title {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: rgba(80, 90, 201, 1);
    }

    .finding-origin-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.3em 0.65em;
        border-radius: 0.375rem;
        letter-spacing: 0.01em;
    }

    .finding-origin-exam {
        background-color: rgba(120, 130, 221, 0.16);
        color: rgba(80, 90, 201, 1);
    }

    .finding-origin-treatment {
        background-color: #e8f5ef;
