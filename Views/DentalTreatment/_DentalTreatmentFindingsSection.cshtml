<script>
    (function () {
        const PERMANENT_TEETH = @Json.Serialize(DentalFindingConstants.PermanentTeeth);
        const PRIMARY_TEETH = @Json.Serialize(DentalFindingConstants.PrimaryTeeth);
        const PRIMARY_TO_PERMANENT = @Json.Serialize(DentalFindingConstants.PrimaryToothToPermanentNumber);
        const PERIODONTAL_SURFACES = @Json.Serialize(DentalFindingConstants.PeriodontalSurfaces);
        const RESTORATIVE_SURFACES_POSTERIOR = @Json.Serialize(DentalFindingConstants.RestorativeSurfacesPosterior);
        const RESTORATIVE_SURFACES_ANTERIOR = @Json.Serialize(DentalFindingConstants.RestorativeSurfacesAnterior);
        const CDT_CODES_BY_TYPE = @Html.Raw(cdtCodesJson);
        const examinerNamesByUserId = @Html.Raw(examinerNamesJson);
        const CURRENT_USER_ID = @Json.Serialize(currentUserId);
        const CURRENT_USER_DISPLAY_NAME = @Json.Serialize(currentUserDisplayName);
        const CAN_EDIT_TREATMENT = @Json.Serialize(canEditTreatment);
        const TREATMENT_ONLY_CLASSIFICATION = @Json.Serialize(DentalFindingConstants.ClassificationClass3);
        const FINDING_ORIGIN_EXAM = @Json.Serialize(DentalTreatmentFindingOrigin.Exam);
        const FINDING_ORIGIN_TREATMENT = @Json.Serialize(DentalTreatmentFindingOrigin.Treatment);

        if (CURRENT_USER_ID) {
            examinerNamesByUserId[CURRENT_USER_ID] = CURRENT_USER_DISPLAY_NAME || examinerNamesByUserId[CURRENT_USER_ID] || "";
        }

        function resolveStaffDisplayName(userId) {
            if (!userId) {
                return "";
            }
            if (examinerNamesByUserId[userId]) {
                return examinerNamesByUserId[userId];
            }
            if (userId === CURRENT_USER_ID) {
                return CURRENT_USER_DISPLAY_NAME || "";
            }
            return userId;
        }

        function isTreatmentOnlyMode() {
            if (editingFindingIndex == null) {
                return true;
            }
            const existing = treatmentFindings[editingFindingIndex];
            return !!(existing && existing.isTreatmentOnly);
        }

        function getActiveDiseaseType() {
            return isTreatmentOnlyMode()
                ? ($("#treatmentOnlyDiseaseType").val() || "")
                : ($("#treatmentFindingDiseaseType").val() || "");
        }

        function getActiveAffectedTooth() {
            return isTreatmentOnlyMode()
                ? ($("#treatmentOnlyAffectedTooth").val() || "")
                : ($("#treatmentFindingAffectedTooth").val() || "");
        }

        function getActiveAffectedSurfaces() {
            return getSelectedValues($("#treatmentFindingAffectedSurfaces"));
        }

        function setTreatmentOnlyClinicalVisible(isVisible) {
            $("#treatmentOnlyClinicalFields").toggle(!!isVisible);
        }

        let treatmentFindings = (@Html.Raw(findingsJson) || []).map(function (item) {
            return normalizeTreatmentFinding(item);
        });
        let editingFindingIndex = null;
        let suppressTreatmentCdtReset = false;

        function normalizeTreatmentFinding(item) {
            const affectedSurfaces = item.affectedSurfaces || [];
            const cdtCodes = item.cdtCodes || [];
            const finalDrc = item.finalDrc || "";
            const examFindingId = item.dentalFindingId && item.dentalFindingId > 0
                ? item.dentalFindingId
                : null;
            const origin = item.origin === FINDING_ORIGIN_TREATMENT || item.isTreatmentOnly || !examFindingId
                ? FINDING_ORIGIN_TREATMENT
                : FINDING_ORIGIN_EXAM;
            const isTreatmentOnly = origin === FINDING_ORIGIN_TREATMENT;
            return {
                id: item.id || 0,
                dentalFindingId: examFindingId,
                origin: origin,
                isTreatmentOnly: isTreatmentOnly,
                isPrimaryTooth: !!item.isPrimaryTooth,
                affectedTooth: item.affectedTooth || "",
                diseaseConditionType: item.diseaseConditionType || "",
                affectedSurfaces: affectedSurfaces,
                cdtCodes: cdtCodes,
                cdtCodesNotes: item.cdtCodesNotes || "",
                descriptionDetails: item.descriptionDetails || "",
                classification: item.classification || "",
                sortOrder: item.sortOrder || 0,
                examinationAddedBy: item.examinationAddedBy || null,
                examinationAddedOn: item.examinationAddedOn || null,
                examinationUpdatedBy: item.examinationUpdatedBy || null,
                examinationUpdatedOn: item.examinationUpdatedOn || null,
                treatmentCompleted: item.treatmentCompleted || "",
                postServiceTreatment: item.postServiceTreatment || [],
                treatmentCdtCodes: item.treatmentCdtCodes || [],
                reason: item.reason || "",
                notes: item.notes || "",
                finalDrc: finalDrc,
                dentistProfessional: item.dentistProfessional || "",
                treatmentStatus: resolveTreatmentStatus({
                    treatmentCompleted: item.treatmentCompleted || "",
                    finalDrc: finalDrc,
                    reason: item.reason || ""
                }),
                treatmentDateTime: item.treatmentDateTime || "",
                findingDateTime: item.findingDateTime || ""
            };
        }

        function isFindingOnlyDrc(drc) {
            return drc === "1" || drc === "2" || drc === "4";
        }

        function isUrgentTreatmentDrc(drc) {
            return drc === "3";
        }

        function fillCurrentDentistAndTimestamp($input) {
            if (!$input.val()) {
                $input.val(formatTreatmentDateTime());
            }
            $("#treatmentDentistProfessional").val(resolveStaffDisplayName(CURRENT_USER_ID) || "");
        }

        function applyTreatmentFormLayout() {
            const treatmentOnly = isTreatmentOnlyMode();
            const drc = $("#treatmentFinalDrc").val() || "";
            const selected = $("input[name='TreatmentCompleted']:checked").val();
            const isYes = selected === "Yes";
            const isNo = selected === "No";

            if (treatmentOnly) {
                setTreatmentOnlyClinicalVisible(true);
                $("#treatmentWorkFields").show();
                $("#treatmentNotesSection").show();
                $("#treatmentCompletedGroup").insertAfter($("#treatmentFinalDrc").closest(".mb-3"));
                $("#treatmentCompletedGroup").toggle(isUrgentTreatmentDrc(drc));

                if (isFindingOnlyDrc(drc)) {
                    $("input[name='TreatmentCompleted']").prop("checked", false);
                    $("#treatmentReason").val("");
                    $("#treatmentCompletedNoFields").hide();
                    $("#treatmentDentistProfessionalGroup").show();
                    $("#treatmentFindingDateTimeGroup").show();
                    $("#treatmentDateTimeGroup").hide();
                    $("#treatmentDateTime").val("");
                    fillCurrentDentistAndTimestamp($("#treatmentFindingDateTime"));
                    return;
                }

                if (isUrgentTreatmentDrc(drc)) {
                    $("#treatmentCompletedNoFields").toggle(isNo);
                    $("#treatmentDentistProfessionalGroup").toggle(isYes || isNo);
                    $("#treatmentDateTimeGroup").toggle(isYes);
                    $("#treatmentFindingDateTimeGroup").toggle(isNo);
                    if (isYes) {
                        $("#treatmentReason").val("");
                        $("#treatmentFindingDateTime").val("");
                        fillCurrentDentistAndTimestamp($("#treatmentDateTime"));
                    } else if (isNo) {
                        $("#treatmentDateTime").val("");
                        fillCurrentDentistAndTimestamp($("#treatmentFindingDateTime"));
                    } else {
                        $("#treatmentDentistProfessional").val("");
                        $("#treatmentDateTime").val("");
                        $("#treatmentFindingDateTime").val("");
                    }
                    return;
                }

                $("input[name='TreatmentCompleted']").prop("checked", false);
                $("#treatmentCompletedNoFields").hide();
                $("#treatmentDentistProfessionalGroup").hide();
                $("#treatmentDateTimeGroup").hide();
                $("#treatmentFindingDateTimeGroup").hide();
                $("#treatmentDentistProfessional").val("");
                $("#treatmentDateTime").val("");
                $("#treatmentFindingDateTime").val("");
                return;
            }

            setTreatmentOnlyClinicalVisible(false);
            $("#treatmentCompletedGroup").appendTo("#treatmentCompletedExamSlot");
            $("#treatmentCompletedGroup").show();
            $("#treatmentWorkFields").toggle(isYes);
            $("#treatmentCompletedNoFields").toggle(isNo);
            $("#treatmentNotesSection").toggle(isYes || isNo);
            $("#treatmentFindingDateTimeGroup").hide();
            $("#treatmentFindingDateTime").val("");
            $("#treatmentDentistProfessionalGroup").toggle(isYes);
            $("#treatmentDateTimeGroup").toggle(isYes);
            if (isYes) {
                fillCurrentDentistAndTimestamp($("#treatmentDateTime"));
            } else {
                $("#treatmentDentistProfessional").val("");
                $("#treatmentDateTime").val("");
            }
        }

        function resolveTreatmentStatus(source) {
            const treatmentCompleted = source?.treatmentCompleted || "";
            const finalDrc = source?.finalDrc || "";
            const reason = source?.reason || "";

            if (treatmentCompleted === "No" && reason) {
                return "Complete with Reason";
            }
            if (finalDrc) {
                return "Complete";
            }
            return "Incomplete";
        }

        function formatTreatmentStatusBadge(status) {
            if (status === "Complete") {
                return '<span class="badge bg-success">Complete</span>';
            }
            if (status === "Complete with Reason") {
                return '<span class="badge" style="background-color:#33cc33;color:#ffffff;">Complete with Reason</span>';
            }
            return '<span class="badge bg-warning text-dark">Incomplete</span>';
        }

        function escapeHtml(value) {
            return $("<div>").text(value ?? "").html();
        }

        function destroySelect2($select) {
            if ($select.hasClass("select2-hidden-accessible")) {
                $select.select2("destroy");
            }
        }

        function initMultiSelect($select, placeholder) {
            destroySelect2($select);
            $select.select2({
                placeholder: placeholder,
                width: "100%",
                closeOnSelect: false,
                allowClear: true,
                dropdownParent: $("#treatmentFindingFormCard")
            });

            $select.off("select2:select.clearSearch select2:unselect.clearSearch")
                .on("select2:select.clearSearch select2:unselect.clearSearch", function () {
                    const $searchField = $select.next(".select2-container")
                        .find(".select2-search__field");
                    if ($searchField.length) {
                        $searchField.val("");
                        $searchField.trigger("input");
                    }
                });
        }

        function getSelectedValues($select) {
            const values = $select.val();
            if (!values) {
                return [];
            }
            return Array.isArray(values) ? values.filter(Boolean) : [values].filter(Boolean);
        }

        function setMultiSelectValues($select, values) {
            $select.val(values || []).trigger("change");
        }

        function getRestorativeSurfacesForTooth(tooth) {
            if (isRestorativeAnteriorTooth(tooth)) {
                return RESTORATIVE_SURFACES_ANTERIOR.slice();
            }
            if (isRestorativePosteriorTooth(tooth)) {
                return RESTORATIVE_SURFACES_POSTERIOR.slice();
            }
            return [];
        }

        // Permanent: 6-11, 22-27 | Primary: C-H, M-R
        function isRestorativeAnteriorTooth(tooth) {
            const value = (tooth || "").toString().trim();
            const n = parseInt(value, 10);
            if (!isNaN(n) && String(n) === value) {
                return (n >= 6 && n <= 11) || (n >= 22 && n <= 27);
            }
            return value.length === 1 && "CDEFGHMNOPQR".indexOf(value.toUpperCase()) >= 0;
        }

        // Permanent: 1-5, 12-21, 28-32 | Primary: A,B,I,J,K,L,S,T
        function isRestorativePosteriorTooth(tooth) {
            const value = (tooth || "").toString().trim();
            const n = parseInt(value, 10);
            if (!isNaN(n) && String(n) === value) {
                return (n >= 1 && n <= 5) || (n >= 12 && n <= 21) || (n >= 28 && n <= 32);
            }
            return value.length === 1 && "ABIJKLST".indexOf(value.toUpperCase()) >= 0;
        }

        function getRestorativeCdtCodes(tooth, surfaceCount) {
            if (!surfaceCount || surfaceCount < 1) {
                return [];
            }

            const isAnterior = isRestorativeAnteriorTooth(tooth);
            const isPosterior = isRestorativePosteriorTooth(tooth);
            if (!isAnterior && !isPosterior) {
                return [];
            }

            const amalgam = surfaceCount === 1
                ? "D2140 - Amalgam-One Surface"
                : surfaceCount === 2
                    ? "D2150 - Amalgam-Two Surfaces"
                    : surfaceCount === 3
                        ? "D2160 - Amalgam-Three Surfaces"
                        : "D2161 - Amalgam-Four or More Surfaces";

            const resin = isAnterior
                ? (surfaceCount === 1
                    ? "D2330 - Resin Based Composite-One Surface, Anterior"
                    : surfaceCount === 2
                        ? "D2331 - Resin Based Composite-Two Surfaces, Anterior"
                        : surfaceCount === 3
                            ? "D2332 - Resin Based Composite-Three Surfaces, Anterior"
                            : "D2335 - Resin Based Composite-Four or More Surfaces, Anterior")
                : (surfaceCount === 1
                    ? "D2391 - Resin Based Composite-One Surface, Posterior"
                    : surfaceCount === 2
                        ? "D2392 - Resin Based Composite-Two Surfaces, Posterior"
                        : surfaceCount === 3
                            ? "D2393 - Resin Based Composite-Three Surfaces, Posterior"
                            : "D2394 - Resin Based Composite-Four or More Surfaces, Posterior");

            return [amalgam, resin];
        }

        function getSurfaceOptionsForFinding(diseaseType, tooth) {
            if (diseaseType === "Periodontal") {
                return PERIODONTAL_SURFACES.slice();
            }
            if (diseaseType === "Restorative") {
                return getRestorativeSurfacesForTooth(tooth);
            }
            return [];
        }

        function populateToothOptions() {
            const isPrimary = $("#treatmentFindingPrimaryTooth").is(":checked");
            const teeth = isPrimary ? PRIMARY_TEETH : PERMANENT_TEETH;
            const current = $("#treatmentFindingAffectedTooth").val();
            const $select = $("#treatmentFindingAffectedTooth");
            $select.empty().append('<option value=""></option>');
            teeth.forEach(function (tooth) {
                $select.append($("<option>").val(tooth).text(tooth));
            });
            if (current && teeth.includes(current)) {
                $select.val(current);
            }
        }

        function populateTreatmentOnlyToothOptions() {
            const isPrimary = $("#treatmentOnlyPrimaryTooth").is(":checked");
            const teeth = isPrimary ? PRIMARY_TEETH : PERMANENT_TEETH;
            const current = $("#treatmentOnlyAffectedTooth").val();
            const $select = $("#treatmentOnlyAffectedTooth");
            const missing = getPsrMissingToothNumbers();
            $select.empty().append('<option value=""></option>');
            teeth.forEach(function (tooth) {
                const toothValue = String(tooth);
                let isMissing = false;
                if (isPrimary) {
                    const permanentNumber = PRIMARY_TO_PERMANENT[toothValue] || PRIMARY_TO_PERMANENT[toothValue.toUpperCase()];
                    isMissing = !!permanentNumber && missing.indexOf(permanentNumber) >= 0;
                } else {
                    const permanentNumber = parseInt(toothValue, 10);
                    isMissing = !isNaN(permanentNumber) && missing.indexOf(permanentNumber) >= 0;
                }

                const $option = $("<option>").val(toothValue);
                if (isMissing) {
                    $option.text(toothValue + " - missing tooth").prop("disabled", true);
                } else {
                    $option.text(toothValue);
                }
                $select.append($option);
            });

            if (current && teeth.map(String).indexOf(String(current)) >= 0 && !isAffectedToothMissing(current, isPrimary)) {
                $select.val(current);
            } else {
                $select.val("");
            }
        }

        function getPsrMissingToothNumbers() {
            const missing = [];
            $("#psrInteractiveToothChart .psr-tooth-input:checked").each(function () {
                const tooth = parseInt($(this).attr("data-tooth") || $(this).val(), 10);
                if (!isNaN(tooth)) {
                    missing.push(tooth);
                }
            });
            return missing;
        }

        function resolveFindingAffectedToothToPermanent(tooth, isPrimary) {
            const value = (tooth || "").toString().trim();
            if (!value) {
                return null;
            }

            if (isPrimary) {
                const permanentNumber = PRIMARY_TO_PERMANENT[value] || PRIMARY_TO_PERMANENT[value.toUpperCase()];
                return permanentNumber ? parseInt(permanentNumber, 10) : null;
            }

            const permanentNumber = parseInt(value, 10);
            return isNaN(permanentNumber) ? null : permanentNumber;
        }

        function isAffectedToothMissing(tooth, isPrimary) {
            const permanentNumber = resolveFindingAffectedToothToPermanent(tooth, isPrimary);
            if (permanentNumber == null) {
                return false;
            }
            return getPsrMissingToothNumbers().indexOf(permanentNumber) >= 0;
        }

        function getDentalFindingUsedPermanentTeeth() {
            const used = [];
            treatmentFindings.forEach(function (finding) {
                const permanentNumber = resolveFindingAffectedToothToPermanent(
                    finding.affectedTooth,
                    !!finding.isPrimaryTooth
                );
                if (permanentNumber != null && used.indexOf(permanentNumber) < 0) {
                    used.push(permanentNumber);
                }
            });
            return used;
        }

        window.getDentalFindingUsedPermanentTeeth = getDentalFindingUsedPermanentTeeth;
        window.refreshDentalFindingToothOptions = function () {
            if (!$("#treatmentOnlyAffectedTooth").length) {
                return;
            }
            populateTreatmentOnlyToothOptions();
        };

        function populateFindingSurfaceOptions(selectedValues) {
            const diseaseType = $("#treatmentFindingDiseaseType").val();
            const $section = $("#treatmentFindingSurfacesSection");
            const $select = $("#treatmentFindingAffectedSurfaces");
            destroySelect2($select);
            $select.empty();

            const surfaces = getSurfaceOptionsForFinding(diseaseType, $("#treatmentFindingAffectedTooth").val());
            if (!surfaces.length) {
                $section.hide();
                setMultiSelectValues($select, []);
                populateFindingCdtOptions([]);
                return;
            }

            surfaces.forEach(function (surface) {
                $select.append($("<option>").val(surface).text(surface));
            });
            $section.show();
            initMultiSelect($select, "Select surface(s)");
            const validSelected = (selectedValues || []).filter(function (surface) {
                return surfaces.indexOf(surface) >= 0;
            });
            setMultiSelectValues($select, validSelected);
            populateFindingCdtOptions(getSelectedValues($("#treatmentFindingCdtCodes")));
        }

        function populateFindingCdtOptions(selectedValues) {
            const diseaseType = $("#treatmentFindingDiseaseType").val();
            const $select = $("#treatmentFindingCdtCodes");
            destroySelect2($select);
            $select.empty();

            let codes = CDT_CODES_BY_TYPE[diseaseType] || [];
            if (diseaseType === "Restorative") {
                codes = getRestorativeCdtCodes(
                    $("#treatmentFindingAffectedTooth").val(),
                    getSelectedValues($("#treatmentFindingAffectedSurfaces")).length
                );
            }

            codes.forEach(function (code) {
                $select.append($("<option>").val(code).text(code));
            });

            initMultiSelect($select, "Select CDT code(s)");
            if (selectedValues && selectedValues.length) {
                const valid = selectedValues.filter(function (code) { return codes.indexOf(code) >= 0; });
                setMultiSelectValues($select, valid);
            } else {
                setMultiSelectValues($select, []);
            }
        }

        function populatePostServiceTreatmentOptions(selectedValues) {
            const diseaseType = getActiveDiseaseType();
            const tooth = getActiveAffectedTooth();
            const $section = $("#treatmentPostServiceSection");
            const $select = $("#treatmentPostServiceTreatment");
            destroySelect2($select);
            $select.empty();

            const surfaces = getSurfaceOptionsForFinding(diseaseType, tooth);
            if (!surfaces.length) {
                $section.hide();
                setMultiSelectValues($select, []);
                populateTreatmentCdtOptions([]);
                return;
            }

            surfaces.forEach(function (surface) {
                $select.append($("<option>").val(surface).text(surface));
            });
            $section.show();
            initMultiSelect($select, "Select post service treatment");
            const validSelected = (selectedValues || []).filter(function (surface) {
                return surfaces.indexOf(surface) >= 0;
            });
            setMultiSelectValues($select, validSelected);
            populateTreatmentCdtOptions(getSelectedValues($("#treatmentSectionCdtCodes")));
        }

        function populateTreatmentCdtOptions(selectedValues) {
            const diseaseType = getActiveDiseaseType();
            const tooth = getActiveAffectedTooth();
            const $select = $("#treatmentSectionCdtCodes");
            destroySelect2($select);
            $select.empty();

            let codes = CDT_CODES_BY_TYPE[diseaseType] || [];
            if (diseaseType === "Restorative") {
                codes = getRestorativeCdtCodes(
                    tooth,
                    getSelectedValues($("#treatmentPostServiceTreatment")).length
                );
            }

            codes.forEach(function (code) {
                $select.append($("<option>").val(code).text(code));
            });

            initMultiSelect($select, "Select CDT code(s)");
            if (selectedValues && selectedValues.length) {
                const valid = selectedValues.filter(function (code) { return codes.indexOf(code) >= 0; });
                setMultiSelectValues($select, valid);
            } else {
                setMultiSelectValues($select, []);
            }
        }

        function formatClassificationBadge(classification) {
            if (!classification) {
                return "-";
            }
            if (classification.indexOf("Class 2") === 0) {
                return "<span class='badge finding-classification-badge finding-class-2'>Class 2</span>";
            }
            if (classification.indexOf("Class 3") === 0) {
                return "<span class='badge finding-classification-badge finding-class-3'>Class 3</span>";
            }
            return escapeHtml(classification);
        }

        function displayOrDash(value) {
            return value ? escapeHtml(value) : "";
        }

        function formatExaminerDateTime(value) {
            if (!value) {
                return "";
            }
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) {
                return String(value);
            }
            return date.toLocaleString(undefined, {
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
                hour: "2-digit",
                minute: "2-digit"
            });
        }

        function getExaminerUserId(finding) {
            return finding.examinationUpdatedBy || finding.examinationAddedBy || "";
        }

        function getExaminerDateTime(finding) {
            return finding.examinationUpdatedOn || finding.examinationAddedOn || "";
        }

        function formatExaminerDetail(finding) {
            const userId = getExaminerUserId(finding);
            const when = getExaminerDateTime(finding);
            if (!userId && !when) {
                return "-";
            }

            const name = resolveStaffDisplayName(userId);
            const nameHtml = name ? escapeHtml(name) : "-";
            const whenHtml = when
                ? ("<div class='small text-muted'>" + escapeHtml(formatExaminerDateTime(when)) + "</div>")
                : "";
            return nameHtml + whenHtml;
        }

        function formatOriginBadge(finding) {
            const isTreatment = finding.origin === FINDING_ORIGIN_TREATMENT || !!finding.isTreatmentOnly;
            if (isTreatment) {
                return "<span class='badge finding-origin-badge finding-origin-treatment'>Treatment</span>";
            }
            return "<span class='badge finding-origin-badge finding-origin-exam'>Exam</span>";
        }

        function formatDetailValue(value) {
            if (value === null || value === undefined || value === "") {
                return "<span class='value is-empty'>—</span>";
            }
            return "<span class='value'>" + escapeHtml(String(value)) + "</span>";
        }

        function formatDetailListValue(values) {
            const list = (values || []).filter(function (item) { return !!item; });
            if (!list.length) {
                return formatDetailValue("");
            }
            return formatDetailValue(list.join(", "));
        }

        function buildTreatmentDetailPanel(finding) {
            const isTreatmentOrigin = finding.origin === FINDING_ORIGIN_TREATMENT || !!finding.isTreatmentOnly;
            const hasTreatmentData = !!(finding.treatmentCompleted
                || (finding.postServiceTreatment && finding.postServiceTreatment.length)
                || (finding.treatmentCdtCodes && finding.treatmentCdtCodes.length)
                || finding.reason
                || finding.notes
                || finding.finalDrc
                || finding.dentistProfessional
                || finding.treatmentDateTime
                || finding.findingDateTime);

            const originLabel = isTreatmentOrigin ? "Treatment" : "Exam";
            const toothLabel = finding.affectedTooth
                ? (finding.affectedTooth + (finding.isPrimaryTooth ? " (Primary)" : ""))
                : "";

            let bodyHtml;
            if (!hasTreatmentData) {
                bodyHtml = "<p class='finding-treatment-detail-empty mb-0'>No treatment details recorded yet.</p>";
            } else {
                bodyHtml =
                    "<div class='finding-treatment-detail-grid'>" +
                    "<div class='finding-treatment-detail-item'><label>Treatment Completed</label>" + formatDetailValue(finding.treatmentCompleted) + "</div>" +
                    "<div class='finding-treatment-detail-item'><label>Post Service Treatment</label>" + formatDetailListValue(finding.postServiceTreatment) + "</div>" +
                    "<div class='finding-treatment-detail-item'><label>Treatment CDT Code(s)</label>" + formatDetailListValue(finding.treatmentCdtCodes) + "</div>";

                // Tooth / disease in this panel are treatment-entered values only (not exam copy).
                if (isTreatmentOrigin) {
                    bodyHtml +=
                        "<div class='finding-treatment-detail-item'><label>Affected Tooth</label>" + formatDetailValue(toothLabel) + "</div>" +
                        "<div class='finding-treatment-detail-item'><label>Disease / Condition Type (Treatment)</label>" + formatDetailValue(finding.diseaseConditionType) + "</div>";
                }

                bodyHtml +=
                    "<div class='finding-treatment-detail-item'><label>DRC</label>" + formatDetailValue(finding.finalDrc) + "</div>" +
                    "<div class='finding-treatment-detail-item'><label>Treated By</label>" + formatDetailValue(resolveStaffDisplayName(finding.dentistProfessional)) + "</div>" +
                    "<div class='finding-treatment-detail-item'><label>Treated On</label>" + formatDetailValue(finding.treatmentDateTime) + "</div>" +
                    "<div class='finding-treatment-detail-item'><label>Finding Date/Time</label>" + formatDetailValue(finding.findingDateTime) + "</div>" +
                    "<div class='finding-treatment-detail-item'><label>Reason</label>" + formatDetailValue(finding.reason) + "</div>" +
                    "<div class='finding-treatment-detail-item'><label>Notes</label>" + formatDetailValue(finding.notes) + "</div>" +
                    "</div>";
            }

            return "" +
                "<div class='finding-treatment-detail'>" +
                "<div class='finding-treatment-detail-header'>" +
                "<h6 class='finding-treatment-detail-title'>Treatment details</h6>" +
                "<span class='badge finding-origin-badge " +
                (originLabel === "Treatment" ? "finding-origin-treatment" : "finding-origin-exam") +
                "'>Source: " + originLabel + "</span>" +
                "</div>" +
                bodyHtml +
                "</div>";
        }

        function renderFindingsTable() {
            const $tbody = $("#treatmentFindingsTableBody");
            $tbody.empty();

            if (!treatmentFindings.length) {
                $tbody.append(
                    '<tr id="treatmentFindingsEmptyRow"><td colspan="11" class="text-center text-muted py-4">No findings added yet.</td></tr>'
                );
                syncDentalTreatmentFindingsJson();
                return;
            }

            treatmentFindings.forEach(function (finding, index) {
                const isTreatmentOrigin = finding.origin === FINDING_ORIGIN_TREATMENT || !!finding.isTreatmentOnly;
                const surfaces = isTreatmentOrigin
                    ? "-"
                    : ((finding.affectedSurfaces || []).join(", ") || "-");
                const toothLabel = isTreatmentOrigin
                    ? "-"
                    : (finding.affectedTooth
                        ? (finding.affectedTooth + (finding.isPrimaryTooth ? " (Primary)" : ""))
                        : "-");
                const diseaseType = isTreatmentOrigin ? "-" : (finding.diseaseConditionType || "-");
                const classificationBadge = isTreatmentOrigin
                    ? "-"
                    : formatClassificationBadge(finding.classification);
                const description = isTreatmentOrigin
                    ? "-"
                    : (finding.descriptionDetails ? escapeHtml(finding.descriptionDetails) : "-");
                const examinerDetail = isTreatmentOrigin ? "-" : formatExaminerDetail(finding);
                const detailId = "findingTreatmentDetail_" + index;
                let actionButtons = "-";
                if (CAN_EDIT_TREATMENT) {
                    actionButtons =
                        "<button type='button' class='btn btn-sm btn-outline-primary finding-action-btn edit-treatment-finding-btn' data-index='" +
                        index +
                        "' title='Edit'><i class='fas fa-edit' aria-hidden='true'></i><span class='visually-hidden'>Edit</span></button>";
                    if (isTreatmentOrigin) {
                        actionButtons +=
                            " <button type='button' class='btn btn-sm btn-outline-danger finding-action-btn delete-treatment-finding-btn' data-index='" +
                            index +
                            "' title='Delete'><i class='fas fa-trash-alt' aria-hidden='true'></i><span class='visually-hidden'>Delete</span></button>";
                    }
                } else {
                    actionButtons =
                        "<button type='button' class='btn btn-sm btn-outline-secondary finding-action-btn edit-treatment-finding-btn' data-index='" +
                        index +
                        "' title='View'><i class='fas fa-eye' aria-hidden='true'></i><span class='visually-hidden'>View</span></button>";
                }

                const toggleButton =
                    "<button type='button' class='btn btn-sm toggle-finding-treatment-detail' data-index='" +
                    index +
                    "' data-target='#" + detailId + "' aria-expanded='false' aria-controls='" + detailId +
                    "' title='Show treatment details'>" +
                    "<i class='fas fa-chevron-right' aria-hidden='true'></i>" +
                    "<span class='visually-hidden'>Show treatment details</span>" +
                    "</button>";

                $tbody.append(
                    "<tr class='finding-main-row' data-finding-index='" + index + "'>" +
                    "<td class='text-center'>" + toggleButton + "</td>" +
                    "<td>" + (index + 1) + "</td>" +
                    "<td>" + formatOriginBadge(finding) + "</td>" +
                    "<td>" + escapeHtml(toothLabel) + "</td>" +
                    "<td>" + escapeHtml(surfaces) + "</td>" +
                    "<td>" + escapeHtml(diseaseType) + "</td>" +
                    "<td>" + classificationBadge + "</td>" +
                    "<td>" + description + "</td>" +
                    "<td>" + examinerDetail + "</td>" +
                    "<td>" + formatTreatmentStatusBadge(resolveTreatmentStatus(finding)) + "</td>" +
                    "<td class='text-nowrap'>" + actionButtons + "</td>" +
                    "</tr>" +
                    "<tr class='finding-detail-row' id='" + detailId + "' style='display:none;' data-finding-index='" + index + "'>" +
                    "<td colspan='11'>" + buildTreatmentDetailPanel(finding) + "</td>" +
                    "</tr>"
                );
            });
            syncDentalTreatmentFindingsJson();
            if (typeof window.updateDentalTreatmentOverallStatus === "function") {
                window.updateDentalTreatmentOverallStatus();
            }
        }

        function syncDentalTreatmentFindingsJson() {
            const payload = treatmentFindings.map(function (item, index) {
                return {
                    id: item.id || 0,
                    dentalFindingId: item.dentalFindingId || null,
                    origin: item.origin || (item.isTreatmentOnly ? FINDING_ORIGIN_TREATMENT : FINDING_ORIGIN_EXAM),
                    isTreatmentOnly: !!item.isTreatmentOnly || item.origin === FINDING_ORIGIN_TREATMENT,
                    isPrimaryTooth: !!item.isPrimaryTooth,
                    affectedTooth: item.affectedTooth || "",
                    diseaseConditionType: item.diseaseConditionType || "",
                    affectedSurfaces: item.affectedSurfaces || [],
                    cdtCodes: item.cdtCodes || [],
                    cdtCodesNotes: item.cdtCodesNotes || "",
                    descriptionDetails: item.descriptionDetails || "",
                    classification: item.classification || "",
                    sortOrder: index,
                    examinationAddedBy: item.examinationAddedBy || null,
                    examinationAddedOn: item.examinationAddedOn || null,
                    examinationUpdatedBy: item.examinationUpdatedBy || null,
                    examinationUpdatedOn: item.examinationUpdatedOn || null,
                    treatmentCompleted: item.treatmentCompleted || "",
                    postServiceTreatment: item.postServiceTreatment || [],
                    treatmentCdtCodes: item.treatmentCdtCodes || [],
                    reason: item.reason || "",
                    notes: item.notes || "",
                    finalDrc: item.finalDrc || "",
                    dentistProfessional: item.dentistProfessional || "",
                    treatmentStatus: item.treatmentStatus || "",
                    treatmentDateTime: item.treatmentDateTime || "",
                    findingDateTime: item.findingDateTime || ""
                };
            });
            $("#TreatmentFindingsJson").val(JSON.stringify(payload));
        }

        function setFindingSectionEditable(isEditable) {
            const $findingFields = $(
                "#treatmentFindingDiseaseType, #treatmentFindingAffectedTooth, #treatmentFindingPrimaryTooth, #treatmentFindingAffectedSurfaces, #treatmentFindingCdtCodes, #treatmentFindingCdtCodesNotes, #treatmentFindingDescription, input[name='TreatmentFindingClassification']"
            );
            $findingFields.each(function () {
                const $el = $(this);
                if ($el.is("input:checkbox, input:radio, select")) {
                    $el.prop("disabled", !isEditable);
                } else if (isEditable) {
                    $el.prop("readonly", false).removeClass("read-only-style");
                } else {
                    $el.prop("readonly", true).addClass("read-only-style");
                }
            });

            ["#treatmentFindingAffectedSurfaces", "#treatmentFindingCdtCodes"].forEach(function (selector) {
                const $select = $(selector);
                if ($select.hasClass("select2-hidden-accessible")) {
                    const $container = $select.next(".select2-container");
                    if (isEditable) {
                        $container.css("pointer-events", "").removeClass("read-only-style");
                    } else {
                        $container.css("pointer-events", "none").addClass("read-only-style");
                    }
                }
            });
        }

        function applyFindingSectionReadOnly() {
            setFindingSectionEditable(false);
        }

        function applyTreatmentSectionReadOnly() {
            if (CAN_EDIT_TREATMENT) {
                $("#updateTreatmentFindingBtn").show();
                return;
            }

            const $treatmentFields = $(
                "input[name='TreatmentCompleted'], #treatmentPostServiceTreatment, #treatmentSectionCdtCodes, #treatmentFinalDrc, #treatmentReason, #treatmentNotes, #treatmentOnlyDiseaseType, #treatmentOnlyAffectedTooth, #treatmentOnlyPrimaryTooth"
            );
            $treatmentFields.each(function () {
                const $el = $(this);
                if ($el.is("input:checkbox, input:radio, select")) {
                    $el.prop("disabled", true);
                } else {
                    $el.prop("readonly", true).addClass("read-only-style");
                }
            });

            ["#treatmentPostServiceTreatment", "#treatmentSectionCdtCodes"].forEach(function (selector) {
                const $select = $(selector);
                if ($select.hasClass("select2-hidden-accessible")) {
                    $select.next(".select2-container").css("pointer-events", "none").addClass("read-only-style");
                }
            });

            $("#updateTreatmentFindingBtn").hide();
        }

        function getTreatmentPostServiceValues(finding) {
            if (finding.postServiceTreatment && finding.postServiceTreatment.length) {
                return finding.postServiceTreatment.slice();
            }
            // Prefill edit form from exam surfaces only when opening Treatment Completed = Yes.
            // Do not treat this as saved treatment data in the table detail panel.
            if (!finding.isTreatmentOnly && finding.origin !== FINDING_ORIGIN_TREATMENT) {
                return (finding.affectedSurfaces || []).slice();
            }
            return [];
        }

        function getTreatmentCdtValues(finding) {
            if (finding.treatmentCdtCodes && finding.treatmentCdtCodes.length) {
                return finding.treatmentCdtCodes.slice();
            }
            if (!finding.isTreatmentOnly && finding.origin !== FINDING_ORIGIN_TREATMENT) {
                return (finding.cdtCodes || []).slice();
            }
            return [];
        }

        function formatTreatmentDateTime(date) {
            const d = date || new Date();
            const mm = String(d.getMonth() + 1).padStart(2, "0");
            const dd = String(d.getDate()).padStart(2, "0");
            const yyyy = d.getFullYear();
            let hours = d.getHours();
            const minutes = String(d.getMinutes()).padStart(2, "0");
            const ampm = hours >= 12 ? "PM" : "AM";
            hours = hours % 12;
            hours = hours ? hours : 12;
            const hh = String(hours).padStart(2, "0");
            return mm + "/" + dd + "/" + yyyy + " " + hh + ":" + minutes + " " + ampm;
        }

        function toggleTreatmentCompletedFields() {
            applyTreatmentFormLayout();
        }

        function writeFindingForm(finding) {
            $("#treatmentFindingDiseaseType").val(finding.diseaseConditionType || "");
            $("#treatmentFindingPrimaryTooth").prop("checked", !!finding.isPrimaryTooth);
            populateToothOptions();
            $("#treatmentFindingAffectedTooth").val(finding.affectedTooth || "");

            const postServiceValues = getTreatmentPostServiceValues(finding);
            const treatmentCdtValues = getTreatmentCdtValues(finding);

            suppressTreatmentCdtReset = true;
            try {
                populateFindingSurfaceOptions(finding.affectedSurfaces || []);
                populateFindingCdtOptions(finding.cdtCodes || []);
                populatePostServiceTreatmentOptions(postServiceValues);
                populateTreatmentCdtOptions(treatmentCdtValues);
            } finally {
                suppressTreatmentCdtReset = false;
            }

            $("#treatmentFindingCdtCodesNotes").val(finding.cdtCodesNotes || "");
            $("#treatmentFindingDescription").val(finding.descriptionDetails || "");
            $("input[name='TreatmentFindingClassification']").each(function () {
                $(this).prop("checked", $(this).val() === (finding.classification || ""));
            });

            const examinerUserId = getExaminerUserId(finding);
            const examinerWhen = getExaminerDateTime(finding);
            if (finding.isTreatmentOnly) {
                $("#treatmentFindingDetailsCard").hide();
                $("#treatmentSectionAffectedToothGroup").hide();
                $("#treatmentFindingExaminerSection").hide();
                $("#treatmentFindingExaminerName").val("");
                $("#treatmentFindingExaminerDateTime").val("");
                writeTreatmentOnlyClinicalFields(finding);
            } else {
                $("#treatmentFindingDetailsCard").show();
                $("#treatmentSectionAffectedToothGroup").show();
                $("#treatmentFindingExaminerSection").show();
                $("#initialExamFindingHeader").text("Initial Exam Finding");
                $("#treatmentFindingExaminerName").val(resolveStaffDisplayName(examinerUserId));
                $("#treatmentFindingExaminerDateTime").val(
                    examinerWhen ? formatExaminerDateTime(examinerWhen) : ""
                );
                clearTreatmentOnlyClinicalFields();
            }

            $("input[name='TreatmentCompleted']").prop("checked", false);
            if (finding.treatmentCompleted === "Yes" || finding.treatmentCompleted === "No") {
                $("input[name='TreatmentCompleted'][value='" + finding.treatmentCompleted + "']").prop("checked", true);
            }

            const toothLabel = finding.affectedTooth
                ? (finding.affectedTooth + (finding.isPrimaryTooth ? " (Primary)" : ""))
                : "";
            $("#treatmentSectionAffectedTooth").val(toothLabel);

            $("#treatmentFinalDrc").val(finding.finalDrc || "");
            $("#treatmentFindingDateTime").val(finding.findingDateTime || "");
            $("#treatmentDateTime").val(finding.treatmentDateTime || "");
            $("#treatmentReason").val(finding.reason || "");
            $("#treatmentNotes").val(finding.notes || "");

            toggleTreatmentCompletedFields();
            if (isTreatmentOnlyMode() || finding.treatmentCompleted === "Yes") {
                suppressTreatmentCdtReset = true;
                try {
                    populatePostServiceTreatmentOptions(postServiceValues);
                    populateTreatmentCdtOptions(treatmentCdtValues);
                } finally {
                    suppressTreatmentCdtReset = false;
                }
            }

            applyFindingSectionReadOnly();
        }

        function clearTreatmentOnlyClinicalFields() {
            $("#treatmentOnlyDiseaseType").val("");
            $("#treatmentOnlyPrimaryTooth").prop("checked", false);
            populateTreatmentOnlyToothOptions();
            $("#treatmentOnlyAffectedTooth").val("");
        }

        function writeTreatmentOnlyClinicalFields(finding) {
            $("#treatmentOnlyDiseaseType").val(finding.diseaseConditionType || "");
            $("#treatmentOnlyPrimaryTooth").prop("checked", !!finding.isPrimaryTooth);
            $("#treatmentOnlyAffectedTooth").val(finding.affectedTooth || "");
            populateTreatmentOnlyToothOptions();
        }

        function readTreatmentOnlyClinicalFields() {
            return {
                isPrimaryTooth: $("#treatmentOnlyPrimaryTooth").is(":checked"),
                affectedTooth: $("#treatmentOnlyAffectedTooth").val() || "",
                diseaseConditionType: $("#treatmentOnlyDiseaseType").val() || "",
                classification: TREATMENT_ONLY_CLASSIFICATION
            };
        }

        function validateTreatmentOnlyClinicalFields() {
            const clinical = readTreatmentOnlyClinicalFields();
            if (!clinical.diseaseConditionType) {
                Swal.fire("Invalid Data", "Disease / Condition Type is required.", "warning");
                return null;
            }
            if (!clinical.affectedTooth) {
                Swal.fire("Invalid Data", "Affected Tooth is required.", "warning");
                return null;
            }
            if (isAffectedToothMissing(clinical.affectedTooth, !!clinical.isPrimaryTooth)) {
                Swal.fire("Invalid Data", "Affected Tooth cannot be a missing tooth selected in PSR.", "warning");
                return null;
            }
            if (clinical.diseaseConditionType === "Restorative") {
                const allowedSurfaces = getRestorativeSurfacesForTooth(clinical.affectedTooth);
                if (!allowedSurfaces.length) {
                    Swal.fire("Invalid Data", "For Restorative findings, select a valid permanent (1-32) or primary tooth.", "warning");
                    return null;
                }
            }
            return clinical;
        }

        function clearTreatmentForm() {
            editingFindingIndex = null;
            $("#treatmentFindingFormTitle").text("Add Finding/Treatment");
            $("#updateTreatmentFindingBtn").html('<i class="fas fa-list-ul"></i> Add to List');
            $("#treatmentFindingDetailsCard").hide();
            $("#treatmentSectionAffectedToothGroup").hide();
            clearTreatmentOnlyClinicalFields();
            $("#treatmentFindingPrimaryTooth").prop("checked", false);
            $("#treatmentFindingDiseaseType").val("");
            populateToothOptions();
            $("#treatmentFindingAffectedTooth").val("");
            populateFindingSurfaceOptions([]);
            populateFindingCdtOptions([]);
            $("#treatmentFindingCdtCodesNotes").val("");
            $("#treatmentFindingDescription").val("");
            $("input[name='TreatmentFindingClassification']").prop("checked", false);
            $("#treatmentFindingExaminerName").val("");
            $("#treatmentFindingExaminerDateTime").val("");
            $("#treatmentFindingExaminerSection").hide();
            $("input[name='TreatmentCompleted']").prop("checked", false);
            $("#treatmentSectionAffectedTooth").val("");
            populatePostServiceTreatmentOptions([]);
            populateTreatmentCdtOptions([]);
            $("#treatmentFinalDrc").val("");
            $("#treatmentDentistProfessional").val("");
            $("#treatmentDateTime").val("");
            $("#treatmentFindingDateTime").val("");
            $("#treatmentReason").val("");
            $("#treatmentNotes").val("");
            toggleTreatmentCompletedFields();
        }

        function showFindingForm(finding) {
            const postServiceValues = getTreatmentPostServiceValues(finding);
            const treatmentCdtValues = getTreatmentCdtValues(finding);
            const isTreatmentOnly = !!finding.isTreatmentOnly;

            if (isTreatmentOnly) {
                $("#treatmentFindingDetailsCard").hide();
                $("#treatmentSectionAffectedToothGroup").hide();
            } else {
                $("#treatmentFindingDetailsCard").show();
                $("#treatmentSectionAffectedToothGroup").show();
            }

            $("#treatmentFindingFormCard").slideDown(200, function () {
                suppressTreatmentCdtReset = true;
                try {
                    if (!isTreatmentOnly) {
                        populateFindingSurfaceOptions(finding.affectedSurfaces || []);
                        populateFindingCdtOptions(finding.cdtCodes || []);
                    } else {
                        writeTreatmentOnlyClinicalFields(finding);
                    }
                    populatePostServiceTreatmentOptions(postServiceValues);
                    populateTreatmentCdtOptions(treatmentCdtValues);
                } finally {
                    suppressTreatmentCdtReset = false;
                }

                if (!isTreatmentOnly) {
                    applyFindingSectionReadOnly();
                }

                applyTreatmentSectionReadOnly();
                toggleTreatmentCompletedFields();
                if (isTreatmentOnly || $("input[name='TreatmentCompleted']:checked").val() === "Yes") {
                    suppressTreatmentCdtReset = true;
                    try {
                        populatePostServiceTreatmentOptions(postServiceValues);
                        populateTreatmentCdtOptions(treatmentCdtValues);
                    } finally {
                        suppressTreatmentCdtReset = false;
                    }
                    applyTreatmentSectionReadOnly();
                    if (!isTreatmentOnly) {
                        applyFindingSectionReadOnly();
                    }
                }
            });
        }

        function hideFindingForm() {
            destroySelect2($("#treatmentFindingAffectedSurfaces"));
            destroySelect2($("#treatmentFindingCdtCodes"));
            destroySelect2($("#treatmentPostServiceTreatment"));
            destroySelect2($("#treatmentSectionCdtCodes"));
            $("#treatmentFindingFormCard").slideUp(200);
            clearTreatmentForm();
        }

        function validateTreatmentSectionForm() {
            const treatmentOnly = isTreatmentOnlyMode();
            const finalDrc = $("#treatmentFinalDrc").val() || "";
            let treatmentCompleted = $("input[name='TreatmentCompleted']:checked").val() || "";

            if (treatmentOnly) {
                const clinical = validateTreatmentOnlyClinicalFields();
                if (!clinical) {
                    return null;
                }

                const postServiceVisible = $("#treatmentPostServiceSection").is(":visible");
                const postServiceTreatment = getSelectedValues($("#treatmentPostServiceTreatment"));
                const treatmentCdtCodes = getSelectedValues($("#treatmentSectionCdtCodes"));

                if (postServiceVisible && postServiceTreatment.length === 0) {
                    Swal.fire("Invalid Data", "Post Service Treatment is required.", "warning");
                    return null;
                }
                if (treatmentCdtCodes.length === 0) {
                    Swal.fire("Invalid Data", "CDT Code is required.", "warning");
                    return null;
                }
                if (!finalDrc) {
                    Swal.fire("Invalid Data", "DRC is required.", "warning");
                    return null;
                }

                if (isFindingOnlyDrc(finalDrc)) {
                    return {
                        clinical: clinical,
                        treatmentCompleted: "",
                        postServiceTreatment: postServiceTreatment,
                        treatmentCdtCodes: treatmentCdtCodes,
                        finalDrc: finalDrc,
                        dentistProfessional: CURRENT_USER_ID || "",
                        treatmentDateTime: "",
                        findingDateTime: $("#treatmentFindingDateTime").val()?.trim() || "",
                        reason: "",
                        notes: $("#treatmentNotes").val()?.trim() || "",
                        treatmentStatus: resolveTreatmentStatus({
                            treatmentCompleted: "",
                            finalDrc: finalDrc,
                            reason: ""
                        })
                    };
                }

                if (!treatmentCompleted) {
                    Swal.fire("Invalid Data", "Treatment Completed is required.", "warning");
                    return null;
                }

                if (treatmentCompleted === "Yes") {
                    return {
                        clinical: clinical,
                        treatmentCompleted: treatmentCompleted,
                        postServiceTreatment: postServiceTreatment,
                        treatmentCdtCodes: treatmentCdtCodes,
                        finalDrc: finalDrc,
                        dentistProfessional: CURRENT_USER_ID || "",
                        treatmentDateTime: $("#treatmentDateTime").val()?.trim() || "",
                        findingDateTime: "",
                        reason: "",
                        notes: $("#treatmentNotes").val()?.trim() || "",
                        treatmentStatus: resolveTreatmentStatus({
                            treatmentCompleted: treatmentCompleted,
                            finalDrc: finalDrc,
                            reason: ""
                        })
                    };
                }

                const reason = $("#treatmentReason").val() || "";
                if (!reason) {
                    Swal.fire("Invalid Data", "Reason is required.", "warning");
                    return null;
                }

                return {
                    clinical: clinical,
                    treatmentCompleted: treatmentCompleted,
                    postServiceTreatment: postServiceTreatment,
                    treatmentCdtCodes: treatmentCdtCodes,
                    finalDrc: finalDrc,
                    dentistProfessional: CURRENT_USER_ID || "",
                    treatmentDateTime: "",
                    findingDateTime: $("#treatmentFindingDateTime").val()?.trim() || "",
                    reason: reason,
                    notes: $("#treatmentNotes").val()?.trim() || "",
                    treatmentStatus: resolveTreatmentStatus({
                        treatmentCompleted: treatmentCompleted,
                        finalDrc: finalDrc,
                        reason: reason
                    })
                };
            }

            if (!treatmentCompleted) {
                Swal.fire("Invalid Data", "Treatment Completed is required.", "warning");
                return null;
            }

            if (treatmentCompleted === "Yes") {
                const postServiceVisible = $("#treatmentPostServiceSection").is(":visible");
                const postServiceTreatment = getSelectedValues($("#treatmentPostServiceTreatment"));
                const treatmentCdtCodes = getSelectedValues($("#treatmentSectionCdtCodes"));

                if (postServiceVisible && postServiceTreatment.length === 0) {
                    Swal.fire("Invalid Data", "Post Service Treatment is required.", "warning");
                    return null;
                }
                if (treatmentCdtCodes.length === 0) {
                    Swal.fire("Invalid Data", "CDT Code is required.", "warning");
                    return null;
                }
                if (!finalDrc) {
                    Swal.fire("Invalid Data", "DRC is required.", "warning");
                    return null;
                }

                return {
                    clinical: null,
                    treatmentCompleted: treatmentCompleted,
                    postServiceTreatment: postServiceTreatment,
                    treatmentCdtCodes: treatmentCdtCodes,
                    finalDrc: finalDrc,
                    dentistProfessional: CURRENT_USER_ID || "",
                    treatmentDateTime: $("#treatmentDateTime").val()?.trim() || "",
                    findingDateTime: "",
                    reason: "",
                    notes: $("#treatmentNotes").val()?.trim() || "",
                    treatmentStatus: resolveTreatmentStatus({
                        treatmentCompleted: treatmentCompleted,
                        finalDrc: finalDrc,
                        reason: ""
                    })
                };
            }

            const reason = $("#treatmentReason").val() || "";
            if (!reason) {
                Swal.fire("Invalid Data", "Reason is required.", "warning");
                return null;
            }

            return {
                clinical: null,
                treatmentCompleted: treatmentCompleted,
                postServiceTreatment: [],
                treatmentCdtCodes: [],
                finalDrc: "",
                dentistProfessional: "",
                treatmentDateTime: "",
                findingDateTime: "",
                reason: reason,
                notes: $("#treatmentNotes").val()?.trim() || "",
                treatmentStatus: resolveTreatmentStatus({
                    treatmentCompleted: treatmentCompleted,
                    finalDrc: "",
                    reason: reason
                })
            };
        }

        function updateFindingFromTreatmentSection() {
            if (!CAN_EDIT_TREATMENT) {
                return;
            }

            const isNew = editingFindingIndex == null;
            const existing = isNew ? null : treatmentFindings[editingFindingIndex];
            if (!isNew && !existing) {
                return;
            }

            const isTreatmentOnly = isNew || !!existing.isTreatmentOnly;

            const validated = validateTreatmentSectionForm();
            if (!validated) {
                return;
            }

            if (!isTreatmentOnly) {
                const toothLabel = existing.affectedTooth
                    ? (existing.affectedTooth + (existing.isPrimaryTooth ? " (Primary)" : ""))
                    : "";
                $("#treatmentSectionAffectedTooth").val(toothLabel);
            }

            if (isNew) {
                const clinical = validated.clinical || readTreatmentOnlyClinicalFields();
                const surfacesForStore = validated.postServiceTreatment || [];
                treatmentFindings.push({
                    id: 0,
                    dentalFindingId: null,
                    origin: FINDING_ORIGIN_TREATMENT,
                    isTreatmentOnly: true,
                    isPrimaryTooth: !!clinical.isPrimaryTooth,
                    affectedTooth: clinical.affectedTooth || "",
                    diseaseConditionType: clinical.diseaseConditionType || "",
                    affectedSurfaces: surfacesForStore,
                    cdtCodes: validated.treatmentCdtCodes || [],
                    cdtCodesNotes: "",
                    descriptionDetails: "",
                    classification: TREATMENT_ONLY_CLASSIFICATION,
                    sortOrder: treatmentFindings.length,
                    examinationAddedBy: null,
                    examinationAddedOn: null,
                    examinationUpdatedBy: null,
                    examinationUpdatedOn: null,
                    treatmentCompleted: validated.treatmentCompleted,
                    postServiceTreatment: validated.postServiceTreatment,
                    treatmentCdtCodes: validated.treatmentCdtCodes,
                    reason: validated.reason,
                    notes: validated.notes,
                    finalDrc: validated.finalDrc,
                    dentistProfessional: validated.dentistProfessional,
                    treatmentStatus: validated.treatmentStatus,
                    treatmentDateTime: validated.treatmentDateTime,
                    findingDateTime: validated.findingDateTime
                });
            } else {
                if (isTreatmentOnly && validated.clinical) {
                    existing.isPrimaryTooth = !!validated.clinical.isPrimaryTooth;
                    existing.affectedTooth = validated.clinical.affectedTooth || "";
                    existing.diseaseConditionType = validated.clinical.diseaseConditionType || "";
                    existing.classification = TREATMENT_ONLY_CLASSIFICATION;
                }
                if (isTreatmentOnly) {
                    existing.affectedSurfaces = validated.postServiceTreatment || [];
                    existing.cdtCodes = validated.treatmentCdtCodes || [];
                }

                existing.treatmentCompleted = validated.treatmentCompleted;
                existing.postServiceTreatment = validated.postServiceTreatment;
                existing.treatmentCdtCodes = validated.treatmentCdtCodes;
                existing.finalDrc = validated.finalDrc;
                existing.dentistProfessional = validated.dentistProfessional;
                existing.treatmentDateTime = validated.treatmentDateTime;
                existing.findingDateTime = validated.findingDateTime;
                existing.reason = validated.reason;
                existing.notes = validated.notes;
                existing.treatmentStatus = validated.treatmentStatus;
                treatmentFindings[editingFindingIndex] = existing;
            }

            renderFindingsTable();
            hideFindingForm();
        }

        function startAddTreatmentFinding() {
            if (!CAN_EDIT_TREATMENT) {
                return;
            }

            editingFindingIndex = null;
            clearTreatmentForm();
            $("#treatmentFindingFormTitle").text("Add Finding/Treatment");
            $("#updateTreatmentFindingBtn").html('<i class="fas fa-list-ul"></i> Add to List');
            $("#treatmentFindingDetailsCard").hide();
            $("#treatmentSectionAffectedToothGroup").hide();
            setTreatmentOnlyClinicalVisible(true);

            if (!$("#toggleSubsequentSectionSwitch").is(":checked")) {
                $("#toggleSubsequentSectionSwitch").prop("checked", true).trigger("change");
            }
            if (!$("#toggleDentalFindingsSectionSwitch").is(":checked")) {
                $("#toggleDentalFindingsSectionSwitch").prop("checked", true).trigger("change");
            }

            showFindingForm({
                origin: FINDING_ORIGIN_TREATMENT,
                isTreatmentOnly: true,
                affectedSurfaces: [],
                cdtCodes: [],
                postServiceTreatment: [],
                treatmentCdtCodes: []
            });

            $("html, body").animate({
                scrollTop: $("#treatmentFindingFormCard").offset().top - 80
            }, 300);
        }

        function editFinding(index) {
            const finding = treatmentFindings[index];
            if (!finding) {
                return;
            }

            editingFindingIndex = index;
            $("#treatmentFindingFormTitle").text(finding.isTreatmentOnly ? "Edit Finding/Treatment" : "Required Treatment Services");
            $("#updateTreatmentFindingBtn").html(
                finding.isTreatmentOnly
                    ? '<i class="fas fa-check-circle"></i> Update Treatment'
                    : '<i class="fas fa-check-circle"></i> Update Finding'
            );
            writeFindingForm(finding);
            showFindingForm(finding);

            // Ensure parent Subsequent section is visible when editing.
            if (!$("#toggleSubsequentSectionSwitch").is(":checked")) {
                $("#toggleSubsequentSectionSwitch").prop("checked", true).trigger("change");
            }

            // Ensure Dental Findings section is visible when editing.
            if (!$("#toggleDentalFindingsSectionSwitch").is(":checked")) {
                $("#toggleDentalFindingsSectionSwitch").prop("checked", true).trigger("change");
            }

            $("html, body").animate({
                scrollTop: $("#treatmentFindingFormCard").offset().top - 80
            }, 300);
        }

        function deleteTreatmentFinding(index) {
            if (!CAN_EDIT_TREATMENT) {
                return;
            }

            const finding = treatmentFindings[index];
            if (!finding || !finding.isTreatmentOnly) {
                return;
            }

            Swal.fire({
                title: "Delete finding?",
                text: "This treatment-only finding will be removed from the list.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Delete",
                confirmButtonColor: "#dc3545"
            }).then(function (result) {
                if (!result.isConfirmed) {
                    return;
                }

                treatmentFindings.splice(index, 1);
                if (editingFindingIndex === index) {
                    hideFindingForm();
                } else if (editingFindingIndex != null && editingFindingIndex > index) {
                    editingFindingIndex -= 1;
                }
                renderFindingsTable();
            });
        }

        function toggleDentalFindingsSectionFromSwitch() {
            const isOn = $("#toggleDentalFindingsSectionSwitch").is(":checked");
            const $section = $("#dentalFindingsContentSection");
            if (isOn) {
                $section.slideDown(200);
            } else {
                $section.slideUp(200);
            }
            $("#toggleDentalFindingsSectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
        }

        window.initDentalTreatmentFindingsSection = function () {
            populateToothOptions();
            populateTreatmentOnlyToothOptions();
            renderFindingsTable();
        };

        window.syncDentalTreatmentFindingsJson = syncDentalTreatmentFindingsJson;

        $(document).ready(function () {
            initDentalTreatmentFindingsSection();

            $("#toggleDentalFindingsSectionSwitch").on("change", toggleDentalFindingsSectionFromSwitch);

            $("#addTreatmentFindingBtn").on("click", startAddTreatmentFinding);
            $("#cancelTreatmentFindingFormBtn").on("click", hideFindingForm);
            $("#updateTreatmentFindingBtn").on("click", function () {
                if (!CAN_EDIT_TREATMENT) {
                    return;
                }
                updateFindingFromTreatmentSection();
            });

            $(document).on("change", "#treatmentOnlyDiseaseType, #treatmentOnlyAffectedTooth, #treatmentOnlyPrimaryTooth", function () {
                if (!CAN_EDIT_TREATMENT || !isTreatmentOnlyMode()) {
                    return;
                }

                if (this.id === "treatmentOnlyPrimaryTooth") {
                    populateTreatmentOnlyToothOptions();
                }

                if (suppressTreatmentCdtReset) {
                    return;
                }

                populatePostServiceTreatmentOptions([]);
                populateTreatmentCdtOptions([]);
            });

            $(document).on("change", "#treatmentFinalDrc", function () {
                toggleTreatmentCompletedFields();
            });

            $(document).on("change", "input[name='TreatmentCompleted']", function () {
                toggleTreatmentCompletedFields();
                if ($(this).val() !== "Yes" || isTreatmentOnlyMode()) {
                    return;
                }

                suppressTreatmentCdtReset = true;
                try {
                    if (editingFindingIndex != null && treatmentFindings[editingFindingIndex]) {
                        const finding = treatmentFindings[editingFindingIndex];
                        if (finding.isTreatmentOnly) {
                            populatePostServiceTreatmentOptions(getTreatmentPostServiceValues(finding));
                            populateTreatmentCdtOptions(getTreatmentCdtValues(finding));
                        } else {
                            const toothLabel = finding.affectedTooth
                                ? (finding.affectedTooth + (finding.isPrimaryTooth ? " (Primary)" : ""))
                                : "";
                            $("#treatmentSectionAffectedTooth").val(toothLabel);
                            populatePostServiceTreatmentOptions(getTreatmentPostServiceValues(finding));
                            populateTreatmentCdtOptions(getTreatmentCdtValues(finding));
                        }
                    } else if (isTreatmentOnlyMode()) {
                        populatePostServiceTreatmentOptions([]);
                        populateTreatmentCdtOptions([]);
                    }
                } finally {
                    suppressTreatmentCdtReset = false;
                }
            });

            $(document).on("change", "#treatmentPostServiceTreatment", function () {
                if (suppressTreatmentCdtReset) {
                    return;
                }
                if (getActiveDiseaseType() === "Restorative") {
                    populateTreatmentCdtOptions([]);
                }
            });

            $(document).on("click", ".toggle-finding-treatment-detail", function () {
                const $btn = $(this);
                const target = $btn.attr("data-target");
                const $detail = $(target);
                if (!$detail.length) {
                    return;
                }

                const willOpen = !$detail.is(":visible");
                $detail.toggle(willOpen);
                $btn.attr("aria-expanded", willOpen ? "true" : "false");
                $btn.attr("title", willOpen ? "Hide treatment details" : "Show treatment details");
                $btn.find("i").toggleClass("fa-chevron-right", !willOpen).toggleClass("fa-chevron-down", willOpen);
                $btn.closest("tr.finding-main-row").toggleClass("finding-row-expanded", willOpen);
                $btn.find(".visually-hidden").text(willOpen ? "Hide treatment details" : "Show treatment details");
            });

            $(document).on("click", ".edit-treatment-finding-btn", function () {
                editFinding(parseInt($(this).data("index"), 10));
            });

            $(document).on("click", ".delete-treatment-finding-btn", function () {
                deleteTreatmentFinding(parseInt($(this).data("index"), 10));
            });
        });
    })();
</script>
