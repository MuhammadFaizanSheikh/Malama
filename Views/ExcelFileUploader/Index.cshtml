    $('#eventIdDropdown').on('change', async function () {
        const selectedEventId = $(this).val();
        await fetchAndRenderEventData(selectedEventId);
    });

    async function fetchAndRenderEventData(eventId, callback) {
        if (!eventId) return;

        $('#loader').removeClass('d-none');

        try {
            const response = await fetch('/ExcelFileUploader/GetEventDataByEventId', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(eventId)
            });

            const result = await response.json();

            if (result.success && result.data.length > 0) {
                await renderPreviewTable(result.data); // ✅ wait for DataTable init
                if (typeof callback === 'function') {
                    await callback();
                }
            } else {
                Swal.fire('No Data', 'No records found for the selected Event ID.', 'info');
            }
        } catch (error) {
            Swal.fire('Error', 'Something went wrong while fetching data.', 'error');
        } finally {
            $('#loader').addClass('d-none');
        }
    }

    function renderPreviewTable(data) {
        debugger;
        if ($.fn.DataTable.isDataTable("#previewTable")) {
            $("#previewTable").DataTable().clear().destroy();
        }

        $("#previewTable thead").empty();
        $("#previewTable tbody").empty();

        // Generate headers dynamically from columnMappings
        let headerRow = `<tr><th>Actions</th>`;
        columnMappingsForInsertionAndFetching.forEach(mapping => {
            headerRow += `<th>${mapping.label}</th>`;
        });
        headerRow += `</tr>`;
        $("#previewTable thead").append(headerRow);

        $("#previewTable thead th").css({
            "background-color": "rgba(120, 130, 221, 1)",
            "color": "white" // optional: for better contrast
        });

        debugger;
        // Generate rows
        let formattedData = data.map(row => {
            const rowData = [null]; // placeholder for "Actions"
            columnMappingsForInsertionAndFetching.forEach(mapping => {
                let value = row[mapping.key] ?? "";

                // Format date fields
                if (mapping.type === "date" && value) {
                    const parsedDate = new Date(value);
                    if (!isNaN(parsedDate)) {
                        value = parsedDate.toLocaleString("en-US", {
                            year: "numeric",
                            month: "2-digit",
                            day: "2-digit",
                            hour: "2-digit",
                            minute: "2-digit",
                            second: "2-digit",
                            hour12: false
                        }).replace(",", ""); // Remove comma between date and time
                    }
                }

                rowData.push($('<div>').text(value).html()); // escape HTML
            });

            rowData.push(`<input type="hidden" class="row-id" value="${row.Id}" />`);
            return rowData;
        });


        const fullNameIndexForSorting = keys.indexOf("FULL NAME") - 1;
        const sexIndexForSorting = keys.indexOf("SEX") - 1;
        const smIdIndexForSorting = keys.indexOf("SM ID");

        // Initialize DataTable
        $("#previewTable").DataTable({
            data: formattedData,
            columns: [
                {
                    title: "Actions",
                    data: null,
                    orderable: false,
                    render: function () {
                        return `
                                   <button class="btn btn-primary mr-2" style="background-color: rgba(80, 90, 201, 1); border-color: rgba(80, 90, 201, 1);" onclick="editRow(this)">Edit</button>
                                 <button class="btn mr-2 btn-print" style="background-color: rgba(80, 90, 201, 1); border-color: rgba(80, 90, 201, 1); color: white;">Print</button>
                            `;
                    }
                },
                ...columnMappingsForInsertionAndFetching.map((mapping, i) => ({
                    title: mapping.label,
                    orderable: (i === fullNameIndexForSorting || i === sexIndexForSorting)
                }))
            ],
            createdRow: function (row, data, dataIndex) {
                // Append the hidden ID input at the end of the row
                const hiddenInput = $(data[data.length - 1]);
                $(row).append(hiddenInput);
            },
            scrollY: 400,
            scrollX: true,
            scrollCollapse: true,
            paging: false,
            autoWidth: false,
            fixedColumns: {
                leftColumns: 7
            },
            ordering: true,
            order: [[smIdIndexForSorting, 'asc']]
        });

        // Show relevant UI
        debugger;
        $('#eventSummaryTable').removeClass('d-none');
        const filterDiv = document.querySelector('.card.p-3.mb-4');
                filterDiv.style.display = 'block';
                $('.add-row-button').show();
        // document.getElementById('addRowButton').classList.remove('d-none');

        RenderUpdatedEventSummaryTable();
    }

    $('#searchStaffBtn').on('click', function () {
        var fullName = $('#filterFullName').val().trim().toLowerCase();
        var last4Ssn = $('#filterLast4Ssn').val().trim();
        var dodId = $('#filterDodId').val().trim();
        var dob = $('#filterDob').val();
        var sex = $('#filterSex').val();
        var checkIn = $('#filterCheckIn').val();
        var checkOut = $('#filterCheckOut').val();
        var walkInSm = $('#filterWalkInSm').val();
        var previewTable = $('#previewTable').DataTable();

        // Clear previous searches
        previewTable.columns().search('');

        if (fullName) {
            const escapedFullName = fullName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const regex = escapedFullName; // match anywhere
            previewTable.column(keys.indexOf('FULL NAME')).search(regex, true, false, true);
        }

        if (last4Ssn) {
            previewTable.column(keys.indexOf('LAST 4')).search('^' + last4Ssn + '$', true, false);
        }

        if (dodId) {
            previewTable.column(keys.indexOf('DOD ID')).search('^' + dodId + '$', true, false);
        }

        if (dob) {
            previewTable.column(keys.indexOf('DOB')).search(formatDateToMMDDYYYY(dob));
        }

        if (sex) {
            previewTable.column(keys.indexOf('SEX')).search('^' + sex + '$', true, false);
        }

        if (checkIn) {
            previewTable.column(keys.indexOf('Checked In')).search('^' + checkIn + '$', true, false);
        }

        if (checkOut) {
            previewTable.column(keys.indexOf('Checked Out')).search('^' + checkOut + '$', true, false);
        }

        if (walkInSm) {
            previewTable.column(keys.indexOf('Walk-In Service Member')).search('^' + walkInSm + '$', true, false);
        }

        previewTable.draw();
    });


    $('#resetFiltersBtn').click(function () {
        resetAllFilters();
    });

    function resetAllFilters() {
