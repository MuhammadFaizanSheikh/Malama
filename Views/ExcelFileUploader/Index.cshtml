    async function addSingleRecordInDatabase(url, data) {
        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            return {
                success: response.ok && result.success,
                data: result,
                status: response.status
            };
        } catch (error) {
            console.error("AJAX call failed:", error);
            return {
                success: false,
                error: error
            };
        }
    }

    async function updateSingleRecordInDatabase(url, dtoObject) {
        try {
            debugger;
            const response = await fetch(url, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(dtoObject)
            });

            const data = await response.json();

            return {
                success: response.ok,
                status: response.status,
                data: data
            };
        } catch (error) {
            return {
                success: false,
                status: null,
                error: error
            };
        }
    }


    function prepareObjectToAddRecordInDatabase(fullRowData, keys) {
        const dto = {};

        columnMappingsForInsertionAndFetching.forEach(mapping => {
            const keyIndex = keys.indexOf(mapping.label);
            if (keyIndex === -1) return;

            let value = fullRowData[keyIndex];

            switch (mapping.type) {
                case "int":
                    dto[mapping.key] = value !== "" && value != null ? parseInt(value) : 0;
                    break;

                case "float":
                    dto[mapping.key] = value !== "" && value != null ? parseFloat(value) : 0.0;
                    break;

                case "date":
                    if (!value) {
                        dto[mapping.key] = null;
                    } else {
                        let parsedDate = new Date(value);
                        dto[mapping.key] = isNaN(parsedDate.getTime()) ? null : parsedDate.toISOString();
                    }
                    break;

                default: // string or unknown
                    dto[mapping.key] = value !== undefined && value !== null ? value.toString().trim() : null;
                    break;
            }
        });

        dto["isDeleted"] = false;

        return dto;
    }

    function prepareObjectToUpdateRecordInDatabase(updatedData, columnMappings) {
        debugger;
        const keyByLabel = {};
        const typeByLabel = {};

        columnMappings.forEach(mapping => {
            const labelUpper = mapping.label.toUpperCase();
            keyByLabel[labelUpper] = mapping.key;
            typeByLabel[labelUpper] = mapping.type;
        });

        const transformed = {};
        for (const label in updatedData) {
            const labelUpper = label.toUpperCase();
            const dbKey = keyByLabel[labelUpper];
            const fieldType = typeByLabel[labelUpper];

            if (dbKey) {
                let value = updatedData[label];

                // Apply type conversion
                if (fieldType === 'int') {
                    value = value === '' || value == null ? null : parseInt(value);
                } else if (fieldType === 'date') {
                    value = value ? new Date(value).toISOString() : null;
                } else if (fieldType === 'string') {
                    value = value != null ? String(value) : null;
                }

                transformed[dbKey] = value;
            }
        }

        transformed["Id"] = primaryKeyForEdit;//bind id for update record in database
        transformed["SmId"] = smIdEditing

        return transformed;
    }


