@model Malama.Models.CreateContainerDto
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var selectedEventId = ViewBag.EventId;
    var types = ViewBag.ContainerTypes as IEnumerable<ContainerType> ?? new List<ContainerType>();
}

<style>
    #page-heading {
        text-align: center;
        margin: 20px auto;
    }

    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white; /* ensures text is visible */
    }

        .btn-general:hover {
            background-color: rgba(60, 70, 180, 1); /* slightly darker on hover */
            border-color: rgba(60, 70, 180, 1);
            color: white;
        }

        .btn-general:focus,
        .btn-general:active {
            box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.5);
            outline: none;
        }

    .button-container {
        gap: 15px;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    table {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        table th,
        table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center; /* Aligns the text in the middle of the cell */
        }

        table th {
            background-color: #f4f4f4;
        }

        table tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

            table tbody tr:hover {
                background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
            }

        table td button,
        table td a {
            display: inline-block; /* Makes the buttons appear side by side */
            margin-right: 5px; /* Optional: Adds space between the buttons */
        }

        table td .button-container {
            display: flex;
            justify-content: center; /* Aligns buttons horizontally in the center */
        }

            table td .button-container a {
                margin-right: 5px; /* Optional: Adds space between the buttons */
            }

        table thead th {
            background-color: rgba(120, 130, 221, 1); /* Header background color */
            color: white; /* Header text color */
            text-align: center; /* Center-align header text */
        }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }
</style>


<h2 id="page-heading">Add New Container</h2>
<h2 id="page-heading">Event ID : @selectedEventId</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Add" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()

    <input type="hidden" name="EventId" value="@selectedEventId" />
    <!-- Container Name -->
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ContainerName" class="form-label">Container Name</label>
            <input asp-for="ContainerName" class="form-control" placeholder="Enter container name" required />
            <span asp-validation-for="ContainerName" class="text-danger"></span>
        </div>

        <!-- Container Type -->
        <div class="col-md-6 mb-3">
            <label asp-for="ContainerTypeId" class="form-label">Container Type</label>
            <select asp-for="ContainerTypeId" class="form-select" id="containerTypeSelect" onchange="onContainerTypeChange()" required>
                <option value="">-- Select Container Type --</option>
                @if (types != null)
                {
                    foreach (var t in types)
                    {
                        <option value="@t.Id" data-min="@t.TemperatureFromRange" data-max="@t.TemperatureToRange">
                            @t.Name (@t.TemperatureFromRange - @t.TemperatureToRange @t.TemperatureUnit)
                        </option>
                    }
                }
            </select>
            <span asp-validation-for="ContainerTypeId" class="text-danger"></span>
        </div>
    </div>

    <!-- Start Date and Time -->
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label">Container Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" readonly required />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
       @*  <div class="col-md-6 mb-3">
            <label asp-for="StartTime" class="form-label">Container Start Time</label>
            <input asp-for="StartTime" type="time" class="form-control" required />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div> *@
    </div>

    <!-- Initial Temperature -->
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="InitialTemperature" class="form-label">Container Temperature</label>
            <input asp-for="InitialTemperature" class="form-control" id="initialTemp"
                   oninput="checkInitialTemp()" required  type="number" step="0.1"
                   min="-100"
                   max="100" />
            <span asp-validation-for="InitialTemperature" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3" id="commentDiv">
            <label asp-for="Comment" class="form-label">Comment</label>
            <textarea asp-for="Comment" id="commentInput" class="form-control"
                      rows="3" placeholder="Enter comment if temperature is out of range"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>
    </div>

    <!-- Submit Button -->
    @* <div class="d-flex justify-content-end">
    <button type="submit" class="btn btn-primary">Submit</button>
    </div> *@
    <div class="d-flex justify-content-end mt-4">
        @{
            bool canSubmit =
            (User.IsInRole("Imm RN") && User.HasClaim("Attribute", "Cold Chain Cert")) ||
            (User.IsInRole("Imm Staff") && User.HasClaim("Attribute", "Cold Chain Cert"));
        }

        <button type="submit" id="submitBtn" class="btn btn-success btn-lg me-3" name="action" @(canSubmit ? "" : "disabled")>
            <i class="bi bi-check-circle"></i> Submit
        </button>

        <a asp-action="Index" class="btn btn-secondary btn-lg">
            <i class="bi bi-arrow-left"></i> Back
        </a>

    </div>
</form>

<script>
        onContainerTypeChange();

        function onContainerTypeChange() {
        const sel = document.getElementById('containerTypeSelect');
        const option = sel.options[sel.selectedIndex];
        const min = option ? option.getAttribute('data-min') : null;
        const max = option ? option.getAttribute('data-max') : null;
        window._selectedMin = min ? parseFloat(min) : null;
        window._selectedMax = max ? parseFloat(max) : null;
        checkInitialTemp();
    }

        function checkInitialTemp() {
        const tempInput = document.getElementById('initialTemp');
        const val = parseFloat(tempInput.value);
        const min = window._selectedMin;
        const max = window._selectedMax;
        const commentDiv = document.getElementById('commentDiv');
        const commentInput = document.getElementById('commentInput');

        if (!isNaN(val) && min != null && max != null) {
            const outOfRange = val < min || val > max;
        // commentDiv.style.display = outOfRange ? 'block' : 'none';
        commentInput.required = outOfRange;
        // if (!outOfRange) commentInput.value = ''; // clear old comment
        // }
    }

</script>
