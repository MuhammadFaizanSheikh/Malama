@using Malama.Utilities
@model Malama.Models.Container
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var readings = ViewBag.Readings as IEnumerable<ContainerTemperatureReading> ?? new List<ContainerTemperatureReading>();
}
<style>
    #page-heading {
        text-align: center;
        margin: 20px auto;
    }

    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white; /* ensures text is visible */
    }

        .btn-general:hover {
            background-color: rgba(60, 70, 180, 1); /* slightly darker on hover */
            border-color: rgba(60, 70, 180, 1);
            color: white;
        }

        .btn-general:focus,
        .btn-general:active {
            box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.5);
            outline: none;
        }

    .button-container {
        gap: 15px;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    table {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        table th,
        table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center; /* Aligns the text in the middle of the cell */
        }

        table th {
            background-color: #f4f4f4;
        }

        table tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

            table tbody tr:hover {
                background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
            }

        table td button,
        table td a {
            display: inline-block; /* Makes the buttons appear side by side */
            margin-right: 5px; /* Optional: Adds space between the buttons */
        }

        table td .button-container {
            display: flex;
            justify-content: center; /* Aligns buttons horizontally in the center */
        }

            table td .button-container a {
                margin-right: 5px; /* Optional: Adds space between the buttons */
            }

        table thead th {
            background-color: rgba(120, 130, 221, 1); /* Header background color */
            color: white; /* Header text color */
            text-align: center; /* Center-align header text */
        }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }
</style>


<h2 id="page-heading" class="mb-4">Container Temperature Reading</h2>
@* <h2 id="page-heading">Event ID : @Model.EventId</h2> *@

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-center gap-3 mb-4">

    <div class="flex-fill" style="min-width: 180px;">
        <label class="form-label mb-0">Name:</label>
        <input readonly value="@Model.ContainerName" class="form-control" />
    </div>

    <div class="flex-fill" style="min-width: 260px;">
        <label class="form-label mb-0">Type:</label>
        <input readonly
               value="@($"{Model.ContainerType?.Name} (Temp {Model.ContainerType?.TemperatureFromRange ?? 0}{Model.ContainerType?.TemperatureUnit ?? ""} to {Model.ContainerType?.TemperatureToRange ?? 0}{Model.ContainerType?.TemperatureUnit ?? ""})")"
               class="form-control" />
    </div>

    <div class="flex-fill" style="min-width: 160px;">
        <label class="form-label mb-0">Start Date:</label>
        <input readonly value="@Model.StartDateTimeUtc.ToString("MM/dd/yyyy")" class="form-control" />
    </div>

    <div class="flex-fill" style="min-width: 160px;">
        <label class="form-label mb-0">Start Time:</label>
        <input readonly value="@Model.StartDateTimeUtc.ToString("hh:mm tt")" class="form-control" />
    </div>

    <div class="flex-fill" style="min-width: 120px;">
        <label class="form-label mb-0">Initial Temp:</label>
        <input readonly value="@($"{Model.InitialTemperature} {Model.ContainerType?.TemperatureUnit}")" class="form-control" />
    </div>
    

</div>
<div class="flex-fill mb-4" style="min-width: 120px;">
    <label class="form-label mb-0">Comment:</label>
    <textarea readonly rows="3" class="form-control">@Model.Comment</textarea>
</div>



<div class="mb-5 mt-4">
    <table class="display">
        <thead>
            <tr>
                <th style="width: 33%;">Time</th>
                <th style="width: 33%;">
                    Temp (@Model.ContainerType?.TemperatureUnit)
                </th>
                <th style="width: 34%;">Comment</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in readings)
            {
                <tr>
                    <td>@r.ReadingTimeUtc.ToString("hh:mm tt")</td>
                    <td style="font-weight:bold; color:@(r.IsOutOfRange ? "red" : "green")">
                        @r.Temperature
                    </td>
                    <td>@r.Comment</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mb-4">
    <h3 id="page-heading">New Reading</h3>
    <form asp-action="Monitor" asp-route-id="@Model.Id" method="post">
        <input type="hidden" name="ContainerId" value="@Model.Id" />
        <div class="row g-3 align-items-end">
            @if (!Model.FinalTemp)
            {
                <div class="col-md-4">
                    <label class="form-label">Reading Expected Time</label>
                    <input readonly value="@Model.NextExpectedReadingUtc.ToString("hh:mm tt")" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Temperature</label>
                    <input name="Temperature" id="monitorTemp" oninput="checkMonitorTemp()" class="form-control" type="number"
                    step="0.1"
                    min="-100"
                    max="100" required />
                </div>
                <div class="col-md-4" id="monitorCommentDiv">
                    <label class="form-label">Comment (required if Out of Range)</label>
                    <textarea name="Comment" id="monitorComment" rows="3" class="form-control"></textarea>
            </div>
            }
            else
            {
                <div class="alert alert-info mt-3">
                    <strong>Final temperature recorded — no further readings allowed.</strong>
                </div>
            }
        </div>

        <div class="col-md-4 mt-3">
            <div class="form-check">
                <!-- Hidden ensures a false value is sent when unchecked -->
                @* <input type="hidden" name="IsFinalReading" value="false" /> *@

                <!-- Checkbox overrides to true when checked -->
                <input class="form-check-input" type="checkbox" name="IsFinalReading" id="isFinalReading"
                       value="true" @(Model.FinalTemp ? "checked" : "") />

                <label class="form-check-label" for="isFinalReading">
                    Final Temp
                </label>
            </div>
        </div>


        <div class="d-flex justify-content-end mt-4">
           

            <button type="submit" id="submitBtn" class="btn btn-success btn-lg me-3" name="action" @(DashboardAuthorizationHelper.HasAccess(User, "Container_Save") ? "" : "disabled")>
                <i class="bi bi-check-circle"></i> Submit
            </button>

            <a asp-action="Index" class="btn btn-secondary btn-lg btn-back-confirm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </form>
</div>

<script>
    // Set allowed temperature range from model
    const minTemp = @Model.ContainerType?.TemperatureFromRange ?? 0;
    const maxTemp = @Model.ContainerType?.TemperatureToRange ?? 0;

    let isSubmitting = false;

    $("#submitBtn").on("click", function (e) {
        const btn = $(this);

        if (isSubmitting) {
            e.preventDefault();
            return;
        }

        isSubmitting = true;

        setTimeout(() => {
            btn.prop("disabled", true);
            btn.html('<i class="bi bi-check-circle"></i> Saving...');
        }, 0);
    });

    $('a.btn-back-confirm').on('click', async function (e) {
            e.preventDefault();

            const url = $(this).attr('href');

            const confirmed = await showYesNoModal(
                "Are you sure you want to go back to main screen without saving changes?"
            );

            if (!confirmed) {
                return;
            }

            window.location.href = url;
        });

    function checkMonitorTemp() {
        const tempInput = document.getElementById('monitorTemp');
        const commentDiv = document.getElementById('monitorCommentDiv');
        const commentInput = document.getElementById('monitorComment');

        const val = parseFloat(tempInput.value);

        if (!isNaN(val)) {
            if (val < minTemp || val > maxTemp) {
                // Show comment and make it required
                // commentDiv.style.display = 'block';
                commentInput.required = true;
            } else {
                // Hide comment and remove required
                // commentDiv.style.display = 'none';
                commentInput.required = false;
                // commentInput.value = '';
            }
        } else {
            // commentDiv.style.display = 'none';
            commentInput.required = false;
        }
    }

    // document.getElementById("isFinalReading").addEventListener("change", function (e) {
    //     if (e.target.checked) {
    //         if (!confirm("Are you sure you want to mark this as final temperature? This will stop further monitoring.")) {
    //             e.target.checked = false;
    //         }
    //     }
    // });

</script>
