@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

            Swal.fire({
                icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor, // Conditional button color
                iconColor: iconColor // Conditional icon color
            });
        });
    </script>
}

<!-- Preview Table (shown only if event selected) -->
@if (Model != null)
{
    @* <h2 id="page-heading">Event ID : @selectedEventId</h2> *@

    <div class="card p-3 mb-4">
        <div class="container">
            <div class="row g-2">
                <!-- First Row -->
                <div class="col-md-3">
                    <label for="filterContainerName" class="form-label">Container Name</label>
                    <input type="text" id="filterContainerName" class="form-control" placeholder="Container Name">

                </div>
                <div class="col-md-3">
                    <label for="filterContainerType" class="form-label">Container Type</label>
                    <input type="text" id="filterContainerType" class="form-control" placeholder="Container Type">
                </div>
                <div class="col-md-3">
                    <label for="filterContainerStartDate" class="form-label">Container Start Date</label>
                    <input type="date" id="filterContainerStartDate" class="form-control">
                </div>
                <div class="col-12 text-center mt-3">
                    <button id="searchStaffBtn" type="button" class="btn btn-general">Search</button>
                    <button id="resetFiltersBtn" type="button" class="btn btn-general">Reset Filters</button>
                </div>
            </div>
        </div>
    </div>

    <table id="contractsTable"  class="display">
        <thead>
            <tr>
                <th>Actions</th>
                <th>Container Name</th>
                <th>Type</th>
                <th>Container Start Date</th>
                <th>Container Start Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Monitor" asp-route-id="@item.Id" class="btn btn-primary edit-btn" style="background-color: rgba(80, 90, 201, 1);">Monitor</a>
                    </td>
                    <td>@item.ContainerName</td>
                    <td>
                        @($"{item.ContainerType?.Name} (Temp {item.ContainerType?.TemperatureFromRange ?? 0}{item.ContainerType?.TemperatureUnit ?? ""} to {item.ContainerType?.TemperatureToRange ?? 0}{item.ContainerType?.TemperatureUnit ?? ""})")
                    </td>
                    <td>@item.StartDateTimeUtc.ToString("MM/dd/yyyy")</td>
                    <td>@item.StartDateTimeUtc.ToString("hh:mm tt")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center mt-4 pb-4">
        <a asp-action="Add" asp-route-eventId="@selectedEventId" class="btn btn-general" id="addContainerBtn">Add New Container</a>
    </div>

}
else if (!string.IsNullOrEmpty(selectedEventId))
{
    <p>No containers found for this event.</p>
}

<script>
        $('#searchStaffBtn').on('click', function () {
        var containerName = $('#filterContainerName').val().trim().toLowerCase();
        var containerType = $('#filterContainerType').val().trim().toLowerCase();
        var containerStartDate = $('#filterContainerStartDate').val();

        var contractsTable = $('#contractsTable').DataTable();

        // Clear previous searches
        contractsTable.columns().search('');

        // 🔹 Column indexes (adjust if order changes)
        // 0 = Actions, 1 = Container Name, 2 = Type, 3 = Start Date

        if (containerName) {
            const escapedContainerName = containerName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            contractsTable.column(1).search(escapedContainerName, true, false, true);
        }

        if (containerType) {
            const escapedContainerType = containerType.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            contractsTable.column(2).search(escapedContainerType, true, false, true);
        }

        if (containerStartDate) {
            // Convert yyyy-MM-dd to MM/dd/yyyy for matching table display
            const formattedDate = formatDateToMMDDYYYY(containerStartDate);
            contractsTable.column(3).search(formattedDate, true, false, true);
        }

        contractsTable.draw();
    });


    $('#resetFiltersBtn').on('click', function () {
        $('#filterContainerName').val('');
        $('#filterContainerType').val('');
        $('#filterContainerStartDate').val('');

        var contractsTable = $('#contractsTable').DataTable();
        contractsTable.columns().search('');
        contractsTable.search('').draw();
    });


    function formatDateToMMDDYYYY(dateString) {
        const [year, month, day] = dateString.split('-'); // Split the yyyy/mm/dd format
        return `${month}/${day}/${year}`; // Return as mm/dd/yyyy
    }

</script>