        function addStaffToSelectedTable(staffData, rowIndex = null) {
    let eventStaffData = staffData.eventStaffRolesNameAndLicense || staffData; // Handle both Add & Edit mode
    let selectedTable = $('#eventStaffSelectedTable').DataTable();

    let existingRows = selectedTable.rows().data().toArray();
    if (existingRows.some(row => row.id === eventStaffData.id)) {
        alert("Staff already added!");
        return;
    }

    if (rowIndex === null) {
        rowIndex = selectedTable.rows().count();
    }

    let roleDropdownId = `roleSelect_${eventStaffData.id}`;

    let eventStartDate = $('#EventStartDate').val();
    let eventEndDate = $('#EventEndDate').val();

    // Validate event dates
    if (!eventStartDate || !eventEndDate) {
        alert("Please fill Event Start Date and Event End Date first");
        return;
    }

    let startDate = new Date(eventStartDate);
    let endDate = new Date(eventEndDate);

    if (startDate > endDate) {
        alert("Event Start Date cannot be after Event End Date");
        return;
    }

            let selectedDates = (staffData.eventStaffDetail?.availabilityDatesList || []).map(item => {
                let dt = new Date(item.availabilityDate); // Access the availabilityDate property
                return (dt.getMonth() + 1).toString().padStart(2, '0') + '/' +
                    dt.getDate().toString().padStart(2, '0') + '/' +
                    dt.getFullYear(); // Convert to MM/DD/YYYY
            });

            // Generate checkboxes for each date in the range
            let availabilityCheckboxes = "";
            let currentDate = new Date(startDate);

            while (currentDate <= endDate) {
                let formattedDate = (currentDate.getMonth() + 1).toString().padStart(2, '0') + '/' +
                    currentDate.getDate().toString().padStart(2, '0') + '/' +
                    currentDate.getFullYear(); // Format: MM/DD/YYYY

                let isChecked = selectedDates.includes(formattedDate) ? "checked" : "";

                availabilityCheckboxes += `
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chk_${eventStaffData.id}_${formattedDate}"
                name="SingleEventManagement.EventStaffDetailList[${rowIndex}].AvailabilityDates"
                value="${formattedDate}" ${isChecked}>
            <label class="form-check-label" for="chk_${eventStaffData.id}_${formattedDate}">
                ${formattedDate}
            </label>
        </div>`;
                currentDate.setDate(currentDate.getDate() + 1);
            }


    // Handle Pre-Event Availability Checkbox for Edit Mode
    let isPreEventChecked = staffData.eventStaffDetail?.preEventAvailability ? "checked" : "";
    let preEventAvailabilityCheckbox = `
        <input type="checkbox" class="form-check-input" id="preEventChk_${eventStaffData.id}"
            name="SingleEventManagement.EventStaffDetailList[${rowIndex}].PreEventAvailability"
            value="true" ${isPreEventChecked}>
    `;

    // Filter roles based on CAC status
    let filteredRoles = rolesData.filter(role => role.category === "EventManagementRole");
    filteredRoles = filteredRoles.filter(role => {
        if (eventStaffData.staffCAC === "false" && role.name === "CAC'd Admin") {
            return false;
        }
        if (eventStaffData.staffCAC === "true" && role.name === "NonCAC'd Admin") {
            return false;
        }
        return true;
    });

    // Create role dropdown options
    let roleOptions = filteredRoles.map(role => {
        let isSelected = false;

        // Handle edit mode: Check if this role is in eventWiseStaffRoleList
        if (staffData.eventStaffDetail && staffData.eventStaffDetail.eventWiseStaffRoleList) {
            isSelected = staffData.eventStaffDetail.eventWiseStaffRoleList.some(r => r.roleId === role.id);
        }

        return `<option value="${role.id}" ${isSelected ? "selected" : ""}>${role.name}</option>`;
    }).join("");

    let roleDropdown = `
        <select id="${roleDropdownId}" name="SingleEventManagement.EventStaffDetailList[${rowIndex}].SelectedRoles"
                class="form-control role-multi-select" multiple>
            ${roleOptions}
        </select>`;

    // Add row to DataTable
    selectedTable.row.add({
        staffID: `${eventStaffData.staffID} 
                  <input type="hidden" class="eventStaffIdHidden" 
                    name="SingleEventManagement.EventStaffDetailList[${rowIndex}].EventStaffId"
                    value="${eventStaffData.id}" />`,
        staffLastName: eventStaffData.staffLastName,
        staffFirstName: eventStaffData.staffFirstName,
        roles: eventStaffData.roles,
        licenseStateAndTypes: eventStaffData.licenseStateAndTypes,
        primaryState: eventStaffData.primaryState,
        primaryCity: eventStaffData.primaryCity,
        primaryZip: eventStaffData.primaryZip,
        status: eventStaffData.status,
        id: eventStaffData.id, 
        countOfStaffEnrolledInEvent: staffEventCountCache[eventStaffData.id] || 0,
        availability: availabilityCheckboxes,  // Add checkboxes for availability
        preEventAvailability: preEventAvailabilityCheckbox, // Fix: Ensure it is checked in edit mode
        additionalroles: roleDropdown,  // Add dropdown to the roles column
        action: `<button type="button" class="btn btn-danger btn-sm remove-staff-btn"
                  data-staffid="${eventStaffData.id}">Remove</button>`
    }).draw();

    // Initialize select2 for the new dropdown
    $(`#${roleDropdownId}`).select2();
}




