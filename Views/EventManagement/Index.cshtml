            // Function to generate final table dynamically based on selected rows from eventServicesTable
        function GenerateStaffRequirementTable() {

            let finalTableHtml = '<thead><tr><th>Role</th><th>Event Service</th>';
            let dayIndex = 1;
            const checkedRows = [];

            function collectCheckedRowsFrom(tableSelector) {
                $(`${tableSelector} tbody tr`).each(function () {
                    const checkbox = $(this).find('input[type="checkbox"]');
                    if (checkbox.prop('checked')) {
                        const eventService = $(this).find("input[type='hidden'][name*='EventService']").val();
                        const totalMembers = parseInt($(this).find("input[type='number'][name*='FinalPreEventConfirmedNumbers']").val()) || 0;
                        checkedRows.push({ eventService, totalMembers });
                    }
                });
            }

            function generateStaffCountCells(ratePerHour, totalMembers, eventService) {
                let html = "";
                let dayIdx = 1;
                while ($(`#EventStartTimeDay${dayIdx}`).length) {
                    const start = $(`#EventStartTimeDay${dayIdx}`).val();
                    const end = $(`#EventEndTimeDay${dayIdx}`).val();
                    const percent = parseFloat($(`#ServiceMemberPercentPerDay${dayIdx}`).val());

                    if (!start || !end || isNaN(percent)) {
                        html += '<td>Invalid data</td>';
                        dayIdx++;
                        continue;
                    }

                    const [sh, sm] = start.split(':').map(Number);
                    const [eh, em] = end.split(':').map(Number);
                    const startDate = new Date(0, 0, 0, sh, sm, 0);
                    const endDate = new Date(0, 0, 0, eh, em, 0);

                    let availableHours = 0;
                    if (endDate > startDate) {
                        availableHours = (endDate - startDate) / (1000 * 60 * 60);
                    }

                    if (eventService === "DOEHRS Entry") {
                        html += `<td>${1}</td>`;
                    }
                    else if (eventService === "Check-In/Out")
                    {
                        html += `<td>${2}</td>`;
                    }
                    else {
                        const membersForDay = (totalMembers * percent) / 100;
                        const capacityPerMan = ratePerHour * availableHours;
                        let menRequired = capacityPerMan > 0 ? (membersForDay / capacityPerMan) : 0;

                        const fractional = menRequired % 1;
                        menRequired = fractional >= 0.5 ? Math.ceil(menRequired) : Math.floor(menRequired);

                        html += `<td>${menRequired}</td>`;
                    }
                    dayIdx++;
                }
                return html;
            }

            function renderRow(role, eventService, totalMembers, isDropdown = false) {
                const ratePerHour = ratePerHourData[eventService]?.rate;
                if (!ratePerHour) return '';

                let row = `<tr${isDropdown ? ` data-total-members="${totalMembers}"` : ''}>`;

                if (isDropdown) {
                    row += `<td><select class="form-select roleDropdown">
                            <option value="Dentist" selected>Dentist</option>
                            <option value="Dental Assistant/RDH">Dental Assistant/RDH</option>
                        </select></td>`;
                } else {
                    row += `<td>${role}</td>`;
                }

                row += `<td>${eventService}</td>`;
                row += generateStaffCountCells(ratePerHour, totalMembers, eventService);
                row += `</tr>`;
                return row;
            }

            collectCheckedRowsFrom('#eventServicesTable');
            collectCheckedRowsFrom('#eventServicesTable2');
            collectCheckedRowsFrom('#eventServicesTable3');

            while ($(`#EventStartTimeDay${dayIndex}`).length) {
                finalTableHtml += `<th>Required Staff Count Day ${dayIndex}</th>`;
                dayIndex++;
            }

            finalTableHtml += '</tr></thead><tbody>';

            let labTotalMembers = 0;  // Variable to store sum of totalMembers for LABS events
            let immunizationsTotalMembers = 0;

            checkedRows.forEach(function (row) {
                const { eventService, totalMembers } = row;
                const rateData = ratePerHourData[eventService];
                const role = rateData?.roles;
                const rate = rateData?.rate;
                const group = rateData?.group;  // Get the group if it exists

                // Check if the eventService belongs to the LABS group
                if (group === "LABS") {
                    labTotalMembers += totalMembers;  // Sum the totalMembers for LABS-related services
                } else if (group === "Immunizations") {
                    immunizationsTotalMembers += totalMembers;  // Sum the totalMembers for LABS-related services
                    } else {
                    // Process non-LABS events as usual
                    if (eventService === "Dental Treatment") {
                        finalTableHtml += renderRow(role, eventService, totalMembers, true);
                    } else {
                        finalTableHtml += renderRow(role, eventService, totalMembers);
                    }

                    if (eventService === "Dental Exam" || eventService === "Dental Treatment") {
                        finalTableHtml += renderRow("Dental Assistant/RDH", eventService, totalMembers);
                    }

                    if (eventService === "Periodic Health Assessment") {
                        const rrEventService = "Record Review (Periodic Health Assessment)";
                        const rrRole = ratePerHourData[rrEventService]?.roles;
                        const rrRate = ratePerHourData[rrEventService]?.rate;

                        if (rrRole && rrRate) {
                            finalTableHtml += renderRow(rrRole, rrEventService, totalMembers);
                        }
                    }
                }
            });

            if (labTotalMembers > 0) {
                finalTableHtml += renderRow("Phlebotomist/Medical Assistant/LVN", "LABS", labTotalMembers);
            }

            if (immunizationsTotalMembers > 0) {
                finalTableHtml += renderRow("RN/LVN/MA", "Immunizations", immunizationsTotalMembers);
            }
            const doerhsEvent = "DOEHRS Entry";
            const doerhsRole = ratePerHourData[doerhsEvent]?.roles;
            const doerhsRate = ratePerHourData[doerhsEvent]?.rate;
            if (doerhsRole && doerhsRate) {
                finalTableHtml += renderRow(doerhsRole, doerhsEvent, 1);
            }

            const checkInOutEvent = "Check-In/Out";
            const checkInOutRole = ratePerHourData[checkInOutEvent]?.roles;
            const checkInOutRate = ratePerHourData[checkInOutEvent]?.rate;
            if (checkInOutRole && checkInOutRate) {
                finalTableHtml += renderRow(checkInOutRole, checkInOutEvent, 1);
            }


            finalTableHtml += '</tbody>';
            $('#StaffRequirementTable').html(finalTableHtml);

