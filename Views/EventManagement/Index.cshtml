        function validateTableRequiredFields() {
            var isValidForm = true;

            // Loop through each table (eventServicesTable, eventServicesTable2, eventServicesTable3)
            var tableIds = ["eventServicesTable", "eventServicesTable2", "eventServicesTable3"];
            tableIds.forEach(function (tableId) {
                $("#" + tableId + " tbody tr").each(function () {
                    var row = $(this);

                    // Check for required td input fields
                    row.find("td input[required]").each(function () {
                        if ($(this).val() === "") {
                            isValidForm = false;
                            // Trigger browser validation (focus on empty required field)
                            $(this)[0].setCustomValidity('This field is required.');
                            $(this).focus();
                            return false; // Break out of the each loop for this row
                        } else {
                            // Clear custom validity if input is not empty
                            $(this)[0].setCustomValidity('');
                        }
                    });

                    if (!isValidForm) {
                        return false; // Break out of the each loop for all rows
                    }
                });
            });

            return isValidForm;
        }


        function getCompletedSections() {
            const completedSections = [];

            // Loop through each section and validate required fields
            $(".form-section").each(function () {
                const sectionId = $(this).attr("id"); // e.g., "section1"
                let isSectionValid = true;

                // Special handling for Section 6
                if (sectionId === "section6") {
                    const requiredFieldsInSection6 = $(this).find("[required]");

                    // If no required fields in Section 6, don't consider it completed
                    if (requiredFieldsInSection6.length === 0) {
                        isSectionValid = false;
                    } else {
                        // Check if any required field is empty
                        requiredFieldsInSection6.each(function () {
                            if (!$(this).val().trim()) {
                                isSectionValid = false;
                                return false; // Break out of the loop
                            }
                        });
                    }
                } else if (sectionId === "section7") {
                    // Check if eventStaffSelectedTable has at least one row
                    let table = $("#eventStaffSelectedTable").DataTable();
                    if (table.rows().count() === 0) {
                        isSectionValid = false;
                    }
                }
                else {
                    // For other sections, validate as usual
                    $(this)
                        .find("[required]")
                        .each(function () {
                            if (!$(this).val().trim()) {
                                isSectionValid = false; // Mark invalid if a required field is empty
                                return false; // Break out of the loop
                            }
                        });
                }

                // If the section is valid, add it to the completed sections list
                if (isSectionValid) {
                    const numericId = sectionId.replace(/\D/g, ""); // Extract numeric part (e.g., "section1" -> "1")
                    completedSections.push(numericId);
                }
            });

            return completedSections;
        }



        function validateSectionFields(sectionId) {
            const sectionFields = $(`#section${sectionId}`).find("input, select, textarea");

            let anyFieldFilled = false;
            let isValid = true;

            sectionFields.each(function () {
                const fieldValue = $(this).val();

                if (
                    fieldValue !== "SingleEventManagement.EventStartDate" &&
                    fieldValue !== "SingleEventManagement.EventEndDate" &&
                    fieldValue !== "SingleEventManagement.EventStartTimeDay" &&
                    fieldValue !== "SingleEventManagement.EventEndTimeDay" &&
                    fieldValue !== "Deploying" &&
                    fieldValue !== "Non-Deploying" &&
                    fieldValue !== "SingleEventManagement.TotalRequestedServiceMembers" &&
                    fieldValue !== "SingleEventManagement.MOBDate" &&
                    fieldValue !== "SingleEventManagement.ShippingPocOpenAt" &&
                    fieldValue !== "SingleEventManagement.ShippingPocCloseAt" &&
                    fieldValue !== "SingleEventManagement.ShippingPocPickupDate" &&
                    fieldValue !== "SingleEventManagement.ShippingPocPickupTime" &&
                    fieldValue !== "SingleEventManagement.ShippingPocDeliveryFromDate" &&
                    fieldValue !== "SingleEventManagement.ShippingPocDeliveryToDate" &&
                    fieldValue !== "SingleEventManagement.ShippingPocEventSetupDate" &&
                    fieldValue !== "SingleEventManagement.ShippingPocEventSetupTime"
                ) {
                    if (!$(this).is(':checkbox') && !$(this).is(':radio') && fieldValue !== null && fieldValue !== undefined && fieldValue.trim() !== "") {
                        anyFieldFilled = true;
                    }
                }
            });

            if (anyFieldFilled) {
                // sectionFields.each(function () {
                //     if (!this.checkValidity()) {
                //         this.reportValidity();
                //         isValid = false;
                //     }
                // });

                sectionFields.each(function () {
                    if ($(this).prop("required") && !$(this).val()) {
                        this.setCustomValidity("This field is required.");
                        this.reportValidity();
                        this.focus(); // 👈 Force focus to show the message
                        isValid = false;
                        return false; // 👈 Exit .each early to avoid jumping messages
                    } else {
                        this.setCustomValidity("");
                    }
                });


            }

            return isValid;
        }

        function validateSection1() {
            const section = document.getElementById("section1");
            const requiredControls = section.querySelectorAll("[required]");
            let isValid = true;

            requiredControls.forEach(control => {
                const controlValue = control.value.trim();

                if (!controlValue) {
                    isValid = false;
                    control.classList.add("is-invalid");
                } else {
                    control.classList.remove("is-invalid");
                }
            });

            return isValid;
        }



