        function updateTableRows(tableId, data) {
            const table = document.getElementById(tableId);
            const rows = table.querySelectorAll('tbody tr');

            rows.forEach(row => {
                const eventService = row.getAttribute('data-event-service');
                const matchingData = data.find(item => item.eventService === eventService);

                if (matchingData) {
                    const checkbox = row.querySelector('input[type="checkbox"]');
                    const clientRequestInput = row.querySelector('td:nth-of-type(2) input[type="number"]');
                    const initialReportInput = row.querySelector('td:nth-of-type(3) input[type="number"]');
                    const finalPreEventInput = row.querySelector('td:nth-of-type(4) input[type="number"]');
                    const eventServiceHidden = row.querySelector('input[type="hidden"][name$=".EventService"]');
                    const typeHidden = row.querySelector('input[type="hidden"][name$=".Type"]');

                    if (checkbox) {
                        checkbox.checked = matchingData.isSelected || false;

                        // Enable/disable fields based on checkbox state
                        const isEnabled = checkbox.checked;

                        if (clientRequestInput) {
                            clientRequestInput.value = matchingData.clientRequestInitial || '';
                            clientRequestInput.disabled = !isEnabled;
                            clientRequestInput.required = isEnabled;
                        }
                        if (initialReportInput) {
                            initialReportInput.value = matchingData.initialReportNumbers || '';
                            initialReportInput.disabled = !isEnabled;
                            initialReportInput.required = isEnabled;
                        }
                        if (finalPreEventInput) {
                            finalPreEventInput.value = matchingData.finalPreEventConfirmedNumbers || '';
                            finalPreEventInput.disabled = !isEnabled;
                            finalPreEventInput.required = isEnabled;
                        }
                        if (eventServiceHidden) {
                            eventServiceHidden.value = matchingData.eventService || '';
                        }
                        if (typeHidden) {
                            typeHidden.value = matchingData.type || '';
                        }
                    }
                }
            });
        }



    });

    function setProgressFromServer(completedSections) {
        if (typeof completedSections === "string") {
            try {
                completedSections = JSON.parse(completedSections); // Convert JSON string to array
            } catch (e) {
                console.error("Invalid JSON format:", completedSections);
                return;
            }
        }

        if (!Array.isArray(completedSections)) {
            console.error("Expected an array but got:", completedSections);
            return;
        }

        $("#progressBar span").removeClass("completed"); // Reset all first
        completedSections.forEach(sectionNumber => {
            $(`#progress${sectionNumber}`).addClass("completed");
        });
    }

    function generateControlsForDateRange(startDate, endDate, existingData = []) {
        var date1 = new Date(startDate);
        var date2 = new Date(endDate);
        var dayCount = Math.floor((date2 - date1) / (1000 * 3600 * 24)) + 1;

        if (dayCount > 14) {
            alert("Maximum 14 days are allowed");
            $('#EventStartDate').val('');
            $('#EventEndDate').val('');
            $('#dynamicControlsContainer').empty();
            return;
        }

        $('#dynamicControlsContainer').empty();
        for (var i = 0; i < dayCount; i++) {
            var currentDate = new Date(date1);
            currentDate.setDate(currentDate.getDate() + i);

            var dayLabel = "Day " + (i + 1);
            var startTimeId = "EventStartTimeDay" + (i + 1);
            var endTimeId = "EventEndTimeDay" + (i + 1);
            var percentId = "ServiceMemberPercentPerDay" + (i + 1);

            // Fetch existing data for this day (if available)
            var existingEntry = existingData.find(e => e.eventDay === (i + 1)) || {};
            var eventStartTime = existingEntry.eventStartTime || "";
            var eventEndTime = existingEntry.eventEndTime || "";
            var serviceMemberPercent = existingEntry.serviceMemberPercentPerDay || "";

            var controlHtml = `
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="${startTimeId}" class="form-label">${dayLabel} Start Time</label>
                                <input type="text" class="form-control" id="${startTimeId}" name="SingleEventManagement.EventStartEndTimeDayWiseList[${i}].EventStartTime" value="${eventStartTime}" required/>
                            </div>
                            <div class="col-md-4">
                                <label for="${endTimeId}" class="form-label">${dayLabel} End Time</label>
                                    <input type="text" class="form-control" id="${endTimeId}" name="SingleEventManagement.EventStartEndTimeDayWiseList[${i}].EventEndTime" value="${eventEndTime}" required/>
                            </div>
                            <div class="col-md-4">
                                <label for="${percentId}" class="form-label">${dayLabel} Service Member %</label>
                                    <input type="number" class="form-control" id="${percentId}" name="SingleEventManagement.EventStartEndTimeDayWiseList[${i}].ServiceMemberPercentPerDay" placeholder="Enter % per day" value="${serviceMemberPercent}" oninput="if(this.value.length > 3) this.value = this.value.slice(0, 3);" required/>
                            </div>
                            <input type="hidden" name="SingleEventManagement.EventStartEndTimeDayWiseList[${i}].EventDay" value="${i + 1}" />
                        </div>
                    `;

            $('#dynamicControlsContainer').append(controlHtml);

            flatpickr(`#${startTimeId}`, {
                enableTime: true,
                noCalendar: true,
                time_24hr: true,
                dateFormat: "H:i",
                defaultDate: eventStartTime
            });

            flatpickr(`#${endTimeId}`, {
                enableTime: true,
                noCalendar: true,
                time_24hr: true,
                dateFormat: "H:i",
                defaultDate: eventEndTime
            });
        }
    }

