<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        h2 {
            color: rgba(80, 90, 201, 1);
        }

        h3 {
            color: rgba(80, 90, 201, 1);
        }

        body {
            background-color: #f8f9fa;
        }

        #contractsTable {
            border: 1px solid #ddd;
            border-collapse: collapse;
            width: 100%;
        }

            #contractsTable th, #contractsTable td {
                border: 1px solid #ddd;
                padding: 8px;
                text-align: left;
            }

            #contractsTable th {
                background-color: #f4f4f4;
            }

            #contractsTable tbody tr {
                background-color: rgba(240, 245, 255, 1); /* Very lighter version */
            }

                #contractsTable tbody tr:hover {
                    background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
                }

            #contractsTable td, #contractsTable th {
                text-align: center; /* Aligns the text in the middle of the cell */
            }

                #contractsTable td button, #contractsTable td a {
                    display: inline-block; /* Makes the buttons appear side by side */
                    margin-right: 5px; /* Optional: Adds space between the buttons */
                }

                #contractsTable td .button-container {
                    display: flex;
                    justify-content: center; /* Aligns buttons horizontally in the center */
                }

                    #contractsTable td .button-container a {
                        margin-right: 5px; /* Optional: Adds space between the buttons */
                    }

            #contractsTable thead th {
                background-color: rgba(120, 130, 221, 1); /* Header background color */
                color: white; /* Header text color */
                text-align: center; /* Optional: Center-align header text */
            }


        /* Common Styles for All Tables */
        #eventServicesTable, #eventServicesTable2, #eventServicesTable3, #eventStaffSelectionTable, #eventStaffSelectedTable {
            border: 1px solid #ddd;
            border-collapse: collapse;
            width: 100% !important;
            table-layout: auto;
        }

        #StaffRequirementTable {
            border: 1px solid #ddd;
            border-collapse: collapse;
            table-layout: auto; /* Ensures the table columns resize based on content */
        }

            #eventServicesTable th, #eventServicesTable td,
            #eventServicesTable2 th, #eventServicesTable2 td,
            #eventServicesTable3 th, #eventServicesTable3 td,
            #eventStaffSelectionTable th, #eventStaffSelectionTable td,
            #eventStaffSelectedTable th, #eventStaffSelectedTable td,
            #StaffRequirementTable th, #StaffRequirementTable td {
                border: 1px solid #ddd;
                padding: 8px;
            }

            #eventServicesTable th, #eventServicesTable2 th, #eventServicesTable3 th, #eventStaffSelectionTable th, #eventStaffSelectedTable th, #StaffRequirementTable th {
                background-color: #f4f4f4;
                text-align: center; /* Keep headers centered */
            }

            #eventServicesTable tbody tr, #eventServicesTable2 tbody tr, #eventServicesTable3 tbody tr, #eventStaffSelectionTable tbody tr, #eventStaffSelectedTable tbody tr, #StaffRequirementTable tbody tr {
                background-color: rgba(240, 245, 255, 1); /* Very lighter version */
            }

                #eventServicesTable tbody tr:hover, #eventServicesTable2 tbody tr:hover, #eventServicesTable3 tbody tr:hover, #eventStaffSelectionTable tbody tr:hover, #eventStaffSelectedTable tbody tr:hover, #StaffRequirementTable tbody tr:hover {
                    background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
                }

            #eventServicesTable td, #eventServicesTable2 td, #eventServicesTable3 td, #eventStaffSelectionTable td, #eventStaffSelectedTable td, #StaffRequirementTable td {
                text-align: center; /* Center align all columns by default */
            }

                #eventServicesTable td:first-child, #eventServicesTable2 td:first-child, #eventServicesTable3 td:first-child, #StaffRequirementTable td:first-child {
                    text-align: left; /* Left align the first column */
                    padding-left: 12px; /* Optional: Add some left padding for better spacing */
                }

                #eventServicesTable td button, #eventServicesTable2 td button, #eventServicesTable3 td button, #eventStaffSelectionTable td button, #eventStaffSelectedTable td button, #StaffRequirementTable td button
                #eventServicesTable td a, #eventServicesTable2 td a, #eventServicesTable3 td a, #eventStaffSelectionTable td a, #StaffRequirementTable td a {
                    display: inline-block;
                    margin-right: 5px;
                }

                #eventServicesTable td .button-container, #eventServicesTable2 td .button-container, #eventServicesTable3 td .button-container, #eventStaffSelectionTable td .button-container, #eventStaffSelectedTable td .button-container, #StaffRequirementTable td .button-container {
                    display: flex;
                    justify-content: center;
                }

                    #eventServicesTable td .button-container a, #eventServicesTable2 td .button-container a, #eventServicesTable3 td .button-container a, #eventStaffSelectionTable td .button-container a, #eventStaffSelectedTable td .button-container a, #StaffRequirementTable td .button-container a {
                        margin-right: 5px;
                    }

            #eventServicesTable thead th, #eventServicesTable2 thead th, #eventServicesTable3 thead th, #eventStaffSelectionTable thead th, #eventStaffSelectedTable thead th, #StaffRequirementTable thead th {
                background-color: rgba(120, 130, 221, 1);
                color: white;
                text-align: center;
            }

        .plus-icon {
            width: 20px; /* Image width */
            height: 20px; /* Image height */
            cursor: pointer; /* Show pointer on hover */
        }

            .plus-icon:hover {
                transform: scale(1.1); /* Slight enlarge on hover */
                transition: 0.2s ease-in-out; /* Smooth animation */
            }

        .add-row-button {
            background-color: transparent; /* No background */
            border: none; /* Remove border */
            padding: 0; /* Remove button padding */
            cursor: pointer; /* Pointer cursor on hover */
            display: inline-block;
        }

            .add-row-button img {
                outline: none;
            }

            .add-row-button:focus,
            .add-row-button:active {
                outline: none;
                border: none;
                box-shadow: none;
            }

        /*     #eventStaffSelectedTable th:nth-child(10) {
    display: none;
} */

           




        .read-only-style {
            background-color: #f8f9fa; /* Light gray background */
            pointer-events: none; /* Disable click and focus */
            border-color: #ced4da; /* Light border color */
        }

        .card-title {
            margin-bottom: 1rem;
        }

        /*  .btn-primary {
                min-width: 150px;
            } */

        #progressBar {
            width: 100%;
            height: 50px;
            background-color: lightgray;
            display: flex;
            border-radius: 5px;
            padding: 2px;
            margin-top: 20px;
        }

            #progressBar span {
                flex-grow: 1; /* Ensure each tab takes equal space */
                padding: 10px;
                text-align: center;
                background-color: lightgray;
                color: black;
                font-weight: bold;
                border-radius: 5px;
                transition: background-color 0.3s, color 0.3s;
                margin: 0; /* Remove the margin to eliminate space between the tabs */
            }

                #progressBar span.completed {
                    background-color: green;
                    color: white;
                }

            #progressBar .active {
                border: 4px solid #007bff; /* Blue border around the step */
                border-radius: 5px; /* Optional: Rounded corners */
                color: black;
                background: none;
                padding: 10px; /* Ensure spacing looks good */
            }

            #progressBar span:hover {
                border-bottom: 3px solid #007bff; /* Blue bottom border on hover */
                cursor: pointer; /* Show pointer cursor */
                color: #007bff; /* Change text color on hover */
                transition: 0.3s ease-in-out; /* Smooth transition effect */
            }



        .select2 {
            width: 100%;
            font-size: 14px;
            padding: 8px 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            background-color: #fff;
            color: #333;
            transition: border-color 0.3s, box-shadow 0.3s;
        }
            /*
                /* Focused state */
            .select2:focus {
                border-color: #0056b3;
                box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
            }

        /* Dropdown arrow customization */


        /* Adjust the dropdown width */
        .select2 {
            width: 100% !important; /* Ensures full-width dropdown */
        }

            /* Hover state for options */
            .select2 option:hover {
                background-color: #e6f7ff;
            }

            /* Focus state for options */
            .select2 option:focus {
                background-color: #cce5ff;
            }

            /* Disabled state */
            .select2 option:disabled {
                color: #aaa;
                background-color: #f5f5f5;
            }

        */
    </style>
</head>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

            Swal.fire({
                icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor, // Conditional button color
                iconColor: iconColor // Conditional icon color
            });
        });
    </script>
}

<h2 class="text-center mb-4">@ViewData["Title"]</h2>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div class="alert alert-danger">
            <strong>Validation failed!</strong>
            <ul>
                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@modelError.ErrorMessage</li>
                }
            </ul>
        </div>
    }


    <div style="display: flex; justify-content: center; align-items: center;">
        <button class="btn btn-primary" id="addContractBtn"
                style="background-color: rgba(80, 90, 201, 1); border-color: rgba(80, 90, 201, 1);">
            Add New Event
        </button>
    </div>
    <div id="datatableWrapper" class="datatable-wrapper">
        <table id="contractsTable" class="display">
            <thead>
                <tr>
                    <th>Event ID</th>
                    <th>Sub Event Id</th>
                    <th>Taskforce</th>
                    <th>Event Status</th>
                    <th>State</th>
                    <th>City</th>
                    <th>ZipCode</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.EventManagements != null && Model.EventManagements.Any())
                {
                    @foreach (var contract in Model.EventManagements)
                    {
                        <tr data-id="@contract.Id">
                            <td>@contract.EventID</td>
                            <td>@contract.SubEventID</td>
                            <td>@contract.TaskForce</td>
                            <td>@contract.EventStatus</td>
                            <td>@contract.EventState</td>
                            <td>@contract.EventCity</td>
                            <td>@contract.EventZipCode</td>
                            <td>@contract.EventStartDate.ToString("yyyy-MM-dd")</td>
                            <td>@contract.EventEndDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="button-container">
                                    <a href="javascript:void(0);" class="btn btn-primary" data-id="@contract.Id" style="background-color: @(contract.StatusDescription == "Pending" ? "#f5db8e" : (contract.StatusDescription == "Completed" ? "green" : ""))">@contract.StatusDescription</a>
                                    <a href="javascript:void(0);" class="btn btn-primary edit-btn" data-id="@contract.Id" style="background-color: rgba(80, 90, 201, 1);">Edit</a>
                                    <a href="javascript:void(0);" class="btn btn-secondary view-btn" data-id="@contract.Id">View</a>
                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-body" style="display: none;">

        <form id="eventManagementForm" asp-action="CreateEventManagement" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SingleEventManagement.Id" id="hiddenId" />
            <div class="col-md-6 d-flex align-items-center">
                <label class="form-label me-2 fw-bold" style="font-size: 1.2rem;">Event ID : </label>
                <label asp-for="SingleEventManagement.EventID" id="EventID" class="form-label" style="font-size: 1.2rem;" readonly required></label>
                <input asp-for="SingleEventManagement.EventID" id="EventIDHidden" type="hidden" />
            </div>


            <!-- Progress Bar -->
            <div id="progressBar">
                <span id="progress1" data-target="1">Event Specific Details</span>
                <span id="progress2" data-target="2">Event POC</span>
                <span id="progress3" data-target="3">Shipping</span>
                <span id="progress4" data-target="4">Additional Information</span>
                <span id="progress5" data-target="5">Immunization and Lab Info</span>
                <span id="progress6" data-target="6">Event Service Detail</span>
                <span id="progress7" data-target="7">Event Staff Detail</span>
            </div>

            <!-- Section 1 -->
            <div id="section1" class="form-section section">
                <h3 class="mt-5 mb-3">Event Specific Details</h3>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.SubEventID" class="form-label">Sub Event ID Number</label>
                        <input asp-for="SingleEventManagement.SubEventID" id="SubEventID" class="form-control" maxLength="5" placeholder="Enter Sub Event ID" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.ContractId" class="form-label">Contract Name</label>
                        <select id="ContractId" class="form-select select2" asp-for="SingleEventManagement.ContractId" required>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.EventStatus" class="form-label">Event Status</label>
                        <select asp-for="SingleEventManagement.EventStatus" id="EventStatus" class="form-control" required>
                            <option value="">Select Event Status</option>
                            <option value="Initial Pre-event">Initial Pre-event</option>
                            <option value="Pre-Event Confirmed">Pre-Event Confirmed</option>
                            <option value="Pre-Event Complete">Pre-Event Complete</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Post event Incomplete">Post event Incomplete</option>
                            <option value="Complete">Complete</option>
                            <option value="Canceled">Canceled</option>
                        </select>
                    </div>
                </div>

                <div id="contractDetails" style="display: none;">
                    <p><strong>Contract Id:</strong> <span id="contractIdLabel"></span></p>
                    <p><strong>Contract Agency:</strong> <span id="contractAgencyLabel"></span></p>
                    <p><strong>Dawson Service Branch:</strong> <span id="contractServiceBranchLabel"></span></p>
                    <p><strong>Contract Component:</strong> <span id="contractComponentLabel"></span></p>
                    <p><strong>Contract Type:</strong> <span id="contractTypeLabel"></span></p>
                    <p><strong>Contract Start:</strong> <span id="contractStartDateLabel"></span></p>
                    <p><strong>Contract End:</strong> <span id="contractEndDateLabel"></span></p>
                    <p><strong>Dawson Project Manager:</strong> <span id="dawsonProjectManagerLabel"></span></p>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.EventAddress1" class="form-label">Event Address 1</label>
                        <input asp-for="SingleEventManagement.EventAddress1" id="EventAddress1" class="form-control" maxLength="200" placeholder="Enter Address Line 1" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.EventAddress2" class="form-label">Event Address 2</label>
                        <input asp-for="SingleEventManagement.EventAddress2" id="EventAddress2" class="form-control" maxLength="200" placeholder="Enter Address Line 2" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.EventState" class="form-label">Event State</label>
                        <select asp-for="SingleEventManagement.EventState" id="EventState" class="form-select" required>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.EventCity" class="form-label">Event City</label>
                        <select asp-for="SingleEventManagement.EventCity" id="EventCity" class="form-select city-dropdown" required>
                            <option value="">Select City</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.EventZipCode" class="form-label">Event Zip Code</label>
                        <select asp-for="SingleEventManagement.EventZipCode" id="EventZipCode" class="form-select" required>
                            <option value="">Select Zip Code</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.TotalRequestedServiceMembers" class="form-label">Total Requested Service Members</label>
                        <input asp-for="SingleEventManagement.TotalRequestedServiceMembers" id="TotalRequestedServiceMembers" class="form-control" maxLength="4" placeholder="Enter Total Requested Service Members" type="number" oninput="if(this.value.length > 4) this.value = this.value.slice(0, 4);" required />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.EventStartDate" class="form-label">Event Start Date</label>
                        <input type="date" class="form-control" id="EventStartDate" asp-for="SingleEventManagement.EventStartDate" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.EventEndDate" class="form-label">Event End Date</label>
                        <input asp-for="SingleEventManagement.EventEndDate" id="EventEndDate" type="date" class="form-control" required />
                    </div>

                </div>

                <div id="dynamicControlsContainer"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Please select</label>
                        <div>
                            <input asp-for="SingleEventManagement.Deploy" id="Deploying" type="radio" value="Deploying" required />
                            <label for="Deploying">Deploying</label>
                            <input asp-for="SingleEventManagement.Deploy" id="NonDeploying" type="radio" value="Non-Deploying" required />
                            <label for="NonDeploying">Non-Deploying</label>
                        </div>
                    </div>
                    <div class="col-md-6" id="MOBDateContainer" style="display: none;">
                        <label asp-for="SingleEventManagement.MOBDate" class="form-label">MOB Date</label>
                        <input asp-for="SingleEventManagement.MOBDate" id="EventMobDate" type="date" class="form-control" required />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.RegardingSites" class="form-label">Regarding Sites</label>
                        <textarea asp-for="SingleEventManagement.RegardingSites" id="RegardingSites" class="form-control" rows="4" maxLength="300" placeholder="Enter details about sites"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SingleEventManagement.EventHelpLine" class="form-label">Event Help Line</label>
                        <input id="EventHelpLine" asp-for="SingleEventManagement.EventHelpLine" class="form-control" placeholder="xxx-xxx-xxxx" inputmode="numeric" maxlength="12" required />

                    <label class="form-label">Task Force</label>
                    @* <input asp-for="SingleEventManagement.TaskForce" id="TaskForce" class="form-control" maxLength="100" placeholder="Enter Task Force" /> *@

                    <div class="form-container-Taskforce">
                        <!-- Dynamic License Rows will be inserted here -->
                    </div>

                    <button type="button" id="addTaskForceRowButton" class="add-row-button mt-2" style="background-color: rgba(80, 90, 201, 1); color: white; border: none; padding: 10px 15px; border-radius: 5px; display: flex; align-items: center; cursor: pointer;">
                        <img src="/images/PlusIcon.png" alt="Add Row" class="plus-icon" style="margin-right: 8px;" />
                        <span class="button-text">Add another taskforce</span>
                    </button>
                    </div>
                
                </div>

                <div class="row mt-4">
                    <div class="col-md-6 text-end">
                    </div>
                    <div class="col-md-6 text-start">
                        <button type="button" id="NextButton" class="btn btn-primary next" data-section="1">Next</button>
                    </div>
                </div>
            </div>

            @*  <div class="d-flex justify-content-end mt-4">
            <button type="button" id="NextButton" class="btn btn-primary next" data-section="1">Next</button>
            </div> *@

            <!-- Section 2 -->
            <div id="section2" class="form-section section" style="display: none;">
                <h3 class="mt-5 mb-3">Event Main POC</h3>
                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label for="MainPocLastName" class="form-label">Last Name</label>
                        <input id="MainPocLastName" asp-for="SingleEventManagement.MainPocLastName" class="form-control" maxLength="50" placeholder="Enter Last Name" required />
                    </div>
                    <div class="col-sm-6">
                        <label for="MainPocFirstName" class="form-label">First Name</label>
                        <input id="MainPocFirstName" asp-for="SingleEventManagement.MainPocFirstName" class="form-control" maxLength="50" placeholder="Enter First Name" required />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label for="MainPocRank" class="form-label">Rank</label>
                        <input id="MainPocRank" asp-for="SingleEventManagement.MainPocRank" class="form-control" maxLength="50" placeholder="Enter Rank" required />
                    </div>
                    <div class="col-sm-6">
                        <label for="MainPocPhonePrimary" class="form-label">Phone Number (Primary)</label>
                        <input id="MainPocPhonePrimary" asp-for="SingleEventManagement.MainPocPhonePrimary" class="form-control" maxLength="12" placeholder="xxx-xxx-xxxx" inputmode="numeric" required />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label for="MainPocPhoneSecondary" class="form-label">Phone Number (Secondary)</label>
                        <input id="MainPocPhoneSecondary" asp-for="SingleEventManagement.MainPocPhoneSecondary" class="form-control" maxLength="12" placeholder="xxx-xxx-xxxx" inputmode="numeric" />
                    </div>
