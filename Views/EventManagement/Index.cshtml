$(document).ready(function () {
    let currentSection = 1;

        $(".next").click(function () {
            const section = $(this).data("section");
            $("#submitBtn").data("section", section + 1);

            const isValid = validateSectionFields(section);

            if (!isValid) {
                return;
            }

            $(`#section${section}`).hide();
            $(`#section${section + 1}`).show();

            currentSection++;
        });


        $(".back").click(function () {
            const section = $(this).data("section");
            $("#submitBtn").data("section", section - 1);

            const isValid = validateSectionFields(section);

            if (!isValid) {
                return;
            }

            $(`#section${section}`).hide();
            $(`#section${section - 1}`).show();
            currentSection--;
        });

