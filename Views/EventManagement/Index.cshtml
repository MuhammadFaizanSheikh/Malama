@model ExcelFilesCompiler.Models.EventManagementViewModel

@{
    ViewData["Title"] = "Multi-Step Form";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    // Fixed categories
    var categories = new[]
    {
        "Event Specific Details",
        "Event Main POC",
        "Event Secondary POC",
        "Shipping Address",
        "Shipping POC",
        "Preferred Pharmacy if SM needs prescription",
        "POC for military contact (HIV Supply)"
    };
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.11/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- DataTables CSS for Bootstrap 5 -->
<link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <style>
        h2 {
            color: rgba(80, 90, 201, 1);
        }

        h3 {
            color: rgba(80, 90, 201, 1);
        }

        body {
            background-color: #f8f9fa;
        }

        #contractsTable {
            border: 1px solid #ddd;
            border-collapse: collapse;
            width: 100%;
        }

            #contractsTable th, #contractsTable td {
                border: 1px solid #ddd;
                padding: 8px;
                text-align: left;
            }

            #contractsTable th {
                background-color: #f4f4f4;
            }

            #contractsTable tbody tr {
                background-color: rgba(240, 245, 255, 1); /* Very lighter version */
            }

                #contractsTable tbody tr:hover {
                    background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
                }

            #contractsTable td, #contractsTable th {
                text-align: center; /* Aligns the text in the middle of the cell */
            }

                #contractsTable td button, #contractsTable td a {
                    display: inline-block; /* Makes the buttons appear side by side */
                    margin-right: 5px; /* Optional: Adds space between the buttons */
                }

                #contractsTable td .button-container {
                    display: flex;
                    justify-content: center; /* Aligns buttons horizontally in the center */
                }

                    #contractsTable td .button-container a {
                        margin-right: 5px; /* Optional: Adds space between the buttons */
                    }

            #contractsTable thead th {
                background-color: rgba(120, 130, 221, 1); /* Header background color */
                color: white; /* Header text color */
                text-align: center; /* Optional: Center-align header text */
            }

        .read-only-style {
            background-color: #f8f9fa; /* Light gray background */
            pointer-events: none; /* Disable click and focus */
            border-color: #ced4da; /* Light border color */
        }

        .card-title {
        margin-bottom: 1rem;
    }

    .btn-primary {
        min-width: 150px;
    }

        #progressBar {
            width: 100%;
            height: 40px;
            background-color: lightgray;
            display: flex;
            border-radius: 5px;
            padding: 2px;
            margin-top: 20px;
        }

            #progressBar span {
                flex-grow: 1; /* Ensure each tab takes equal space */
                padding: 10px;
                text-align: center;
                background-color: lightgray;
                color: black;
                /* font-weight: bold; */
                border-radius: 5px;
                transition: background-color 0.3s, color 0.3s;
                margin: 0; /* Remove the margin to eliminate space between the tabs */
            }

                #progressBar span.completed {
                    background-color: green;
                    color: white;
                }




    </style>
</head>

<h2 class="text-center mb-4">Multi-Step Form</h2>

<form id="eventManagementForm" asp-action="CreateEventManagement" method="post">
    @Html.AntiForgeryToken()
    <!-- Progress Bar -->
    <div id="progressBar">
        <span id="progress1">Event Specific Details</span>
        <span id="progress2">Event Main POC</span>
        <span id="progress3">Event Secondary POC</span>
        <span id="progress4">Test 4</span>
        <span id="progress5">Test 5</span>
        <span id="progress6">Test 6</span>
    </div>

    <!-- Section 1 -->
    <div id="section1" class="form-section">
        <h3 class="mt-5 mb-3">Event Specific Details</h3>
        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventID" class="form-label">Event ID</label>
                                <input asp-for="SingleEventManagement.EventID" class="form-control" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.SubEventID" class="form-label">Sub Event ID Number</label>
                                <input asp-for="SingleEventManagement.SubEventID" class="form-control" placeholder="Enter Sub Event ID" required />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.TaskForce" class="form-label">Task Force</label>
                                <input asp-for="SingleEventManagement.TaskForce" class="form-control" placeholder="Enter Task Force" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventStatus" class="form-label">Event Status</label>
                                <input asp-for="SingleEventManagement.EventStatus" class="form-control" placeholder="Enter Event Status" required />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventAddress1" class="form-label">Event Address 1</label>
                                <input asp-for="SingleEventManagement.EventAddress1" class="form-control" placeholder="Enter Address Line 1" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventAddress2" class="form-label">Event Address 2</label>
                                <input asp-for="SingleEventManagement.EventAddress2" class="form-control" placeholder="Enter Address Line 2" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventState" class="form-label">Event State</label>
                                <select asp-for="SingleEventManagement.EventState" class="form-select" required>
                                    <option value="">Select State</option>
                                    <option value="State1">State 1</option>
                                    <option value="State2">State 2</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventCity" class="form-label">Event City</label>
                                <select asp-for="SingleEventManagement.EventCity" class="form-select" required>
                                    <option value="">Select City</option>
                                    <option value="City1">City 1</option>
                                    <option value="City2">City 2</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventZipCode" class="form-label">Event Zip Code</label>
                                <select asp-for="SingleEventManagement.EventZipCode" class="form-select" required>
                                    <option value="">Select Zip Code</option>
                                    <option value="12345">12345</option>
                                    <option value="67890">67890</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventStartDate" class="form-label">Event Start Date</label>
                <input type="date" class="form-control" value="" id="EventStartDate" asp-for="SingleEventManagement.EventStartDate" value="" required />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventEndDate" class="form-label">Event End Date</label>
                                <input asp-for="SingleEventManagement.EventEndDate" type="date" class="form-control"  required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventStartTimeDay1" class="form-label">Event Start Time Day 1</label>
                                <input asp-for="SingleEventManagement.EventStartTimeDay1" type="time" class="form-control"   required />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="SingleEventManagement.EventEndTimeDay1" class="form-label">Event End Time Day 1</label>
                                <input asp-for="SingleEventManagement.EventEndTimeDay1" type="time" class="form-control"  required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Deploy</label>
                                <div>
                                    <input asp-for="SingleEventManagement.Deploy" type="radio" value="Deploying" id="deployingOption" required/>
                                    <label for="deployingOption">Deploying</label>
                                    <input asp-for="SingleEventManagement.Deploy" type="radio" value="Non-Deploying" id="nonDeployingOption" required/>
                                    <label for="nonDeployingOption">Non-Deploying</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="SingleEventManagement.RegardingSites" class="form-label">Regarding Sites</label>
                                <textarea asp-for="SingleEventManagement.RegardingSites" class="form-control" rows="4" placeholder="Enter details about sites" required></textarea>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                        <button type="button" class="btn btn-primary next" data-section="1">Next</button>
                        </div>
    </div>

    <!-- Section 2 -->
    <div id="section2" class="form-section" style="display: none;">
        <h3 class="mt-5 mb-3">Event Main POC</h3>
        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="MainPocLastName" class="form-label">Last Name</label>
                                <input id="MainPocLastName" asp-for="SingleEventManagement.MainPocLastName" class="form-control" placeholder="Enter Last Name" required />
                            </div>
                            <div class="col-sm-6">
                                <label for="MainPocFirstName" class="form-label">First Name</label>
                                <input id="MainPocFirstName" asp-for="SingleEventManagement.MainPocFirstName" class="form-control" placeholder="Enter First Name" required />
                            </div>
                        </div>
            
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="MainPocRank" class="form-label">Rank</label>
                                <input id="MainPocRank" asp-for="SingleEventManagement.MainPocRank" class="form-control" placeholder="Enter Rank" required />
                            </div>
                            <div class="col-sm-6">
                                <label for="MainPocPhonePrimary" class="form-label">Phone Number (Primary)</label>
                                <input id="MainPocPhonePrimary" asp-for="SingleEventManagement.MainPocPhonePrimary" class="form-control" placeholder="Enter Primary Phone Number" required />
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="MainPocPhoneSecondary" class="form-label">Phone Number (Secondary)</label>
                                <input id="MainPocPhoneSecondary" asp-for="SingleEventManagement.MainPocPhoneSecondary" class="form-control" placeholder="Enter Secondary Phone Number" />
                            </div>
                            <div class="col-sm-6">
                                <label for="MainPocEmailPrimary" class="form-label">Email (Primary)</label>
                                <input id="MainPocEmailPrimary" asp-for="SingleEventManagement.MainPocEmailPrimary" class="form-control" placeholder="Enter Primary Email" type="email" required />
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="MainPocEmailSecondary" class="form-label">Email (Secondary)</label>
                                <input id="MainPocEmailSecondary" asp-for="SingleEventManagement.MainPocEmailSecondary" class="form-control" placeholder="Enter Secondary Email" type="email" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-secondary back" data-section="2">Back</button>

                        <div class="d-flex justify-content-end mt-4">
                        <button type="button" class="btn btn-primary next" data-section="2">Next</button>
                        </div>
    </div>

    <!-- Section 3 -->
    <div id="section3" class="form-section" style="display: none;">
        <h3 class="mt-5 mb-3">Event Secondary POC</h3>
        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="SecondaryPocLastName" class="form-label">Last Name</label>
                                <input id="SecondaryPocLastName" asp-for="SingleEventManagement.SecondaryPocLastName" class="form-control" placeholder="Enter Last Name" required />
                            </div>
                            <div class="col-sm-6">
                                <label for="SecondaryPocFirstName" class="form-label">First Name</label>
                                <input id="SecondaryPocFirstName" asp-for="SingleEventManagement.SecondaryPocFirstName" class="form-control" placeholder="Enter First Name" required />
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="SecondaryPocRank" class="form-label">Rank</label>
                                <input id="SecondaryPocRank" asp-for="SingleEventManagement.SecondaryPocRank" class="form-control" placeholder="Enter Rank" required />
                            </div>
                            <div class="col-sm-6">
                                <label for="SecondaryPocPhonePrimary" class="form-label">Phone Number (Primary)</label>
                                <input id="SecondaryPocPhonePrimary" asp-for="SingleEventManagement.SecondaryPocPhonePrimary" class="form-control" placeholder="Enter Primary Phone Number" required />
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="SecondaryPocPhoneSecondary" class="form-label">Phone Number (Secondary)</label>
                                <input id="SecondaryPocPhoneSecondary" asp-for="SingleEventManagement.SecondaryPocPhoneSecondary" class="form-control" placeholder="Enter Secondary Phone Number" />
                            </div>
                            <div class="col-sm-6">
                                <label for="SecondaryPocEmailPrimary" class="form-label">Email (Primary)</label>
                                <input id="SecondaryPocEmailPrimary" asp-for="SingleEventManagement.SecondaryPocEmailPrimary" class="form-control" placeholder="Enter Primary Email" type="email" required />
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="SecondaryPocEmailSecondary" class="form-label">Email (Secondary)</label>
                                <input id="SecondaryPocEmailSecondary" asp-for="SingleEventManagement.SecondaryPocEmailSecondary" class="form-control" placeholder="Enter Secondary Email" type="email" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-secondary back" data-section="3">Back</button>
    </div>

    <!-- Save Button -->
                        <input type="hidden" id="filledSections" name="filledSections" />

                    <div class="d-flex justify-content-end mt-4">
        <button type="submit" id="submitBtn" class="btn btn-success btn-lg me-3" name="action" value="Add" data-section="1">
                            <i class="bi bi-check-circle"></i> Submit
                        </button>
                    </div>
</form>



<script>
$(document).ready(function () {
    //////////////////////////////////////////////////javascript////////////////////////////////////////
    let currentSection = 1;

        $(".next").click(function () {
            const section = $(this).data("section");
            $("#submitBtn").data("section", section + 1);

            const isValid = validateSectionFields(section);

            if (!isValid) {
                return;
            }

            $(`#section${section}`).hide();
            $(`#section${section + 1}`).show();

            currentSection++;
        });


        $(".back").click(function () {
            const section = $(this).data("section");
            $("#submitBtn").data("section", section - 1);

            const isValid = validateSectionFields(section);

            if (!isValid) {
                return;
            }

            $(`#section${section}`).hide();
            $(`#section${section - 1}`).show();
            currentSection--;
        });

        $("#submitBtn").click(function (e) {
            debugger;

            e.preventDefault();

            const section = $(this).data("section");

            const isValid = validateSectionFields(section);

            if (!isValid) {
                return;
            }

            $("#eventManagementForm").submit();
        });

    // Save button logic
