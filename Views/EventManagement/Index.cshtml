<script>
    $(document).ready(function () {

        fetchRolesByCategory("");

        let currentSection = 1;
        $("#EventID").text('');

        flatpickr("#OpenAt", {
            enableTime: true,
            noCalendar: true,
            time_24hr: true,
            dateFormat: "H:i",
        });

        flatpickr("#CloseAt", {
            enableTime: true,
            noCalendar: true,
            time_24hr: true,
            dateFormat: "H:i",
        });

        flatpickr("#ShippingPocEventSetupTime", {
            enableTime: true,
            noCalendar: true,
            time_24hr: true,
            dateFormat: "H:i",
        });

        flatpickr("#PickupTime", {
            enableTime: true,
            noCalendar: true,
            time_24hr: true,
            dateFormat: "H:i",
        });

        $('#HIVDropOffStaffId').select2({
            theme: 'bootstrap-5',
            width: '100%'
        });

        $('#ContractId').select2({
            theme: 'bootstrap-5',
            width: '100%'
        });

        let taskForceIndex = 0;


        $("#EventStatus").change(function () {
            toggleTaskForceRequired();
        });

        // Call this function when adding a new Task Force row
        function toggleTaskForceRequired() {
            let selectedStatus = $("#EventStatus").val();
            let isRequired = selectedStatus && selectedStatus !== "Initial Pre-event";

            $(".form-container-Taskforce .taskforce-row input").each(function () {
                if (isRequired) {
                    $(this).attr("required", "required");
                } else {
                    $(this).removeAttr("required");
                }
            });
        }

        // Modify function when adding a new row
        function addTaskForceRow(value = "") {
            let taskForceValue = value ? value : "";
            let newInput = `
        <div class="taskforce-row mt-2" style="display: flex; align-items: center;" data-index="${taskForceIndex}">
                <input name="SingleEventManagement.EventManagementTaskforcesList[${taskForceIndex}].Taskforce" class="form-control" maxLength="100" placeholder="Enter Task Force" style="margin-right: 8px;" value="${taskForceValue}"/>
            <button type="button" class="btn btn-danger btn-sm remove-row remove-taskforce-row" style="height: 38px;">Remove</button>
        </div>
        `;

            $(".form-container-Taskforce").append(newInput);
            taskForceIndex++;
        }

        // Function to populate Taskforce fields in Edit Mode
        function populateTaskForces(taskForces) {
            $(".form-container-Taskforce").empty(); // Clear existing fields if needed
            taskForceIndex = 0; // Reset index

            taskForces.forEach(taskForce => {
                addTaskForceRow(taskForce.taskforce); // Generate input fields with values
            });

            toggleTaskForceRequired(); // Apply validation logic
        }


        $("#addTaskForceRowButton").click(function () {
            addTaskForceRow();
        });

        $(document).on("click", ".remove-taskforce-row", function () {
            $(this).parent(".taskforce-row").remove();
            resetTaskForceIndices();
        });

        function resetTaskForceIndices() {
            taskForceIndex = 0;
            $(".form-container-Taskforce .taskforce-row").each(function () {
                $(this).attr("data-index", taskForceIndex);
                $(this).find("input").attr("name", `SingleEventManagement.EventManagementTaskforcesList[${taskForceIndex}].Taskforce`);
                taskForceIndex++;
            });
            toggleTaskForceRequired(); // Re-check requirement after resetting
        }

        // Remove a Task Force row
        $(document).on("click", ".remove-taskforce-row", function () {
            $(this).parent(".taskforce-row").remove();
            resetTaskForceIndices();
        });

        // Reset indices after removing a row
        function resetTaskForceIndices() {
            taskForceIndex = 0;
            $(".form-container-Taskforce .taskforce-row").each(function () {
                $(this).attr("data-index", taskForceIndex);
                $(this).find("input").attr("name", `SingleEventManagement.EventManagementTaskforcesList[${taskForceIndex}].Taskforce`);
                taskForceIndex++;
            });
        }


        $('#HIVDropOffStaffId').select2({
            ajax: {
                url: '/EventStaff/GetEventStaffForSearching',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        staffId: params.term || ''
                    };
                },
                processResults: function (data) {
                    return {
                        results: data.map(function (staff) {
                            return {
                                id: staff.id,
                                text: staff.text
                            };
                        })
                    };
                },
                cache: true
            },
            placeholder: 'Search for Event Staff...',
            minimumInputLength: 1
        });

        $('#HIVDropOffStaffId').on('change', function (e) {
            const selectedStaffId = $(this).val();  // Get selected staff ID

            if (!selectedStaffId) {
                return;  // If no staff ID is selected, return early
            }

            $.ajax({
                url: '/EventStaff/GetEventStaffWithoutIncludeById',  // Your action URL
                type: 'GET',
                data: { id: selectedStaffId },  // Send selected staff ID
                success: function (response) {
                    if (response.success) {
                        // Populate the fields with fetched staff data
                        $('#HIVDropOffStaffLastName').val(response.eventStaff.staffLastName);
                        $('#HIVDropOffStaffFirstName').val(response.eventStaff.staffFirstName);
                    } else {
                        alert(response.message);  // Show error message if staff not found
                    }
                },
                error: function () {
                    alert('An error occurred while fetching staff details.');
                }
            });
        });

        $('#ContractId').select2({
            ajax: {
                url: '/ContractDetails/GetContractsForSearching', // Your endpoint for fetching contracts
                dataType: 'json',
                delay: 250,  // Optional: delay to limit requests to avoid too many hits
                data: function (params) {
                    return {

                        contractId: params.term || ''  // Send the search term to the server
                    };
                },
                processResults: function (data) {
                    if (!data || data.length === 0) {
                        return {
                            results: []
                        };
                    }
                    return {
                        results: data.map(function (contract) {
                            return {
                                id: contract.id,
                                text: contract.text
                            };
                        })
                    };
                },
                cache: true // Optional: caches the response to improve performance
            },
            placeholder: 'Search for a contract...', // Placeholder text when nothing is selected
