                        if (response.success) {
                            const part3 = response.data.eventManagementId.toString().padStart(4, '0'); // Ensure 4 digits
                            const finalEventManagementId = part1 + part2 + part3;
                            $("#EventID").text(finalEventManagementId);
                            $("#EventIDHidden").val(finalEventManagementId);
                        } else {
                            console.error("Error fetching Event Management ID sequence.");
                        }
                    },
                    error: function () {
                        alert("An error occurred while getting EventID sequence.");
                    }
                });
            } else {
                $("#EventID").val("");
                $("#EventIDHidden").val('');
            }
        }

        $("#EventCity").change(function () {
            generateEventID();
        });

        $("#EventState").on("change", function () {
            generateEventID();
        });


        function toggleMobDate() {
            const isDeployingSelected = $("#Deploying").is(":checked");
            const mobDateContainer = $("#MOBDateContainer");
            const mobDateInput = $("#EventMobDate");

            if (isDeployingSelected) {
                mobDateContainer.show();
                mobDateInput.prop("required", true);
            } else {
                mobDateContainer.hide();
                mobDateInput.prop("required", false);
                mobDateInput.val("");
            }
        }

        $("#Deploying, #NonDeploying").change(function () {
            toggleMobDate();
        });

        toggleMobDate();



        function generateControlsForDateRange(startDate, endDate) {
            var date1 = new Date(startDate);
            var date2 = new Date(endDate);
            var dayCount = Math.floor((date2 - date1) / (1000 * 3600 * 24)) + 1;

            if (dayCount > 14) {
                alert("Maximum 14 days are allowed");
                $('#EventStartDate').val('');
                $('#EventEndDate').val('');
                $('#dynamicControlsContainer').empty();
                return;
            }

            $('#dynamicControlsContainer').empty();
            for (var i = 0; i < dayCount; i++) {
                var currentDate = new Date(date1);
                currentDate.setDate(currentDate.getDate() + i);

                var dayLabel = "Day " + (i + 1);
                var startTimeId = "EventStartTimeDay" + (i + 1);
                var endTimeId = "EventEndTimeDay" + (i + 1);
                var percentId = "ServiceMemberPercentPerDay" + (i + 1);

                var controlHtml = `
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="${startTimeId}" class="form-label">${dayLabel} Start Time</label>
                            <input type="text" class="form-control" id="${startTimeId}" name="SingleEventManagement.EventStartTimeDay${i + 1}" />
                        </div>
                        <div class="col-md-4">
                            <label for="${endTimeId}" class="form-label">${dayLabel} End Time</label>
                            <input type="text" class="form-control" id="${endTimeId}" name="SingleEventManagement.EventEndTimeDay${i + 1}" />
                        </div>
                        <div class="col-md-4">
                            <label for="${percentId}" class="form-label">${dayLabel} Service Member %</label>
                                <input type="number" class="form-control" id="${percentId}" name="SingleEventManagement.ServiceMemberPercentPerDay" placeholder="Enter % per day" oninput="if(this.value.length > 3) this.value = this.value.slice(0, 3); required" />
                        </div>
                    </div>
                `;

                $('#dynamicControlsContainer').append(controlHtml);

                flatpickr(`#${startTimeId}`, {
                    enableTime: true,
                    noCalendar: true,
                    time_24hr: true,  
                    dateFormat: "H:i",
                });

                flatpickr(`#${endTimeId}`, {
                    enableTime: true,
                    noCalendar: true,
                    time_24hr: true, 
                    dateFormat: "H:i",
                });
            }
        }


        $('#EventStartDate, #EventEndDate').change(function () {
            var startDate = $('#EventStartDate').val();
            var endDate = $('#EventEndDate').val();

            if (startDate && endDate) {
                generateControlsForDateRange(startDate, endDate);
            }
        });

        var startDate = $('#EventStartDate').val();
        var endDate = $('#EventEndDate').val();
        if (startDate && endDate) {
            generateControlsForDateRange(startDate, endDate);
        }


        function validateServiceMemberPercentages() {
            let isValid = true;
            let totalSum = 0;

            // Select all inputs that match the name pattern
            const percentInputs = $('[name^="SingleEventManagement.ServiceMemberPercentPerDay"]');

            // Check if there are any percentage controls
            if (percentInputs.length === 0) {
                // Skip validation if no controls are found
                return true;
            }

            // Iterate over the inputs to validate their values
            percentInputs.each(function () {
                const value = parseFloat($(this).val());
                if (isNaN(value) || value <= 0) {
                    isValid = false;
                } else {
                    totalSum += value;
                }
            });

            if (!isValid) {
                alert("Please provide correct value of Service member day wise");
                return false;
            }

            if (totalSum !== 100) {
                alert("Invalid breakdown of Service member day wise");
                return false;
            }

            return true;
        }

        document.getElementById("toggleAdditionalPOC").addEventListener("change", function () {
            toggleRequiredFields();
        });

        function toggleRequiredFields() {
            const checkbox = document.getElementById("toggleAdditionalPOC");
            const controlsDiv = document.getElementById("additionalPocControls");
            const isChecked = checkbox.checked;

            // Toggle visibility of additional POC controls
            controlsDiv.style.display = isChecked ? "block" : "none";

            // Define required controls
            const requiredFields = [
                "AddtionalAlternatePocLastName",
                "AddtionalAlternatePocFirstName",
                "AddtionalAlternatePocRank",
                "AddtionalAlternatePocPhonePrimary",
                "AddtionalAlternatePocEmailPrimary"
            ];

            // Add or remove 'required' attribute based on checkbox state
            requiredFields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (isChecked) {
                    field.setAttribute("required", "required");
                } else {
                    field.removeAttribute("required");
                }
            });
        }

        // Centralized requirements object
        const requirements = {
            "Initial Pre-event": {
                PickupDate: true,
                PickupTime: false,
                DeliveryFromDate: false,
                DeliveryToDate: false,
                SuggestedHourlyFlow: false,
                TaskForce: false,
            },
            "Pre-Event Confirmed": {
                PickupDate: true,
                PickupTime: false,
                DeliveryFromDate: false,
                DeliveryToDate: false,
                SuggestedHourlyFlow: false,
                TaskForce: true,
            },
            "Pre- Event Complete": {
                PickupDate: true,
                PickupTime: true,
                DeliveryFromDate: true,
                DeliveryToDate: true,
                SuggestedHourlyFlow: true,
                TaskForce: true,
            },
            "In Progress": {
                PickupDate: true,
                PickupTime: true,
                DeliveryFromDate: true,
                DeliveryToDate: true,
                SuggestedHourlyFlow: true,
                TaskForce: true,
            },
            "Post event Incomplete": {
                PickupDate: true,
                PickupTime: true,
                DeliveryFromDate: true,
                DeliveryToDate: true,
                SuggestedHourlyFlow: true,
                TaskForce: true,
            },
            "Complete": {
                PickupDate: true,
                PickupTime: true,
                DeliveryFromDate: true,
                DeliveryToDate: true,
                SuggestedHourlyFlow: true,
                TaskForce: true,
            },
            "Canceled": {
                PickupDate: true,
                PickupTime: true,
                DeliveryFromDate: true,
                DeliveryToDate: true,
                SuggestedHourlyFlow: true,
                TaskForce: true,
            },
        };

        document.getElementById("EventStatus").addEventListener("change", function () {
            updateFieldRequirements(requirements);
        });

        // Update field requirements based on EventStatus
        function updateFieldRequirements(requirements) {
            const eventStatus = document.getElementById("EventStatus").value;
            const currentSettings = requirements[eventStatus] || {};

            for (const [field, isRequired] of Object.entries(currentSettings)) {
                const fieldElement = document.getElementById(field);
                if (fieldElement) {
                    if (isRequired) {
                        fieldElement.setAttribute("required", "required");
                    } else {
                        fieldElement.removeAttribute("required");
                    }
                }
            }
        }

        // Validate fields on form submission
        function validateEventStatusDependantFields(requirements) {
            const eventStatus = document.getElementById("EventStatus").value;
            const currentSettings = requirements[eventStatus] || {};
            let isValid = true;

            for (const [field, isRequired] of Object.entries(currentSettings)) {
                const fieldElement = document.getElementById(field);
                if (isRequired && fieldElement && !fieldElement.value.trim()) {
                    alert(`${field} field is required when Event Status is ${eventStatus}`);
                    isValid = false;
                    break;
                }
            }

            return isValid;
        }

        const phoneFields = ['EventHelpLine', 'MainPocPhonePrimary', 'MainPocPhoneSecondary', 'SecondaryPocPhonePrimary', 'SecondaryPocPhoneSecondary', 'AddtionalAlternatePocPhonePrimary', 'AddtionalAlternatePocPhoneSecondary', 'ShippingPocPrimaryPhone', 'ShippingPocSecondaryPhone', 'PharmacyPhoneNumber', 'HIVSupplyMilitaryContactPOCPhonePrimary', 'HIVSupplyMilitaryContactPOCPhoneSecondary', 'ImmVaccineSupplyMilitaryContactPOCPhonePrimary', 'ImmVaccineSupplyMilitaryContactPOCPhoneSecondary'];

        phoneFields.forEach(function (fieldId) {
            applyPhoneNumberMask(document.getElementById(fieldId));
        });

        function applyPhoneNumberMask(inputElement) {
            inputElement.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, ''); // Remove all non-digit characters
                if (value.length > 3 && value.length <= 6) {
                    value = value.slice(0, 3) + '-' + value.slice(3);
                } else if (value.length > 6) {
                    value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6, 10);
                }
                e.target.value = value;
            });
        }


        var tableIds = ["eventServicesTable", "eventServicesTable2", "eventServicesTable3"];

        tableIds.forEach(function (tableId) {
            var tableSelector = "#" + tableId;

            // Disable all number inputs and remove 'required' attribute by default
            $(tableSelector + " tbody tr").each(function () {
                $(this).find("td input[type='number']").prop("disabled", true).removeAttr('required');
            });

            // Enable number inputs and add 'required' when the checkbox is checked
            $(tableSelector + " tbody").on("change", "input[type='checkbox']", function () {
                var row = $(this).closest("tr");
                var numberInputs = row.find("td input[type='number']");
                if ($(this).is(":checked")) {
                    numberInputs.prop("disabled", false).attr('required', true);
                } else {
                    numberInputs.prop("disabled", true).removeAttr('required');
                }
            });

            // Restrict number inputs to 9 digits
            $(tableSelector + " tbody").on("input", "td input[type='number']", function () {
                var value = $(this).val();

                // Remove non-numeric characters
                value = value.replace(/\D/g, '');

                // Limit to 9 digits
                if (value.length > 9) {
                    value = value.substring(0, 9);
                }

                $(this).val(value);
            });
        });

});







</script>
