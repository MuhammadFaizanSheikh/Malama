        function getCompletedSections() {
            const completedSections = [];

            // Loop through each section and validate required fields
            $(".form-section").each(function () {
                const sectionId = $(this).attr("id"); // e.g., "section1"
                let isSectionValid = true;

                // Validate required fields in the section
                $(this)
                    .find("[required]")
                    .each(function () {
                        if (!$(this).val().trim()) {
                            isSectionValid = false; // Mark invalid if a required field is empty
                            return false; // Break out of the loop
                        }
                    });

                // If all required fields in the section are filled, add the section ID
                if (isSectionValid) {
                    const numericId = sectionId.replace(/\D/g, ""); // Extract numeric part (e.g., "section1" -> "1")
                    completedSections.push(numericId);
                }
            });

            return completedSections;
        }


        function validateSectionFields(sectionId) {
            const sectionFields = $(`#section${sectionId}`).find("input, select, textarea");

            let anyFieldFilled = false;
            let isValid = true;

            sectionFields.each(function () {
                const fieldValue = $(this).val();

                if (
                    fieldValue !== "SingleEventManagement.EventStartDate" &&
                    fieldValue !== "SingleEventManagement.EventEndDate" &&
                    fieldValue !== "SingleEventManagement.EventStartTimeDay1" &&
                    fieldValue !== "SingleEventManagement.EventEndTimeDay1" &&
                    fieldValue !== "Deploying" &&
                    fieldValue !== "Non-Deploying"
                ) {
                    if (fieldValue.trim() !== "") {
                        anyFieldFilled = true;
                    }
                }
            });

            if (anyFieldFilled) {
                sectionFields.each(function () {
                    if (!this.checkValidity()) {
                        this.reportValidity();
                        isValid = false;
                    }
                });
            }

            return isValid;
        }

        function validateSection1() {
            const section = document.getElementById("section1");
            const requiredControls = section.querySelectorAll("[required]");
            let isValid = true;

            requiredControls.forEach(control => {
                const controlValue = control.value.trim();

                if (!controlValue) {
                    isValid = false;
                    control.classList.add("is-invalid");
                } else {
                    control.classList.remove("is-invalid");
                }
            });

            return isValid;
        }

    $(document).on('input', '[required]', function () {
        const section = $(this).closest(".form-section").attr("id").replace("section", "");
        updateProgressBar(section); // Update progress bar when user fills required fields
    });

    function updateProgressBar(sectionNumber) {
        const requiredFields = $(`#section${sectionNumber}`).find('[required]');
        let allFieldsFilled = true;

        // Check if all required fields are filled
        requiredFields.each(function () {
            if ($(this).val().trim() === "") {
                allFieldsFilled = false;
            }
        });

        // If all required fields are filled, change the progress bar color to green
        if (allFieldsFilled) {
            $(`#progress${sectionNumber}`).addClass("completed"); // Green color
        } else {
            $(`#progress${sectionNumber}`).removeClass("completed"); // Reset color
        }
    }

        $('#addContractBtn').click(function () {
            $('.card-body').show();
            $('#datatableWrapper').hide();
            $('#submitBtn').show();
            // $('#resetBtn').show();
            // $('#updateBtn').hide();
            $('#addContractBtn').hide();
        });

        $('#contractsTable').DataTable({
