        function generateEventID() {
            const eventCity = $("#EventCity").val();
            const eventState = $("#EventState").val();  // This gets the selected state name
            const existingEventID = $("#EventIDHidden").val();

            if (eventCity && eventState) {

                $.getJSON("/data/statesAndCities.json", function (data) {
                    let selectedState = data.states.find(state => state.Name === eventState);
                    let part1 = selectedState ? selectedState.ShortName : "";  // Get the short name safely

                    const part2 = eventCity.toUpperCase().substring(0, 3);
                    let part3 = "";

                    if (existingEventID) {
                        // Extract part3 from existing Event ID
                        part3 = existingEventID.substring(part1.length + part2.length);
                        updateEventID(part1, part2, part3);
                    } else {
                        // Fetch the next Event Management ID
                        $.ajax({
                            url: '/EventManagement/GetNextEventManagementId',
                            type: 'GET',
                            success: function (response) {
                                if (response.success) {
                                    part3 = response.data.eventManagementId.toString().padStart(4, '0'); // Ensure 4 digits
                                    updateEventID(part1, part2, part3);
                                } else {
                                    console.error("Error fetching Event Management ID sequence.");
                                }
                            },
                            error: function () {
                                alert("An error occurred while getting EventID sequence.");
                            }
                        });
                    }
                }).fail(function () {
                    console.error("Error loading statesAndCities JSON file.");
                });
            } else {
                $("#EventID").val("");
                $("#EventIDHidden").val('');
            }
        }

