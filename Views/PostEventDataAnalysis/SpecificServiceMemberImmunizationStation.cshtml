@using Malama.Utilities
@using ExcelFilesCompiler.Utilities
@using Malama.Models
@model PostEventImmunizationStationAnalysisDto

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Post Event Immunization Station";
}

<style>
    #page-heading {
        text-align: center;
        margin: 20px auto;
    }

    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white;
    }

    .btn-general:hover {
        background-color: rgba(60, 70, 180, 1);
        border-color: rgba(60, 70, 180, 1);
        color: white;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }
</style>

<div class="d-flex align-items-center mb-3">
    <div style="flex: 1;">
        <label class="fw-bold me-2" style="font-size: 1.2rem;">Event ID:</label>
        <span style="font-size: 1.2rem;">@ViewBag.EventID</span>
    </div>
    <div style="flex: 1; text-align: center;">
        <h2 id="page-heading" class="m-0">Post Event Immunization Station</h2>
    </div>
    <div style="flex: 1;"></div>
</div>

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

            Swal.fire({
                icon: '@TempData["ResponseStatus"]',
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor,
                iconColor: iconColor
            });
        });
    </script>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4"><strong>Full Name:</strong> @Model.ServiceMember?.FullName</div>
            <div class="col-md-4"><strong>DOD ID:</strong> @Model.ServiceMember?.DodId</div>
            <div class="col-md-4"><strong>Barcode:</strong> @Model.ServiceMember?.Barcode</div>
        </div>
        <div class="row">
            <div class="col-md-4"><strong>DOB:</strong> @Model.ServiceMember?.Dob</div>
            <div class="col-md-4"><strong>Age:</strong> @Model.ServiceMember?.Age</div>
            <div class="col-md-4"><strong>Sex:</strong> @Model.ServiceMember?.Sex</div>
        </div>
    </div>
</div>

<form id="frmPostEventImmunizationStation" asp-action="SavePostEventImmunizationStation" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="PostEventImmunizationStation.Id" type="hidden" />
    <input asp-for="PostEventImmunizationStation.ServiceMembersChildId" type="hidden" />
    <input asp-for="PostEventImmunizationStation.PostEventManagementId" type="hidden" />
    <input asp-for="EventId" type="hidden" />
    <input type="hidden" asp-for="PostEventImmunizationStation.SubmissionToken" value="@Guid.NewGuid()" />

    <h3 class="mb-3">Required Immunization(s)</h3>

    @{
        var vaccineCards = Model.GetVaccineCards().ToList();
    }

    @if (!vaccineCards.Any())
    {
        <div class="alert alert-warning">No completed pre-event immunizations require post-event data entry.</div>
    }
    else
    {
        @foreach (var card in vaccineCards)
        {
            <partial name="_ImmunizationSection" model="card" />
        }

        <div class="row mt-4">
            <div class="col-md-4">
                <label class="form-label" for="PostEventImmunizationStation_Status">Status</label>
                <input class="form-control"
                       asp-for="PostEventImmunizationStation.Status"
                       id="PostEventImmunizationStation_Status"
                       readonly />
            </div>
        </div>
    }

    <div class="d-flex justify-content-end mt-4">
        @if (vaccineCards.Any())
        {
            <button type="button"
                    id="btnSf600Pdf"
                    class="btn btn-general btn-lg me-3"
                    data-service-members-child-id="@Model.PostEventImmunizationStation.ServiceMembersChildId">
                <i class="bi bi-file-earmark-pdf"></i> Print SF600
            </button>
        }
        
        <button type="submit" class="btn btn-success btn-lg me-3" @(DashboardAuthorizationHelper.HasAccess(User, "PostEventDataAnalysis_Save") ? "" : "disabled")>
            <i class="bi bi-check-circle"></i> Save
        </button>
        <a asp-action="SelectStation"
           asp-route-eventManagementId="@Model.EventId"
           asp-route-selectedStation="Immunization"
           class="btn btn-secondary btn-lg btn-back-confirm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</form>

<script>
        (function () {
            const IMM_STATUS_PENDING = 'Pending';
            const IMM_STATUS_COMPLETED = 'Completed';
            const VACCINE_RESULT_STATUS = {
                complete: 'Complete',
                incomplete: 'Incomplete',
                notApplicable: 'N/A'
            };

            function formatDateTimeForPost(date) {
                const pad = (n) => String(n).padStart(2, '0');
                return date.getFullYear() + '-' +
                    pad(date.getMonth() + 1) + '-' +
                    pad(date.getDate()) + ' ' +
                    pad(date.getHours()) + ':' +
                    pad(date.getMinutes()) + ':' +
                    pad(date.getSeconds());
            }

            function formatDateTimeForDisplay(date) {
                return date.toLocaleString('en-US', {
                    month: '2-digit',
                    day: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                });
            }

            function syncDataEnteredCheckbox(checkbox) {
                const hiddenId = checkbox.getAttribute('data-datetime-input');
                const displayId = checkbox.getAttribute('data-datetime-display');
                const hidden = document.getElementById(hiddenId);
                const display = document.getElementById(displayId);
                if (!hidden || !display) {
                    return;
                }

                if (checkbox.checked) {
                    const now = new Date();
                    if (!hidden.value) {
                        hidden.value = formatDateTimeForPost(now);
                    }
                    const displayDate = hidden.value
                        ? new Date(hidden.value.replace(' ', 'T'))
                        : now;
                    display.innerHTML = '<span>' + formatDateTimeForDisplay(displayDate) + '</span>';
                    display.style.display = 'block';
                } else {
                    hidden.value = '';
                    display.innerHTML = '';
                    display.style.display = 'none';
                }
            }

            function computeVaccineStatus(checkbox) {
                return checkbox.checked
                    ? VACCINE_RESULT_STATUS.complete
                    : VACCINE_RESULT_STATUS.incomplete;
            }

            function getVaccineStatusBadgeMeta(status) {
                switch (status) {
                    case VACCINE_RESULT_STATUS.complete:
                    case 'Completed':
                        return { label: 'Complete', badgeClass: 'bg-success', style: '' };
                    case VACCINE_RESULT_STATUS.notApplicable:
                        return { label: 'N/A', badgeClass: 'bg-secondary', style: '' };
                    default:
                        return { label: 'Incomplete', badgeClass: 'bg-warning text-dark', style: '' };
                }
            }

            function renderVaccineStatusBadge(cardId, status) {
                const statusDisplay = document.getElementById(cardId + '_immStatusDisplay');
                if (!statusDisplay) {
                    return;
                }

                const badge = getVaccineStatusBadgeMeta(status);
                statusDisplay.textContent = badge.label;
                statusDisplay.className = badge.badgeClass ? 'badge ' + badge.badgeClass : 'badge';
                statusDisplay.style.cssText = badge.style || '';
            }

            function updateVaccineCardStatus(checkbox) {
                const cardId = checkbox.getAttribute('data-card-id');
                const statusHidden = document.getElementById(cardId + '_immStatus');
                if (!cardId || !statusHidden) {
                    return;
                }

                const status = computeVaccineStatus(checkbox);
                statusHidden.value = status;
                renderVaccineStatusBadge(cardId, status);
            }

            function isVaccineFinishedForOverall(vaccineStatus) {
                if (!vaccineStatus) {
                    return false;
                }

                return vaccineStatus === VACCINE_RESULT_STATUS.complete ||
                    vaccineStatus === 'Completed';
            }

            function updateAllVaccineCardStatuses() {
                document.querySelectorAll('.imm-data-entered').forEach(function (checkbox) {
                    updateVaccineCardStatus(checkbox);
                });
            }

            function updatePostEventImmunizationStatus() {
                const statusInput = document.getElementById('PostEventImmunizationStation_Status');
                const cards = document.querySelectorAll('.imm-vaccine-card');
                if (!statusInput) {
                    return;
                }

                updateAllVaccineCardStatuses();

                if (cards.length === 0) {
                    statusInput.value = IMM_STATUS_PENDING;
                    return;
                }

                const allComplete = Array.from(cards).every(function (card) {
                    const cardId = card.getAttribute('data-card-id');
                    const vaccineStatus = document.getElementById(cardId + '_immStatus')?.value;
                    return isVaccineFinishedForOverall(vaccineStatus);
                });

                statusInput.value = allComplete ? IMM_STATUS_COMPLETED : IMM_STATUS_PENDING;
            }

            document.querySelectorAll('.imm-data-entered').forEach(function (checkbox) {
                syncDataEnteredCheckbox(checkbox);
                checkbox.addEventListener('change', function () {
                    syncDataEnteredCheckbox(checkbox);
                    updatePostEventImmunizationStatus();
                });
            });

            updatePostEventImmunizationStatus();
        })();

        $('#btnSf600Pdf').on('click', function () {
            const serviceMembersChildId = $(this).data('service-members-child-id');
            if (!serviceMembersChildId) {
                alert('Service member is missing.');
                return;
            }

            const url = '@Url.Action("GenerateSf600ImmunizationPdf", "PostEventDataAnalysis")'
                + '?serviceMembersChildId=' + encodeURIComponent(serviceMembersChildId);

            const $btn = $(this);
            $btn.prop('disabled', true);

            fetch(url)
                .then(async function (response) {
                    if (!response.ok) {
                        const message = await response.text();
                        throw new Error(message || 'Failed to generate SF600 PDF.');
                    }

                    return response.blob();
                })
                .then(function (blob) {
                    if (!blob || blob.size === 0) {
                        alert('No PDF was generated.');
                        return;
                    }

                    const objectUrl = window.URL.createObjectURL(blob);
                    window.open(objectUrl, '_blank');
                    setTimeout(function () {
                        window.URL.revokeObjectURL(objectUrl);
                    }, 60000);
                })
                .catch(function (error) {
                    alert(error.message || 'Failed to generate SF600 PDF.');
                })
                .finally(function () {
                    $btn.prop('disabled', false);
                });
        });

        $('a.btn-back-confirm').on('click', async function (e) {
            e.preventDefault();

            const url = $(this).attr('href');

            const confirmed = await showYesNoModal(
                "Are you sure you want to go back to main screen without saving changes?"
            );

            if (!confirmed) {
                return;
            }

            window.location.href = url;
        });
</script>
