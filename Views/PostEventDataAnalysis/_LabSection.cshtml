@model LabUIModel

<div class="card mb-3">
    <div class="card-header fw-bold">@Model.Title</div>

    <div class="card-body">

        @if (Model.Prefix.Equals("dna", StringComparison.OrdinalIgnoreCase))
        {
            <div class="row g-2 mb-3 align-items-end">

                <!-- COLLECTION DATE -->
                <div class="col-md-3">
                    <label class="form-label">Collection Date/Time</label>

                    <input class="form-control w-auto"
                           value="@Model.GivenDate?.ToString("MM-dd-yyyy HH:mm")"
                           readonly />
                </div>

                <!-- DNA SERIAL -->
                <div class="col-md-3">
                    <label class="form-label">Serial No.</label>

                    <input class="form-control"
                           name="@Model.DnaSerialNoName"
                           value="@Model.DnaSerialNo"
                           readonly />
                </div>

            </div>

        }
        else
        {
        <!-- GIVEN DATE + RESULT -->
        <div class="row g-2 mb-3 align-items-end">

            <!-- DATE -->
            <div class="col-md-3">
                <label class="form-label">Collection Date/Time</label>
                <input class="form-control w-auto"
                       value="@Model.GivenDate?.ToString("MM-dd-yyyy HH:mm")"
                       readonly />
            </div>

            <!-- LIPID RAPID -->
            @if (Model.Prefix.Equals("lipid", StringComparison.OrdinalIgnoreCase))
            {
                <div class="col-md-3">
                    <div class="form-check mt-4">
                        <input class="form-check-input"
                               type="checkbox"
                        @(Model.IsLipidRapid == true ? "checked" : "")
                               disabled />
                        <label class="form-check-label">Rapid Testing</label>
                    </div>
                </div>
            }

            <!-- HIV BARCODE -->
            @if (Model.Prefix.Equals("hiv", StringComparison.OrdinalIgnoreCase))
            {
                <div class="col-md-3">
                    <label class="form-label">Barcode Carebill</label>
                    <input class="form-control"
                           value="@Model.HivBarcodeCarebill"
                           readonly />
                </div>
            }
            <!-- PREGNANCY RESULT -->
            @if (Model.Prefix.Equals("preg", StringComparison.OrdinalIgnoreCase))
            {
                <div class="col-md-3">
                    <label class="form-label">Pregnancy Test Result</label>
                    <input class="form-control"
                           value="@Model.PregnancyTestResult"
                           readonly />
                </div>
            }

            <!-- RESULT RECEIVED -->
            <div class="col-md-@(
            Model.Prefix.Equals("lipid", StringComparison.OrdinalIgnoreCase) ||
            Model.Prefix.Equals("hiv", StringComparison.OrdinalIgnoreCase) ||
            Model.Prefix.Equals("preg", StringComparison.OrdinalIgnoreCase)
            ? "6" : "9")">

                <label class="form-label">Lab Result Received</label>

                <div class="mt-1">
                    <input type="radio"
                           name="@Model.ResultReceivedName"
                           value="true"
                    @(Model.ResultReceived ? "checked" : "")
                           onchange="toggleLab('@Model.Prefix', true)" />
                    <label class="me-3">Yes</label>

                    <input type="radio"
                           name="@Model.ResultReceivedName"
                           value="false"
                    @(!Model.ResultReceived ? "checked" : "")
                           onchange="toggleLab('@Model.Prefix', false)" />
                    <label>No</label>
                </div>
            </div>

        </div>

        <!-- YES SECTION -->
        <div id="@($"{Model.Prefix}_yes")"
             style="display:@(Model.ResultReceived ? "block" : "none");">

            <div class="row g-2 mb-3">

                <!-- RECEIVED DATE -->
                <div class="col-md-3">
                    <label>Lab Result Received Date/Time</label>
                    <input name="@Model.ReceivedDateName"
                           id="@($"{Model.Prefix}_received")"
                           value="@(Model.ReceivedDate?.ToString("yyyy-MM-dd HH:mm"))"
                           placeholder="MM-dd-yyyy HH:mm"
                           class="form-control flatpickr" />
                </div>

                <!-- MALAMA -->
                
                <div class="col-md-3">
                    <label>Upload Lab Result (Malama)</label>

                    <input type="file"
                           class="malama-file d-none"
                           name="@($"{Model.Prefix}MalamaFile")"
                           data-prefix="@Model.Prefix"
                           accept=".pdf,application/pdf"
                           onchange="toggleFlatpicker(this, '@Model.Prefix')" />

                    <button type="button"
                            class="btn btn-outline-primary btn-sm mt-1 open-malama-picker"
                            data-prefix="@Model.Prefix">
                        <i class="bi bi-upload"></i> Upload
                    </button>

                    <div class="d-flex align-items-center gap-2 mt-2 malama-file-status"
                         id="@($"{Model.Prefix}_fileStatus")"
                         data-prefix="@Model.Prefix"
                         data-existing-filename="@Model.MalamaFileName"
                         style="display:none;">
                        <span class="text-success fs-6" title="File selected">
                            <i class="bi bi-file-earmark-check-fill"></i>
                        </span>
                        <span class="small text-truncate"
                              id="@($"{Model.Prefix}_fileNameDisplay")"
                              style="max-width: 150px;">File selected</span>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary preview-selected-file"
                                data-prefix="@Model.Prefix">
                            Preview
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger cancel-selected-file"
                                data-prefix="@Model.Prefix">
                            Cancel
                        </button>
                    </div>

                    <input name="@Model.MalamaDateName"
                           value="@(Model.MalamaDate?.ToString("yyyy-MM-dd HH:mm"))"
                           class="form-control flatpickr mt-2"
                           id="@($"{Model.Prefix}_malamaDate")"
                               style="display:@(Model.Malama ? "block" : "none");"
                           readonly />

                    <input type="hidden"
                           id="@($"{Model.Prefix}_malamaUploaded")"
                           name="@Model.MalamaName"
                           value="@(Model.Malama ? "true" : "false")" />

                    <input type="hidden"
                           id="@($"{Model.Prefix}_malamaFileName")"
                           name="@Model.MalamaResultFileNameName"
                           value="@Model.MalamaFileName" />

                </div>

                <!-- SOR -->
                <div class="col-md-3">
                    <div class="form-check mb-1">
                        <input class="form-check-input"
                               type="checkbox"
                               name="@Model.SORName"
                               value="true"
                        @(Model.SOR ? "checked" : "")
                               onchange="toggleLabSOR('@Model.Prefix', this.checked)" />
                        <label class="form-check-label">Upload System of Records (SOR)</label>
                    </div>

                    <input name="@Model.SORDateName"
                           id="@($"{Model.Prefix}_sor")"
                           value="@(Model.SORDate?.ToString("yyyy-MM-dd HH:mm"))"
                           class="form-control flatpickr"
                           placeholder="MM-dd-yyyy HH:mm"
                           style="display:@(Model.SOR ? "block" : "none");" />
                </div>

                <!-- HRR -->
                <div class="col-md-3">
                    <div class="form-check mb-1">
                        <input class="form-check-input"
                               type="checkbox"
                               name="@Model.HRRName"
                               value="true"
                        @(Model.HRR ? "checked" : "")
                               onchange="toggleLabHRR('@Model.Prefix', this.checked)" />
                        <label class="form-check-label">Upload to client database (HRR)</label>
                    </div>

                    <input name="@Model.HRRDateName"
                           id="@($"{Model.Prefix}_hrr")"
                           value="@(Model.HRRDate?.ToString("yyyy-MM-dd HH:mm"))"
                           class="form-control flatpickr"
                           placeholder="MM-dd-yyyy HH:mm"
                           style="display:@(Model.HRR ? "block" : "none");" />
                </div>

                

            </div>
        </div>

        <!-- NO SECTION -->
        <div id="@($"{Model.Prefix}_no")"
             style="display:@(Model.ResultReceived ? "none" : "block");">

            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Provide Reason</label>
                    <select class="form-control w-auto"
                            name="@Model.ReasonName">

                        <option value="">-- Select Reason --</option>
                        <option value="Still waiting" selected="@(Model.Reason == "Still waiting")">Still waiting</option>
                        <option value="Insufficient blood sample" selected="@(Model.Reason == "Insufficient blood sample")">Insufficient blood sample</option>

                    </select>
                </div>
            </div>

        </div>
        }
    </div>
</div>
