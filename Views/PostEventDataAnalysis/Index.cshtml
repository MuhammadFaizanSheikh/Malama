@model Malama.Models.PostEventManagementViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml"; // Adjust the path to your layout file if necessary
    ViewData["Title"] = "Post Event Management";
}

<style>
    #page-heading {
        text-align: center;
        margin: 20px auto;
    }

    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white; /* ensures text is visible */
    }

        .btn-general:hover {
            background-color: rgba(60, 70, 180, 1); /* slightly darker on hover */
            border-color: rgba(60, 70, 180, 1);
            color: white;
        }

        .btn-general:focus,
        .btn-general:active {
            box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.5);
            outline: none;
        }

    .button-container {
        gap: 15px;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    table {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        table th,
        table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center; /* Aligns the text in the middle of the cell */
        }

        table th {
            background-color: #f4f4f4;
        }

        table tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

            table tbody tr:hover {
                background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
            }

        table td button,
        table td a {
            display: inline-block; /* Makes the buttons appear side by side */
            margin-right: 5px; /* Optional: Adds space between the buttons */
        }

        table td .button-container {
            display: flex;
            justify-content: center; /* Aligns buttons horizontally in the center */
        }

            table td .button-container a {
                margin-right: 5px; /* Optional: Adds space between the buttons */
            }

        table thead th {
            background-color: rgba(120, 130, 221, 1); /* Header background color */
            color: white; /* Header text color */
            text-align: center; /* Center-align header text */
        }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }
</style>


<h2 id="page-heading" >Post Event Data Selection</h2>

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

            Swal.fire({
                icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor, // Conditional button color
                iconColor: iconColor // Conditional icon color
            });
        });
    </script>
}


 

<div id="datatableWrapper" class="datatable-wrapper">
    <table id="contractsTable" class="display">
        <thead>
            <tr>
                <th>Event ID</th>
                <th>Version</th>
                <th>Taskforce</th>
                <th>Event Status</th>
                <th>State</th>
                <th>City</th>
                <th>ZipCode</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.EventManagements != null && Model.EventManagements.Any())
            {
                @foreach (var eventManagement in Model.EventManagements)
                {
                    <tr data-id="@eventManagement.Id">
                        <td>@eventManagement.EventID</td>
                        <td>
                            @if (eventManagement.EventVersion != 0)
                            {
                                @eventManagement.EventVersion
                            }
                        </td>

                        <td>@eventManagement.TaskForce</td>
                        <td>@eventManagement.EventStatus</td>
                        <td>@eventManagement.EventState</td>
                        <td>@eventManagement.EventCity</td>
                        <td>@eventManagement.EventZipCode</td>
                        <td>@eventManagement.EventStartDateUtc.ToString("MM-dd-yyyy")</td>
                        <td>@eventManagement.EventEndDateUtc.ToString("MM-dd-yyyy")</td>
                        <td>
                            <a asp-action="SelectStation" asp-route-eventManagementId="@eventManagement.Id" class="btn btn-primary edit-btn" style="background-color: rgba(80, 90, 201, 1);">Edit</a>
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                    <td class="text-center">No data available</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script>
</script>
