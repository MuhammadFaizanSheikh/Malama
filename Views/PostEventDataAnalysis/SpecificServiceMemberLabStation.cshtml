<script>
        function getLabResultNamePrefix(prefix) {
            switch ((prefix || "").toLowerCase()) {
                case "preg":
                    return "Pregnancy";
                case "lipid":
                    return "LipidPanel";
                case "sickle":
                    return "SickleCell";
                default:
                    return prefix.charAt(0).toUpperCase() + prefix.slice(1);
            }
        }

        const LAB_STATUS_PREFIXES = ["g6pd", "abo", "hiv", "preg", "lipid", "sickle"];
        const LAB_STATUS_PENDING = "Pending";
        const LAB_STATUS_COMPLETED = "Completed";

        function isLabSectionOnPage(prefix) {
            return !!document.getElementById(prefix + "_yes");
        }

        function isLabFieldsComplete(form, prefix) {
            const namePrefix = getLabResultNamePrefix(prefix);
            const receivedRadio = form.querySelector(
                `input[name*='${namePrefix}ResultReceived']:checked`
            );
            if (!receivedRadio) {
                return false;
            }

            const isYes = receivedRadio.value === "true";

            if (isYes) {
                const receivedInput = document.getElementById(prefix + "_received");
                if (!receivedInput || !(receivedInput.value || "").trim()) {
                    return false;
                }

                const malamaUploaded = document.getElementById(prefix + "_malamaUploaded");
                if (!malamaUploaded || malamaUploaded.value !== "true") {
                    return false;
                }

                const sorCheckbox = form.querySelector(
                    `input[type='checkbox'][name*='${namePrefix}ResultSORUploaded']`
                );
                const hrrCheckbox = form.querySelector(
                    `input[type='checkbox'][name*='${namePrefix}ResultHRRUploaded']`
                );
                if (!sorCheckbox?.checked || !hrrCheckbox?.checked) {
                    return false;
                }

                const sorInput = document.getElementById(prefix + "_sor");
                const hrrInput = document.getElementById(prefix + "_hrr");
                if (!sorInput || !(sorInput.value || "").trim()) {
                    return false;
                }
                if (!hrrInput || !(hrrInput.value || "").trim()) {
                    return false;
                }

                return true;
            }

            const reasonSelect = form.querySelector(`select[name*='${namePrefix}ResultReason']`);
            return !!(reasonSelect && (reasonSelect.value || "").trim());
        }

        function updatePostEventLabStatus() {
            const form = document.getElementById("frmPostEventLabStation");
            const statusInput = document.getElementById("PostEventLabStation_Status");
            if (!form || !statusInput) {
                return;
            }

            const activePrefixes = LAB_STATUS_PREFIXES.filter(isLabSectionOnPage);
            if (activePrefixes.length === 0) {
                statusInput.value = LAB_STATUS_PENDING;
                return;
            }

            const allComplete = activePrefixes.every(function (p) {
                return isLabFieldsComplete(form, p);
            });

            statusInput.value = allComplete ? LAB_STATUS_COMPLETED : LAB_STATUS_PENDING;
        }

        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".flatpickr").forEach(function (el) {

                if (!el._flatpickr) { // prevent double init
                    flatpickr(el, {
                        altInput: true,
                        altFormat: "m/d/Y h:i K",
                        dateFormat: "Y-m-d H:i",
                        allowInput: true,
                        enableTime: true,
                        time_24hr: true,
                        onChange: function () {
                            updatePostEventLabStatus();
                        }
                    });
                }

            });

            document.querySelectorAll("input[id$='_malamaDate']").forEach(function (el) {
                el.setAttribute("readonly", "readonly");
                if (el._flatpickr) {
                    el._flatpickr.set("allowInput", false);
                    el._flatpickr.set("clickOpens", false);
                }
                if (el._flatpickr?.altInput) {
                    el._flatpickr.altInput.setAttribute("readonly", "readonly");
                    el._flatpickr.altInput.setAttribute("disabled", "disabled");
                }
            });

            const prefixes = ["g6pd", "abo", "hiv", "preg", "lipid", "sickle", "dna"];
            for (const p of prefixes) {
                const namePrefix = getLabResultNamePrefix(p);
                const sorCheckbox = document.querySelector(`input[type='checkbox'][name*='${namePrefix}ResultSORUploaded']`);
                const hrrCheckbox = document.querySelector(`input[type='checkbox'][name*='${namePrefix}ResultHRRUploaded']`);
                const malamaDateInput = document.getElementById(p + "_malamaDate");

                if (malamaDateInput) {
                    malamaDateInput.dataset.originalValue = malamaDateInput.value || "";
                }

                toggleLabSOR(p, sorCheckbox?.checked === true);
                toggleLabHRR(p, hrrCheckbox?.checked === true);
                updateMalamaFileUI(p);
                syncMalamaDateVisibility(p);
            }

            updatePostEventLabStatus();

            const statusForm = document.getElementById("frmPostEventLabStation");
            if (statusForm) {
                statusForm.addEventListener("change", updatePostEventLabStatus);
                statusForm.addEventListener("input", updatePostEventLabStatus);
            }
        });

        document.addEventListener("submit", function (e) {
            const form = e.target;
            if (form.tagName !== "FORM") return;

            updatePostEventLabStatus();

            const prefixes = ["g6pd", "abo", "hiv", "preg", "lipid", "sickle", "dna"];

            for (let p of prefixes) {

                const namePrefix = getLabResultNamePrefix(p);

                // =========================
                // RECEIVED VALIDATION
                // =========================
                const receivedRadio = form.querySelector(
                    `input[name*='${namePrefix}ResultReceived']:checked`
                );

                if (receivedRadio) {

                    const isYes = receivedRadio.value === "true";

                    const receivedInput = form.querySelector(`#${p}_received`);
                    const receivedValue = receivedInput?.value;

                    if (isYes && !receivedValue) {

                        const visibleInput = receivedInput?._flatpickr?.altInput || receivedInput;
                        visibleInput?.focus();

                        e.preventDefault();
                        return;
                    }
                }

                // =========================
                // HRR VALIDATION
                // =========================
                const hrrCheckbox = form.querySelector(
                    `input[type='checkbox'][name*='${namePrefix}ResultHRRUploaded']`
                );

                const hrrInput = form.querySelector(`#${p}_hrr`);
                const hrrValue = hrrInput?.value;

                const hrrChecked = hrrCheckbox?.checked === true;

                if (hrrChecked && !hrrValue) {

                    const visibleInput = hrrInput?._flatpickr?.altInput || hrrInput;
                    visibleInput?.focus();

                    e.preventDefault();
                    return;
                }

                // =========================
                // SOR VALIDATION
                // =========================
                const sorCheckbox = form.querySelector(
                    `input[type='checkbox'][name*='${namePrefix}ResultSORUploaded']`
                );

                const sorInput = form.querySelector(`#${p}_sor`);
                const sorValue = sorInput?.value;

                const sorChecked = sorCheckbox?.checked === true;

                if (sorChecked && !sorValue) {

                    const visibleInput = sorInput?._flatpickr?.altInput || sorInput;
                    visibleInput?.focus();

                    e.preventDefault();
                    return;
                }
            }
        });

        $('a.btn-back-confirm').on('click', async function (e) {
            e.preventDefault();

            const url = $(this).attr('href');

            const confirmed = await showYesNoModal(
                "Are you sure you want to go back to main screen without saving changes?"
            );

            if (!confirmed) {
                return;
            }

            window.location.href = url;
        });

        function clearLabBranchFields(prefix) {
            const form = document.getElementById("frmPostEventLabStation");
            const namePrefix = getLabResultNamePrefix(prefix);

            const received = document.getElementById(prefix + "_received");
            if (received) {
                received.removeAttribute("required");
                received.value = "";
                if (received._flatpickr) {
                    received._flatpickr.clear();
                }
            }

            const reasonSelect = form?.querySelector(`select[name*='${namePrefix}ResultReason']`);
            if (reasonSelect) {
                reasonSelect.value = "";
            }

            const sorCheckbox = form?.querySelector(`input[type='checkbox'][name*='${namePrefix}ResultSORUploaded']`);
            if (sorCheckbox) {
                sorCheckbox.checked = false;
            }
            toggleLabSOR(prefix, false);

            const hrrCheckbox = form?.querySelector(`input[type='checkbox'][name*='${namePrefix}ResultHRRUploaded']`);
            if (hrrCheckbox) {
                hrrCheckbox.checked = false;
            }
            toggleLabHRR(prefix, false);

            const fileInput = document.querySelector(`.malama-file[data-prefix='${prefix}']`);
            const status = document.getElementById(prefix + "_fileStatus");
            const hiddenUploaded = document.getElementById(prefix + "_malamaUploaded");
            const hiddenFileName = document.getElementById(prefix + "_malamaFileName");
            const datePicker = document.getElementById(prefix + "_malamaDate");
            const fileNameDisplay = document.getElementById(prefix + "_fileNameDisplay");

            if (fileInput) {
                fileInput.value = "";
            }
            if (status) {
                const prevUrl = status.dataset.selectedPreviewUrl;
                if (prevUrl) {
                    URL.revokeObjectURL(prevUrl);
                }
                status.dataset.selectedPreviewUrl = "";
                status.dataset.previewMode = "";
                status.dataset.existingFilename = "";
                status.dataset.removedExisting = "";
                status.style.display = "none";
            }
            if (hiddenUploaded) {
                hiddenUploaded.value = "false";
            }
            if (hiddenFileName) {
                hiddenFileName.value = "";
            }
            if (datePicker) {
                datePicker.value = "";
                datePicker.dataset.originalValue = "";
                setFlatpickrVisibility(datePicker, false);
                if (datePicker._flatpickr) {
                    datePicker._flatpickr.clear();
                }
            }
            if (fileNameDisplay) {
                fileNameDisplay.textContent = "";
            }

            updateMalamaFileUI(prefix);
        }

        function toggleLab(prefix, isYes) {

        const yes = document.getElementById(prefix + "_yes");
        const no = document.getElementById(prefix + "_no");
        const received = document.getElementById(prefix + "_received");

        if (!yes || !no) return;

        clearLabBranchFields(prefix);

        yes.style.display = isYes ? "block" : "none";
        no.style.display = isYes ? "none" : "block";

        if (received) {
            if (isYes) {
                received.setAttribute("required", "required");
            } else {
                received.removeAttribute("required");
            }
        }

        // Keep Malama datetime hidden unless an actual file is selected.
        syncMalamaDateVisibility(prefix);
        updatePostEventLabStatus();
    }

    function toggleLabHRR(prefix, show) {
        const el = document.getElementById(prefix + "_hrr");

        if (!el) return;

        setFlatpickrVisibility(el, show);

        if (show) el.setAttribute("required", "required");
        else {
            el.removeAttribute("required");
            el.value = "";
            if (el._flatpickr) {
                el._flatpickr.clear();
            }
        }
        updatePostEventLabStatus();
    }

    function toggleLabSOR(prefix, show) {
        const el = document.getElementById(prefix + "_sor");

        if (!el) return;

        setFlatpickrVisibility(el, show);

        if (show) el.setAttribute("required", "required");
        else {
            el.removeAttribute("required");
            el.value = "";
            if (el._flatpickr) {
                el._flatpickr.clear();
            }
        }
        updatePostEventLabStatus();
    }

            function toggleFlatpicker(input, prefix) {

        const datePicker = document.getElementById(prefix + "_malamaDate");
        const hiddenField = document.getElementById(prefix + "_malamaUploaded");
        const now = getCurrentDateTimeValue();

        if (input.files && input.files.length > 0) {
            setFlatpickrVisibility(datePicker, true);
            hiddenField.value = "true";
            datePicker.value = now;
            if (datePicker._flatpickr) {
                datePicker._flatpickr.setDate(now, true, "Y-m-d H:i");
            }
        } else {
            const status = document.getElementById(prefix + "_fileStatus");
            const hasExistingServerFile = !!(status?.dataset?.existingFilename || "").trim() &&
                status?.dataset?.removedExisting !== "true";
            const originalValue = datePicker?.dataset?.originalValue || "";

            if (hasExistingServerFile) {
                // Keep original persisted state but keep datetime hidden until a new file is selected.
                setFlatpickrVisibility(datePicker, false);
                hiddenField.value = "true";
                datePicker.value = originalValue;
                if (datePicker._flatpickr && originalValue) {
                    datePicker._flatpickr.setDate(originalValue, true, "Y-m-d H:i");
                } else if (datePicker._flatpickr) {
                    datePicker._flatpickr.clear();
                }
            } else {
                setFlatpickrVisibility(datePicker, false);
                hiddenField.value = "false";
                datePicker.value = "";
                if (datePicker._flatpickr) {
                    datePicker._flatpickr.clear();
                }
            }
        }
        updatePostEventLabStatus();
    }

    function setFlatpickrVisibility(input, show) {
        if (!input) return;

        input.style.display = show ? "block" : "none";
        input.setAttribute("readonly", "readonly");

        if (input._flatpickr?.altInput) {
            input._flatpickr.altInput.style.display = show ? "block" : "none";
            input._flatpickr.altInput.setAttribute("readonly", "readonly");
        }
    }

    function getCurrentDateTimeValue() {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, "0");
        const day = String(now.getDate()).padStart(2, "0");
        const hour = String(now.getHours()).padStart(2, "0");
        const minute = String(now.getMinutes()).padStart(2, "0");
        return `${year}-${month}-${day} ${hour}:${minute}`;
    }

    function syncMalamaDateVisibility(prefix) {
        const fileInput = document.querySelector(`.malama-file[data-prefix='${prefix}']`);
        const datePicker = document.getElementById(prefix + "_malamaDate");
        if (!fileInput || !datePicker) return;

        const hasSelectedFile = fileInput.files && fileInput.files.length > 0;
        setFlatpickrVisibility(datePicker, hasSelectedFile);
    }

    function updateMalamaFileUI(prefix) {
        const fileInput = document.querySelector(`.malama-file[data-prefix='${prefix}']`);
        const status = document.getElementById(prefix + "_fileStatus");
        const fileNameDisplay = document.getElementById(prefix + "_fileNameDisplay");
        const hiddenUploaded = document.getElementById(prefix + "_malamaUploaded");
        const hiddenFileName = document.getElementById(prefix + "_malamaFileName");

        if (!fileInput || !status || !fileNameDisplay || !hiddenUploaded || !hiddenFileName) return;

        const selectedFile = fileInput.files && fileInput.files.length > 0 ? fileInput.files[0] : null;
        const existingFileName = (status.dataset.existingFilename || "").trim();
        const removedExisting = status.dataset.removedExisting === "true";
        const selectedPreviewUrl = status.dataset.selectedPreviewUrl || "";

        if (selectedFile) {
            fileNameDisplay.textContent = "File selected";
            status.style.display = "flex";

            hiddenUploaded.value = "true";
            hiddenFileName.value = "";

            if (selectedPreviewUrl) {
                URL.revokeObjectURL(selectedPreviewUrl);
            }
            status.dataset.selectedPreviewUrl = URL.createObjectURL(selectedFile);
            status.dataset.previewMode = "selected";
            return;
        }

        if (selectedPreviewUrl) {
            URL.revokeObjectURL(selectedPreviewUrl);
        }
        status.dataset.selectedPreviewUrl = "";

        if (existingFileName && !removedExisting) {
            fileNameDisplay.textContent = "File selected";
            status.style.display = "flex";
            hiddenUploaded.value = "true";
            hiddenFileName.value = existingFileName;
            status.dataset.previewMode = "server";
            return;
        }

        fileNameDisplay.textContent = "";
        status.style.display = "none";
        hiddenUploaded.value = "false";
        hiddenFileName.value = "";
        status.dataset.previewMode = "";
        updatePostEventLabStatus();
    }

    $(document).on("change", ".malama-file", function () {
        const prefix = $(this).data("prefix");
        if (!prefix) return;
        updateMalamaFileUI(prefix);
        updatePostEventLabStatus();
    });

    $(document).on("click", ".open-malama-picker", function () {
        const prefix = $(this).data("prefix");
        if (!prefix) return;

        const input = document.querySelector(`.malama-file[data-prefix='${prefix}']`);
        if (!input) return;

        input.click();
    });

    $(document).on("click", ".cancel-selected-file", function () {
        const prefix = $(this).data("prefix");
        if (!prefix) return;

        const input = document.querySelector(`.malama-file[data-prefix='${prefix}']`);
        const status = document.getElementById(prefix + "_fileStatus");
        if (!input) return;

        const hadSelectedFile = input.files && input.files.length > 0;
        const hadExistingFile = !!(status?.dataset?.existingFilename || "").trim();

        input.value = "";
        if (status && !hadSelectedFile && hadExistingFile) {
            status.dataset.removedExisting = "true";
        }

        toggleFlatpicker(input, prefix);
        updateMalamaFileUI(prefix);
        updatePostEventLabStatus();
    });

    $(document).on("click", ".preview-selected-file", function () {
        const prefix = $(this).data("prefix");
        if (!prefix) return;

        const status = document.getElementById(prefix + "_fileStatus");
        const hiddenFileName = document.getElementById(prefix + "_malamaFileName");
        if (!status || !hiddenFileName) return;

        const previewMode = status.dataset.previewMode;
        if (previewMode === "selected") {
            const localUrl = status.dataset.selectedPreviewUrl;
            if (localUrl) {
                window.open(localUrl, "_blank");
            }
            return;
        }

        const fileName = hiddenFileName.value || status.dataset.existingFilename;
        if (!fileName) return;

        const url = "/PostEventDataAnalysis/DownloadMalamaFile?station=Labs&prefix=" + encodeURIComponent(prefix) + "&fileName=" + encodeURIComponent(fileName);
        window.open(url, "_blank");
    });

        
</script>