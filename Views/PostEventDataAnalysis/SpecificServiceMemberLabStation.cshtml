<script>
    
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".flatpickr").forEach(function (el) {

                if (!el._flatpickr) { // prevent double init
                    flatpickr(el, {
                        altInput: true,
                        altFormat: "m/d/Y h:i K",
                        dateFormat: "Y-m-d H:i",
                        allowInput: true,
                        enableTime: true,
                        time_24hr: true
                    });
                }

            });
        });

        document.addEventListener("submit", function (e) {
            const form = e.target;
            if (form.tagName !== "FORM") return;

            const prefixes = ["g6pd", "abo", "hiv", "preg", "lipid", "sickle", "dna"];

            for (let p of prefixes) {

                const namePrefix = p.charAt(0).toUpperCase() + p.slice(1);

                // =========================
                // RECEIVED VALIDATION
                // =========================
                const receivedRadio = form.querySelector(
                    `input[name*='${namePrefix}ResultReceived']:checked`
                );

                if (receivedRadio) {

                    const isYes = receivedRadio.value === "true";

                    const receivedInput = form.querySelector(`#${p}_received`);
                    const receivedValue = receivedInput?.value;

                    if (isYes && !receivedValue) {

                        const visibleInput = receivedInput?._flatpickr?.altInput || receivedInput;
                        visibleInput?.focus();

                        e.preventDefault();
                        return;
                    }
                }

                // =========================
                // EMR VALIDATION
                // =========================
                const emrCheckbox = form.querySelector(
                    `input[type='checkbox'][name*='${namePrefix}ResultEMRUploaded']`
                );

                const emrInput = form.querySelector(`#${p}_emr`);
                const emrValue = emrInput?.value;

                const emrChecked = emrCheckbox?.checked === true;

                if (emrChecked && !emrValue) {

                    const visibleInput = emrInput?._flatpickr?.altInput || emrInput;
                    visibleInput?.focus();

                    e.preventDefault();
                    return;
                }

                // =========================
                // SOR VALIDATION
                // =========================
                const sorCheckbox = form.querySelector(
                    `input[type='checkbox'][name*='${namePrefix}ResultSORUploaded']`
                );

                const sorInput = form.querySelector(`#${p}_sor`);
                const sorValue = sorInput?.value;

                const sorChecked = sorCheckbox?.checked === true;

                if (sorChecked && !sorValue) {

                    const visibleInput = sorInput?._flatpickr?.altInput || sorInput;
                    visibleInput?.focus();

                    e.preventDefault();
                    return;
                }
            }
        });

        $('a.btn-back-confirm').on('click', async function (e) {
            e.preventDefault();

            const url = $(this).attr('href');

            const confirmed = await showYesNoModal(
                "Are you sure you want to go back to main screen without saving changes?"
            );

            if (!confirmed) {
                return;
            }

            window.location.href = url;
        });

        function toggleLab(prefix, isYes) {

        const yes = document.getElementById(prefix + "_yes");
        const no = document.getElementById(prefix + "_no");
        const received = document.getElementById(prefix + "_received");

        if (!yes || !no) return;

        yes.style.display = isYes ? "block" : "none";
        no.style.display = isYes ? "none" : "block";

        if (received) {
            if (isYes) {
                received.setAttribute("required", "required");
            } else {
                received.removeAttribute("required");
                received.value = "";
            }
        }
    }

    function toggleLabEMR(prefix, show) {
        const el = document.getElementById(prefix + "_emr");

        if (!el) return;

        el.style.display = show ? "block" : "none";

        if (show) el.setAttribute("required", "required");
        else {
            el.removeAttribute("required");
            el.value = "";
        }
    }

    function toggleLabSOR(prefix, show) {
        const el = document.getElementById(prefix + "_sor");

        if (!el) return;

        el.style.display = show ? "block" : "none";

        if (show) el.setAttribute("required", "required");
        else {
            el.removeAttribute("required");
            el.value = "";
        }
    }

            function toggleFlatpicker(input, prefix) {

        const datePicker = document.getElementById(prefix + "_malamaDate");
        const hiddenField = document.getElementById(prefix + "_malamaUploaded");

        if (input.files && input.files.length > 0) {
            datePicker.style.display = "block";
            hiddenField.value = "true";
        } else {
            datePicker.style.display = "none";
            hiddenField.value = "false";
            datePicker.value = "";
        }
    }

        $(document).on("change", ".malama-file", function () {

        var fileInput = this;
        var file = fileInput.files[0];

        if (!file) return;

        var prefix = $(this).data("prefix");
        var barcode = $(this).data("barcode");

        var formData = new FormData();
        formData.append("file", file);
        formData.append("prefix", prefix);
        formData.append("barcode", barcode);

        $.ajax({
            url: "/PostEventDataAnalysis/UploadMalamaFile",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {

                if (res.success) {

                    // set hidden values
                    $("#" + prefix + "_malamaUploaded").val("true");
                    $("#" + prefix + "_malamaFileName").val(res.fileName);

                    // show preview button
                    $("#" + prefix + "_previewContainer").show();

                    $("#" + prefix + "_previewContainer button")
                        .attr("data-filename", res.fileName);
                }
                else {
                    alert(res.message);
                }
            }
        });
    });

    $(document).on("click", ".preview-file", function () {

        var prefix = $(this).data("prefix");
        var fileName = $(this).data("filename");

        if (!fileName) return;

        var url = "/PostEventDataAnalysis/DownloadLabFile?fileName=" + encodeURIComponent(fileName);

        window.open(url, "_blank");
    });

        
</script>