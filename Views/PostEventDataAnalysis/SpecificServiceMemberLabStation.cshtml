            outline: none;
        }

    .button-container {
        gap: 15px;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    table {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        table th,
        table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center; /* Aligns the text in the middle of the cell */
        }

        table th {
            background-color: #f4f4f4;
        }

        table tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

