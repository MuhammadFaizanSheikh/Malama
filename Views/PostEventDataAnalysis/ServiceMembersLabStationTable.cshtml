                <td></td>
            </tr>
        }
    </tbody>
</table>

<script>
        var table;
        var labReportFilterFn = null;

    $(document).ready(function () {

        table = $('#postEventTable').DataTable();

        // 🔹 Map Lab names to column indexes (UPDATE indexes as per your table)
        const labColumnMap = {
            "G6PD": 9,
            "Lipid Panel": 10,
            "HIV": 11,
            "ABO": 12,
            "Sickle Cell": 13,
            "DNA": 14
        };

        let filterDobPicker = flatpickr("#filterDob", {
            altInput: true,
            altFormat: 'm/d/Y',
            dateFormat: 'Y-m-d',
            allowInput: true
        });

        function destroyFilterReportSelect2() {
            var $fr = $('#filterReport');
            if ($fr.length && $fr.hasClass('select2-hidden-accessible')) {
                $fr.select2('destroy');
            }
        }

        function initFilterReportSelect2() {
            var $fr = $('#filterReport');
            if (!$fr.length || $fr.hasClass('select2-hidden-accessible')) {
                return;
            }
            $fr.select2({
                placeholder: 'All',
                allowClear: true,
                width: '100%',
                closeOnSelect: false,
                dropdownParent: $('.post-event-lab-filters-card')
            });
        }

        function updateFilterReportVisibility() {
            var labStatus = $('#filterLabStatus').val();
            if (labStatus === 'P') {
                $('#filterReportCol').show();
                initFilterReportSelect2();
            } else {
                destroyFilterReportSelect2();
                $('#filterReportCol').hide();
                $('#filterReport').val(null);
            }
        }

        $('#filterLabStatus').on('change', updateFilterReportVisibility);
        updateFilterReportVisibility();

        $('#searchStaffBtn').on('click', function () {

            var barcode = $('#filterBarcode').val().trim().toLowerCase();
            var fullName = $('#filterFullName').val().trim().toLowerCase();
            var dodId = $('#filterDodId').val().trim();
            var last4Ssn = $('#filterLast4Ssn').val().trim();
            var status = $('#filterStatus').val().trim().toLowerCase();

            var lab = $('#filterLab').val();
            var labStatus = $('#filterLabStatus').val();
            var reportSelections = $('#filterReport').val() || [];
            if (!Array.isArray(reportSelections)) {
                reportSelections = reportSelections ? [reportSelections] : [];
            }

            let dobPicker = $('#filterDob')[0]?._flatpickr;
            let dobDate = dobPicker?.selectedDates?.[0] || null;

            if (labReportFilterFn) {
                var fi = $.fn.dataTable.ext.search.indexOf(labReportFilterFn);
                if (fi !== -1) {
                    $.fn.dataTable.ext.search.splice(fi, 1);
                }
                labReportFilterFn = null;
            }

            // 🔹 Clear previous filters
            table.columns().search('');

            if (barcode) {
                table.column(8).search(barcode, true, false, true);
            }

            if (fullName) {
                const escaped = fullName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                table.column(3).search(escaped, true, false, true);
            }

            if (dodId) {
                table.column(5).search('^' + dodId + '$', true, false);
            }

            if (dobDate) {
                const month = (dobDate.getMonth() + 1).toString().padStart(2, '0');
                const day = dobDate.getDate().toString().padStart(2, '0');
                const year = dobDate.getFullYear();

                const formatted = `${month}/${day}/${year}`;
                table.column(7).search('^' + formatted + '$', true, false);
            }

            if (last4Ssn) {
                table.column(4).search('^' + last4Ssn + '$', true, false);
            }

            if (status) {
                table.column(1).search(status, true, false, true);
            }

            // 🔹 NEW: Lab + Status dynamic filtering (cell contains badge + detail text; match status letter)
            if (lab && labStatus) {
                let columnIndex = labColumnMap[lab];

                if (columnIndex !== undefined) {
                    table.column(columnIndex).search(labStatus, true, false, true);
                }
            }

            // 🔹 Optional: If only Lab selected (no status)
            else if (lab && !labStatus) {
                let columnIndex = labColumnMap[lab];

                if (columnIndex !== undefined) {
                    table.column(columnIndex).search('.', true, false); // any non-empty
                }
            }

            if (lab && labStatus === 'P' && reportSelections.length > 0) {
                var columnIndexForReport = labColumnMap[lab];
                if (columnIndexForReport !== undefined) {
                    var needles = reportSelections.map(function (r) {
                        return '✖ ' + r;
                    });
                    labReportFilterFn = function (settings, data, dataIndex) {
                        if (settings.nTable.id !== 'postEventTable') {
                            return true;
                        }
                        var api = new $.fn.dataTable.Api(settings);
                        var rowNode = api.row(dataIndex).node();
                        if (!rowNode) {
                            return true;
                        }
                        var $cell = $('td', rowNode).eq(columnIndexForReport);
                        var badgeText = $cell.find('.badge').first().text().trim();
                        if (badgeText !== 'P') {
                            return false;
                        }
                        var cellText = $cell.text();
                        for (var i = 0; i < needles.length; i++) {
                            if (cellText.indexOf(needles[i]) === -1) {
                                return false;
                            }
                        }
                        return true;
                    };
                    $.fn.dataTable.ext.search.push(labReportFilterFn);
                }
            }

            table.draw();
        });

        // 🔹 Reset Filters
        $('#resetFiltersBtn').on('click', function () {
            destroyFilterReportSelect2();

            $('input').val('');
            $('select').not('#filterReport').val('');
            $('#filterReport').val(null);

            let dobPicker = $('#filterDob')[0]?._flatpickr;
            if (dobPicker) dobPicker.clear();

            if (labReportFilterFn) {
                var fi = $.fn.dataTable.ext.search.indexOf(labReportFilterFn);
                if (fi !== -1) {
                    $.fn.dataTable.ext.search.splice(fi, 1);
                }
                labReportFilterFn = null;
            }

            table.columns().search('');
            updateFilterReportVisibility();
            table.draw();
        });

    });
</script>
