                       style="background-color: rgba(80, 90, 201, 1);">
                        Edit
                    </a>
                </td>

                <td>Pending</td>
                <td>@item.SmId</td>
                <td>@item.FullName</td>
                <td>@item.Last4</td>
                <td>@item.DodId</td>
                <td>@item.Sex</td>
                <td>@item.Dob</td>
                <td>@item.Barcode</td>

                <!-- G6PD -->
                @{
                    var g6pd = GetLabStatus(
                    item.LabStationRecord?.G6pdNeeded,
                    item.PostEventLabStation?.G6pdResultMalamaUploaded,
                    item.PostEventLabStation?.G6pdResultHRRUploaded,
                    item.PostEventLabStation?.G6pdResultSORUploaded,
                    item.PostEventLabStation,
                    item.PostEventLabStation?.G6pdResultReceived,
                    item.PostEventLabStation?.G6pdResultReason
                    );
                }
                <td style="min-width:70px;">
                    <div style="text-align:center;">
                        <span class="badge" style="background-color:@g6pd.BgColor; color:@g6pd.TextColor;">
                            @g6pd.Text
                        </span>
                        @if (g6pd.ShowDetails)
                        {
                            <div class="lab-details" style="margin-top:5px; font-size:12px; text-align:center;">

                                <span style="color:@(g6pd.Malama == true ? "green" : "red")">
                                    @(g6pd.Malama == true ? "✔" : "✖") Malama
                                </span>

                                <span style="color:@(g6pd.Hrr == true ? "green" : "red")">
                                    @(g6pd.Hrr == true ? "✔" : "✖") HRR
                                </span>

                                <span style="color:@(g6pd.Sor == true ? "green" : "red")">
                                    @(g6pd.Sor == true ? "✔" : "✖") SOR
                                </span>

                            </div>
                        }
                    </div>
                </td>

                <!-- Lipid -->
                @{
                    var lipid = GetLabStatus(
                    item.LabStationRecord?.LipidPanelNeeded,
                    item.PostEventLabStation?.LipidPanelResultMalamaUploaded,
                    item.PostEventLabStation?.LipidPanelResultHRRUploaded,
                    item.PostEventLabStation?.LipidPanelResultSORUploaded,
                    item.PostEventLabStation,
                    item.PostEventLabStation?.LipidPanelResultReceived,
                    item.PostEventLabStation?.LipidPanelResultReason
                    );
                }
                <td style="min-width:70px;">
                    <div style="text-align:center;">
                        <span class="badge" style="background-color:@lipid.BgColor; color:@lipid.TextColor;">
                            @lipid.Text
                        </span>
                        @if (lipid.ShowDetails)
                        {
                            <div class="lab-details" style="margin-top:5px; font-size:12px; text-align:center;">

                                <span style="color:@(lipid.Malama == true ? "green" : "red")">
                                    @(lipid.Malama == true ? "✔" : "✖") Malama
                                </span>

                                <span style="color:@(lipid.Hrr == true ? "green" : "red")">
                                    @(lipid.Hrr == true ? "✔" : "✖") HRR
                                </span>

                                <span style="color:@(lipid.Sor == true ? "green" : "red")">
                                    @(lipid.Sor == true ? "✔" : "✖") SOR
                                </span>

                            </div>
                        }
                    </div>
                </td>

                <!-- HIV -->
                @{
                    var hiv = GetLabStatus(
                    item.LabStationRecord?.HivNeeded,
                    item.PostEventLabStation?.HivResultMalamaUploaded,
                    item.PostEventLabStation?.HivResultHRRUploaded,
                    item.PostEventLabStation?.HivResultSORUploaded,
                    item.PostEventLabStation,
                    item.PostEventLabStation?.HivResultReceived,
                    item.PostEventLabStation?.HivResultReason
                    );
                }
                <td style="min-width:70px;">
                    <div style="text-align:center;">
                        <span class="badge" style="background-color:@hiv.BgColor; color:@hiv.TextColor;">
                            @hiv.Text
                        </span>
                        @if (hiv.ShowDetails)
                        {
                            <div class="lab-details" style="margin-top:5px; font-size:12px; text-align:center;">

                                <span style="color:@(hiv.Malama == true ? "green" : "red")">
                                    @(hiv.Malama == true ? "✔" : "✖") Malama
                                </span>

                                <span style="color:@(hiv.Hrr == true ? "green" : "red")">
                                    @(hiv.Hrr == true ? "✔" : "✖") HRR
                                </span>

                                <span style="color:@(hiv.Sor == true ? "green" : "red")">
                                    @(hiv.Sor == true ? "✔" : "✖") SOR
                                </span>

                            </div>
                        }
                    </div>
                </td>

                <!-- ABO -->
                @{
                    var abo = GetLabStatus(
                    item.LabStationRecord?.AboNeeded,
                    item.PostEventLabStation?.AboResultMalamaUploaded,
                    item.PostEventLabStation?.AboResultHRRUploaded,
                    item.PostEventLabStation?.AboResultSORUploaded,
                    item.PostEventLabStation,
                    item.PostEventLabStation?.AboResultReceived,
                    item.PostEventLabStation?.AboResultReason
                    );
                }
                <td style="min-width:70px;">
                    <div style="text-align:center;">
                        <span class="badge" style="background-color:@abo.BgColor; color:@abo.TextColor;">
                            @abo.Text
                        </span>
                        @if (abo.ShowDetails)
                        {
                            <div class="lab-details" style="margin-top:5px; font-size:12px; text-align:center;">

                                <span style="color:@(abo.Malama == true ? "green" : "red")">
                                    @(abo.Malama == true ? "✔" : "✖") Malama
                                </span>

                                <span style="color:@(abo.Hrr == true ? "green" : "red")">
                                    @(abo.Hrr == true ? "✔" : "✖") HRR
                                </span>

                                <span style="color:@(abo.Sor == true ? "green" : "red")">
                                    @(abo.Sor == true ? "✔" : "✖") SOR
                                </span>

                            </div>
                        }
                    </div>
                </td>
                <!-- Sickle -->
                @{
                    var sickle = GetLabStatus(
                    item.LabStationRecord?.SickleCellNeeded,
                    item.PostEventLabStation?.SickleCellResultMalamaUploaded,
                    item.PostEventLabStation?.SickleCellResultHRRUploaded,
                    item.PostEventLabStation?.SickleCellResultSORUploaded,
                    item.PostEventLabStation,
                    item.PostEventLabStation?.SickleCellResultReceived,
                    item.PostEventLabStation?.SickleCellResultReason
                    );
                }
                <td style="min-width:70px;">
                    <div style="text-align:center;">
                        <span class="badge" style="background-color:@sickle.BgColor; color:@sickle.TextColor;">
                            @sickle.Text
                        </span>
                        @if (sickle.ShowDetails)
                        {
                            <div class="lab-details" style="margin-top:5px; font-size:12px; text-align:center;">

                                <span style="color:@(sickle.Malama == true ? "green" : "red")">
                                    @(sickle.Malama == true ? "✔" : "✖") Malama
                                </span>

                                <span style="color:@(sickle.Hrr == true ? "green" : "red")">
                                    @(sickle.Hrr == true ? "✔" : "✖") HRR
                                </span>

                                <span style="color:@(sickle.Sor == true ? "green" : "red")">
                                    @(sickle.Sor == true ? "✔" : "✖") SOR
                                </span>

                            </div>
                        }
                    </div>
                </td>
                @{
                    var dnaCompleted = item.LabStationRecord?.DnaNeeded == "Completed";
                }

                <td>
                    <div style="text-align:center;">
                        <span class="badge"
                              style="background-color:@(dnaCompleted ? "#198754" : "#6c757d");
                     color:#ffffff;">
                            @(dnaCompleted ? "C" : "N/A")
                        </span>
                    </div>
                </td>
                <!-- Pregnancy -->
                @{
                    var preg = GetLabStatus(
                    item.LabStationRecord?.PregnancyTestNeeded,
                    item.PostEventLabStation?.PregnancyResultMalamaUploaded,
                    item.PostEventLabStation?.PregnancyResultHRRUploaded,
                    item.PostEventLabStation?.PregnancyResultSORUploaded,
                    item.PostEventLabStation,
                    item.PostEventLabStation?.PregnancyResultReceived,
                    item.PostEventLabStation?.PregnancyResultReason
                    );
                }
                <td>
                    <div style="text-align:center;">
                        <span class="badge" style="background-color:@preg.BgColor; color:@preg.TextColor;">
                            @preg.Text
