                        @if (preg.ShowDetails)
                        {
                            <div class="lab-details" style="margin-top:5px; font-size:12px; text-align:center;">

                                <span style="color:@(preg.Malama == true ? "green" : "red")">
                                    @(preg.Malama == true ? "✔" : "✖") Malama
                                </span>

                                <span style="color:@(preg.Hrr == true ? "green" : "red")">
                                    @(preg.Hrr == true ? "✔" : "✖") HRR
                                </span>

                                <span style="color:@(preg.Sor == true ? "green" : "red")">
                                    @(preg.Sor == true ? "✔" : "✖") SOR
                                </span>

                            </div>
