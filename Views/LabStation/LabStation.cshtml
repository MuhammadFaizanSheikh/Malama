@using Malama.Utilities
@model Malama.Models.LabStation

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Add Lab Screening";
}

<style>
    #page-heading {
        text-align: center;
        margin: 20px auto;
    }

    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white; /* ensures text is visible */
    }

        .btn-general:hover {
            background-color: rgba(60, 70, 180, 1); /* slightly darker on hover */
            border-color: rgba(60, 70, 180, 1);
            color: white;
        }

        .btn-general:focus,
        .btn-general:active {
            box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.5);
            outline: none;
        }

    .button-container {
        gap: 15px;
    }

    h2, h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    table {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        table th,
        table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center; /* Aligns the text in the middle of the cell */
        }

        table th {
            background-color: #f4f4f4;
        }

        table tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

            table tbody tr:hover {
                background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
            }

        table td button,
        table td a {
            display: inline-block; /* Makes the buttons appear side by side */
            margin-right: 5px; /* Optional: Adds space between the buttons */
        }

        table td .button-container {
            display: flex;
            justify-content: center; /* Aligns buttons horizontally in the center */
        }

            table td .button-container a {
                margin-right: 5px; /* Optional: Adds space between the buttons */
            }

        table thead th {
            background-color: rgba(120, 130, 221, 1); /* Header background color */
            color: white; /* Header text color */
            text-align: center; /* Center-align header text */
        }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }
</style>

<h2 id="page-heading">Edit Service Member at Lab Station</h2>

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

            Swal.fire({
                icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor, // Conditional button color
                iconColor: iconColor // Conditional icon color
            });
        });
    </script>
}

<form id="SaveLabStation" asp-action="SaveLabStation" method="post">
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.ServiceMembersChildId)
    <input type="hidden" name="SubmissionToken" id="SubmissionToken" value="@Guid.NewGuid()" />
    <!-- Link to parent contract -->
    @* <input type="hidden" asp-for="FileDataId" /> *@

    <h3 class="mb-4">Personal Information</h3>
    <div class="card mb-4">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <p><span class="fw-bold">Full Name:</span> @Model.ServiceMembersChild?.FullName</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">DOD ID:</span> @Model.ServiceMembersChild?.DodId</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">Routing Sheet Barcode:</span> @Model.ServiceMembersChild?.Barcode</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <p><span class="fw-bold">DOB:</span> @Model.ServiceMembersChild?.Dob</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">Age:</span> @Model.ServiceMembersChild?.Age</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">Sex:</span> @Model.ServiceMembersChild?.Sex</p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    

    <h3 class="mb-4">Questionnaires :</h3>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">1. Are you fasting for 8 hours or more?</label>
            <select asp-for="AreYouFasting" class="form-select">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">2. Have you ever had any complications getting your blood drawn?</label>
            <select asp-for="AnyComplicationInBloodDrawn" class="form-select">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">3. Are you allergic to Latex? </label>
            <select asp-for="AllergicToLatex" class="form-select">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">4. Do you feel all right?"</label>
            <select asp-for="FeelAlright" class="form-select">
                <option value="No" selected>No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="mb-2">
                <label class="form-label">LabCorp Account Number :</label>
                <input type="text"
                       class="form-control fw-bold"
                       value="42084755"
                       readonly />
            </div>
        </div>
    </div>
    
    <hr class="my-4" />
    <h3 class="mb-4">Required Lab(s) :</h3>
    <div id="lab-section">

        @if (string.Equals(Model.ServiceMembersChild?.G6pd?.Trim(), "NEEDED", StringComparison.OrdinalIgnoreCase))
        {
            <!-- Hepatitis B -->
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-2">
                        <label>G6pd Needed Status</label>
                        <select asp-for="G6pdNeeded" class="form-control">
                            <option value=""></option>
                            <option value="Completed">Completed</option>
                            <option value="Not Completed">Not Completed</option>
                        </select>
                    </div>

                    <div class="col-md-2" id="g6pdReasonContainer" style="display:none;">
                        <label>Reason</label>
                        <select asp-for="G6pdReason" class="form-control">
                            <option value=""></option>
                            <option value="Insufficient Supplies">Insufficient Supplies</option>
                            <option value="Refused">Refused</option>
                            <option value="Contraindication">Contraindication</option>
                            <option value="Excused">Excused</option>
                            <option value="Proof of Service">Proof of Service</option>
                        </select>
                    </div>
                    @if (Model.Id != 0)
                    {
                        @if (Model.G6pdNeeded == "Completed")
                        {
                            <div class="col-md-2">
                                <label>Collection Date/Time</label>
                                <input asp-for="G6pdGivenDateTime" class="form-control givendatetime-input" type="text"
                                       value="@(Model.G6pdGivenDateTime?.ToString("MM/dd/yyyy hh:mm tt") ?? "")" readonly />
                            </div>
                        }
                    }
                </div>
            </div>

            <hr class="my-4" />
        }

        @if (string.Equals(Model.ServiceMembersChild?.AboNeeded?.Trim(), "NEEDED", StringComparison.OrdinalIgnoreCase))
        {
            <div class="card-body">

                <div class="row mb-2">

                    <!-- ABO Needed Status (REQUIRED) -->
                    <div class="col-md-2">
                        <label>ABO Needed Status</label>
                        <select asp-for="AboNeeded" class="form-control">
                            <option value=""></option>
                            <option value="Completed">Completed</option>
                            <option value="Not Completed">Not Completed</option>
                        </select>
                    </div>

                    <!-- Reason (Only when Not Completed) -->
                    <div class="col-md-2" id="aboReasonContainer" style="display:none;">
                        <label>Reason</label>
                        <select asp-for="AboReason" class="form-control">
                            <option value=""></option>
                            <option value="Insufficient Supplies">Insufficient Supplies</option>
                            <option value="Refused">Refused</option>
                            <option value="Contraindication">Contraindication</option>
                            <option value="Excused">Excused</option>
                            <option value="Proof of Service">Proof of Service</option>
                        </select>
                    </div>

                    <!-- ABO Grouping (Only when Completed) -->
                    <div class="col-md-2" id="aboGroupingContainer" style="display:none;">
                        <label>ABO Grouping</label>
                        <select asp-for="AboGrouping" class="form-control">
                            <option value=""></option>
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="AB">AB</option>
                            <option value="O">O</option>
                        </select>

                    </div>

                    <!-- Rh Factor (Only when Completed) -->
                    <div class="col-md-2" id="aboRhContainer" style="display:none;">
                        <label>Rh Factor</label>
                        <select asp-for="AboRhFactor" class="form-control">
                            <option value=""></option>
                            <option value="+ve">+ve</option>
                            <option value="-ve">-ve</option>
                        </select>

                    </div>
                    @if (Model.Id != 0)
                    {
                        @if (Model.AboNeeded == "Completed")
                        {
                            <div class="col-md-2">
                                <label>Collection Date/Time</label>
                                <input asp-for="AboGivenDateTime" class="form-control givendatetime-input" type="text"
                                       value="@(Model.AboGivenDateTime?.ToString("MM/dd/yyyy hh:mm tt") ?? "")" readonly />
                            </div>
                        }
                    }
                </div>
            </div>

            <hr class="my-4" />
        }

        @if (string.Equals(Model.ServiceMembersChild?.LipidNeeded?.Trim(), "NEEDED", StringComparison.OrdinalIgnoreCase))
        {
            <div class="card-body">

                <div class="row mb-2">

                    <!-- Lipid Panel Needed Status (REQUIRED) -->
                    <div class="col-md-2">
                        <label>Lipid Panel Needed Status</label>
                        <select asp-for="LipidPanelNeeded" class="form-control">
                            <option value=""></option>
                            <option value="Completed">Completed</option>
                            <option value="Not Completed">Not Completed</option>
                        </select>
                    </div>

                    <!-- Reason -->
                    <div class="col-md-2" id="lipidReasonContainer" style="display:none;">
                        <label>Reason</label>
                        <select asp-for="LipidPanelReason" class="form-control">
                            <option value=""></option>
                            <option value="Insufficient Supplies">Insufficient Supplies</option>
                            <option value="Refused">Refused</option>
                            <option value="Contraindication">Contraindication</option>
                            <option value="Excused">Excused</option>
                            <option value="Proof of Service">Proof of Service</option>
                        </select>
                    </div>

                    <!-- Rapid Testing -->
                    <div class="col-md-2" id="lipidRapidContainer" style="display:none;">
                        <div class="d-flex align-items-center mt-4">
                            <input type="checkbox"
                                   asp-for="LipidPanelRapidTesting"
                                   class="form-check-input me-2"
                                   style="transform: scale(2);" />
                            <label class="mb-0">Rapid Testing</label>
                        </div>
                    </div>
                    @if (Model.Id != 0)
                    {
                        @if (Model.LipidPanelNeeded == "Completed")
                        {
                            <div class="col-md-2">
                                <label>Collection Date/Time</label>
                                <input asp-for="LipidPanelGivenDateTime" class="form-control givendatetime-input" type="text"
                                       value="@(Model.LipidPanelGivenDateTime?.ToString("MM/dd/yyyy hh:mm tt") ?? "")" readonly />
                            </div>
                        }
                    }
                </div>

                <!-- Lipid Values (VERTICAL) -->
                <div class="row" id="lipidValuesContainer" style="display:none;">
                    <div class="col-md-3 offset-md-3">

                        <div class="mb-2">
                            <label>Total Cholesterol</label>

                            <div class="d-flex align-items-center gap-3">
                                <!-- Textbox -->
                                <div style="width: 440px; flex-shrink: 0;">
                                    @if (Model.TotalCholesterol_LessThan100 || Model.TotalCholesterol_GreaterThan400)
                                    {
                                        <input asp-for="TotalCholesterol"
                                               class="form-control min-max lipid-input"
                                               data-min="100"
                                               data-max="400"
                                               type="number"
                                               step="1"
                                               readonly />
                                    }
                                    else
                                    {
                                        <input asp-for="TotalCholesterol"
                                               class="form-control min-max lipid-input"
                                               data-min="100"
                                               data-max="400"
                                               type="number"
                                               step="1" required />
                                    }
                                </div>

                                <!-- Radios -->
                                <div class="form-check mb-0 text-nowrap">
                                    <input asp-for="TotalCholesterol_LessThan100"
                                           class="form-check-input lipid-radio"
                                           type="checkbox"/>
                                    <label class="form-check-label">
                                        Less than 100 mg/dL
                                    </label>
                                </div>

                                <div class="form-check mb-0 text-nowrap">
                                    <input asp-for="TotalCholesterol_GreaterThan400"
                                           class="form-check-input lipid-radio"
                                           type="checkbox" />
                                    <label class="form-check-label">
                                        Greater than 400 mg/dL
                                    </label>
                                </div>
                            </div>
                        </div>



                        <div class="mb-2">
                            <label>High Density Lipoproteins (HDL CHOL)</label>

                            <div class="d-flex align-items-center gap-3">
                                <div style="width: 440px; flex-shrink: 0;">
                                    @if (Model.HdlCholesterol_LessThan20 || Model.HdlCholesterol_GreaterThan120)
                                    {
                                        <input asp-for="HdlCholesterol"
                                               class="form-control min-max lipid-input"
                                               data-min="20"
                                               data-max="120"
                                               type="number"
                                               step="1"
                                               readonly />
                                    }
                                    else
                                    {
                                        <input asp-for="HdlCholesterol"
                                               class="form-control min-max lipid-input"
                                               data-min="20"
                                               data-max="120"
                                               type="number"
                                               step="1" required />
                                    }
                                </div>

                                <div class="form-check mb-0 text-nowrap">
                                    <input asp-for="HdlCholesterol_LessThan20"
                                           class="form-check-input lipid-radio"
                                           type="checkbox" />
                                    <label class="form-check-label">
                                        Less than 20 mg/dL
                                    </label>
                                </div>

                                <div class="form-check mb-0 text-nowrap">
                                    <input asp-for="HdlCholesterol_GreaterThan120"
                                           class="form-check-input lipid-radio"
                                           type="checkbox" />
                                    <label class="form-check-label">
                                        Greater than 120 mg/dL
                                    </label>
                                </div>
                            </div>
                        </div>



                        <div class="mb-2">
                            <label>Triglycerides (TRIG)</label>

                            <div class="d-flex align-items-center gap-3">
                                <div style="width: 440px; flex-shrink: 0;">
                                    @if (Model.Triglycerides_LessThan50 || Model.Triglycerides_GreaterThan500)
                                    {
                                        <input asp-for="Triglycerides"
                                               class="form-control min-max lipid-input"
                                               data-min="50"
                                               data-max="500"
                                               type="number"
                                               step="1"
                                               readonly />
                                    }
                                    else
                                    {
                                        <input asp-for="Triglycerides"
                                               class="form-control min-max lipid-input"
                                               data-min="50"
                                               data-max="500"
                                               type="number"
                                               step="1" required />
                                    }
                                </div>

                                <div class="form-check mb-0 text-nowrap">
                                    <input asp-for="Triglycerides_LessThan50"
                                           class="form-check-input lipid-radio"
                                           type="checkbox" />
                                    <label class="form-check-label">
                                        Less than 50 mg/dL
                                    </label>
                                </div>

                                <div class="form-check mb-0 text-nowrap">
                                    <input asp-for="Triglycerides_GreaterThan500"
                                           class="form-check-input lipid-radio"
                                           type="checkbox" />
                                    <label class="form-check-label">
                                        Greater than 500 mg/dL
                                    </label>
                                </div>
                            </div>
                        </div>



                        <div class="mb-2">
                            <label>Glucose (eGLU)</label>

                            <div class="d-flex align-items-center gap-3">
                                <div style="width: 440px; flex-shrink: 0;">
                                    @if (Model.Glucose_LessThan20 || Model.Glucose_GreaterThan600)
                                    {
                                        <input asp-for="Glucose"
                                               class="form-control min-max lipid-input"
                                               data-min="20"
                                               data-max="600"
                                               type="number"
                                               step="1"
                                               readonly />
                                    }
                                    else
                                    {
                                        <input asp-for="Glucose"
                                               class="form-control min-max lipid-input"
                                               data-min="20"
                                               data-max="600"
                                               type="number"
                                               step="1" required />
                                    }
                                </div>

                                <div class="form-check mb-0 text-nowrap">
                                    <input asp-for="Glucose_LessThan20"
                                           class="form-check-input lipid-radio"
                                           type="checkbox" />
                                    <label class="form-check-label">
                                        Less than 20 mg/dL
                                    </label>
                                </div>

                                <div class="form-check mb-0 text-nowrap">
                                    <input asp-for="Glucose_GreaterThan600"
                                           class="form-check-input lipid-radio"
                                           type="checkbox" />
                                    <label class="form-check-label">
                                        Greater than 600 mg/dL
                                    </label>
                                </div>
                            </div>
                        </div>



                        <div class="mb-2">
                            <label>A1C(%)</label>
                            <input asp-for="A1C" class="form-control decimal-range" data-min="0.1" data-max="99.9" type="number" step="0.1" required />
                        </div>

                        <div class="mb-2">
                            <label>Low density Lipoprotiens (CALC LDL)</label>
                            <input asp-for="LdlCholesterol" class="form-control decimal-range" data-min="0.1" data-max="99.9" type="number" step="0.1" required />
                        </div>

                        <div class="mb-2">
                            <label>Total Cholesterol/High Density Lipoprotiens (TC/HDL)</label>
                            <input asp-for="TotalCholesterolHdlRatio" class="form-control decimal-range" data-min="0.1" data-max="99.9" type="number" step="0.1" required />
                        </div>

                        <div class="mb-2">
                            <label>Low density Lipoprotiens/High Density Lipoprotiens (TC/HDL)</label>
                            <input asp-for="LdlHdlLipoprotiens" class="form-control decimal-range" data-min="0.1" data-max="99.9" type="number" step="0.1" required />
                        </div>

                        <div class="mb-2">
                            <label>Non - High Density Lipoprotiens (Non-HDL)</label>
                            <input asp-for="NonHdlCholesterol" class="form-control max-3-digit" type="number" required />
                        </div>

                    </div>
                </div>

                
            </div>

            <hr class="my-4" />
        }

        @if (string.Equals(Model.ServiceMembersChild?.Hiv?.Trim(), "NEEDED", StringComparison.OrdinalIgnoreCase))
        {
            <div class="card-body">

                <div class="row mb-2">

                    <!-- HIV Needed Status -->
                    <div class="col-md-2">
                        <label>HIV Needed Status</label>
                        <select asp-for="HivNeeded" class="form-control">
                            <option value=""></option>
                            <option value="Completed">Completed</option>
                            <option value="Not Completed">Not Completed</option>
                        </select>
                    </div>

                    <!-- Reason (only if Not Completed) -->
                    <div class="col-md-2" id="hivReasonContainer" style="display:none;">
                        <label>Reason</label>
                        <select asp-for="HivReason" class="form-control">
                            <option value=""></option>
                            <option value="Insufficient Supplies">Insufficient Supplies</option>
                            <option value="Refused">Refused</option>
                            <option value="Contraindication">Contraindication</option>
                            <option value="Excused">Excused</option>
                            <option value="Proof of Service">Proof of Service</option>
                        </select>
                    </div>

                    <!-- Barcode (Carebill) textbox, only if Completed -->
                    <div class="col-md-2" id="hivBarcodeContainer" style="display:none;">
                        <label>Barcode (Carebill)</label>
                        <input asp-for="HivBarcodeCarebill" class="form-control" />
                    </div>
                    @if (Model.Id != 0)
                    {
                        @if (Model.HivNeeded == "Completed")
                        {
                            <div class="col-md-2">
                                <label>Collection Date/Time</label>
                                <input asp-for="HivGivenDateTime" class="form-control givendatetime-input" type="text"
                                       value="@(Model.HivGivenDateTime?.ToString("MM/dd/yyyy hh:mm tt") ?? "")" readonly />
                            </div>
                        }
                    }
                </div>

            </div>

            <hr class="my-4" />
        }

        @if (string.Equals(Model.ServiceMembersChild?.Sex?.Trim(), "F", StringComparison.OrdinalIgnoreCase))
        {
            <div class="card-body">

                <div class="row mb-2">

                    <!-- Pregnancy Test Needed Status -->
                    <div class="col-md-2">
                        <label>Pregnancy Test Needed Status</label>
                        <select asp-for="PregnancyTestNeeded" class="form-control">
                            <option value=""></option>
                            <option value="Completed">Completed</option>
                            <option value="Not Completed">Not Completed</option>
                        </select>
                    </div>

                    <!-- Result dropdown (only if Completed) -->
                    <div class="col-md-2" id="pregnancyResultContainer" style="display:none;">
                        <label>Result</label>
                        <select asp-for="PregnancyTestResult" class="form-control">
                            <option value=""></option>
                            <option value="Positive">Positive</option>
                            <option value="Negative">Negative</option>
                        </select>
                    </div>

                    <!-- Reason dropdown (only if Not Completed) -->
                    <div class="col-md-2" id="pregnancyReasonContainer" style="display:none;">
                        <label>Reason</label>
                        <select asp-for="PregnancyTestReason" class="form-control">
                            <option value=""></option>
                            <option value="Insufficient Supplies">Insufficient Supplies</option>
                            <option value="Refused">Refused</option>
                            <option value="Contraindication">Contraindication</option>
                            <option value="Excused">Excused</option>
                            <option value="Proof of Service">Proof of Service</option>
                        </select>
                    </div>
                    @if (Model.Id != 0)
                    {
                        @if (Model.PregnancyTestNeeded == "Completed")
                        {
                            <div class="col-md-2">
                                <label>Collection Date/Time</label>
                                <input asp-for="PregnancyTestGivenDateTime" class="form-control givendatetime-input" type="text"
                                       value="@(Model.PregnancyTestGivenDateTime?.ToString("MM/dd/yyyy hh:mm tt") ?? "")" readonly />
                            </div>
                        }
                    }
                </div>

            </div>

            <hr class="my-4" />
        }

        <div class="card-body">
            <div class="row mb-2">
                <div class="col-md-2">
                    <label>FedEx Tracking No</label>
                    <input asp-for="FedExTrackingNo" class="form-control" />
                </div>
            </div>
        </div>

        <hr class="my-4" />


    </div>


    <div class="row mb-2">
        @* <div class="col-md-2">
            <label>Staff Name</label>
            <input asp-for="CompletedBy" class="form-control" value="@User.Identity.Name" readonly />
        </div> *@

        <div class="col-md-2">
            <label>Status</label>
            <select asp-for="Status" class="form-control">
                <option value="Pending">Pending</option>
                <option value="Completed">Completed</option>
            </select>
        </div>
    </div>
    <!-- Submit Buttons -->
    <div class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn btn-success btn-lg me-3" @(DashboardAuthorizationHelper.HasAccess(User, "LabStation_Save") ? "" : "disabled")>
            <i class="bi bi-check-circle"></i> Save
        </button>

        <a asp-action="Index" class="btn btn-secondary btn-lg btn-back-confirm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</form>

<script>
    
    $(document).ready(function () {

        // Checkbox change
        $(".lipid-radio").on("change", function () {
            const $container = $(this).closest(".d-flex");
            const $input = $container.find(".lipid-input");

            if ($(this).is(":checked")) {
                // Checkbox selected → clear, readonly, not required
                $input.val("").prop({
                    readonly: true,
                    required: false
                });

                // Uncheck the other checkbox in the same group
                $container.find(".lipid-radio").not(this).prop("checked", false);
            } else {
                // Checkbox unchecked → only enable input if no other checkbox is checked
                const anyChecked = $container.find(".lipid-radio:checked").length > 0;
                if (!anyChecked) {
                    $input.prop({
                        readonly: false,
                        required: true
                    });
                }
            }
        });

        // Input typing
        $(".lipid-input").on("input", function () {
            const $container = $(this).closest(".d-flex");

            // Typing → uncheck all checkboxes + enable + required
            $container.find(".lipid-radio").prop("checked", false);
            $(this).prop({
                readonly: false,
                required: true
            });
        });

        // On page load (edit mode) → set readonly + required according to checked checkbox
        $(".lipid-radio").each(function () {
            const $container = $(this).closest(".d-flex");
            const $input = $container.find(".lipid-input");

            if ($container.find(".lipid-radio:checked").length > 0) {
                $input.prop({
                    readonly: true,
                    required: false
                });
            } else {
                $input.prop({
                    readonly: false,
                    required: true
                });
            }
        });

        function toggleTextboxRequired($checkbox) {
            var $container = $checkbox.closest('.d-flex');
            var $textbox = $container.find('.lipid-input');

            if ($checkbox.is(':checked')) {
                $textbox.prop('readonly', true).prop('required', false).val('');
            } else {
                // Check if the other checkbox is also unchecked
                var otherChecked = $container.find('.lipid-radio:checked').length;
                if (!otherChecked) {
                    $textbox.prop('readonly', false).prop('required', true);
                }
            }
        }

        function validateRange($input) {
            const val = $input.val();
            if (val === "") return true;

            const num = Number(val);
            const min = Number($input.data("min"));
            const max = Number($input.data("max"));

            // Find only the first <label> that is **direct child of .mb-2**
            const fieldName = $input
                .closest(".mb-2")
                .children("label")
                .first()
                .text()
                .trim();

            if (isNaN(num)) {
                alert(`${fieldName} must be a numeric value.`);
                $input.val("").focus();
                return false;
            }

            if (num < min || num > max) {
                alert(`${fieldName} must be between ${min} and ${max}.`);
                $input.val("").focus();
                return false;
            }

            return true;
        }

        $(".min-max").on("blur", function () {
            validateRange($(this));
        });

        $(".decimal-range").on("blur", function () {
            @* let val = $(this).val();

            // Split by decimal point
            const parts = val.split(".");
            if (parts.length > 1) {
                // Keep only first decimal digit
                parts[1] = parts[1].slice(0, 1);
            }

            // Join back and remove any non-digit characters except the first dot
            const cleanVal = parts.join(".").replace(/[^0-9.]/g, "");

            // Set back to input
            $(this).val(cleanVal); *@
            validateRange($(this));
        });

        $(".max-3-digit").on("input", function () {
            this.value = this.value.replace(/\D/g, "").slice(0, 3);
        });

        $(".max-3-digit").on("blur", function () {
            if (this.value.length > 3) {
                alert("Only up to 3 digits allowed.");
                $(this).val("").focus();
            }
        });


        $("#SaveLabStation").on("submit", function (e) {
            
            const form = $(this);
            const submitBtn = $("button[type='submit']", form);

            let isValid = true;

            // Validate all ranged fields
            $(".min-max, .decimal-range").each(function () {
                if (!validateRange($(this))) {
                    isValid = false;
                    return false; // break loop
                }
            });

            // Validate Non-HDL: exactly 3 digits
            $(".max-3-digit").each(function () {
                const val = this.value.trim();

                if (val === "") return true; // allow empty if not required

                if (!/^\d{3}$/.test(val)) {
                    alert("Non-HDL Cholesterol must be exactly 3 digits.");
                    $(this).val("").focus();
                    isValid = false;
                    return false; // break loop
                }
            });

            if (!isValid) {
                e.preventDefault(); // stop submit
            }
        });


        $('a.btn-back-confirm').on('click', async function (e) {
            e.preventDefault();

            const url = $(this).attr('href');

            const confirmed = await showYesNoModal(
                "Are you sure you want to go back to main screen without saving changes?"
            );

            if (!confirmed) {
                return;
            }

            window.location.href = url;
        });

        function toggleG6pdReason() {
            var status = $('#G6pdNeeded').val();
            var reason = $('#G6pdReason');

            if (status === 'Not Completed') {
                $('#g6pdReasonContainer').show();

                // HTML5 required → browser will focus automatically on Save
                reason.prop('required', true);

            } else {
                $('#g6pdReasonContainer').hide();

                reason.prop('required', false);
                reason.val('');
            }
        }

        function toggleAboFields() {
            var status = $('#AboNeeded').val();

            var reason = $('#AboReason');
            var grouping = $('#AboGrouping');
            var rh = $('#AboRhFactor');

            // Reset all
            $('#aboReasonContainer').hide();
            $('#aboGroupingContainer').hide();
            $('#aboRhContainer').hide();

            reason.prop('required', false);

            if (status === 'Not Completed') {
                $('#aboReasonContainer').show();
                reason.prop('required', true);
            }

            if (status === 'Completed') {
                $('#aboGroupingContainer').show();
                $('#aboRhContainer').show();
            }
        }

        function toggleLipidPanel() {
            var status = $('#LipidPanelNeeded').val();
            var rapid = $('#LipidPanelRapidTesting').is(':checked');

            var reason = $('#LipidPanelReason');

            // Reset
            $('#lipidReasonContainer').hide();
            $('#lipidRapidContainer').hide();
            $('#lipidValuesContainer').hide();

            reason.prop('required', false);

            if (status === 'Not Completed') {
                $('#lipidReasonContainer').show();
                reason.prop('required', true);
            }

            if (status === 'Completed') {
                $('#lipidRapidContainer').show();

                if (rapid) {
                    $('#lipidValuesContainer').show();
                }
            }
        }

        function toggleHivFields() {
            var status = $('#HivNeeded').val();

            // Reset
            $('#hivReasonContainer').hide();
            $('#hivBarcodeContainer').hide();

            $('#HivReason')
                .prop('required', false);

            $('#HivBarcodeCarebill')
                .prop('required', false);

            if (status === 'Not Completed') {
                $('#hivReasonContainer').show();
                $('#HivReason').prop('required', true);
            }

            if (status === 'Completed') {
                $('#hivBarcodeContainer').show();
                $('#HivBarcodeCarebill').prop('required', true);
            }
        }



        function togglePregnancyTestFields() {
            var status = $('#PregnancyTestNeeded').val();
            var result = $('#PregnancyTestResult');
            var reason = $('#PregnancyTestReason');

            // Hide both initially
            $('#pregnancyResultContainer').hide();
            $('#pregnancyReasonContainer').hide();

            // Remove required from both
            result.prop('required', false);
            reason.prop('required', false);

            if (status === 'Completed') {
                $('#pregnancyResultContainer').show();
                result.prop('required', true); // Make Result required
            }

            if (status === 'Not Completed') {
                $('#pregnancyReasonContainer').show();
                reason.prop('required', true); // Make Reason required
            }
        }

        function updateOverallStatus() {
            var allSelected = true;

            // Array of all visible Needed Status dropdowns
            var dropdowns = [
                '#G6pdNeeded',
                '#AboNeeded',
                '#LipidPanelNeeded',
                '#HivNeeded',
                '#PregnancyTestNeeded'
            ];

            dropdowns.forEach(function (selector) {
                var elem = $(selector);

                // Skip if element not visible
                if (elem.length && elem.is(':visible')) {
                    if (!elem.val()) { // empty value
                        allSelected = false;
                    }
                }
            });

            // Set overall Status dropdown
            if (allSelected) {
                $('#Status').val('Completed');
            } else {
                $('#Status').val('Pending');
            }
        }

        $('#AboNeeded').on('change', toggleAboFields);
        $('#G6pdNeeded').on('change', function () {
            toggleG6pdReason();
        });
        $('#LipidPanelNeeded').on('change', toggleLipidPanel);
        $('#LipidPanelRapidTesting').on('change', toggleLipidPanel);
        $('#HivNeeded').on('change', toggleHivFields);
        $('#PregnancyTestNeeded').on('change', togglePregnancyTestFields);
        $('#G6pdNeeded, #AboNeeded, #LipidPanelNeeded, #HivNeeded, #PregnancyTestNeeded').on('change', updateOverallStatus);

        toggleG6pdReason();
        toggleAboFields();
        toggleLipidPanel();
        toggleHivFields();
        togglePregnancyTestFields();
        @* updateOverallStatus(); *@
    });
</script>


