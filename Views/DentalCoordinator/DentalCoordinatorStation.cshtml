@using ExcelFilesCompiler.Controllers.Services
@using ExcelFilesCompiler.Utilities
@using Malama.Models
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model DentalCoordinatorStationPageViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Treatment Coordinator Station";

    var sm = Model.ServiceMember;
    var questionnaire = Model.Questionnaire;
    var dentalExam = Model.DentalExam ?? new DentalExam { ServiceMembersChildId = sm.Id };
    var xRayStation = Model.XRayStation ?? new DentalXRayStation
    {
        ServiceMembersChildId = sm.Id,
        Status = "Pending",
        PaImages = new List<DentalXRayPaImage>()
    };
    xRayStation.ServiceMembersChild ??= sm;
    var isFemale = DentalXRayStationService.IsFemale(sm);
    var bwxNeeded = DentalXRayStationService.IsNeeded(sm?.BwxNeeded);
    var serviceMemberPanoRequired = DentalXRayStationService.IsNeeded(sm?.PanoNeeded);
    var vitalStationDto = ViewBag.VitalStation as VitalStationDto ?? new VitalStationDto
    {
        ServiceMembersChildId = sm.Id,
        Status = "Pending"
    };
    var treatmentXRayStatus = DentalCoordinatorTreatmentStatusHelper.ResolveXRayStatus(sm, Model.XRayStation);
    var treatmentDentalExamStatus = DentalCoordinatorTreatmentStatusHelper.ResolveDentalExamStatus(sm, Model.DentalExam);
    var dentalTreatment = Model.DentalTreatment;
    var treatmentCoordinatorDisplayName = ViewBag.TreatmentCoordinatorDisplayName as string ?? string.Empty;
    var treatmentCoordinatorDateTimeDisplay = (dentalTreatment?.TreatmentCoordinatorDateTime ?? DateTime.Now)
        .ToString("MM/dd/yyyy hh:mm tt");
    var treatmentCoordinatorComments = dentalTreatment?.TreatmentCoordinatorComments ?? string.Empty;
    var treatmentCoordinatorOverallStatus = string.IsNullOrWhiteSpace(dentalTreatment?.Status)
        ? AppConstants.Status.Pending
        : dentalTreatment!.Status;

    string TreatmentStatusBadgeClass(string status) => status switch
    {
        AppConstants.Status.Completed => "is-completed",
        DentalCoordinatorTreatmentStatusHelper.NotApplicable => "is-na",
        _ => "is-pending"
    };
}

<style>
    .dco-station {
        --dco-indigo: rgba(80, 90, 201, 1);
        --dco-indigo-soft: rgba(80, 90, 201, 0.12);
        --dco-indigo-mid: rgba(80, 90, 201, 0.22);
        --dco-text: #1f2430;
        --dco-muted: #6b7285;
        --dco-surface: #ffffff;
        --dco-border: rgba(31, 36, 48, 0.08);
        --dco-shadow: 0 10px 28px rgba(21, 24, 33, 0.06);
        --dco-radius: 16px;
    }

    .dco-station .btn-general {
        background: var(--dco-indigo);
        border: 1px solid var(--dco-indigo);
        color: #fff;
        border-radius: 10px;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .dco-station .btn-general:hover:not(:disabled) {
        background: rgb(60, 70, 180);
        border-color: rgb(60, 70, 180);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(80, 90, 201, 0.25);
    }

    .dco-station .btn-back-confirm {
        border-radius: 10px;
        font-weight: 600;
        background: #fff;
        color: #4b5160;
        border: 1px solid rgba(31, 36, 48, 0.14);
    }

    .dco-station .btn-back-confirm:hover {
        background: #f3f4f8;
        color: #1f2430;
        border-color: rgba(31, 36, 48, 0.22);
    }

    .dco-hero {
        margin-bottom: 1.25rem;
        padding: 0.1rem 0.15rem 0.25rem;
    }

    .dco-kicker {
        margin: 0 0 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
