                                    <span class="dco-form-signed-icon" title="Signed" aria-label="Signed">
                                        <i class="fas fa-file-signature" aria-hidden="true"></i>
                                    </span>
                                    <button type="button"
                                            class="dco-form-preview-btn"
                                            title="Preview"
