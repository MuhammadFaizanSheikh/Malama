<script src="~/js/dental-xray-station-uploads.js" asp-append-version="true"></script>
<script src="~/js/dental-psr-tooth-chart.js" asp-append-version="true"></script>
<script>
    const IS_FEMALE = @Json.Serialize(isFemale);
    const BWX_NEEDED = @Json.Serialize(bwxNeeded);
    const XRAY_DOWNLOAD_URL = "/DentalCoordinator/DownloadXRayImage";
    const XRAY_ZOOM_STEP = 25;
    const XRAY_ZOOM_MIN = 50;
    const XRAY_ZOOM_MAX = 300;
    const xrayZoomLevels = {};
    const xrayPreviewUrls = {};
    const xrayPanState = { active: false, viewport: null, startX: 0, startY: 0, scrollLeft: 0, scrollTop: 0 };

    function toggleQuestionnaireDetail(selectEl) {
        const $select = $(selectEl);
        const target = $select.data("detail");
        if (!target) return;
        const $detail = $(target);
        const $textarea = $detail.find("textarea");
        if ($select.val() === "Yes") {
            $detail.show();
            $textarea.prop("required", true);
        } else {
            $detail.hide();
            $textarea.prop("required", false).val("");
        }
    }

    function toggleTobaccoSection() {
        const isYes = $("#UseTobaccoOrVape").val() === "Yes";
        const $section = $("#tobaccoDetailsSection");
        $section.toggle(isYes);
        $section.find(".tobacco-used-select").prop("required", isYes);
        if (!isYes) {
            $section.find(".tobacco-used-select").val("No");
            $section.find(".tobacco-type-detail").hide();
            $section.find(".tobacco-frequency-input").prop("required", false).val("");
        } else {
            $(".tobacco-used-select").each(function () {
                toggleTobaccoTypeDetail(this);
            });
        }
    }

    function toggleTobaccoTypeDetail(selectEl) {
        const $select = $(selectEl);
        const index = $select.data("index");
        const $detail = $("#tobaccoTypeDetail_" + index);
        const $inputs = $detail.find(".tobacco-frequency-input");
        if ($("#UseTobaccoOrVape").val() !== "Yes") {
            $detail.hide();
            $inputs.prop("required", false);
            return;
        }
        if ($select.val() === "Yes") {
            $detail.show();
            $inputs.prop("required", true);
        } else {
            $detail.hide();
            $inputs.prop("required", false).val("");
        }
    }

    function toggleConditionDetail(checkboxEl) {
        const $item = $(checkboxEl).closest(".condition-item");
        const $detail = $item.find(".condition-detail");
        const $textarea = $detail.find("textarea");
        if ($(checkboxEl).is(":checked")) {
            $detail.show();
        } else {
            $detail.hide();
            $textarea.val("");
        }
    }

    function initConditionToggles() {
        $(".condition-checkbox").each(function () {
            toggleConditionDetail(this);
        });
    }

    function initQuestionnaireToggles() {
        $(".dental-q-detail-toggle").each(function () {
            toggleQuestionnaireDetail(this);
        });
        toggleTobaccoSection();
        initConditionToggles();
    }

    function toggleQuestionnaireSectionFromSwitch() {
        const isOn = $("#toggleQuestionnaireSectionSwitch").is(":checked");
        const $section = $("#questionnaireSection");

        if (isOn) {
            $section.slideDown(200);
        } else {
            $section.slideUp(200);
        }

        $("#toggleQuestionnaireSectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleVitalsSectionFromSwitch() {
        const isOn = $("#toggleVitalsSectionSwitch").is(":checked");
        const $section = $("#vitalsSection");

        if (isOn) {
            $section.slideDown(200);
        } else {
            $section.slideUp(200);
        }

        $("#toggleVitalsSectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleXRaySectionFromSwitch() {
        const isOn = $("#toggleXRaySectionSwitch").is(":checked");
        const $section = $("#xrayCoordinatorSection");
        if (isOn) { $section.slideDown(200); } else { $section.slideUp(200); }
        $("#toggleXRaySectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleSectionFromSwitch(switchSelector, sectionSelector) {
        const isOn = $(switchSelector).is(":checked");
        const $section = $(sectionSelector);
        if (isOn) { $section.slideDown(200); } else { $section.slideUp(200); }
        $(switchSelector).attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleSubsequentDiseasesContentFromSwitch() {
        toggleSectionFromSwitch("#toggleSubsequentDiseasesSectionSwitch", "#subsequentDiseasesContent");
    }

    function toggleTreatmentCoordinatorSectionFromSwitch() {
        toggleSectionFromSwitch("#toggleTreatmentCoordinatorSectionSwitch", "#treatmentCoordinatorContent");
    }

    function toggleDentalFindingsSectionFromSwitch() {
        toggleSectionFromSwitch("#toggleDentalFindingsSectionSwitch", "#dentalFindingsContentSection");
    }

    const treatmentCoordinatorDocs = [];

    function formatDocumentSize(bytes) {
        if (!bytes && bytes !== 0) return "";
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
        return (bytes / (1024 * 1024)).toFixed(1) + " MB";
    }

    function isPdfFile(file) {
        if (!file) return false;
        const name = (file.name || "").toLowerCase();
        return file.type === "application/pdf" || name.endsWith(".pdf");
    }

    function renderTreatmentCoordinatorDocs() {
        const $list = $("#treatmentCoordinatorDocsList");
        const $empty = $("#treatmentCoordinatorDocsEmpty");
        $list.empty();

        if (!treatmentCoordinatorDocs.length) {
            $list.hide();
            $empty.show();
            return;
        }

        $empty.hide();
        $list.show();

        treatmentCoordinatorDocs.forEach(function (doc, index) {
            const $item = $('<li class="dco-docs-item"></li>');
            const $meta = $('<div class="dco-docs-item-meta"></div>');
            $meta.append($('<span class="dco-docs-item-name"></span>').text(doc.file.name));
            $meta.append($('<span class="dco-docs-item-size"></span>').text(formatDocumentSize(doc.file.size)));

            const $actions = $('<div class="dco-docs-item-actions"></div>');
            const $preview = $('<button type="button" class="dco-docs-preview-btn" title="Preview" aria-label="Preview document"><i class="fas fa-eye" aria-hidden="true"></i></button>');
            $preview.on("click", function () {
                previewTreatmentCoordinatorDocument(index);
            });
            const $remove = $('<button type="button" class="dco-docs-remove-btn" title="Remove" aria-label="Remove document"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>');
            $remove.on("click", function () {
                removeTreatmentCoordinatorDocument(index);
            });

            $actions.append($preview, $remove);
            $item.append($meta, $actions);
            $list.append($item);
        });
    }

    function addTreatmentCoordinatorDocuments(fileList) {
        const files = Array.from(fileList || []);
        if (!files.length) return;

        const rejected = [];
        files.forEach(function (file) {
            if (!isPdfFile(file)) {
                rejected.push(file.name || "file");
                return;
            }
            const duplicate = treatmentCoordinatorDocs.some(function (doc) {
                return doc.file.name === file.name && doc.file.size === file.size;
            });
            if (duplicate) return;
            treatmentCoordinatorDocs.push({
                id: "doc_" + Date.now() + "_" + Math.random().toString(36).slice(2, 8),
                file: file,
                url: URL.createObjectURL(file)
            });
        });

        renderTreatmentCoordinatorDocs();

        if (rejected.length) {
            Swal.fire("PDF only", "These files were skipped because they are not PDFs:\n" + rejected.join(", "), "warning");
        }
    }

    function removeTreatmentCoordinatorDocument(index) {
        const doc = treatmentCoordinatorDocs[index];
        if (!doc) return;
        if (doc.url) {
            URL.revokeObjectURL(doc.url);
        }
        treatmentCoordinatorDocs.splice(index, 1);
        renderTreatmentCoordinatorDocs();
    }

    function previewTreatmentCoordinatorDocument(index) {
        const doc = treatmentCoordinatorDocs[index];
        if (!doc || !doc.url) return;

        Swal.fire({
            title: doc.file.name,
            width: "80%",
            confirmButtonText: "Close",
            confirmButtonColor: "rgba(80, 90, 201, 1)",
            html:
                '<iframe src="' + doc.url + '" title="PDF preview" ' +
                'style="width:100%;height:70vh;border:1px solid rgba(31,36,48,0.12);border-radius:8px;background:#fff;"></iframe>'
        });
    }

    function initTreatmentCoordinatorDocuments() {
        const $input = $("#treatmentCoordinatorDocumentsInput");
        $("#treatmentCoordinatorUploadBtn").on("click", function () {
            $input.trigger("click");
        });
        $input.on("change", function () {
            addTreatmentCoordinatorDocuments(this.files);
            this.value = "";
        });
        renderTreatmentCoordinatorDocs();
    }

    function togglePsrSectionFromSwitch() {
        toggleSectionFromSwitch("#togglePsrSectionSwitch", "#psrContentSection");
    }

    function toggleDenClassSectionFromSwitch() {
        toggleSectionFromSwitch("#toggleDenClassSectionSwitch", "#denClassContentSection");
    }

    function togglePanoXraySectionFromSwitch() {
        toggleSectionFromSwitch("#togglePanoXraySectionSwitch", "#panoXrayContentSection");
    }

    function toggleSoftTissuesDetail() {
        const isNotWnl = $("input[name='SoftTissuesWnl']:checked").val() === @Json.Serialize(DentalExamPsr.SoftTissuesWnlNo);
        $("#softTissuesConditionSection").toggle(isNotWnl);
        if (!isNotWnl) {
            $("#SoftTissuesConditionDetail").val("");
        }
    }

    function toggleDenClassCommentsRequired() {
        const hasSelection = !!$("input[name='DenClass']:checked").val();
        $("#DenClassReasonComments").prop("required", hasSelection);
        updateTreatmentCoordinatorOverallStatus();
    }

    function isDenClassCompleteForCoordinator() {
        return !!$("input[name='DenClass']:checked").val()
            && !!$("#DenClassReasonComments").val()?.trim();
    }

    function areAllCoordinatorFindingsAppointed() {
        let findings = [];
        let appointments = [];
        try {
            findings = JSON.parse($("#FindingsJson").val() || "[]");
            appointments = JSON.parse($("#AppointmentsJson").val() || "[]");
        } catch (e) {
            return false;
        }

        if (!Array.isArray(findings) || findings.length === 0) {
            return true;
        }

        const assignedKeys = new Set();
        if (Array.isArray(appointments)) {
            appointments.forEach(function (appt) {
                (appt.findingClientKeys || []).forEach(function (key) {
                    if (key) {
                        assignedKeys.add(key);
                    }
                });
            });
        }

        return findings.every(function (finding) {
            const key = (finding.clientKey || "").toString().trim();
            return key && assignedKeys.has(key);
        });
    }

    function updateTreatmentCoordinatorOverallStatus() {
        const status = isDenClassCompleteForCoordinator() && areAllCoordinatorFindingsAppointed()
            ? "Completed"
            : "Pending";

        $("#TreatmentCoordinatorOverallStatus").val(status);
        $("#TreatmentCoordinatorOverallStatusHidden").val(status);
    }

    window.updateTreatmentCoordinatorOverallStatus = updateTreatmentCoordinatorOverallStatus;

    function updatePsrTobaccoDisplay() {
        const $display = $("#psrTobaccoDisplay");
        if ($display.length) {
            $display.text(@Json.Serialize(DentalExamTobaccoDisplayHelper.FormatFromQuestionnaire(questionnaire)));
        }
    }

    function setXRayZoom(prefix, level) {
        const previewImg = document.getElementById(prefix + "_previewImg");
        const zoomLabel = document.getElementById(prefix + "_zoomLevel");
        if (!previewImg || !zoomLabel) return;
        const clamped = Math.max(XRAY_ZOOM_MIN, Math.min(XRAY_ZOOM_MAX, level));
        xrayZoomLevels[prefix] = clamped;
        previewImg.style.width = clamped + "%";
        previewImg.style.height = "auto";
        previewImg.style.transform = "";
        zoomLabel.textContent = clamped + "%";
    }

    function updateXRayPanAvailability(prefix) {
        const viewport = document.getElementById(prefix + "_previewViewport");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (!viewport) return;
        const canPan = !!previewImg?.src &&
            (viewport.scrollWidth > viewport.clientWidth + 1 || viewport.scrollHeight > viewport.clientHeight + 1);
        viewport.classList.toggle("can-pan", canPan);
    }

    function clearXrayPreviewInstance(prefix) {
        const previewSection = document.getElementById(prefix + "_previewSection");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (previewImg) { previewImg.removeAttribute("src"); }
        if (previewSection) { previewSection.style.display = "none"; }
        xrayPreviewUrls[prefix] = "";
        $("#" + prefix + "_fileNameDisplay").text("");
        $("#" + prefix + "_emptyMsg").show();
    }

    function showXrayPreviewInstance(prefix, downloadPrefix, fileName, label) {
        const previewSection = document.getElementById(prefix + "_previewSection");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (!previewSection || !previewImg || !fileName || !downloadPrefix) {
            clearXrayPreviewInstance(prefix);
            return;
        }
        const src = XRAY_DOWNLOAD_URL + "?prefix=" + encodeURIComponent(downloadPrefix) + "&fileName=" + encodeURIComponent(fileName);
        xrayPreviewUrls[prefix] = src;
        $("#" + prefix + "_fileNameDisplay").text(label || fileName);
        previewImg.onload = function () {
            setXRayZoom(prefix, 100);
            updateXRayPanAvailability(prefix);
        };
        previewImg.onerror = function () { clearXrayPreviewInstance(prefix); };
        previewImg.src = src;
        previewSection.style.display = "block";
        $("#" + prefix + "_emptyMsg").hide();
    }

    function initXrayPreviewWidgets() {
        $(document).on("change", ".xray-preview-type-radio", function () {
            const prefix = $(this).closest(".xray-preview-widget").data("prefix");
            if (!prefix) return;
            const isBwx = this.value === "BWX";
            $("#" + prefix + "_bwxSelectWrap").toggle(isBwx);
            $("#" + prefix + "_paSelectWrap").toggle(!isBwx);
            const bwxSel = document.getElementById(prefix + "_bwxSelect");
            const paSel = document.getElementById(prefix + "_paSelect");
            if (bwxSel) bwxSel.value = "";
            if (paSel) paSel.value = "";
            clearXrayPreviewInstance(prefix);
        });

        $(document).on("change", ".xray-preview-image-select", function () {
            const prefix = $(this).closest(".xray-preview-widget").data("prefix");
            if (!prefix) return;
            const opt = this.options[this.selectedIndex];
            const fileName = opt ? opt.getAttribute("data-filename") : null;
            const downloadPrefix = opt ? opt.getAttribute("data-prefix") : null;
            const label = opt ? opt.text : null;
            if (fileName && downloadPrefix) {
                showXrayPreviewInstance(prefix, downloadPrefix, fileName, label);
            } else {
                clearXrayPreviewInstance(prefix);
            }
        });

        $(document).on("click", ".xray-preview-open-btn", function () {
            const prefix = $(this).closest(".xray-preview-widget").data("prefix");
            if (prefix && xrayPreviewUrls[prefix]) {
                window.open(xrayPreviewUrls[prefix], "_blank");
            }
        });
    }

    $(document).ready(function () {
        initQuestionnaireToggles();
        toggleSoftTissuesDetail();
        toggleDenClassCommentsRequired();
        updateTreatmentCoordinatorOverallStatus();
        updatePsrTobaccoDisplay();

        if (window.DentalPsrToothChart) {
            DentalPsrToothChart.init({
                chartSelector: "#psrInteractiveToothChart",
                editable: true,
                isToothBlocked: function (toothNumber) {
                    const tooth = parseInt(toothNumber, 10);
                    if (isNaN(tooth) || typeof window.getDentalFindingUsedPermanentTeeth !== "function") {
                        return false;
                    }
                    const used = window.getDentalFindingUsedPermanentTeeth() || [];
                    return used.indexOf(tooth) >= 0;
                },
                onBlocked: function (toothNumber) {
                    Swal.fire(
                        "Cannot select missing tooth",
                        "Tooth " + toothNumber + " is already used in a Dental Finding.",
                        "warning"
                    );
                },
                onSelectionChanged: function (toothNumber, selected) {
                    const tooth = String(toothNumber);
                    const $chart = $("#findingReadonlyToothChart");
                    if ($chart.length) {
                        const $input = $("#findingToothCheck_" + tooth);
                        const $btn = $chart.find('.psr-tooth-image-btn[data-tooth="' + tooth + '"]');
                        const $img = $btn.find(".psr-tooth-img");
                        $input.prop("checked", !!selected);
                        $btn.attr("aria-pressed", selected ? "true" : "false");
                        if ($img.length) {
                            $img.attr("src", selected ? $img.attr("data-selected") : $img.attr("data-normal"));
                        }
                    }
                    if (typeof window.refreshDentalFindingToothOptions === "function") {
                        window.refreshDentalFindingToothOptions();
                    }
                }
            });

            $("#psrInteractiveToothChart .psr-tooth-input").each(function () {
                const tooth = $(this).attr("data-tooth");
                const selected = $(this).is(":checked");
                const $btn = $("#findingReadonlyToothChart").find('.psr-tooth-image-btn[data-tooth="' + tooth + '"]');
                const $img = $btn.find(".psr-tooth-img");
                $("#findingToothCheck_" + tooth).prop("checked", selected);
                $btn.attr("aria-pressed", selected ? "true" : "false");
                if ($img.length) {
                    $img.attr("src", selected ? $img.attr("data-selected") : $img.attr("data-normal"));
                }
            });
            if (typeof window.refreshDentalFindingToothOptions === "function") {
                window.refreshDentalFindingToothOptions();
            }
        }

        initXrayPreviewWidgets();
        initTreatmentCoordinatorDocuments();

        $("#toggleQuestionnaireSectionSwitch").on("change", toggleQuestionnaireSectionFromSwitch);
        $("#toggleVitalsSectionSwitch").on("change", toggleVitalsSectionFromSwitch);
        $("#toggleXRaySectionSwitch").on("change", toggleXRaySectionFromSwitch);
        $("#toggleSubsequentDiseasesSectionSwitch").on("change", toggleSubsequentDiseasesContentFromSwitch);
        $("#toggleTreatmentCoordinatorSectionSwitch").on("change", toggleTreatmentCoordinatorSectionFromSwitch);
        $("#toggleDentalFindingsSectionSwitch").on("change", toggleDentalFindingsSectionFromSwitch);
        $("#togglePsrSectionSwitch").on("change", togglePsrSectionFromSwitch);
        $("#toggleDenClassSectionSwitch").on("change", toggleDenClassSectionFromSwitch);
        $("#togglePanoXraySectionSwitch").on("change", togglePanoXraySectionFromSwitch);

        $(document).on("change", "input[name='SoftTissuesWnl']", toggleSoftTissuesDetail);
        $(document).on("change", "input.den-class-radio, input[name='DenClass']", toggleDenClassCommentsRequired);
        $(document).on("input change", "#DenClassReasonComments", updateTreatmentCoordinatorOverallStatus);
        $(document).on("dentalFindingsChanged tcAppointmentsChanged", updateTreatmentCoordinatorOverallStatus);

        $(document).on("click", ".section-collapse-btn", function () {
            const switchId = $(this).data("target-switch");
            if (!switchId) return;
            const $switch = $("#" + switchId);
            if ($switch.length && $switch.is(":checked")) {
                $switch.prop("checked", false).trigger("change");
            }
        });

        $(".dental-q-detail-toggle").on("change", function () {
            toggleQuestionnaireDetail(this);
        });
        $("#UseTobaccoOrVape").on("change", toggleTobaccoSection);
        $(document).on("change", ".tobacco-used-select", function () {
            toggleTobaccoTypeDetail(this);
        });
        $(document).on("change", ".condition-checkbox", function () {
            toggleConditionDetail(this);
        });

        $(document).on("click", ".xray-zoom-in", function () {
            const prefix = $(this).data("prefix");
            setXRayZoom(prefix, (xrayZoomLevels[prefix] || 100) + XRAY_ZOOM_STEP);
            updateXRayPanAvailability(prefix);
        });
        $(document).on("click", ".xray-zoom-out", function () {
            const prefix = $(this).data("prefix");
            setXRayZoom(prefix, (xrayZoomLevels[prefix] || 100) - XRAY_ZOOM_STEP);
            updateXRayPanAvailability(prefix);
        });
        $(document).on("click", ".xray-zoom-reset", function () {
            setXRayZoom($(this).data("prefix"), 100);
            updateXRayPanAvailability($(this).data("prefix"));
        });

        window.DentalXRayStationConfig = {
            downloadImageUrl: "/DentalCoordinator/DownloadXRayImage",
            formSelector: "#SaveDentalCoordinatorStation",
            isFemale: IS_FEMALE,
            bwxNeeded: BWX_NEEDED,
            paCardIndex: @(ViewBag.DentalXRayFormPaCardCount ?? 1),
            initialBwxReason: @Html.Raw(Json.Serialize(ViewBag.DentalXRayFormBwxReason as string ?? xRayStation.BwxReason ?? "")),
            initialPaReason: @Html.Raw(Json.Serialize(ViewBag.DentalXRayFormPaReason as string ?? xRayStation.PaReason ?? "")),
            enableGoToVitalStation: false
        };
        DentalXRayStationUploads.init(window.DentalXRayStationConfig);

        $('a.btn-back-confirm').on('click', async function (e) {
            e.preventDefault();
            const href = $(this).attr('href');
            const result = await Swal.fire({
                title: 'Leave without saving?',
                text: 'Unsaved changes will be lost.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Leave',
                cancelButtonText: 'Stay'
            });
            if (result.isConfirmed) {
                window.location.href = href;
            }
        });
    });
</script>
