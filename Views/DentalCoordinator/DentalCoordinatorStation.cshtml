@using ExcelFilesCompiler.Controllers.Services
@using ExcelFilesCompiler.Utilities
@using Malama.Models
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model DentalCoordinatorStationPageViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dental Coordinator Station";

    var sm = Model.ServiceMember;
    var questionnaire = Model.Questionnaire;
    var dentalExam = Model.DentalExam ?? new DentalExam { ServiceMembersChildId = sm.Id };
    var xRayStation = Model.XRayStation ?? new DentalXRayStation
    {
        ServiceMembersChildId = sm.Id,
        Status = "Pending",
        PaImages = new List<DentalXRayPaImage>()
    };
    xRayStation.ServiceMembersChild ??= sm;
    var isFemale = DentalXRayStationService.IsFemale(sm);
    var bwxNeeded = DentalXRayStationService.IsNeeded(sm?.BwxNeeded);
    var serviceMemberPanoRequired = DentalXRayStationService.IsNeeded(sm?.PanoNeeded);
    var vitalStationDto = ViewBag.VitalStation as VitalStationDto ?? new VitalStationDto
    {
        ServiceMembersChildId = sm.Id,
        Status = "Pending"
    };
}

<style>
    .dco-station {
        --dco-indigo: rgba(80, 90, 201, 1);
        --dco-indigo-soft: rgba(80, 90, 201, 0.12);
        --dco-indigo-mid: rgba(80, 90, 201, 0.22);
        --dco-text: #1f2430;
        --dco-muted: #6b7285;
        --dco-surface: #ffffff;
        --dco-border: rgba(31, 36, 48, 0.08);
        --dco-shadow: 0 10px 28px rgba(21, 24, 33, 0.06);
        --dco-radius: 16px;
    }

    .dco-station .btn-general {
        background: var(--dco-indigo);
        border: 1px solid var(--dco-indigo);
        color: #fff;
        border-radius: 10px;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .dco-station .btn-general:hover:not(:disabled) {
        background: rgb(60, 70, 180);
        border-color: rgb(60, 70, 180);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(80, 90, 201, 0.25);
    }

    .dco-station .btn-back-confirm {
        border-radius: 10px;
        font-weight: 600;
        background: #fff;
        color: #4b5160;
        border: 1px solid rgba(31, 36, 48, 0.14);
    }

    .dco-station .btn-back-confirm:hover {
        background: #f3f4f8;
        color: #1f2430;
        border-color: rgba(31, 36, 48, 0.22);
    }

    .dco-hero {
        margin-bottom: 1.25rem;
        padding: 0.1rem 0.15rem 0.25rem;
    }

    .dco-kicker {
        margin: 0 0 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--dco-indigo);
    }

    .dco-title {
        margin: 0;
        font-size: clamp(1.55rem, 2.2vw, 2rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--dco-text);
    }

    .dco-subtitle {
        margin: 0.4rem 0 0;
        color: var(--dco-muted);
        font-size: 0.95rem;
    }

    .dco-panel {
        background: var(--dco-surface);
        border: 1px solid var(--dco-border);
        border-radius: var(--dco-radius);
        box-shadow: var(--dco-shadow);
        padding: 1.25rem 1.35rem;
        margin-bottom: 1.1rem;
    }

    .dco-panel-title {
        margin: 0 0 1rem;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--dco-indigo);
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .dco-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem 1.25rem;
    }

    .dco-info-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--dco-muted);
        margin-bottom: 0.2rem;
    }

    .dco-info-value {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--dco-text);
    }

    .questionnaire-heading {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .questionnaire-heading h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--dco-indigo);
    }

    .questionnaire-toggle-switch .form-check-input {
        width: 2.75rem;
        height: 1.4rem;
        margin-top: 0;
        cursor: pointer;
    }

    .questionnaire-toggle-switch .form-check-input:checked {
        background-color: var(--dco-indigo);
        border-color: var(--dco-indigo);
    }

    .questionnaire-toggle-switch .form-check-input:focus {
        border-color: rgba(80, 90, 201, 0.5);
        box-shadow: 0 0 0 0.25rem rgba(80, 90, 201, 0.25);
    }

    .condition-detail { display: none; }
    .condition-item { margin-bottom: 0.75rem; }

    .dco-notice {
        margin: 0 0 0.75rem;
        padding: 0.75rem 0.9rem;
        border-radius: 10px;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.35);
        color: #92400e;
        font-weight: 600;
    }

    .dco-footer-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.5rem;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 768px) {
        .dco-info-grid {
            grid-template-columns: 1fr;
        }
    }

    .dco-station .dxr-panel-title,
    .dco-station .xray-section-title {
        margin: 0 0 1rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--dco-text);
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .dco-station .dxr-panel-title i,
    .dco-station .xray-section-title i {
        color: var(--dco-indigo);
    }

    .dco-station .xray-clinical-panel {
        background: transparent;
        border: none;
        box-shadow: none;
        padding: 0;
        margin: 0;
    }

    .dco-station .card,
    .dco-station .xray-upload-card {
        border: 1px solid var(--dco-border) !important;
        border-radius: 14px !important;
        box-shadow: var(--dco-shadow);
        background: var(--dco-surface);
        overflow: hidden;
    }

    .dco-station .xray-upload-card .card-body {
        padding: 1rem 1.05rem 1.1rem;
    }

    .dco-station .xray-upload-card .card-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--dco-text);
        margin-bottom: 0.75rem;
    }

    .dco-station .open-xray-picker,
    .dco-station .xray-zoom-in,
    .dco-station .xray-zoom-out {
        background: var(--dco-indigo) !important;
        border-color: var(--dco-indigo) !important;
        color: #fff !important;
        border-radius: 8px;
        font-weight: 600;
    }

    .dco-station .preview-xray-file,
    .dco-station .xray-zoom-reset,
    .dco-station #addPaCardBtn {
        border-radius: 8px;
        font-weight: 600;
        border-color: var(--dco-indigo-mid);
        color: var(--dco-indigo);
    }

    .dco-station .xray-file-status {
        padding: 0.55rem 0.7rem;
        border-radius: 10px;
        background: #f7f8fc;
        border: 1px solid var(--dco-border);
    }

    .dxr-notice {
        margin: 0 0 1rem;
        padding: 0.85rem 1rem;
        border-radius: 12px;
        background: var(--dco-indigo-soft);
        border: 1px solid var(--dco-indigo-mid);
        color: var(--dco-indigo);
        font-weight: 700;
    }

    .xray-cards-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    @@media (max-width: 992px) {
        .xray-cards-row { grid-template-columns: 1fr; }
    }

    .xray-upload-full-width { width: 100%; }
    .xray-preview-viewport-full { height: 360px; }
    .bwx-upload-mode-option { margin-bottom: 0.65rem; }

    .xray-preview-viewport {
        width: 100%;
        height: 280px;
        overflow: auto;
        border: 1px solid rgba(31, 36, 48, 0.1);
        border-radius: 12px;
        background:
            linear-gradient(45deg, #eef0f5 25%, transparent 25%),
            linear-gradient(-45deg, #eef0f5 25%, transparent 25%),
            linear-gradient(45deg, transparent 75%, #eef0f5 75%),
            linear-gradient(-45deg, transparent 75%, #eef0f5 75%);
        background-size: 20px 20px;
        background-position: 0 0, 0 10px, 10px -10px, -10px 0;
        background-color: #f4f6fa;
    }

    .xray-preview-viewport.can-pan { cursor: grab; }
    .xray-preview-viewport.can-pan.is-panning {
        cursor: grabbing;
        user-select: none;
    }

    .xray-preview-viewport img {
        display: block;
        width: 100%;
        height: auto;
        max-width: none;
        transform-origin: top left;
        -webkit-user-drag: none;
        user-select: none;
    }

    .read-only-style {
        background-color: #f3f5fa !important;
        pointer-events: none;
        border-color: rgba(31, 36, 48, 0.1) !important;
    }
</style>

<link rel="stylesheet" href="~/css/dental-psr-tooth-chart.css" asp-append-version="true" />

<section class="dco-station">
    <div class="dco-hero">
        <h1 class="dco-title" id="page-heading">Dental Coordinator Station</h1>
    </div>

    <form id="SaveDentalCoordinatorStation" asp-action="SaveDentalCoordinatorStation" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@xRayStation.Id" />
        <input type="hidden" name="ServiceMembersChildId" value="@sm.Id" />
        <input type="hidden" name="SubmissionToken" id="SubmissionToken" value="@Guid.NewGuid()" />

        <div class="dco-panel">
            <h2 class="dco-panel-title"><i class="fas fa-user" aria-hidden="true"></i> Personal Information</h2>
            <div class="dco-info-grid">
                <div>
                    <span class="dco-info-label">Full Name</span>
                    <p class="dco-info-value">@sm?.FullName</p>
                </div>
                <div>
                    <span class="dco-info-label">DOD ID</span>
                    <p class="dco-info-value">@sm?.DodId</p>
                </div>
                <div>
                    <span class="dco-info-label">Routing Sheet Barcode</span>
                    <p class="dco-info-value">@sm?.Barcode</p>
                </div>
                <div>
                    <span class="dco-info-label">DOB</span>
                    <p class="dco-info-value">@sm?.Dob</p>
                </div>
                <div>
                    <span class="dco-info-label">Age</span>
                    <p class="dco-info-value">@sm?.Age</p>
                </div>
                <div>
                    <span class="dco-info-label">Sex</span>
                    <p class="dco-info-value">@sm?.Sex</p>
                </div>
                <div>
                    <span class="dco-info-label">DRC</span>
                    <p class="dco-info-value">@sm?.Drc</p>
                </div>
            </div>
        </div>

        <div class="dco-panel">
            <div class="questionnaire-heading" id="questionnaireHeading">
                <div class="form-check form-switch questionnaire-toggle-switch mb-0">
                    <input class="form-check-input"
                           type="checkbox"
                           role="switch"
                           id="toggleQuestionnaireSectionSwitch"
                           aria-controls="questionnaireSection"
                           aria-expanded="false" />
                </div>
                <h3>Questionnaire</h3>
            </div>

            <div id="questionnaireSection" style="display:none;">
                @await Html.PartialAsync("~/Views/DentalXRay/_DentalXRayQuestionnaire.cshtml", questionnaire)

                @if (isFemale)
                {
                    <div class="row mb-3" id="pregnancyQuestionSection">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">12. Are you pregnant?</label>
                            <select name="AreYouPregnant" id="AreYouPregnant" class="form-select" required>
                                <option value="No" selected="@(string.IsNullOrWhiteSpace(questionnaire.AreYouPregnant) || questionnaire.AreYouPregnant == "No")">No</option>
                                <option value="Yes" selected="@(questionnaire.AreYouPregnant == "Yes")">Yes</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-4" id="pregnancyApprovalSection" style="display:none;">
                        <div class="col-md-12">
                            <p class="dco-notice">Approval is needed from Service Member before going to X-Ray</p>
                            <select name="PregnancyApproval" id="PregnancyApproval" class="form-select">
                                <option value=""></option>
                                <option value="Approved" selected="@(questionnaire.PregnancyApproval == "Approved")">Approved</option>
                                <option value="Declined" selected="@(questionnaire.PregnancyApproval == "Declined")">Declined</option>
                            </select>
                        </div>
                    </div>
                }

                @{
                    var healthConditionsQuestionNumber = isFemale ? 13 : 12;
                    var savedHealthConditions = DentalQuestionnaireService.ParseHealthConditionsJson(questionnaire.ApplicableHealthConditionsJson);
                    var savedByCondition = savedHealthConditions
                        .Where(h => !string.IsNullOrWhiteSpace(h.Condition))
                        .ToDictionary(h => h.Condition, h => h, StringComparer.OrdinalIgnoreCase);

                    bool IsConditionSelected(string condition) => savedByCondition.ContainsKey(condition);
                    string GetConditionDetail(string condition) =>
                        savedByCondition.TryGetValue(condition, out var item) ? item.Detail ?? "" : "";
                }
                <div class="mb-2">
                    <label class="form-label fw-semibold">@healthConditionsQuestionNumber. Check the following conditions if they apply to you:</label>
                    <div class="row condition-checkboxes">
                        @for (var ci = 0; ci < DentalXRayQuestionnaire.HealthConditions.Length; ci++)
                        {
                            var condition = DentalXRayQuestionnaire.HealthConditions[ci];
                            var isSelected = IsConditionSelected(condition);
                            var detail = GetConditionDetail(condition);
                            <div class="col-md-6 condition-item">
                                <input type="hidden" name="HealthConditionDetails[@ci].Condition" value="@condition" />
                                <div class="form-check">
                                    <input class="form-check-input condition-checkbox" type="checkbox"
                                           name="ApplicableHealthConditions"
                                           value="@condition"
                                           id="condition_@ci"
                                           checked="@isSelected" />
                                    <label class="form-check-label" for="condition_@ci">@condition</label>
                                </div>
                                <div class="condition-detail ms-4 mt-1">
                                    <textarea name="HealthConditionDetails[@ci].Detail"
                                              class="form-control condition-detail-text"
                                              rows="3"
                                              placeholder="Please provide details">@detail</textarea>
                                </div>
                            </div>
                        }
                        @{
                            var otherIndex = DentalXRayQuestionnaire.HealthConditions.Length;
                            var otherCondition = DentalXRayQuestionnaire.OtherHealthCondition;
                            var otherSelected = IsConditionSelected(otherCondition);
                            var otherDetail = GetConditionDetail(otherCondition);
                        }
                        <div class="col-md-6 condition-item">
                            <input type="hidden" name="HealthConditionDetails[@otherIndex].Condition" value="@otherCondition" />
                            <div class="form-check">
                                <input class="form-check-input condition-checkbox" type="checkbox"
                                       name="ApplicableHealthConditions"
                                       value="@otherCondition"
                                       id="condition_other"
                                       checked="@otherSelected" />
                                <label class="form-check-label" for="condition_other">@otherCondition</label>
                            </div>
                            <div class="condition-detail ms-4 mt-1">
                                <textarea name="HealthConditionDetails[@otherIndex].Detail"
                                          class="form-control condition-detail-text"
                                          rows="3"
                                          placeholder="Please provide details">@otherDetail</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dco-panel">
            <div class="questionnaire-heading" id="vitalsHeading">
                <div class="form-check form-switch questionnaire-toggle-switch mb-0">
                    <input class="form-check-input"
                           type="checkbox"
                           role="switch"
                           id="toggleVitalsSectionSwitch"
                           aria-controls="vitalsSection"
                           aria-expanded="false" />
                </div>
                <h3>Blood Pressure (Vitals)</h3>
            </div>

            <div id="vitalsSection" style="display:none;">
                @{
                    var vitalBpViewData = new ViewDataDictionary<VitalStationDto>(ViewData, vitalStationDto);
                    vitalBpViewData["ShowVitalRedirect"] = false;
                    vitalBpViewData["AllowVitalStationSubmit"] = false;
                    vitalBpViewData["BpCountdownIdPrefix"] = "dentalCoordinatorBpCountdown";
                    vitalBpViewData["VitalRecommendationContext"] = "dental coordinator";
                    vitalBpViewData["HideSectionHeading"] = true;
                }
                @await Html.PartialAsync("_VitalStationBpSummary", vitalStationDto, vitalBpViewData)
                <div class="d-flex justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm section-collapse-btn"
                            data-target-switch="toggleVitalsSectionSwitch"
                            data-target-heading="vitalsHeading">
                        <i class="fas fa-chevron-up"></i> Collapse Blood Pressure (Vitals)
                    </button>
                </div>
            </div>
        </div>

        <div class="dco-panel">
            <div class="questionnaire-heading" id="xrayHeading">
                <div class="form-check form-switch questionnaire-toggle-switch mb-0">
                    <input class="form-check-input"
                           type="checkbox"
                           role="switch"
                           id="toggleXRaySectionSwitch"
                           aria-controls="xrayCoordinatorSection"
                           aria-expanded="false" />
                </div>
                <h3>X-Ray</h3>
            </div>

            <div id="xrayCoordinatorSection" style="display:none;">
                @{
                    var xrayFormViewData = new ViewDataDictionary<DentalXRayStation>(ViewData, xRayStation)
                    {
                        ["ShowPanoRequirementNotice"] = false
                    };
                }
                @await Html.PartialAsync("~/Views/DentalXRay/_DentalXRayStationForm.cshtml", xRayStation, xrayFormViewData)
                <div class="d-flex justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm section-collapse-btn"
                            data-target-switch="toggleXRaySectionSwitch"
                            data-target-heading="xrayHeading">
                        <i class="fas fa-chevron-up"></i> Collapse X-Ray
                    </button>
                </div>
            </div>
        </div>

        <input type="hidden" name="DentalExamId" value="@dentalExam.Id" />

        <div class="dco-panel" id="subsequentDiseasesSection" data-subsequent-readonly="false">
            <div class="questionnaire-heading" id="subsequentDiseasesHeading">
                <div class="form-check form-switch questionnaire-toggle-switch mb-0">
                    <input class="form-check-input"
                           type="checkbox"
                           role="switch"
                           id="toggleSubsequentDiseasesSectionSwitch"
                           aria-controls="subsequentDiseasesContent"
                           aria-expanded="false" />
                </div>
                <h3 class="mb-0">Subsequent diseases and abnormalities</h3>
            </div>

            <div id="subsequentDiseasesContent" style="display:none;">
                @{
                    var psrViewData = new ViewDataDictionary<DentalExam>(ViewData, dentalExam);
                    psrViewData["TobaccoDisplay"] = DentalExamTobaccoDisplayHelper.FormatFromQuestionnaire(questionnaire);
                    psrViewData["RequirePsrFields"] = false;
                    psrViewData["XRayStation"] = xRayStation;
                    psrViewData["SubsequentReadOnly"] = false;
                }
                @await Html.PartialAsync("~/Views/DentalExams/_DentalExamPsrSection.cshtml", dentalExam, psrViewData)

                @{
                    var denClassViewData = new ViewDataDictionary<DentalExam>(ViewData, dentalExam);
                    denClassViewData["ServiceMemberPanoRequired"] = serviceMemberPanoRequired;
                    denClassViewData["SubsequentReadOnly"] = false;
                }
                @await Html.PartialAsync("~/Views/DentalExams/_DentalExamDenClassSection.cshtml", dentalExam, denClassViewData)

                <div class="d-flex justify-content-center mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm section-collapse-btn"
                            data-target-switch="toggleSubsequentDiseasesSectionSwitch"
                            data-target-heading="subsequentDiseasesHeading">
                        <i class="fas fa-chevron-up"></i> Collapse Subsequent diseases and abnormalities
                    </button>
                </div>
            </div>
        </div>

        <div class="dco-footer-actions">
            <button type="submit" class="btn btn-general btn-lg">
                <i class="fas fa-check-circle" aria-hidden="true"></i> Save
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg btn-back-confirm">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Back
            </a>
        </div>
    </form>
</section>

<script src="~/js/dental-xray-station-uploads.js" asp-append-version="true"></script>
<script src="~/js/dental-psr-tooth-chart.js" asp-append-version="true"></script>
<script>
    const IS_FEMALE = @Json.Serialize(isFemale);
    const BWX_NEEDED = @Json.Serialize(bwxNeeded);
    const XRAY_DOWNLOAD_URL = "/DentalCoordinator/DownloadXRayImage";
    const XRAY_ZOOM_STEP = 25;
    const XRAY_ZOOM_MIN = 50;
    const XRAY_ZOOM_MAX = 300;
    const xrayZoomLevels = {};
    const xrayPreviewUrls = {};
    const xrayPanState = { active: false, viewport: null, startX: 0, startY: 0, scrollLeft: 0, scrollTop: 0 };

    function toggleQuestionnaireDetail(selectEl) {
        const $select = $(selectEl);
        const target = $select.data("detail");
        if (!target) return;
        const $detail = $(target);
        const $textarea = $detail.find("textarea");
        if ($select.val() === "Yes") {
            $detail.show();
            $textarea.prop("required", true);
        } else {
            $detail.hide();
            $textarea.prop("required", false).val("");
        }
    }

    function toggleTobaccoSection() {
        const isYes = $("#UseTobaccoOrVape").val() === "Yes";
        const $section = $("#tobaccoDetailsSection");
        $section.toggle(isYes);
        $section.find(".tobacco-used-select").prop("required", isYes);
        if (!isYes) {
            $section.find(".tobacco-used-select").val("No");
            $section.find(".tobacco-type-detail").hide();
            $section.find(".tobacco-frequency-input").prop("required", false).val("");
        } else {
            $(".tobacco-used-select").each(function () {
                toggleTobaccoTypeDetail(this);
            });
        }
    }

    function toggleTobaccoTypeDetail(selectEl) {
        const $select = $(selectEl);
        const index = $select.data("index");
        const $detail = $("#tobaccoTypeDetail_" + index);
        const $inputs = $detail.find(".tobacco-frequency-input");
        if ($("#UseTobaccoOrVape").val() !== "Yes") {
            $detail.hide();
            $inputs.prop("required", false);
            return;
        }
        if ($select.val() === "Yes") {
            $detail.show();
            $inputs.prop("required", true);
        } else {
            $detail.hide();
            $inputs.prop("required", false).val("");
        }
    }

    function toggleConditionDetail(checkboxEl) {
        const $item = $(checkboxEl).closest(".condition-item");
        const $detail = $item.find(".condition-detail");
        const $textarea = $detail.find("textarea");
        if ($(checkboxEl).is(":checked")) {
            $detail.show();
        } else {
            $detail.hide();
            $textarea.val("");
        }
    }

    function initConditionToggles() {
        $(".condition-checkbox").each(function () {
            toggleConditionDetail(this);
        });
    }

    function initQuestionnaireToggles() {
        $(".dental-q-detail-toggle").each(function () {
            toggleQuestionnaireDetail(this);
        });
        toggleTobaccoSection();
        initConditionToggles();
    }

    function toggleQuestionnaireSectionFromSwitch() {
        const isOn = $("#toggleQuestionnaireSectionSwitch").is(":checked");
        const $section = $("#questionnaireSection");

        if (isOn) {
            $section.slideDown(200);
        } else {
            $section.slideUp(200);
        }

        $("#toggleQuestionnaireSectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleVitalsSectionFromSwitch() {
        const isOn = $("#toggleVitalsSectionSwitch").is(":checked");
        const $section = $("#vitalsSection");

        if (isOn) {
            $section.slideDown(200);
        } else {
            $section.slideUp(200);
        }

        $("#toggleVitalsSectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleXRaySectionFromSwitch() {
        const isOn = $("#toggleXRaySectionSwitch").is(":checked");
        const $section = $("#xrayCoordinatorSection");
        if (isOn) { $section.slideDown(200); } else { $section.slideUp(200); }
        $("#toggleXRaySectionSwitch").attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleSectionFromSwitch(switchSelector, sectionSelector) {
        const isOn = $(switchSelector).is(":checked");
        const $section = $(sectionSelector);
        if (isOn) { $section.slideDown(200); } else { $section.slideUp(200); }
        $(switchSelector).attr("aria-expanded", isOn ? "true" : "false");
    }

    function toggleSubsequentDiseasesContentFromSwitch() {
        toggleSectionFromSwitch("#toggleSubsequentDiseasesSectionSwitch", "#subsequentDiseasesContent");
    }

    function togglePsrSectionFromSwitch() {
        toggleSectionFromSwitch("#togglePsrSectionSwitch", "#psrContentSection");
    }

    function toggleDenClassSectionFromSwitch() {
        toggleSectionFromSwitch("#toggleDenClassSectionSwitch", "#denClassContentSection");
    }

    function togglePanoXraySectionFromSwitch() {
        toggleSectionFromSwitch("#togglePanoXraySectionSwitch", "#panoXrayContentSection");
    }

    function toggleSoftTissuesDetail() {
        const isNotWnl = $("input[name='SoftTissuesWnl']:checked").val() === @Json.Serialize(DentalExamPsr.SoftTissuesWnlNo);
        $("#softTissuesConditionSection").toggle(isNotWnl);
        if (!isNotWnl) {
            $("#SoftTissuesConditionDetail").val("");
        }
    }

    function toggleDenClassCommentsRequired() {
        const hasSelection = !!$("input[name='DenClass']:checked").val();
        $("#DenClassReasonComments").prop("required", hasSelection);
    }

    function updatePsrTobaccoDisplay() {
        const $display = $("#psrTobaccoDisplay");
        if ($display.length) {
            $display.text(@Json.Serialize(DentalExamTobaccoDisplayHelper.FormatFromQuestionnaire(questionnaire)));
        }
    }

    function setXRayZoom(prefix, level) {
        const previewImg = document.getElementById(prefix + "_previewImg");
        const zoomLabel = document.getElementById(prefix + "_zoomLevel");
        if (!previewImg || !zoomLabel) return;
        const clamped = Math.max(XRAY_ZOOM_MIN, Math.min(XRAY_ZOOM_MAX, level));
        xrayZoomLevels[prefix] = clamped;
        previewImg.style.width = clamped + "%";
        previewImg.style.height = "auto";
        previewImg.style.transform = "";
        zoomLabel.textContent = clamped + "%";
    }

    function updateXRayPanAvailability(prefix) {
        const viewport = document.getElementById(prefix + "_previewViewport");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (!viewport) return;
        const canPan = !!previewImg?.src &&
            (viewport.scrollWidth > viewport.clientWidth + 1 || viewport.scrollHeight > viewport.clientHeight + 1);
        viewport.classList.toggle("can-pan", canPan);
    }

    function clearXrayPreviewInstance(prefix) {
        const previewSection = document.getElementById(prefix + "_previewSection");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (previewImg) { previewImg.removeAttribute("src"); }
        if (previewSection) { previewSection.style.display = "none"; }
        xrayPreviewUrls[prefix] = "";
        $("#" + prefix + "_fileNameDisplay").text("");
        $("#" + prefix + "_emptyMsg").show();
    }

    function showXrayPreviewInstance(prefix, downloadPrefix, fileName, label) {
        const previewSection = document.getElementById(prefix + "_previewSection");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (!previewSection || !previewImg || !fileName || !downloadPrefix) {
            clearXrayPreviewInstance(prefix);
            return;
        }
        const src = XRAY_DOWNLOAD_URL + "?prefix=" + encodeURIComponent(downloadPrefix) + "&fileName=" + encodeURIComponent(fileName);
        xrayPreviewUrls[prefix] = src;
        $("#" + prefix + "_fileNameDisplay").text(label || fileName);
        previewImg.onload = function () {
            setXRayZoom(prefix, 100);
            updateXRayPanAvailability(prefix);
        };
        previewImg.onerror = function () { clearXrayPreviewInstance(prefix); };
        previewImg.src = src;
        previewSection.style.display = "block";
        $("#" + prefix + "_emptyMsg").hide();
    }

    function initXrayPreviewWidgets() {
        $(document).on("change", ".xray-preview-type-radio", function () {
            const prefix = $(this).closest(".xray-preview-widget").data("prefix");
            if (!prefix) return;
            const isBwx = this.value === "BWX";
            $("#" + prefix + "_bwxSelectWrap").toggle(isBwx);
            $("#" + prefix + "_paSelectWrap").toggle(!isBwx);
            const bwxSel = document.getElementById(prefix + "_bwxSelect");
            const paSel = document.getElementById(prefix + "_paSelect");
            if (bwxSel) bwxSel.value = "";
            if (paSel) paSel.value = "";
            clearXrayPreviewInstance(prefix);
        });

        $(document).on("change", ".xray-preview-image-select", function () {
            const prefix = $(this).closest(".xray-preview-widget").data("prefix");
            if (!prefix) return;
            const opt = this.options[this.selectedIndex];
            const fileName = opt ? opt.getAttribute("data-filename") : null;
            const downloadPrefix = opt ? opt.getAttribute("data-prefix") : null;
            const label = opt ? opt.text : null;
            if (fileName && downloadPrefix) {
                showXrayPreviewInstance(prefix, downloadPrefix, fileName, label);
            } else {
                clearXrayPreviewInstance(prefix);
            }
        });

        $(document).on("click", ".xray-preview-open-btn", function () {
            const prefix = $(this).closest(".xray-preview-widget").data("prefix");
            if (prefix && xrayPreviewUrls[prefix]) {
                window.open(xrayPreviewUrls[prefix], "_blank");
            }
        });
    }

    $(document).ready(function () {
        initQuestionnaireToggles();
        toggleSoftTissuesDetail();
        toggleDenClassCommentsRequired();
        updatePsrTobaccoDisplay();

        if (window.DentalPsrToothChart) {
            DentalPsrToothChart.init({ chartSelector: "#psrInteractiveToothChart", editable: true });
        }

        initXrayPreviewWidgets();

        $("#toggleQuestionnaireSectionSwitch").on("change", toggleQuestionnaireSectionFromSwitch);
        $("#toggleVitalsSectionSwitch").on("change", toggleVitalsSectionFromSwitch);
        $("#toggleXRaySectionSwitch").on("change", toggleXRaySectionFromSwitch);
        $("#toggleSubsequentDiseasesSectionSwitch").on("change", toggleSubsequentDiseasesContentFromSwitch);
        $("#togglePsrSectionSwitch").on("change", togglePsrSectionFromSwitch);
        $("#toggleDenClassSectionSwitch").on("change", toggleDenClassSectionFromSwitch);
        $("#togglePanoXraySectionSwitch").on("change", togglePanoXraySectionFromSwitch);

        $(document).on("change", "input[name='SoftTissuesWnl']", toggleSoftTissuesDetail);
        $(document).on("change", "input.den-class-radio, input[name='DenClass']", toggleDenClassCommentsRequired);

        $(document).on("click", ".section-collapse-btn", function () {
            const switchId = $(this).data("target-switch");
            if (!switchId) return;
            const $switch = $("#" + switchId);
            if ($switch.length && $switch.is(":checked")) {
                $switch.prop("checked", false).trigger("change");
            }
        });

        $(".dental-q-detail-toggle").on("change", function () {
            toggleQuestionnaireDetail(this);
        });
        $("#UseTobaccoOrVape").on("change", toggleTobaccoSection);
        $(document).on("change", ".tobacco-used-select", function () {
            toggleTobaccoTypeDetail(this);
        });
        $(document).on("change", ".condition-checkbox", function () {
            toggleConditionDetail(this);
        });

        $(document).on("click", ".xray-zoom-in", function () {
            const prefix = $(this).data("prefix");
            setXRayZoom(prefix, (xrayZoomLevels[prefix] || 100) + XRAY_ZOOM_STEP);
            updateXRayPanAvailability(prefix);
        });
        $(document).on("click", ".xray-zoom-out", function () {
            const prefix = $(this).data("prefix");
            setXRayZoom(prefix, (xrayZoomLevels[prefix] || 100) - XRAY_ZOOM_STEP);
            updateXRayPanAvailability(prefix);
        });
        $(document).on("click", ".xray-zoom-reset", function () {
            setXRayZoom($(this).data("prefix"), 100);
            updateXRayPanAvailability($(this).data("prefix"));
        });

        window.DentalXRayStationConfig = {
            downloadImageUrl: "/DentalCoordinator/DownloadXRayImage",
            formSelector: "#SaveDentalCoordinatorStation",
            isFemale: IS_FEMALE,
            bwxNeeded: BWX_NEEDED,
            paCardIndex: @(ViewBag.DentalXRayFormPaCardCount ?? 1),
            initialBwxReason: @Html.Raw(Json.Serialize(ViewBag.DentalXRayFormBwxReason as string ?? xRayStation.BwxReason ?? "")),
            initialPaReason: @Html.Raw(Json.Serialize(ViewBag.DentalXRayFormPaReason as string ?? xRayStation.PaReason ?? "")),
            enableGoToVitalStation: false
        };
        DentalXRayStationUploads.init(window.DentalXRayStationConfig);

        $('a.btn-back-confirm').on('click', async function (e) {
            e.preventDefault();
            const href = $(this).attr('href');
            const result = await Swal.fire({
                title: 'Leave without saving?',
                text: 'Unsaved changes will be lost.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Leave',
                cancelButtonText: 'Stay'
            });
            if (result.isConfirmed) {
                window.location.href = href;
            }
        });
    });
</script>
