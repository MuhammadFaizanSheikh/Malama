<div id="tcAppointmentsSection" aria-label="Treatment coordinator appointments">
    <h4 class="tc-appt-title">Appointments</h4>

    <input type="hidden" name="AppointmentsJson" id="AppointmentsJson" value="[]" />

    <div class="tc-appt-summary" id="tcAppointmentsSummary" aria-live="polite"></div>

    <div class="tc-appt-workspace">
        <div class="tc-appt-list-panel">
            <div class="tc-appt-list-header">
                <h5>Scheduled Appointments</h5>
            </div>
            <div class="tc-appt-table-wrap">
                <table class="table table-striped table-hover align-middle mb-0" id="tcAppointmentsTable">
                    <thead>
                        <tr>
                            <th style="width: 44px;">#</th>
                            <th style="width: 100px;">Dentist</th>
                            <th style="width: 96px;">Date</th>
                            <th style="width: 88px;">Start</th>
                            <th style="width: 88px;">Duration</th>
                            <th>Findings</th>
                            <th style="width: 88px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tcAppointmentsTableBody">
                        <tr id="tcAppointmentsEmptyRow">
                            <td colspan="7" class="text-center py-4 text-muted">No appointments scheduled yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tc-appt-form-panel">
            <div id="tcAppointmentFormCard" class="card h-100">
                <div class="card-header" id="tcAppointmentFormTitle">Add Appointment</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="tcAppointmentDentist">Assign Dentist</label>
                            <select id="tcAppointmentDentist" class="form-select">
                                <option value=""></option>
                                <option value="Dentist 1">Dentist 1</option>
                                <option value="Dentist 2">Dentist 2</option>
                                <option value="Dentist 3">Dentist 3</option>
                                <option value="Dentist 4">Dentist 4</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="tcAppointmentDate">Appointment Date</label>
                            <input type="text"
                                   id="tcAppointmentDate"
                                   class="form-control"
                                   placeholder="MM/DD/YYYY"
                                   autocomplete="off" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="tcAppointmentStartTime">Start Time</label>
                            <input type="text"
                                   id="tcAppointmentStartTime"
                                   class="form-control"
                                   placeholder="hh:mm AM"
                                   autocomplete="off" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="tcAppointmentDuration">Duration</label>
                            <select id="tcAppointmentDuration" class="form-select">
                                <option value=""></option>
                                <option value="15 min">15 min</option>
                                <option value="30 min">30 min</option>
                                <option value="45 min">45 min</option>
                                <option value="1 hr">1 hr</option>
                                <option value="1 hr 15 min">1 hr 15 min</option>
                                <option value="1 hr 30 min">1 hr 30 min</option>
                                <option value="1 hr 45 min">1 hr 45 min</option>
                                <option value="2 hr">2 hr</option>
                                <option value="2 hr 15 min">2 hr 15 min</option>
                                <option value="2 hr 30 min">2 hr 30 min</option>
                                <option value="2 hr 45 min">2 hr 45 min</option>
                                <option value="3 hr">3 hr</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label d-block">Findings for this appointment</label>
                            <div class="tc-appt-findings-picker" id="tcAppointmentFindingsPicker">
                                <p class="tc-appt-findings-empty">Add dental findings above before scheduling appointments.</p>
                            </div>
