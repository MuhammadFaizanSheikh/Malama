                <div class="tc-appt-dentist-col" data-dentist="Dentist 3">
                    <div class="tc-appt-slots"></div>
                    <div class="tc-appt-bookings"></div>
                </div>
                <div class="tc-appt-dentist-col" data-dentist="Dentist 4">
                    <div class="tc-appt-slots"></div>
