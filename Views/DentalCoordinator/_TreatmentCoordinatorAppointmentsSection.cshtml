                    </div>
                    <div class="d-flex justify-content-start gap-2 mt-4">
                        <button type="button" class="btn btn-secondary" id="tcCancelAppointmentBtn">Cancel</button>
                        <button type="button" class="btn btn-general" id="tcSaveAppointmentBtn">
