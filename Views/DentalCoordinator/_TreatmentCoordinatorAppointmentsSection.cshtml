</div>

<script>
    (function () {
        const EVENT_APPOINTMENT_MIN_DATE = @Json.Serialize(eventAppointmentMinDate);
        const EVENT_APPOINTMENT_MAX_DATE = @Json.Serialize(eventAppointmentMaxDate);
        const EVENT_APPOINTMENT_DAY_WINDOWS = @Html.Raw(eventAppointmentDayWindowsJson);
        const SERVICE_MEMBER_DISPLAY_NAME = @Json.Serialize(serviceMemberDisplayName);
        const APPT_SLOT_MINUTES = 15;
        const APPT_SLOT_HEIGHT = 24;
        const APPT_MIN_DURATION_MINUTES = 15;

        let tcAppointments = [];
        let editingAppointmentIndex = null;
        let tcAppointmentDatePicker = null;
        let tcAppointmentStartTimePicker = null;
        let tcCalendarDayPicker = null;
        let calendarDayStartMinutes = 0;
        let calendarDayEndMinutes = 24 * 60;

        const APPT_DURATION_MINUTES = {
            "15 min": 15,
            "30 min": 30,
            "45 min": 45,
            "1 hr": 60,
            "1 hr 15 min": 75,
            "1 hr 30 min": 90,
            "1 hr 45 min": 105,
            "2 hr": 120,
            "2 hr 15 min": 135,
            "2 hr 30 min": 150,
            "2 hr 45 min": 165,
            "3 hr": 180
        };

        function normalizeDayEndMinutes(startMinutes, endMinutes) {
            startMinutes = Number(startMinutes) || 0;
            endMinutes = Number(endMinutes);
            if (!Number.isFinite(endMinutes)) {
                return 24 * 60;
            }

            // 00:00 end with a later start means end-of-day (midnight), not 12:00 AM at day start.
            if (endMinutes === 0 && startMinutes > 0) {
                return 24 * 60;
            }

            if (endMinutes <= startMinutes && startMinutes > 0) {
                return 24 * 60;
            }

            return endMinutes;
        }

        function getEventDayWindow(dateStr) {
            const date = (dateStr || "").toString().trim();
            if (!date || !Array.isArray(EVENT_APPOINTMENT_DAY_WINDOWS)) {
                return null;
            }

            const match = EVENT_APPOINTMENT_DAY_WINDOWS.find(function (dayWindow) {
                const windowDate = (dayWindow.date || dayWindow.Date || "").toString();
                return windowDate === date;
            });

            if (!match) {
                return null;
            }

            return {
                date: date,
                startMinutes: Number(match.startMinutes ?? match.StartMinutes ?? 0),
                endMinutes: normalizeDayEndMinutes(
                    Number(match.startMinutes ?? match.StartMinutes ?? 0),
                    Number(match.endMinutes ?? match.EndMinutes ?? (24 * 60))
                )
            };
        }

        function minutesToFlatpickrTime(totalMinutes) {
            const bounded = Math.max(0, Math.min((24 * 60) - 1, totalMinutes));
            const hour = Math.floor(bounded / 60);
            const minute = bounded % 60;
            return String(hour).padStart(2, "0") + ":" + String(minute).padStart(2, "0");
        }

        function getLatestAllowedStartMinutes(dayWindow) {
            if (!dayWindow) {
                return (24 * 60) - APPT_MIN_DURATION_MINUTES;
            }

            return Math.max(
                dayWindow.startMinutes,
                dayWindow.endMinutes - APPT_MIN_DURATION_MINUTES
            );
        }

        function updateAppointmentStartTimeBounds() {
            if (!tcAppointmentStartTimePicker) {
                return;
            }

            const selectedDate = ($("#tcAppointmentDate").val() || "").toString().trim();
            const dayWindow = getEventDayWindow(selectedDate);

            if (!dayWindow) {
                tcAppointmentStartTimePicker.set("minTime", null);
                tcAppointmentStartTimePicker.set("maxTime", null);
                return;
            }

            const maxStartMinutes = getLatestAllowedStartMinutes(dayWindow);
            tcAppointmentStartTimePicker.set("minTime", minutesToFlatpickrTime(dayWindow.startMinutes));
            tcAppointmentStartTimePicker.set("maxTime", minutesToFlatpickrTime(maxStartMinutes));

            const currentStartMinutes = parseAppointmentStartMinutes($("#tcAppointmentStartTime").val());
            if (currentStartMinutes != null
                && (currentStartMinutes < dayWindow.startMinutes || currentStartMinutes > maxStartMinutes)) {
                tcAppointmentStartTimePicker.clear();
            }
        }

        function generateAppointmentId() {
            if (window.crypto && typeof window.crypto.randomUUID === "function") {
                return window.crypto.randomUUID();
            }
            return "appt-" + Date.now() + "-" + Math.random().toString(36).slice(2, 10);
        }

        function escapeHtml(value) {
            return $("<div>").text(value ?? "").html();
        }

        function formatAppointmentDateForDisplay(value) {
            if (!value) {
                return "-";
            }
            const raw = value.toString();
            if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) {
                const parts = raw.split("-");
                return parts[1] + "/" + parts[2] + "/" + parts[0];
            }
            return raw;
        }

        function parseAppointmentStartMinutes(timeValue) {
            const raw = (timeValue || "").toString().trim();
            if (!raw) {
                return null;
            }

            const twelveHour = raw.match(/^(\d{1,2}):(\d{2})\s*([AaPp][Mm])$/);
            if (twelveHour) {
                let hour = parseInt(twelveHour[1], 10);
                const minute = parseInt(twelveHour[2], 10);
                const meridiem = twelveHour[3].toUpperCase();
                if (hour < 1 || hour > 12 || minute < 0 || minute > 59) {
                    return null;
                }
                if (meridiem === "AM") {
                    if (hour === 12) {
                        hour = 0;
                    }
                } else if (hour !== 12) {
                    hour += 12;
                }
                return (hour * 60) + minute;
            }

            const twentyFourHour = raw.match(/^(\d{1,2}):(\d{2})$/);
            if (twentyFourHour) {
                const hour = parseInt(twentyFourHour[1], 10);
                const minute = parseInt(twentyFourHour[2], 10);
                if (hour < 0 || hour > 23 || minute < 0 || minute > 59) {
                    return null;
                }
                return (hour * 60) + minute;
            }

            return null;
        }

        function parseAppointmentDurationMinutes(durationValue) {
            return APPT_DURATION_MINUTES[(durationValue || "").toString()] || 0;
        }

        function formatMinutesAsTimeLabel(totalMinutes) {
            const minutesInDay = ((totalMinutes % (24 * 60)) + (24 * 60)) % (24 * 60);
            let hour = Math.floor(minutesInDay / 60);
            const minute = minutesInDay % 60;
            const meridiem = hour >= 12 ? "PM" : "AM";
            hour = hour % 12;
            if (hour === 0) {
                hour = 12;
            }
            return hour + ":" + String(minute).padStart(2, "0") + " " + meridiem;
        }

        function getAppointmentWindow(appointment) {
            if (!appointment) {
                return null;
            }

            const dentist = (appointment.assignedDentist || "").toString().trim();
            const date = (appointment.appointmentDate || "").toString().trim();
            const startMinutes = parseAppointmentStartMinutes(appointment.appointmentStartTime);
            const durationMinutes = parseAppointmentDurationMinutes(appointment.appointmentDuration);

            if (!dentist || !date || startMinutes == null || durationMinutes <= 0) {
                return null;
            }

            return {
                dentist: dentist,
                date: date,
                startMinutes: startMinutes,
                endMinutes: startMinutes + durationMinutes,
                durationMinutes: durationMinutes
            };
        }

        function appointmentsOverlap(a, b) {
            return !!a && !!b
                && a.date === b.date
                && a.startMinutes < b.endMinutes
                && b.startMinutes < a.endMinutes;
        }

        function getFindingsSnapshot() {
            if (typeof window.getDentalFindingsForAppointments === "function") {
                return window.getDentalFindingsForAppointments() || [];
            }
            return [];
        }

        function formatFindingLabel(finding, listIndex) {
            const tooth = finding.affectedTooth || "?";
            const toothLabel = finding.isPrimaryTooth ? (tooth + " (Primary)") : tooth;
            const type = finding.diseaseConditionType || "Finding";
            return "#" + (listIndex + 1) + " · Tooth " + toothLabel + " · " + type;
        }

        function getFindingByClientKey(clientKey) {
            return getFindingsSnapshot().find(function (f) {
                return f.clientKey === clientKey;
            }) || null;
        }

        function getAssignedFindingKeys(excludeAppointmentIndex) {
            const validKeys = new Set(
                getFindingsSnapshot()
                    .map(function (f) { return f.clientKey; })
                    .filter(Boolean)
            );
            const assigned = new Set();
            tcAppointments.forEach(function (appt, index) {
                if (excludeAppointmentIndex != null && index === excludeAppointmentIndex) {
                    return;
                }
                (appt.findingClientKeys || []).forEach(function (key) {
                    if (key && validKeys.has(key)) {
                        assigned.add(key);
                    }
                });
            });
            return assigned;
        }

        function pruneInvalidFindingKeys() {
            const validKeys = new Set(getFindingsSnapshot().map(function (f) { return f.clientKey; }));
            tcAppointments.forEach(function (appt) {
                appt.findingClientKeys = (appt.findingClientKeys || []).filter(function (key) {
                    return validKeys.has(key);
                });
            });
            removeEmptyAppointments();
        }

        function removeEmptyAppointments() {
            const editingApptId = editingAppointmentIndex != null
                ? (tcAppointments[editingAppointmentIndex]?.id || null)
                : null;

            tcAppointments = tcAppointments.filter(function (appt) {
                return (appt.findingClientKeys || []).length > 0;
            });

            if (editingApptId) {
                const newIndex = tcAppointments.findIndex(function (appt) {
                    return appt.id === editingApptId;
                });
                if (newIndex < 0) {
                    hideAppointmentForm();
                } else {
                    editingAppointmentIndex = newIndex;
                }
            } else if (editingAppointmentIndex != null && editingAppointmentIndex >= tcAppointments.length) {
                hideAppointmentForm();
            }
        }

        function removeFindingKeyFromAppointments(deletedKey) {
            if (!deletedKey) {
                return;
            }

            tcAppointments.forEach(function (appt) {
                appt.findingClientKeys = (appt.findingClientKeys || []).filter(function (key) {
                    return key !== deletedKey;
                });
            });
            removeEmptyAppointments();
        }

        function syncAppointmentsJson() {
            const normalized = tcAppointments.map(function (appt) {
                return {
                    id: appt.id || "",
                    assignedDentist: appt.assignedDentist || "",
                    appointmentDate: appt.appointmentDate || "",
                    appointmentStartTime: appt.appointmentStartTime || "",
                    appointmentDuration: appt.appointmentDuration || "",
                    findingClientKeys: appt.findingClientKeys || []
                };
            });
            $("#AppointmentsJson").val(JSON.stringify(normalized));
        }

        function renderAppointmentsSummary() {
            const findings = getFindingsSnapshot();
            const totalFindings = findings.length;
            const assignedKeys = getAssignedFindingKeys(null);
            const scheduledFindings = assignedKeys.size;
            const unscheduled = Math.max(0, totalFindings - scheduledFindings);
            const $summary = $("#tcAppointmentsSummary").empty();

            $summary.append(
                "<span class='tc-appt-summary-pill'>" + totalFindings + " finding" + (totalFindings === 1 ? "" : "s") + "</span>"
            );
            $summary.append(
                "<span class='tc-appt-summary-pill'>" + tcAppointments.length + " appointment" + (tcAppointments.length === 1 ? "" : "s") + "</span>"
            );
            if (unscheduled > 0) {
                $summary.append(
                    "<span class='tc-appt-summary-pill is-warning'>" + unscheduled + " unscheduled finding" + (unscheduled === 1 ? "" : "s") + "</span>"
                );
            } else if (totalFindings > 0) {
                $summary.append(
                    "<span class='tc-appt-summary-pill'>All findings scheduled</span>"
                );
            }
        }

        function renderFindingsPicker(selectedKeys) {
            const selected = new Set(selectedKeys || []);
            const assignedElsewhere = getAssignedFindingKeys(editingAppointmentIndex);
            const findings = getFindingsSnapshot();
            const $picker = $("#tcAppointmentFindingsPicker").empty();

            if (!findings.length) {
                $picker.append("<p class='tc-appt-findings-empty'>Add dental findings above before scheduling appointments.</p>");
                return;
            }

            findings.forEach(function (finding) {
                const key = finding.clientKey;
                if (!key) {
                    return;
                }

                const isSelected = selected.has(key);
                const isTaken = assignedElsewhere.has(key);
                if (isTaken && !isSelected) {
                    return;
                }

                const inputId = "tcApptFinding_" + key.replace(/[^a-zA-Z0-9_-]/g, "_");
                const $check = $(
                    "<div class='form-check'>" +
                    "<input class='form-check-input' type='checkbox' id='" + inputId + "' value='" + escapeHtml(key) + "'>" +
                    "<label class='form-check-label' for='" + inputId + "'>" + escapeHtml(formatFindingLabel(finding, finding.index)) + "</label>" +
                    "</div>"
                );
                $check.find("input").prop("checked", isSelected);
                $picker.append($check);
            });

            if (!$picker.children(".form-check").length) {
                $picker.append("<p class='tc-appt-findings-empty'>All findings are already assigned to other appointments.</p>");
            }
        }

        function getSelectedFindingKeysFromForm() {
            const keys = [];
            $("#tcAppointmentFindingsPicker input[type='checkbox']:checked").each(function () {
                keys.push($(this).val());
            });
            return keys;
        }

        function syncAppointmentFormFindingsPicker() {
            if (editingAppointmentIndex != null && tcAppointments[editingAppointmentIndex]) {
                renderFindingsPicker(tcAppointments[editingAppointmentIndex].findingClientKeys || []);
                return;
            }

            if (editingAppointmentIndex != null) {
                return;
            }

            renderFindingsPicker([]);
        }

        function renderAppointmentsTable(options) {
            options = options || {};
            const $tbody = $("#tcAppointmentsTableBody");
            $tbody.empty();

            if (!tcAppointments.length) {
                $tbody.append(
                    "<tr id='tcAppointmentsEmptyRow'>" +
                    "<td colspan='7' class='text-center py-4 text-muted'>No appointments scheduled yet.</td>" +
                    "</tr>"
                );
                renderAppointmentsSummary();
                syncAppointmentsJson();
                renderAppointmentCalendar();
                if (!options.suppressTcAppointmentsChanged) {
                    $(document).trigger("tcAppointmentsChanged");
                }
                if (!options.suppressFormPickerSync) {
                    syncAppointmentFormFindingsPicker();
                }
                return;
            }

            tcAppointments.forEach(function (appt, index) {
                const findingTags = (appt.findingClientKeys || [])
                    .map(function (key) {
                        const finding = getFindingByClientKey(key);
                        if (!finding) {
                            return "";
                        }
                        return "<span class='tc-appt-finding-tag'>" + escapeHtml(formatFindingLabel(finding, finding.index)) + "</span>";
                    })
                    .filter(Boolean)
                    .join("");

                const actionButtons =
                    "<button type='button' class='btn btn-sm btn-outline-primary tc-appt-action-btn tc-appt-edit-btn' data-index='" + index + "' title='Edit'>" +
                    "<i class='fas fa-edit' aria-hidden='true'></i></button> " +
                    "<button type='button' class='btn btn-sm btn-outline-danger tc-appt-action-btn tc-appt-delete-btn' data-index='" + index + "' title='Delete'>" +
                    "<i class='fas fa-trash-alt' aria-hidden='true'></i></button>";

                $tbody.append(
                    "<tr data-appointment-index='" + index + "'>" +
                    "<td>" + (index + 1) + "</td>" +
                    "<td>" + escapeHtml(appt.assignedDentist || "-") + "</td>" +
                    "<td>" + escapeHtml(formatAppointmentDateForDisplay(appt.appointmentDate)) + "</td>" +
                    "<td>" + escapeHtml(appt.appointmentStartTime || "-") + "</td>" +
                    "<td>" + escapeHtml(appt.appointmentDuration || "-") + "</td>" +
                    "<td>" + (findingTags || "-") + "</td>" +
                    "<td class='text-nowrap'>" + actionButtons + "</td>" +
                    "</tr>"
                );
            });

            renderAppointmentsSummary();
            syncAppointmentsJson();
            renderAppointmentCalendar();
            if (!options.suppressTcAppointmentsChanged) {
                $(document).trigger("tcAppointmentsChanged");
            }
            if (!options.suppressFormPickerSync) {
                syncAppointmentFormFindingsPicker();
            }
        }

        function initAppointmentFormPickers() {
            if (typeof flatpickr === "undefined") {
                return;
            }

            const dateOptions = {
                altInput: true,
                altFormat: "m/d/Y",
                dateFormat: "Y-m-d",
                allowInput: true,
                onChange: function () {
                    updateAppointmentStartTimeBounds();
                }
            };
            if (EVENT_APPOINTMENT_MIN_DATE) {
                dateOptions.minDate = EVENT_APPOINTMENT_MIN_DATE;
            }
            if (EVENT_APPOINTMENT_MAX_DATE) {
                dateOptions.maxDate = EVENT_APPOINTMENT_MAX_DATE;
            }

            if (!tcAppointmentDatePicker && $("#tcAppointmentDate").length) {
                tcAppointmentDatePicker = flatpickr("#tcAppointmentDate", dateOptions);
            }
            if (!tcAppointmentStartTimePicker && $("#tcAppointmentStartTime").length) {
                tcAppointmentStartTimePicker = flatpickr("#tcAppointmentStartTime", {
                    enableTime: true,
                    noCalendar: true,
                    dateFormat: "h:i K",
                    altInput: true,
                    altFormat: "h:i K",
                    time_24hr: false,
                    allowInput: true
                });
            }

            updateAppointmentStartTimeBounds();
        }

        function destroyFlatpickrInstance(picker) {
            if (picker) {
                try {
                    picker.destroy();
                } catch (_error) {
                    // ignore stale picker instances
                }
            }
            return null;
        }

        function resetFlatpickrField(picker, inputSelector) {
            destroyFlatpickrInstance(picker);
            const $input = $(inputSelector);
            $input.val("");
            $input.siblings("input.form-control").not($input).remove();
            return null;
        }

        function clearAppointmentForm() {
            editingAppointmentIndex = null;
            $("#tcAppointmentFormTitle").text("Add Appointment");
            $("#tcSaveAppointmentBtn").html('<i class="fas fa-check-circle" aria-hidden="true"></i> Save Appointment');
            $("#tcAppointmentDentist").val("");
            tcAppointmentDatePicker = resetFlatpickrField(tcAppointmentDatePicker, "#tcAppointmentDate");
            tcAppointmentStartTimePicker = resetFlatpickrField(tcAppointmentStartTimePicker, "#tcAppointmentStartTime");
            $("#tcAppointmentDuration").val("");
            initAppointmentFormPickers();
            renderFindingsPicker([]);
        }

        function showAppointmentForm(selectedKeys) {
            initAppointmentFormPickers();
            if (selectedKeys !== undefined) {
                renderFindingsPicker(selectedKeys);
            } else if (editingAppointmentIndex == null) {
                renderFindingsPicker([]);
            }
        }

        function hideAppointmentForm() {
            clearAppointmentForm();
        }

        function readAppointmentForm() {
            return {
                id: editingAppointmentIndex != null
                    ? (tcAppointments[editingAppointmentIndex]?.id || generateAppointmentId())
                    : generateAppointmentId(),
                assignedDentist: ($("#tcAppointmentDentist").val() || "").toString().trim(),
                appointmentDate: ($("#tcAppointmentDate").val() || "").toString().trim(),
                appointmentStartTime: ($("#tcAppointmentStartTime").val() || "").toString().trim(),
                appointmentDuration: ($("#tcAppointmentDuration").val() || "").toString().trim(),
                findingClientKeys: getSelectedFindingKeysFromForm()
            };
        }

        function writeAppointmentForm(appointment) {
            $("#tcAppointmentDentist").val(appointment.assignedDentist || "");
            initAppointmentFormPickers();
            if (tcAppointmentDatePicker) {
                if (appointment.appointmentDate) {
                    tcAppointmentDatePicker.setDate(appointment.appointmentDate, true);
                } else {
                    tcAppointmentDatePicker.clear();
                }
            } else {
                $("#tcAppointmentDate").val(appointment.appointmentDate || "");
            }
            if (tcAppointmentStartTimePicker) {
                if (appointment.appointmentStartTime) {
                    tcAppointmentStartTimePicker.setDate(appointment.appointmentStartTime, true);
                } else {
                    tcAppointmentStartTimePicker.clear();
                }
            } else {
                $("#tcAppointmentStartTime").val(appointment.appointmentStartTime || "");
            }
            $("#tcAppointmentDuration").val(appointment.appointmentDuration || "");
            renderFindingsPicker(appointment.findingClientKeys || []);
            updateAppointmentStartTimeBounds();
        }

        function validateAppointmentForm(appointment) {
            if (!appointment.assignedDentist) {
                Swal.fire("Invalid Data", "Assign Dentist is required.", "warning");
                return false;
            }
            if (!appointment.appointmentDate) {
                Swal.fire("Invalid Data", "Appointment Date is required.", "warning");
                return false;
            }

            const dayWindow = getEventDayWindow(appointment.appointmentDate);
            if (!dayWindow) {
                Swal.fire("Invalid Data", "Appointment Date must be within the event schedule.", "warning");
                return false;
            }

            if (!appointment.appointmentStartTime) {
                Swal.fire("Invalid Data", "Start Time is required.", "warning");
                return false;
            }
            if (!appointment.appointmentDuration) {
                Swal.fire("Invalid Data", "Duration is required.", "warning");
                return false;
            }
            if (!appointment.findingClientKeys.length) {
                Swal.fire("Invalid Data", "Select at least one finding for this appointment.", "warning");
                return false;
            }

            const assignedElsewhere = getAssignedFindingKeys(editingAppointmentIndex);
            for (let i = 0; i < appointment.findingClientKeys.length; i++) {
                if (assignedElsewhere.has(appointment.findingClientKeys[i])) {
                    Swal.fire("Invalid Data", "One or more selected findings are already assigned to another appointment.", "warning");
                    return false;
                }
            }

            const appointmentWindow = getAppointmentWindow(appointment);
            if (!appointmentWindow) {
                Swal.fire("Invalid Data", "Enter a valid start time and duration.", "warning");
                return false;
            }

            if (appointmentWindow.startMinutes < dayWindow.startMinutes) {
                Swal.fire(
                    "Invalid Data",
                    "Start Time must be at or after " + formatMinutesAsTimeLabel(dayWindow.startMinutes) + " on this event day.",
                    "warning"
                );
                return false;
            }

            if (appointmentWindow.endMinutes > dayWindow.endMinutes) {
                Swal.fire(
                    "Invalid Data",
                    "Appointment must end by " + formatMinutesAsTimeLabel(dayWindow.endMinutes) + " on this event day.",
                    "warning"
                );
                return false;
            }

            for (let i = 0; i < tcAppointments.length; i++) {
                if (editingAppointmentIndex != null && i === editingAppointmentIndex) {
                    continue;
                }
                const existingWindow = getAppointmentWindow(tcAppointments[i]);
                if (appointmentsOverlap(appointmentWindow, existingWindow)) {
                    Swal.fire(
                        "Appointment Conflict",
                        "This time slot is already booked on "
                        + formatAppointmentDateForDisplay(appointmentWindow.date)
                        + " from " + formatMinutesAsTimeLabel(existingWindow.startMinutes)
                        + " to " + formatMinutesAsTimeLabel(existingWindow.endMinutes)
                        + (tcAppointments[i].assignedDentist
                            ? " (dentist: " + tcAppointments[i].assignedDentist + ")."
                            : "."),
                        "error"
                    );
                    return false;
                }
            }

            return true;
        }

        function saveAppointment() {
            const appointment = readAppointmentForm();
            if (!validateAppointmentForm(appointment)) {
                return;
            }

            if (editingAppointmentIndex != null) {
                tcAppointments[editingAppointmentIndex] = appointment;
            } else {
                tcAppointments.push(appointment);
            }

            clearAppointmentForm();
            renderAppointmentsTable();
            if (appointment.appointmentDate) {
                syncCalendarToDate(appointment.appointmentDate);
            }
        }

        function editAppointment(index) {
            const appointment = tcAppointments[index];
            if (!appointment) {
                return;
            }

            editingAppointmentIndex = index;
            $("#tcAppointmentFormTitle").text("Edit Appointment");
            $("#tcSaveAppointmentBtn").html('<i class="fas fa-check-circle" aria-hidden="true"></i> Update Appointment');
            writeAppointmentForm(appointment);
            showAppointmentForm(appointment.findingClientKeys || []);
        }

        function deleteAppointment(index) {
            Swal.fire({
                title: "Delete appointment?",
                text: "This appointment will be removed. The linked findings will become available to schedule again.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Delete",
                confirmButtonColor: "#dc3545"
            }).then(function (result) {
                if (!result.isConfirmed) {
                    return;
                }

                tcAppointments.splice(index, 1);
                if (editingAppointmentIndex === index) {
                    hideAppointmentForm();
                } else if (editingAppointmentIndex != null && editingAppointmentIndex > index) {
                    editingAppointmentIndex -= 1;
                }
                renderAppointmentsTable();
            });
        }

        function buildAppointmentCalendarGrid() {
            const selectedDay = getSelectedCalendarDay();
            const dayWindow = getEventDayWindow(selectedDay);

            calendarDayStartMinutes = dayWindow ? dayWindow.startMinutes : 0;
            calendarDayEndMinutes = dayWindow ? dayWindow.endMinutes : (24 * 60);

            const slotSpanMinutes = Math.max(APPT_SLOT_MINUTES, calendarDayEndMinutes - calendarDayStartMinutes);
            const slotCount = Math.max(1, Math.ceil(slotSpanMinutes / APPT_SLOT_MINUTES));

            const $timeCol = $("#tcApptTimeCol").empty();
            $("#tcApptCalendarBody .tc-appt-dentist-col").each(function () {
                const $col = $(this);
                const $slots = $col.find(".tc-appt-slots").empty();
                $col.find(".tc-appt-bookings").empty();

                for (let i = 0; i < slotCount; i++) {
                    const minutes = calendarDayStartMinutes + (i * APPT_SLOT_MINUTES);
                    if (minutes >= calendarDayEndMinutes) {
                        break;
                    }

                    const isHour = minutes % 60 === 0;
                    $slots.append(
                        "<div class='tc-appt-slot" + (isHour ? " is-hour" : "") + "' data-minutes='" + minutes + "'></div>"
                    );
                }
            });

            for (let i = 0; i < slotCount; i++) {
                const minutes = calendarDayStartMinutes + (i * APPT_SLOT_MINUTES);
                if (minutes >= calendarDayEndMinutes) {
                    break;
                }

                const isHour = minutes % 60 === 0;
                $timeCol.append(
                    "<div class='tc-appt-time-label" + (isHour ? " is-hour" : "") + "'>" +
                    escapeHtml(formatMinutesAsTimeLabel(minutes)) +
                    "</div>"
                );
            }
        }

        function getSelectedCalendarDay() {
            if (tcCalendarDayPicker) {
                const selected = tcCalendarDayPicker.selectedDates[0];
                if (selected) {
                    return flatpickr.formatDate(selected, "Y-m-d");
                }
            }
            return ($("#tcCalendarDay").val() || "").toString().trim();
        }

        function renderAppointmentCalendar() {
            const selectedDay = getSelectedCalendarDay();
            buildAppointmentCalendarGrid();
            $("#tcApptCalendarBody .tc-appt-bookings").empty();

            if (!selectedDay) {
                $("#tcApptCalendarHint").text("Select an event date to view booked appointments.");
                return;
            }

            const dayWindow = getEventDayWindow(selectedDay);
            if (!dayWindow) {
                $("#tcApptCalendarHint").text("Selected date is outside the event schedule.");
                return;
            }

            let bookingCount = 0;
            tcAppointments.forEach(function (appt, index) {
                const appointmentWindow = getAppointmentWindow(appt);
                if (!appointmentWindow || appointmentWindow.date !== selectedDay) {
                    return;
                }

                if (appointmentWindow.endMinutes <= dayWindow.startMinutes
                    || appointmentWindow.startMinutes >= dayWindow.endMinutes) {
                    return;
                }

                const $col = $("#tcApptCalendarBody .tc-appt-dentist-col").filter(function () {
                    return ($(this).attr("data-dentist") || "") === appointmentWindow.dentist;
                }).first();
                if (!$col.length) {
                    return;
                }

                const top = ((appointmentWindow.startMinutes - calendarDayStartMinutes) / APPT_SLOT_MINUTES) * APPT_SLOT_HEIGHT;
                const height = Math.max(
                    APPT_SLOT_HEIGHT,
                    (appointmentWindow.durationMinutes / APPT_SLOT_MINUTES) * APPT_SLOT_HEIGHT
                );
                const findingCount = (appt.findingClientKeys || []).length;
                const label = SERVICE_MEMBER_DISPLAY_NAME || "Service Member";
                const title = label
                    + " · " + formatMinutesAsTimeLabel(appointmentWindow.startMinutes)
                    + " – " + formatMinutesAsTimeLabel(appointmentWindow.endMinutes)
                    + " · " + findingCount + " finding" + (findingCount === 1 ? "" : "s");

                $col.find(".tc-appt-bookings").append(
                    "<button type='button' class='tc-appt-booking' data-appointment-index='" + index + "' " +
                    "style='top:" + top + "px;height:" + height + "px;' title='" + escapeHtml(title) + "'>" +
                    "<span class='tc-appt-booking-label'>" + escapeHtml(label) + "</span>" +
                    "</button>"
                );
                bookingCount += 1;
            });

            $("#tcApptCalendarHint").text(
                bookingCount
                    ? (bookingCount + " booked appointment" + (bookingCount === 1 ? "" : "s") + " on " + formatAppointmentDateForDisplay(selectedDay)
                        + " (" + formatMinutesAsTimeLabel(dayWindow.startMinutes) + " – " + formatMinutesAsTimeLabel(dayWindow.endMinutes) + ").")
                    : ("No booked appointments on " + formatAppointmentDateForDisplay(selectedDay)
                        + " (" + formatMinutesAsTimeLabel(dayWindow.startMinutes) + " – " + formatMinutesAsTimeLabel(dayWindow.endMinutes) + ").")
            );
        }

        function syncCalendarNavButtons() {
            const selectedDay = getSelectedCalendarDay();
            const $prev = $("#tcCalendarPrevDayBtn");
            const $next = $("#tcCalendarNextDayBtn");
            if (!selectedDay) {
                $prev.prop("disabled", true);
                $next.prop("disabled", true);
                return;
            }

            $prev.prop("disabled", !!(EVENT_APPOINTMENT_MIN_DATE && selectedDay <= EVENT_APPOINTMENT_MIN_DATE));
            $next.prop("disabled", !!(EVENT_APPOINTMENT_MAX_DATE && selectedDay >= EVENT_APPOINTMENT_MAX_DATE));
        }

        function shiftCalendarDay(dayDelta) {
            const selectedDay = getSelectedCalendarDay();
            if (!selectedDay || !tcCalendarDayPicker) {
                return;
            }

            const current = flatpickr.parseDate(selectedDay, "Y-m-d");
            if (!current) {
                return;
            }

            current.setDate(current.getDate() + dayDelta);
            const nextValue = flatpickr.formatDate(current, "Y-m-d");

            if (EVENT_APPOINTMENT_MIN_DATE && nextValue < EVENT_APPOINTMENT_MIN_DATE) {
                return;
            }
            if (EVENT_APPOINTMENT_MAX_DATE && nextValue > EVENT_APPOINTMENT_MAX_DATE) {
                return;
            }

            tcCalendarDayPicker.setDate(nextValue, true);
        }

        function syncCalendarToDate(dateValue) {
            if (!tcCalendarDayPicker || !dateValue) {
                return;
            }
            const minOk = !EVENT_APPOINTMENT_MIN_DATE || dateValue >= EVENT_APPOINTMENT_MIN_DATE;
            const maxOk = !EVENT_APPOINTMENT_MAX_DATE || dateValue <= EVENT_APPOINTMENT_MAX_DATE;
            if (!minOk || !maxOk) {
                return;
            }
            tcCalendarDayPicker.setDate(dateValue, true);
            syncCalendarNavButtons();
        }

        function initAppointmentCalendar() {
            buildAppointmentCalendarGrid();

            $("#tcCalendarPrevDayBtn").off("click.tcApptNav").on("click.tcApptNav", function () {
                shiftCalendarDay(-1);
            });
            $("#tcCalendarNextDayBtn").off("click.tcApptNav").on("click.tcApptNav", function () {
                shiftCalendarDay(1);
            });

            if (typeof flatpickr === "undefined") {
                renderAppointmentCalendar();
                syncCalendarNavButtons();
                return;
            }

            const dayOptions = {
                altInput: true,
                altFormat: "m/d/Y",
                dateFormat: "Y-m-d",
                allowInput: true,
                onChange: function () {
                    renderAppointmentCalendar();
                    syncCalendarNavButtons();
                }
            };
            if (EVENT_APPOINTMENT_MIN_DATE) {
                dayOptions.minDate = EVENT_APPOINTMENT_MIN_DATE;
            }
            if (EVENT_APPOINTMENT_MAX_DATE) {
                dayOptions.maxDate = EVENT_APPOINTMENT_MAX_DATE;
            }

            if (!tcCalendarDayPicker) {
                tcCalendarDayPicker = flatpickr("#tcCalendarDay", dayOptions);
            }

            const defaultDay = EVENT_APPOINTMENT_MIN_DATE || EVENT_APPOINTMENT_MAX_DATE || "";
            if (defaultDay) {
                tcCalendarDayPicker.setDate(defaultDay, false);
            }

            renderAppointmentCalendar();
            syncCalendarNavButtons();
        }

        function refreshFindingsPickerFromState() {
            const validKeys = new Set(
                getFindingsSnapshot()
                    .map(function (f) { return f.clientKey; })
                    .filter(Boolean)
            );
            let selectedKeys = [];

            if (editingAppointmentIndex != null && tcAppointments[editingAppointmentIndex]) {
                selectedKeys = (tcAppointments[editingAppointmentIndex].findingClientKeys || []).filter(function (key) {
                    return validKeys.has(key);
                });
            } else {
                selectedKeys = getSelectedFindingKeysFromForm().filter(function (key) {
                    return validKeys.has(key);
                });
            }

            renderFindingsPicker(selectedKeys);
        }

        function refreshFromFindingsChange(deletedFindingKey) {
            if (deletedFindingKey) {
                removeFindingKeyFromAppointments(deletedFindingKey);
            }
            pruneInvalidFindingKeys();

            if (editingAppointmentIndex != null && !tcAppointments[editingAppointmentIndex]) {
                hideAppointmentForm();
            } else if (editingAppointmentIndex != null && tcAppointments[editingAppointmentIndex]) {
                writeAppointmentForm(tcAppointments[editingAppointmentIndex]);
            }

            renderAppointmentsTable({ suppressTcAppointmentsChanged: true, suppressFormPickerSync: true });
            if (editingAppointmentIndex == null) {
                syncAppointmentFormFindingsPicker();
            }
            $(document).trigger("tcAppointmentsChanged");
        }

        window.refreshTreatmentCoordinatorAppointmentsFromFindings = refreshFromFindingsChange;

        document.addEventListener("malama-findings-changed", function (event) {
            const deletedKey = event.detail && event.detail.deletedClientKey;
            refreshFromFindingsChange(deletedKey || null);
        });

        window.getFindingAppointmentAssignment = function (clientKey) {
            if (!clientKey) {
                return null;
            }

            for (let i = 0; i < tcAppointments.length; i++) {
                const appt = tcAppointments[i];
                if ((appt.findingClientKeys || []).indexOf(clientKey) >= 0) {
                    return {
                        appointmentIndex: i,
                        assignedDentist: appt.assignedDentist || "",
                        appointmentDate: appt.appointmentDate || "",
                        appointmentStartTime: appt.appointmentStartTime || "",
                        appointmentDuration: appt.appointmentDuration || ""
                    };
                }
            }

            return null;
        };

        window.initTreatmentCoordinatorAppointments = function () {
            initAppointmentFormPickers();
            initAppointmentCalendar();
            clearAppointmentForm();
            renderFindingsPicker([]);
            renderAppointmentsTable();
        };

        $(document).ready(function () {
            window.initTreatmentCoordinatorAppointments();

            $("#tcCancelAppointmentBtn").on("click", hideAppointmentForm);
            $("#tcSaveAppointmentBtn").on("click", saveAppointment);

            $(document).on("click", ".tc-appt-edit-btn", function () {
                editAppointment(parseInt($(this).data("index"), 10));
            });

            $(document).on("click", ".tc-appt-delete-btn", function () {
                deleteAppointment(parseInt($(this).data("index"), 10));
            });

            $(document).on("click", ".tc-appt-booking", function () {
                editAppointment(parseInt($(this).data("appointment-index"), 10));
            });

            $(document).on("dentalFindingsChanged", function (event, deletedFindingKey) {
                const deletedKey = deletedFindingKey || event.deletedFindingKey || null;
                refreshFromFindingsChange(deletedKey);
            });
        });
    })();
</script>
