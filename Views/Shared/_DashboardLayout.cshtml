@using System.Security.Claims
@using Malama.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <!-- Bootstrap CSS -->

    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/css/fixedColumns.dataTables.min.css" rel="stylesheet" />
    <link href="~/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/all.min.css" />@* it is font-awesome library *@
    <link href="~/css/select2.min.css" rel="stylesheet" />
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <link href="~/css/flatpickr.min.css" rel="stylesheet" />
    

    <style>
        /* Custom styling for sidebar */
        body {
            font-family: Arial, sans-serif; /* Or any other font you prefer */
        }

        h1, h2, h3 {
            font-family: inherit; /* Or any specific font you prefer */
            font-weight: normal; /* Ensure consistency across pages */
        }

        #sidebar {
            width: 250px; /* Fixed width for the sidebar */
            position: fixed; /* Keep the sidebar fixed */
            top: 0;
            left: 0;
            height: 100vh; /* Full height of the viewport */
            background-color: #1c1f26; /* Dark background */
            padding-top: 20px;
            color: #fff;
            z-index: 1000;
        }

            #sidebar .sidebar-header {
                background-color: rgba(80, 90, 201, 1); /* Header color */
                padding: 15px; /* Keep padding */
                font-size: 20px; /* Larger header font size */
                font-weight: bold;
                text-align: center;
                margin: 0; /* Remove margin to eliminate space above */
            }

            #sidebar ul {
                list-style-type: none; /* Remove bullets from the menu items */
                padding-left: 0; /* Remove default padding */
            }

            #sidebar .nav-item {
                margin-bottom: 10px; /* Add space between menu items */
            }

            #sidebar .nav-link {
                color: #cfd8dc !important; /* Light gray color */
                font-size: 18px !important; /* Font size */
                padding: 15px 20px !important; /* Padding */
                border-radius: 5px; /* Rounded corners */
                display: block; /* Fill the space */
                text-decoration: none; /* Remove underline */
                font-family: inherit !important; /* Inherit font family to ensure consistency */
                font-weight: normal !important; /* Ensure normal font weight for all links */
                transition: background-color 0.3s, color 0.3s; /* Smooth transition */
            }

                #sidebar .nav-link:hover {
                    background-color: rgba(80, 90, 201, 1) !important; /* Background color for hover */
                    color: #fff !important; /* Font color on hover */
                }

                #sidebar .nav-link.active {
                    background-color: rgba(80, 90, 201, 1) !important; /* Active background */
                    color: #fff !important; /* Active font color */
                }

                /* Ensure the active link styles are consistent */
                #sidebar .nav-link:hover,
                #sidebar .nav-link.active {
                    font-family: inherit !important; /* Ensure font family remains the same */
                    font-size: 18px !important; /* Keep the same font size */
                    font-weight: normal !important; /* Keep font weight normal */
                }

        main {
            margin-left: 250px; /* Offset the main content by sidebar width */
            padding: 20px;
            background-color: #f4f5f7;
            min-height: 100vh;
        }

        .sidebar-logo {
            max-width: 140px;
            height: auto;
            display: block;
            margin: 0 auto;
        }

        #sidebar .sidebar-header {
            background-color: transparent;
        }

        .main-logo {
            max-width: 250px;
            height: auto;
            display: block;
            margin: 0 auto;
        }


    </style>
</head>
<body>
    <!-- Sidebar -->
    @{
        var user = await UserManager.GetUserAsync(User);
        bool isEventUser = user?.IsEventUser ?? false;
        // var isEventAssignedClaim = User.Claims.FirstOrDefault(c => c.Type == "IsEventAssignedToStaff")?.Value;
        // bool isEventAssigned = string.Equals(isEventAssignedClaim, "true", StringComparison.OrdinalIgnoreCase);
    }

    <nav id="sidebar">
        <div class="sidebar-header">
            <a href="/Dashboard/Index" class="logo-link">
                <img src="~/images/MALAMA-Horizontal-01.png" alt="Logo" class="sidebar-logo" />
            </a>
        </div>


        <ul class="nav flex-column">

            <!-- Dashboard -->
            <li class="nav-item">
                <a class="nav-link" href="/Dashboard/Index">
                    Dashboard
                </a>
            </li>

            <!-- Show Select Event only if session is null -->
            @if (isEventUser || User.IsInRole("Event Manager"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="EventSelection" asp-action="Index">
                        Select Event
                    </a>
                </li>
            }

            <!-- Change Password -->
            <li class="nav-item">
                <a class="nav-link" asp-controller="Account" asp-action="ChangePassword">
                    Change Password
                </a>
            </li>

            <!-- Logout -->
            <li class="nav-item">
                <form asp-action="Logout" asp-controller="Account" method="post" style="display:inline;">
                    <button type="submit" class="nav-link" style="border:none; background:none; padding:0;">
                        Logout
                    </button>
                </form>
            </li>
        </ul>
    </nav>


    <!-- Main Content -->
    <main>
        <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
            <div>
                @{
                    var eventId = User.Claims.FirstOrDefault(c => c.Type == "EventIdString")?.Value;
                    var eventVersion = User.Claims.FirstOrDefault(c => c.Type == "EventVersion")?.Value;
                }
                @if (!string.IsNullOrEmpty(eventId) && !string.IsNullOrEmpty(eventVersion))
                {
                    <span>Event ID:</span>
                    <span>@($"{eventId} (V{eventVersion})")</span>
                }
            </div>
            <div>
                <img src="~/images/MALAMA-Horizontal-01.png" alt="Logo" class="main-logo" style="display:none"/>
            </div>
            <div>
                @{
                    var roleClaims = User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(r => r.Value);
                    var rolesDisplay = string.Join(", ", roleClaims);
                }
                <span class="text-muted" >
                    @User.Identity.Name
                    @if (!string.IsNullOrEmpty(rolesDisplay))
                    {
                        <text> (@rolesDisplay)</text>
                    }
                </span>
                @* <span class="text-muted">
                @User.Identity.Name
                @if (!string.IsNullOrEmpty(ViewBag.UserRole))
                {
                <text> (@ViewBag.UserRole)</text>
                }
                </span> *@
                <!-- Alternatively, if you want to use a custom property from Identity, fetch the user data from UserManager -->
            </div>
        </div>
        <div class="content">
            <script src="~/js/jquery-3.6.0.min.js"></script>
            <script src="~/js/jquery.dataTables.min.js"></script>

            <script src="~/js/select2.min.js"></script>
            <script src="~/js/jquery-ui.min.js"></script>
            <script src="~/js/jspdf.umd.min.js"></script>




            @RenderBody()
        </div>
    </main>

    <!-- Bootstrap JS (optional) -->
    <script src="~/js/flatpickr.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dataTables.fixedColumns.min.js"></script>
    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/xlsx.full.min.js"></script>
    <script src="~/js/JsBarcode.all.min.js"></script>
    <script src="~/js/sweetalert2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.10/signalr.min.js"></script>
    <script src="~/js/Common/yesNoModal.js"></script>
    <script src="~/js/Common/Methods.js"></script>

    <script>
        console.log("Temperature alert scripts loaded");

        // Build SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/temperatureHub")       // Match your hub URL
            .withAutomaticReconnect()         // Auto-reconnect if disconnected
            .build();

        // Queue to hold incoming alerts
        const alertQueue = [];

        // Flag to indicate if an alert is currently showing
        let alertShowing = false;

        // Listen for SignalR alerts
        connection.on("TemperatureAlert", function (alert) {
            // Add alert to queue
            alertQueue.push(alert);

            // Show next alert if none is currently showing
            if (!alertShowing) {
                showNextAlert();
            }
        });

        // Function to show alerts sequentially
        function showNextAlert() {
            if (alertQueue.length === 0) {
                alertShowing = false;
                return;
            }

            alertShowing = true;
            const alert = alertQueue.shift();

            Swal.fire({
                icon: 'warning',
                title: 'Temperature Reading Required',
                html: `
                        <b>Container:</b> ${alert.containerName}<br>
                        <b>Due at:</b> ${alert.dueAt}
                    `,
                confirmButtonText: 'OK'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Notify server that user acknowledged
                    fetch('/Container/AcknowledgeNotification', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(alert.notificationId) // Send notification ID
                    }).catch(err => console.error('Ack failed', err));
                }

                // Show next alert in queue
                showNextAlert();
            });
        }

        // Start the SignalR connection
        connection.start()
            .then(() => console.log("SignalR connected"))
            .catch(err => console.error("SignalR connection error:", err));
    </script>

    @await Html.PartialAsync("_YesNoModal")
</body>
</html>
