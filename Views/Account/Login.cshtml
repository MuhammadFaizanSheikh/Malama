@model Malama.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Malama</title>

    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/css/all.min.css" rel="stylesheet" />
    <link href="~/css/plus-jakarta-sans.css" rel="stylesheet" />

    <style>
        :root {
            --malama-indigo: rgba(80, 90, 201, 1);
            --malama-indigo-soft: rgba(80, 90, 201, 0.12);
            --malama-indigo-mid: rgba(80, 90, 201, 0.22);
            --text-main: #1f2430;
            --text-muted: #6b7285;
            --surface: rgba(255, 255, 255, 0.92);
            --border-soft: rgba(31, 36, 48, 0.08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Plus Jakarta Sans", sans-serif;
            color: var(--text-main);
            background:
                radial-gradient(1100px 520px at 8% -8%, rgba(80, 90, 201, 0.28), transparent 55%),
                radial-gradient(900px 480px at 100% 0%, rgba(56, 189, 248, 0.14), transparent 52%),
                radial-gradient(700px 420px at 70% 110%, rgba(80, 90, 201, 0.12), transparent 50%),
                linear-gradient(165deg, #e8ecf8 0%, #f4f6fb 48%, #eef1f8 100%);
            display: grid;
            place-items: center;
            padding: 1.5rem;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(80, 90, 201, 0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(80, 90, 201, 0.035) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: radial-gradient(circle at center, black 35%, transparent 85%);
            pointer-events: none;
            z-index: 0;
        }

        .login-shell {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 440px;
            animation: loginRise 0.55s ease both;
        }

        .login-brand {
            text-align: center;
            margin: 0 0 1.35rem;
            padding-bottom: 1.15rem;
            border-bottom: 1px solid rgba(31, 36, 48, 0.08);
        }

        .login-brand img {
            width: min(120px, 38vw);
            height: auto;
            display: block;
            margin: 0.15rem auto 0.7rem;
            filter: drop-shadow(0 10px 20px rgba(80, 90, 201, 0.18));
        }

        .login-brand-name {
            margin: 0;
            font-size: clamp(1.55rem, 3.5vw, 1.85rem);
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--malama-indigo);
            line-height: 1.1;
        }

        .login-brand-tag {
            margin: 0.35rem 0 0;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .login-panel {
            background: var(--surface);
            border: 1px solid var(--border-soft);
            border-radius: 22px;
            box-shadow:
                0 20px 50px rgba(21, 24, 33, 0.1),
                0 2px 0 rgba(255, 255, 255, 0.7) inset;
            backdrop-filter: blur(12px);
            padding: 1.7rem 1.55rem 1.45rem;
            overflow: hidden;
            position: relative;
        }

        .login-panel::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--malama-indigo), transparent);
        }

        .login-panel-title {
            margin: 0 0 0.25rem;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.01em;
        }

        .login-panel-sub {
            margin: 0 0 1.25rem;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .login-panel .form-label {
            font-size: 0.84rem;
            font-weight: 600;
            color: #4b5160;
            margin-bottom: 0.4rem;
        }

        .login-panel .form-control {
            min-height: 46px;
            border-radius: 12px;
            border-color: rgba(31, 36, 48, 0.12);
            padding: 0.65rem 0.9rem;
            font-size: 0.95rem;
            box-shadow: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .login-panel .form-control:focus {
            border-color: rgba(80, 90, 201, 0.55);
            box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.16);
        }

        .login-field {
            margin-bottom: 1rem;
            position: relative;
        }

        .login-field .input-icon {
            position: absolute;
            left: 14px;
            top: 40px;
            color: #8b91a1;
            pointer-events: none;
            font-size: 0.9rem;
        }

        .login-field .form-control.has-icon {
            padding-left: 2.35rem;
        }

        .btn-theme {
            background: var(--malama-indigo);
            border: 1px solid var(--malama-indigo);
            color: #fff;
            border-radius: 12px;
            min-height: 48px;
            font-weight: 700;
            letter-spacing: 0.01em;
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }

        .btn-theme:hover,
        .btn-theme:focus {
            background: rgb(60, 70, 180);
            border-color: rgb(60, 70, 180);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(80, 90, 201, 0.28);
        }

        .login-forgot {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            margin-top: 1rem;
            color: var(--malama-indigo);
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }

        .login-forgot:hover {
            color: rgb(60, 70, 180);
            opacity: 0.9;
            text-decoration: underline;
        }

        .login-panel .text-danger,
        .login-panel .validation-summary-errors {
            font-size: 0.86rem;
        }

        .login-panel .alert {
            border-radius: 12px;
            border: none;
            font-size: 0.9rem;
        }

        .login-panel .alert-info {
            background: var(--malama-indigo-soft);
            color: var(--malama-indigo);
        }

        .login-footer {
            margin-top: 1rem;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.8rem;
        }

        @@keyframes loginRise {
            from {
                opacity: 0;
                transform: translateY(16px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 480px) {
            .login-panel {
                padding: 1.3rem 1.15rem 1.2rem;
                border-radius: 18px;
            }
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-panel">
            <div class="login-brand">
                <img src="/images/Mālama-Circular.png" alt="Malama">
                <h1 class="login-brand-name">Malama</h1>
                <p class="login-brand-tag">Sign in to continue to your workspace</p>
            </div>

            <h2 class="login-panel-title">Welcome back</h2>
            <p class="login-panel-sub">Enter your credentials to access the dashboard.</p>

            <form method="post" asp-action="Login" autocomplete="off">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="login-field">
                    <label asp-for="Email" class="form-label">Email</label>
                    <i class="fas fa-envelope input-icon" aria-hidden="true"></i>
                    <input asp-for="Email" class="form-control has-icon" placeholder="Enter your email" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Password" class="form-label">Password</label>
                    <i class="fas fa-lock input-icon" aria-hidden="true"></i>
                    <input asp-for="Password" type="password" class="form-control has-icon" placeholder="Enter your password" autocomplete="off" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-theme w-100">
                        <i class="fas fa-sign-in-alt me-1" aria-hidden="true"></i>
                        Login
                    </button>
                </div>

                <div class="text-center">
                    <a href="javascript:void(0);" class="login-forgot" onclick="submitForgotPasswordForm()">
                        Forgot Password?
                    </a>
                </div>
            </form>

            <form id="forgotPasswordForm" method="post" asp-action="ForgotPassword">
                <input type="hidden" name="Email" id="forgotPasswordEmail" />
            </form>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-info mt-3 mb-0">
                    @ViewBag.Message
                </div>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.ErrorMessage
                </div>
            }
        </div>

        <p class="login-footer">Secure access for authorized Malama users</p>
    </div>

    <script src="~/js/jquery-3.6.0.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script>
        function submitForgotPasswordForm() {
            document.getElementById('forgotPasswordEmail').value = document.querySelector('input[name="Email"]').value;
            document.getElementById('forgotPasswordForm').submit();
        }
    </script>
</body>
</html>
