@model ExcelFilesCompiler.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    body {
        background-color: rgba(80, 90, 201, 0.1);
        height: 100vh;
        align-items: center;
        justify-content: center;
        margin: 0;
    }

    h2 {
        color: rgba(80, 90, 201, 1);
        text-align: center;
        margin-bottom: 20px;
    }

    .form-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        height: 40px;
    }

    .btn-theme {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white;
        width: 100%;
        padding: 10px;
    }

        .btn-theme:hover {
            background-color: rgba(80, 90, 201, 0.8);
            border-color: rgba(80, 90, 201, 0.8);
        }
</style>
<body>
    <div class="form-container">
        <h2>Change Password</h2>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">
                @ViewBag.SuccessMessage
            </div>
        }

        <form method="post" asp-action="ChangePassword" id="changePasswordForm">
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <div class="form-group">
                <label asp-for="CurrentPassword" class="font-weight-bold">Current Password</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter your current password" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword" class="font-weight-bold">New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter your new password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="font-weight-bold">Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your new password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-theme" id="changePasswordBtn">Change Password</button>
        </form>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger mt-3">
                @ViewBag.ErrorMessage
            </div>
        }
    </div>

    <!-- Bootstrap JS and dependencies (CDN) -->
    @* <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script> *@

</body>
</html>
