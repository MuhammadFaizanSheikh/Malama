@model Malama.Models.DentalXRayImageUploadModel

@{
    var downloadPrefix = Model.DownloadPrefix ?? Model.Prefix;
    var cardClass = Model.IsPaCard
        ? "card pa-card h-100 xray-upload-card"
        : Model.IsFullWidth
            ? "card h-100 xray-upload-card xray-upload-full-width"
            : "card h-100 xray-upload-card";
    var viewportClass = Model.IsFullWidth ? "xray-preview-viewport xray-preview-viewport-full" : "xray-preview-viewport";
}

<div class="@cardClass" @(Model.IsPaCard ? $"data-index=\"{Model.PaCardIndex}\"" : null)>
    <div class="card-body">
        @if (Model.IsPaCard)
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="card-title mb-0">@Model.Title</h6>
                @if (Model.ShowRemovePaCardButton && !Model.IsReadOnly)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger remove-pa-card" title="Remove">
                        <i class="fas fa-trash-alt" aria-hidden="true"></i>
                    </button>
                }
            </div>
            @if (!Model.IsReadOnly)
            {
                <input type="hidden" name="PaImages[@Model.PaCardIndex].Id" value="@Model.PaImageId" />
                <input type="hidden" name="PaImages[@Model.PaCardIndex].SortOrder" value="@Model.PaCardIndex" class="pa-sort-order" />
            }
        }
        else
        {
            <h6 class="card-title">@Model.Title</h6>
        }

        @if (Model.IsReadOnly)
        {
            @if (Model.Uploaded)
            {
                <div class="align-items-center gap-2 mt-2 xray-file-status d-flex"
                     id="@($"{Model.Prefix}_fileStatus")"
                     data-existing-filename="@Model.StoredFileName"
                     data-existing-original-filename="@Model.OriginalFileName"
                     data-download-prefix="@downloadPrefix"
                     data-preview-mode="server">
                    <span id="@($"{Model.Prefix}_fileNameDisplay")" class="small text-muted">
                        @(Model.OriginalFileName ?? Model.StoredFileName)
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-secondary preview-xray-file" data-prefix="@Model.Prefix">
                        <i class="fas fa-eye" aria-hidden="true"></i> Preview
                    </button>
                </div>

                @if (Model.UploadedDateTime.HasValue)
                {
                    <input type="text"
                           id="@($"{Model.Prefix}_uploadDate")"
                           class="form-control read-only-style mt-2"
                           value="@Model.UploadedDateTime?.ToString("MM/dd/yyyy hh:mm tt")"
                           readonly />
                }

                <div class="xray-preview-panel mt-3" id="@($"{Model.Prefix}_previewSection")" style="display:none;">
                    <label class="form-label fw-semibold mb-1">Image Preview</label>
                    <div class="@viewportClass" id="@($"{Model.Prefix}_previewViewport")">
                        <img id="@($"{Model.Prefix}_previewImg")" alt="X-Ray preview" />
                    </div>
                    <label class="form-label fw-semibold mt-2 mb-1">Zoom Controls</label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-primary xray-zoom-in" data-prefix="@Model.Prefix">
                            <i class="fas fa-search-plus" aria-hidden="true"></i> Zoom In
                        </button>
                        <button type="button" class="btn btn-sm btn-primary xray-zoom-out" data-prefix="@Model.Prefix">
                            <i class="fas fa-search-minus" aria-hidden="true"></i> Zoom Out
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary xray-zoom-reset" data-prefix="@Model.Prefix">
                            <i class="fas fa-undo" aria-hidden="true"></i> Reset
                        </button>
                    </div>
                    <p class="mb-0 small">Zoom Level: <span id="@($"{Model.Prefix}_zoomLevel")" class="text-primary fw-semibold">100%</span></p>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0 mt-2">No image uploaded.</p>
            }
        }
        else
        {
            <input type="file"
                   class="xray-file d-none @(Model.IsPaCard ? "pa-file" : "")"
                   name="@Model.FileInputName"
                   data-prefix="@Model.Prefix"
                   accept=".jpg,.jpeg,image/jpeg"
                   onchange="toggleXRayUploadDate(this, '@Model.Prefix')" />

            <button type="button"
                    class="btn btn-outline-primary btn-sm mt-1 open-xray-picker"
                    data-prefix="@Model.Prefix">
                <i class="fas fa-upload" aria-hidden="true"></i> Upload
            </button>

            <div class="align-items-center gap-2 mt-2 xray-file-status"
                 id="@($"{Model.Prefix}_fileStatus")"
                 style="display:@(Model.Uploaded ? "flex" : "none");"
                 data-existing-filename="@Model.StoredFileName"
                 data-existing-original-filename="@Model.OriginalFileName"
                 data-download-prefix="@downloadPrefix">
                <span id="@($"{Model.Prefix}_fileNameDisplay")" class="small text-muted">
                    @(Model.OriginalFileName ?? Model.StoredFileName)
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary preview-xray-file" data-prefix="@Model.Prefix">
                    <i class="fas fa-eye" aria-hidden="true"></i> Preview
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger remove-xray-file" data-prefix="@Model.Prefix">
                    <i class="fas fa-trash-alt" aria-hidden="true"></i> Remove
                </button>
            </div>

            <input type="hidden"
                   id="@($"{Model.Prefix}_uploaded")"
                   name="@Model.UploadedFieldName"
                   value="@(Model.Uploaded ? "true" : "false")" />
            <input type="hidden"
                   id="@($"{Model.Prefix}_fileName")"
                   name="@Model.FileNameFieldName"
                   value="@Model.StoredFileName" />
            <input type="hidden"
                   id="@($"{Model.Prefix}_originalFileName")"
                   name="@Model.OriginalFileNameFieldName"
                   value="@Model.OriginalFileName" />
            <input type="hidden"
                   id="@($"{Model.Prefix}_removed")"
                   name="@Model.RemovedFieldName"
                   value="false" />

            <input name="@Model.DateFieldName"
                   id="@($"{Model.Prefix}_uploadDate")"
                   class="form-control flatpickr mt-2"
                   type="text"
                   value="@(Model.UploadedDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "")"
                   style="display:@(Model.Uploaded ? "block" : "none");"
                   readonly />

            <div class="xray-preview-panel mt-3" id="@($"{Model.Prefix}_previewSection")" style="display:@(Model.Uploaded ? "block" : "none");">
                <label class="form-label fw-semibold mb-1">Image Preview</label>
                <div class="@viewportClass" id="@($"{Model.Prefix}_previewViewport")">
                    <img id="@($"{Model.Prefix}_previewImg")" alt="X-Ray preview" />
                </div>
                <label class="form-label fw-semibold mt-2 mb-1">Zoom Controls</label>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-primary xray-zoom-in" data-prefix="@Model.Prefix">
                        <i class="fas fa-search-plus" aria-hidden="true"></i> Zoom In
                    </button>
                    <button type="button" class="btn btn-sm btn-primary xray-zoom-out" data-prefix="@Model.Prefix">
                        <i class="fas fa-search-minus" aria-hidden="true"></i> Zoom Out
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary xray-zoom-reset" data-prefix="@Model.Prefix">
                        <i class="fas fa-undo" aria-hidden="true"></i> Reset
                    </button>
                </div>
                <p class="mb-0 small">Zoom Level: <span id="@($"{Model.Prefix}_zoomLevel")" class="text-primary fw-semibold">100%</span></p>
            </div>
        }
    </div>
</div>
