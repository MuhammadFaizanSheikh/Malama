@using ExcelFilesCompiler.Controllers.Services
@using ExcelFilesCompiler.Utilities
@using Malama.Models
@using Malama.Utilities
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model DentalXRayStationPageViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dental X-Ray Station";

    var station = Model.Station;
    var questionnaire = Model.Questionnaire;
    var sm = station.ServiceMembersChild;
    var isFemale = DentalXRayStationService.IsFemale(sm);
    var bwxNeeded = DentalXRayStationService.IsNeeded(sm?.BwxNeeded);
    var panoNeeded = DentalXRayStationService.IsNeeded(sm?.PanoNeeded);
    var paImages = station.PaImages?.OrderBy(p => p.SortOrder).ToList() ?? new List<DentalXRayPaImage>();
    if (!paImages.Any())
    {
        paImages.Add(new DentalXRayPaImage { SortOrder = 0 });
    }

    var vitalStationDto = ViewBag.VitalStation as VitalStationDto ?? new VitalStationDto
    {
        ServiceMembersChildId = station.ServiceMembersChildId,
        Status = "Pending"
    };
    var vitalsCompleted = ViewBag.VitalsCompleted as bool? ?? false;
    var canSaveDentalXRay = DashboardAuthorizationHelper.HasAccess(User, "DentalXRay_Save");

    var initialBwxUploadMode = station.BwxUploadMode;
    if (string.IsNullOrWhiteSpace(initialBwxUploadMode))
    {
        if (!string.IsNullOrWhiteSpace(station.BwxConsolidatedFileName))
        {
            initialBwxUploadMode = BwxUploadMode.Consolidated;
        }
        else if (!string.IsNullOrWhiteSpace(station.BwLeftMolarFileName)
            || !string.IsNullOrWhiteSpace(station.BwLeftPremolarFileName)
            || !string.IsNullOrWhiteSpace(station.BwRightMolarFileName)
            || !string.IsNullOrWhiteSpace(station.BwRightPremolarFileName))
        {
            initialBwxUploadMode = BwxUploadMode.Separate;
        }
    }
}

<style>
    .dxr-station {
        --dxr-indigo: rgba(80, 90, 201, 1);
        --dxr-indigo-soft: rgba(80, 90, 201, 0.12);
        --dxr-indigo-mid: rgba(80, 90, 201, 0.22);
        --dxr-text: #1f2430;
        --dxr-muted: #6b7285;
        --dxr-surface: #ffffff;
        --dxr-border: rgba(31, 36, 48, 0.08);
        --dxr-shadow: 0 10px 28px rgba(21, 24, 33, 0.06);
        --dxr-radius: 16px;
    }

    .dxr-station .btn-general {
        background: var(--dxr-indigo);
        border: 1px solid var(--dxr-indigo);
        color: #fff;
        border-radius: 10px;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .dxr-station .btn-general:hover:not(:disabled) {
        background: rgb(60, 70, 180);
        border-color: rgb(60, 70, 180);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(80, 90, 201, 0.25);
    }

    .dxr-station .btn-general:disabled {
        opacity: 0.55;
    }

    .dxr-station .btn-back-confirm {
        border-radius: 10px;
        font-weight: 600;
        background: #fff;
        color: #4b5160;
        border: 1px solid rgba(31, 36, 48, 0.14);
    }

    .dxr-station .btn-back-confirm:hover {
        background: #f3f4f8;
        color: #1f2430;
        border-color: rgba(31, 36, 48, 0.22);
    }

    .dxr-hero {
        margin-bottom: 1.25rem;
        padding: 0.1rem 0.15rem 0.25rem;
    }

    .dxr-kicker {
        margin: 0 0 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--dxr-indigo);
    }

    .dxr-title {
        margin: 0;
        font-size: clamp(1.45rem, 2.1vw, 1.9rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--dxr-text);
    }

    .dxr-subtitle {
        margin: 0.4rem 0 0;
        color: var(--dxr-muted);
        font-size: 0.95rem;
    }

    .dxr-panel {
        background: var(--dxr-surface);
        border: 1px solid var(--dxr-border);
        border-radius: var(--dxr-radius);
        box-shadow: var(--dxr-shadow);
        padding: 1.15rem 1.25rem 1.2rem;
        margin-bottom: 1.1rem;
    }

    .dxr-panel-title {
        margin: 0 0 1rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--dxr-text);
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .dxr-panel-title i {
        color: var(--dxr-indigo);
    }

    .dxr-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem 1rem;
    }

    .dxr-info-item {
        padding: 0.75rem 0.85rem;
        border-radius: 12px;
        background: linear-gradient(180deg, #f8f9fc 0%, #f3f5fa 100%);
        border: 1px solid var(--dxr-border);
    }

    .dxr-info-label {
        display: block;
        margin-bottom: 0.2rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--dxr-muted);
    }

    .dxr-info-value {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--dxr-text);
        word-break: break-word;
    }

    .dxr-station .form-label {
        font-size: 0.84rem;
        font-weight: 600;
        color: #4b5160;
    }

    .dxr-station .form-control,
    .dxr-station .form-select {
        border-radius: 10px;
        border-color: rgba(31, 36, 48, 0.12);
        min-height: 42px;
        box-shadow: none;
    }

    .dxr-station .form-control:focus,
    .dxr-station .form-select:focus {
        border-color: rgba(80, 90, 201, 0.55);
        box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.18);
    }

    .dxr-station .card,
    .dxr-station .xray-upload-card {
        border: 1px solid var(--dxr-border) !important;
        border-radius: 14px !important;
        box-shadow: var(--dxr-shadow);
        background: var(--dxr-surface);
        overflow: hidden;
    }

    .dxr-station .xray-upload-card .card-body {
        padding: 1rem 1.05rem 1.1rem;
    }

    .dxr-station .xray-upload-card .card-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--dxr-text);
        margin-bottom: 0.75rem;
    }

    .dxr-station .open-xray-picker,
    .dxr-station .xray-zoom-in,
    .dxr-station .xray-zoom-out {
        background: var(--dxr-indigo) !important;
        border-color: var(--dxr-indigo) !important;
        color: #fff !important;
        border-radius: 8px;
        font-weight: 600;
    }

    .dxr-station .open-xray-picker:hover,
    .dxr-station .xray-zoom-in:hover,
    .dxr-station .xray-zoom-out:hover {
        background: rgb(60, 70, 180) !important;
        border-color: rgb(60, 70, 180) !important;
    }

    .dxr-station .preview-xray-file,
    .dxr-station .xray-zoom-reset,
    .dxr-station #addPaCardBtn {
        border-radius: 8px;
        font-weight: 600;
        border-color: var(--dxr-indigo-mid);
        color: var(--dxr-indigo);
    }

    .dxr-station .preview-xray-file:hover,
    .dxr-station .xray-zoom-reset:hover,
    .dxr-station #addPaCardBtn:hover {
        background: var(--dxr-indigo-soft);
        border-color: var(--dxr-indigo);
        color: var(--dxr-indigo);
    }

    .dxr-station .remove-xray-file,
    .dxr-station .remove-pa-card {
        border-radius: 8px;
        font-weight: 600;
    }

    .dxr-station .xray-file-status {
        padding: 0.55rem 0.7rem;
        border-radius: 10px;
        background: #f7f8fc;
        border: 1px solid var(--dxr-border);
    }

    .dxr-notice {
        margin: 0 0 1rem;
        padding: 0.85rem 1rem;
        border-radius: 12px;
        background: var(--dxr-indigo-soft);
        border: 1px solid var(--dxr-indigo-mid);
        color: var(--dxr-indigo);
        font-weight: 700;
    }

    .dxr-notice.is-warning {
        background: rgba(217, 119, 6, 0.1);
        border-color: rgba(217, 119, 6, 0.28);
        color: #b45309;
    }

    .dxr-footer-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.5rem;
        padding: 1rem 0 0.25rem;
        position: sticky;
        bottom: 0;
        background: linear-gradient(180deg, transparent, rgba(247, 248, 252, 0.95) 28%);
        z-index: 5;
    }

    .xray-cards-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    @@media (max-width: 992px) {
        .xray-cards-row { grid-template-columns: 1fr; }
        .dxr-info-grid { grid-template-columns: 1fr; }
    }

    .xray-upload-full-width { width: 100%; }
    .xray-preview-viewport-full { height: 360px; }
    .bwx-upload-mode-option { margin-bottom: 0.65rem; }

    .xray-preview-viewport {
        width: 100%;
        height: 280px;
        overflow: auto;
        border: 1px solid rgba(31, 36, 48, 0.1);
        border-radius: 12px;
        background:
            linear-gradient(45deg, #eef0f5 25%, transparent 25%),
            linear-gradient(-45deg, #eef0f5 25%, transparent 25%),
            linear-gradient(45deg, transparent 75%, #eef0f5 75%),
            linear-gradient(-45deg, transparent 75%, #eef0f5 75%);
        background-size: 20px 20px;
        background-position: 0 0, 0 10px, 10px -10px, -10px 0;
        background-color: #f4f6fa;
    }

    .xray-preview-viewport.can-pan { cursor: grab; }
    .xray-preview-viewport.can-pan.is-panning {
        cursor: grabbing;
        user-select: none;
    }

    .xray-preview-viewport img {
        display: block;
        width: 100%;
        height: auto;
        max-width: none;
        transform-origin: top left;
        -webkit-user-drag: none;
        user-select: none;
    }

    .read-only-style {
        background-color: #f3f5fa !important;
        pointer-events: none;
        border-color: rgba(31, 36, 48, 0.1) !important;
    }

    .condition-detail { display: none; }
    .condition-item { margin-bottom: 0.85rem; }

    .dxr-station .condition-item .form-check {
        padding: 0.55rem 0.7rem;
        border-radius: 10px;
        background: #f7f8fc;
        border: 1px solid transparent;
    }

    .dxr-station .condition-item .form-check:hover {
        border-color: var(--dxr-indigo-mid);
    }

    .questionnaire-detail,
    .tobacco-type-detail { display: none; }

    #tobaccoDetailsSection {
        border: 1px solid var(--dxr-border) !important;
        border-radius: 12px !important;
        background: #f9fafc;
    }
</style>

<section class="dxr-station">
<div class="dxr-hero">
    <p class="dxr-kicker">Clinical station</p>
    <h1 class="dxr-title" id="page-heading">Dental X-Ray Station</h1>
    <p class="dxr-subtitle">Review member details, complete the questionnaire, and upload required X-Ray images.</p>
</div>

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            Swal.fire({
                icon: '@TempData["ResponseStatus"]',
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor,
                iconColor: iconColor
            });
        });
    </script>
}

<form id="SaveDentalXRayStation" asp-action="SaveDentalXRayStation" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@station.Id" />
    <input type="hidden" name="ServiceMembersChildId" value="@station.ServiceMembersChildId" />
    <input type="hidden" name="SubmissionToken" id="SubmissionToken" value="@Guid.NewGuid()" />
    <input type="hidden" name="GoToVitalStation" id="GoToVitalStationFlag" value="false" />

    <div class="dxr-panel">
        <h2 class="dxr-panel-title"><i class="fas fa-user" aria-hidden="true"></i> Personal Information</h2>
        <div class="dxr-info-grid">
            <div class="dxr-info-item">
                <span class="dxr-info-label">Full Name</span>
                <p class="dxr-info-value">@sm?.FullName</p>
            </div>
            <div class="dxr-info-item">
                <span class="dxr-info-label">DOD ID</span>
                <p class="dxr-info-value">@sm?.DodId</p>
            </div>
            <div class="dxr-info-item">
                <span class="dxr-info-label">Routing Sheet Barcode</span>
                <p class="dxr-info-value">@sm?.Barcode</p>
            </div>
            <div class="dxr-info-item">
                <span class="dxr-info-label">DOB</span>
                <p class="dxr-info-value">@sm?.Dob</p>
            </div>
            <div class="dxr-info-item">
                <span class="dxr-info-label">Age</span>
                <p class="dxr-info-value">@sm?.Age</p>
            </div>
            <div class="dxr-info-item">
                <span class="dxr-info-label">Sex</span>
                <p class="dxr-info-value">@sm?.Sex</p>
            </div>
            <div class="dxr-info-item">
                <span class="dxr-info-label">DRC</span>
                <p class="dxr-info-value">@sm?.Drc</p>
            </div>
        </div>
    </div>

    <div class="dxr-panel">
        <h2 class="dxr-panel-title"><i class="fas fa-clipboard-list" aria-hidden="true"></i> Questionnaire</h2>
        @await Html.PartialAsync("_DentalXRayQuestionnaire", questionnaire)

    @if (isFemale)
    {
        <div class="row mb-3" id="pregnancyQuestionSection">
            <div class="col-md-6 mb-3">
                <label class="form-label">12. Are you pregnant?</label>
                <select name="AreYouPregnant" id="AreYouPregnant" class="form-select" required>
                    <option value="No" selected="@(string.IsNullOrWhiteSpace(questionnaire.AreYouPregnant) || questionnaire.AreYouPregnant == "No")">No</option>
                    <option value="Yes" selected="@(questionnaire.AreYouPregnant == "Yes")">Yes</option>
                </select>
            </div>
        </div>

        <div class="row mb-3" id="pregnancyApprovalSection" style="display:none;">
            <div class="col-md-12">
                <p class="dxr-notice is-warning">Approval is needed from Service Member before going to X-Ray</p>
                <select name="PregnancyApproval" id="PregnancyApproval" class="form-select">
                    <option value=""></option>
                    <option value="Approved" selected="@(questionnaire.PregnancyApproval == "Approved")">Approved</option>
                    <option value="Declined" selected="@(questionnaire.PregnancyApproval == "Declined")">Declined</option>
                </select>
            </div>
        </div>
    }

    @{
        var healthConditionsQuestionNumber = isFemale ? 13 : 12;
        var savedHealthConditions = DentalQuestionnaireService.ParseHealthConditionsJson(questionnaire.ApplicableHealthConditionsJson);
        var savedByCondition = savedHealthConditions
            .Where(h => !string.IsNullOrWhiteSpace(h.Condition))
            .ToDictionary(h => h.Condition, h => h, StringComparer.OrdinalIgnoreCase);

        bool IsConditionSelected(string condition) => savedByCondition.ContainsKey(condition);
        string GetConditionDetail(string condition) =>
            savedByCondition.TryGetValue(condition, out var item) ? item.Detail ?? "" : "";
    }
    <div class="dxr-panel mb-0" style="box-shadow:none; border:1px dashed rgba(80,90,201,0.25); background:#f9fafd;">
        <label class="form-label fw-semibold mb-3">@healthConditionsQuestionNumber. Check the following conditions if they apply to you:</label>
        <div class="row condition-checkboxes">
            @for (var ci = 0; ci < DentalXRayQuestionnaire.HealthConditions.Length; ci++)
            {
                var condition = DentalXRayQuestionnaire.HealthConditions[ci];
                var isSelected = IsConditionSelected(condition);
                var detail = GetConditionDetail(condition);
                <div class="col-md-6 condition-item">
                    <input type="hidden" name="HealthConditionDetails[@ci].Condition" value="@condition" />
                    <div class="form-check">
                        <input class="form-check-input condition-checkbox" type="checkbox"
                               name="ApplicableHealthConditions"
                               value="@condition"
                               id="condition_@ci"
                               checked="@isSelected" />
                        <label class="form-check-label" for="condition_@ci">@condition</label>
                    </div>
                    <div class="condition-detail ms-4 mt-1">
                        <textarea name="HealthConditionDetails[@ci].Detail"
                                  class="form-control condition-detail-text"
                                  rows="3"
                                  placeholder="Please provide details">@detail</textarea>
                    </div>
                </div>
            }
            @{
                var otherIndex = DentalXRayQuestionnaire.HealthConditions.Length;
                var otherCondition = DentalXRayQuestionnaire.OtherHealthCondition;
                var otherSelected = IsConditionSelected(otherCondition);
                var otherDetail = GetConditionDetail(otherCondition);
            }
            <div class="col-md-6 condition-item">
                <input type="hidden" name="HealthConditionDetails[@otherIndex].Condition" value="@otherCondition" />
                <div class="form-check">
                    <input class="form-check-input condition-checkbox" type="checkbox"
                           name="ApplicableHealthConditions"
                           value="@otherCondition"
                           id="condition_other"
                           checked="@otherSelected" />
                    <label class="form-check-label" for="condition_other">@otherCondition</label>
                </div>
                <div class="condition-detail ms-4 mt-1">
                    <textarea name="HealthConditionDetails[@otherIndex].Detail"
                              class="form-control condition-detail-text"
                              rows="3"
                              placeholder="Please provide details">@otherDetail</textarea>
                </div>
            </div>
        </div>
    </div>
    </div>

    @{
        var vitalBpViewData = new ViewDataDictionary<VitalStationDto>(ViewData, vitalStationDto);
        vitalBpViewData["ShowVitalRedirect"] = !vitalsCompleted;
        vitalBpViewData["AllowVitalStationSubmit"] = canSaveDentalXRay;
        vitalBpViewData["BpCountdownIdPrefix"] = "dentalBpCountdown";
    }
    <div class="dxr-panel">
        <h2 class="dxr-panel-title"><i class="fas fa-heartbeat" aria-hidden="true"></i> Vitals</h2>
        @await Html.PartialAsync("_VitalStationBpSummary", vitalStationDto, vitalBpViewData)
    </div>

    <div id="clinicalStationSection" style="@(isFemale ? "display:none;" : "")">
        <div id="xrayStationSection">
        <div class="dxr-panel">
        <h2 class="dxr-panel-title"><i class="fas fa-file-medical" aria-hidden="true"></i> X-Ray Station</h2>

        @if (bwxNeeded)
        {
            <div class="card mb-4" id="bwxSection">
                <div class="card-body">
                    <div class="row mb-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">BWX Status</label>
                            <select name="BwxStatus" id="BwxStatus" class="form-select">
                                <option value=""></option>
                                <option value="Completed" selected="@(station.BwxStatus == "Completed")">Completed</option>
                                <option value="Not Completed" selected="@(station.BwxStatus == "Not Completed")">Not Completed</option>
                            </select>
                        </div>
                        @if (station.Id != 0 && station.BwxUploadedDateTime.HasValue)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Uploaded datetime</label>
                                <input type="text" class="form-control read-only-style"
                                       value="@station.BwxUploadedDateTime?.ToString("MM/dd/yyyy hh:mm tt")" readonly />
                            </div>
                        }
                    </div>

                    <div id="bwxReasonContainer" style="display:none;" class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Reason</label>
                            <select name="BwxReason" id="BwxReason" class="form-select">
                                <option value=""></option>
                                <option value="Insufficient Supplies">Insufficient Supplies</option>
                                <option value="Refused">Refused</option>
                                <option value="Contraindication">Contraindication</option>
                                <option value="Excused">Excused</option>
                                <option value="Proof of Service">Proof of Service</option>
                            </select>
                        </div>
                    </div>

                    <div id="bwxUploadModeSection" style="display:none;" class="mb-3">
                        <p class="mb-2">Do you want to upload BWX ray :</p>
                        <div class="bwx-upload-mode-option">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="BwxUploadMode" id="BwxModeConsolidated"
                                       value="@BwxUploadMode.Consolidated"
                                       checked="@(initialBwxUploadMode == BwxUploadMode.Consolidated)" />
                                <label class="form-check-label" for="BwxModeConsolidated">
                                    As a single JPG image file that consolidates all the BWX rays into one cohesive image?
                                </label>
                            </div>
                        </div>
                        <div class="bwx-upload-mode-option">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="BwxUploadMode" id="BwxModeSeparate"
                                       value="@BwxUploadMode.Separate"
                                       checked="@(initialBwxUploadMode == BwxUploadMode.Separate)" />
                                <label class="form-check-label" for="BwxModeSeparate">
                                    Upload each individual BWX ray separately?
                                </label>
                            </div>
                        </div>
                    </div>

                    <div id="bwxConsolidatedUploadContainer" style="display:none;">
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_consolidated",
                            Title = "Consolidated BWX",
                            FileInputName = "BwxConsolidatedFile",
                            UploadedFieldName = "BwxConsolidatedUploaded",
                            FileNameFieldName = "BwxConsolidatedFileName",
                            OriginalFileNameFieldName = "BwxConsolidatedOriginalFileName",
                            DateFieldName = "BwxConsolidatedUploadedDateTime",
                            RemovedFieldName = "BwxConsolidatedRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwxConsolidatedFileName),
                            StoredFileName = station.BwxConsolidatedFileName,
                            OriginalFileName = station.BwxConsolidatedOriginalFileName,
                            UploadedDateTime = station.BwxConsolidatedUploadedDateTime,
                            IsFullWidth = true
                        })
                    </div>

                    <div id="bwxSeparateUploadContainer" style="display:none;" class="xray-cards-row">
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_left_molar",
                            Title = "BW Left Molar",
                            FileInputName = "BwLeftMolarFile",
                            UploadedFieldName = "BwLeftMolarUploaded",
                            FileNameFieldName = "BwLeftMolarFileName",
                            OriginalFileNameFieldName = "BwLeftMolarOriginalFileName",
                            DateFieldName = "BwLeftMolarUploadedDateTime",
                            RemovedFieldName = "BwLeftMolarRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwLeftMolarFileName),
                            StoredFileName = station.BwLeftMolarFileName,
                            OriginalFileName = station.BwLeftMolarOriginalFileName,
                            UploadedDateTime = station.BwLeftMolarUploadedDateTime
                        })
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_left_premolar",
                            Title = "BW Left Premolar",
                            FileInputName = "BwLeftPremolarFile",
                            UploadedFieldName = "BwLeftPremolarUploaded",
                            FileNameFieldName = "BwLeftPremolarFileName",
                            OriginalFileNameFieldName = "BwLeftPremolarOriginalFileName",
                            DateFieldName = "BwLeftPremolarUploadedDateTime",
                            RemovedFieldName = "BwLeftPremolarRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwLeftPremolarFileName),
                            StoredFileName = station.BwLeftPremolarFileName,
                            OriginalFileName = station.BwLeftPremolarOriginalFileName,
                            UploadedDateTime = station.BwLeftPremolarUploadedDateTime
                        })
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_right_molar",
                            Title = "BW Right Molar",
                            FileInputName = "BwRightMolarFile",
                            UploadedFieldName = "BwRightMolarUploaded",
                            FileNameFieldName = "BwRightMolarFileName",
                            OriginalFileNameFieldName = "BwRightMolarOriginalFileName",
                            DateFieldName = "BwRightMolarUploadedDateTime",
                            RemovedFieldName = "BwRightMolarRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwRightMolarFileName),
                            StoredFileName = station.BwRightMolarFileName,
                            OriginalFileName = station.BwRightMolarOriginalFileName,
                            UploadedDateTime = station.BwRightMolarUploadedDateTime
                        })
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_right_premolar",
                            Title = "BW Right Premolar",
                            FileInputName = "BwRightPremolarFile",
                            UploadedFieldName = "BwRightPremolarUploaded",
                            FileNameFieldName = "BwRightPremolarFileName",
                            OriginalFileNameFieldName = "BwRightPremolarOriginalFileName",
                            DateFieldName = "BwRightPremolarUploadedDateTime",
                            RemovedFieldName = "BwRightPremolarRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwRightPremolarFileName),
                            StoredFileName = station.BwRightPremolarFileName,
                            OriginalFileName = station.BwRightPremolarOriginalFileName,
                            UploadedDateTime = station.BwRightPremolarUploadedDateTime
                        })
                    </div>
                </div>
            </div>

            <div class="card mb-4" id="paSection">
                <div class="card-body">
                    <div class="row mb-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Periapical (PA) X-Rays Status</label>
                            <select name="PaStatus" id="PaStatus" class="form-select">
                                <option value=""></option>
                                <option value="Completed" selected="@(station.PaStatus == "Completed")">Completed</option>
                                <option value="Not Completed" selected="@(station.PaStatus == "Not Completed")">Not Completed</option>
                            </select>
                        </div>
                        @if (station.Id != 0 && station.PaUploadedDateTime.HasValue)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Uploaded datetime</label>
                                <input type="text" class="form-control read-only-style"
                                       value="@station.PaUploadedDateTime?.ToString("MM/dd/yyyy hh:mm tt")" readonly />
                            </div>
                        }
                    </div>

                    <div id="paReasonContainer" style="display:none;" class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Reason</label>
                            <select name="PaReason" id="PaReason" class="form-select">
                                <option value=""></option>
                                <option value="Insufficient Supplies">Insufficient Supplies</option>
                                <option value="Refused">Refused</option>
                                <option value="Contraindication">Contraindication</option>
                                <option value="Excused">Excused</option>
                                <option value="Proof of Service">Proof of Service</option>
                            </select>
                        </div>
                    </div>

                    <div id="paUploadContainer" style="display:none;">
                        <div class="d-flex justify-content-end mb-2 gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="addPaCardBtn">
                                <i class="fas fa-plus" aria-hidden="true"></i> Add PA Card
                            </button>
                        </div>
                        <div id="paCardsRow" class="xray-cards-row">
                            @for (var i = 0; i < paImages.Count; i++)
                            {
                                var pa = paImages[i];
                                var prefix = $"pa_{i}";
                                @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                                    Prefix = prefix,
                                    Title = "PA of tooth",
                                    FileInputName = $"PaImages[{i}].ImageFile",
                                    UploadedFieldName = $"PaImages[{i}].Uploaded",
                                    FileNameFieldName = $"PaImages[{i}].FileName",
                                    OriginalFileNameFieldName = $"PaImages[{i}].OriginalFileName",
                                    DateFieldName = $"PaImages[{i}].UploadedDateTime",
                                    RemovedFieldName = $"PaImages[{i}].Removed",
                                    DownloadPrefix = "pa_tooth",
                                    Uploaded = !string.IsNullOrWhiteSpace(pa.FileName),
                                    StoredFileName = pa.FileName,
                                    OriginalFileName = pa.OriginalFileName,
                                    UploadedDateTime = pa.UploadedDateTime,
                                    IsPaCard = true,
                                    PaCardIndex = i,
                                    PaImageId = pa.Id,
                                    ShowRemovePaCardButton = i > 0
                                })
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="mb-4" id="panoSection">
            <div class="card">
                <div class="card-body">
                    <label class="form-label" for="Comment">Comment</label>
                    <textarea name="Comment" id="Comment" class="form-control" rows="4">@station.Comment</textarea>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="Status" id="Status" class="form-select read-only-style" disabled>
                    <option value="Pending" selected="@(station.Status != "Completed")">Pending</option>
                    <option value="Completed" selected="@(station.Status == "Completed")">Completed</option>
                </select>
                <input type="hidden" name="Status" id="StatusHidden" value="@(string.IsNullOrWhiteSpace(station.Status) ? "Pending" : station.Status)" />
            </div>
        </div>

        @if (panoNeeded)
        {
            <p class="dxr-notice">Panorex (Pano) X-ray is Required for this Service member</p>
        }
        else
        {
            <p class="dxr-notice" style="background:#f3f4f8;border-color:rgba(31,36,48,0.1);color:#4b5160;">Panorex (Pano) X-ray is NOT Required for this Service member</p>
        }
        </div>
        </div>
    </div>

    <div class="dxr-footer-actions">
        <button type="submit" class="btn btn-general btn-lg" @(DashboardAuthorizationHelper.HasAccess(User, "DentalXRay_Save") ? "" : "disabled")>
            <i class="fas fa-check-circle" aria-hidden="true"></i> Save
        </button>
        <a asp-action="Index" class="btn btn-secondary btn-lg btn-back-confirm">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Back
        </a>
    </div>
</form>
</section>

<script>
    const IS_FEMALE = @Json.Serialize(isFemale);
    const BWX_NEEDED = @Json.Serialize(bwxNeeded);
    const MAX_PA_CARDS = 8;
    const XRAY_ZOOM_STEP = 25;
    const XRAY_ZOOM_MIN = 50;
    const XRAY_ZOOM_MAX = 300;
    let paCardIndex = @paImages.Count;
    const xrayZoomLevels = {};
    const xrayPanState = {
        active: false,
        viewport: null,
        startX: 0,
        startY: 0,
        scrollLeft: 0,
        scrollTop: 0
    };

    function syncPaAddButton() {
        const count = $("#paCardsRow .pa-card").length;
        const atMax = count >= MAX_PA_CARDS;
        $("#addPaCardBtn").prop("disabled", atMax);
        $("#addPaCardBtn").attr("title", atMax ? "Maximum of 8 PA X-Ray uploads allowed" : "");
    }

    function setFlatpickrVisibility(input, show) {
        if (!input) return;
        input.style.display = show ? "block" : "none";
        if (input._flatpickr?.altInput) {
            input._flatpickr.altInput.style.display = show ? "block" : "none";
        }
    }

    function getCurrentDateTimeValue() {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, "0");
        const day = String(now.getDate()).padStart(2, "0");
        const hour = String(now.getHours()).padStart(2, "0");
        const minute = String(now.getMinutes()).padStart(2, "0");
        return `${year}-${month}-${day} ${hour}:${minute}`;
    }

    function toggleXRayUploadDate(input, prefix) {
        const datePicker = document.getElementById(prefix + "_uploadDate");
        const hiddenUploaded = document.getElementById(prefix + "_uploaded");
        const now = getCurrentDateTimeValue();

        if (input.files && input.files.length > 0) {
            setFlatpickrVisibility(datePicker, true);
            hiddenUploaded.value = "true";
            datePicker.value = now;
            if (datePicker?._flatpickr) {
                datePicker._flatpickr.setDate(now, true, "Y-m-d H:i");
            }
        }
        updateXRayFileUI(prefix);
        updateOverallStatus();
    }

    function setXRayZoom(prefix, level) {
        const previewImg = document.getElementById(prefix + "_previewImg");
        const zoomLabel = document.getElementById(prefix + "_zoomLevel");
        if (!previewImg || !zoomLabel) return;

        const clamped = Math.max(XRAY_ZOOM_MIN, Math.min(XRAY_ZOOM_MAX, level));
        xrayZoomLevels[prefix] = clamped;

        // Zoom the image inside a fixed viewport; do not resize the viewer panel.
        previewImg.style.width = clamped + "%";
        previewImg.style.height = "auto";
        previewImg.style.transform = "";
        previewImg.draggable = false;
        zoomLabel.textContent = clamped + "%";
        requestAnimationFrame(function () {
            updateXRayPanAvailability(prefix);
        });
    }

    function updateXRayPanAvailability(prefix) {
        const viewport = document.getElementById(prefix + "_previewViewport");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (!viewport) return;

        const canPan = !!previewImg?.src &&
            (viewport.scrollWidth > viewport.clientWidth + 1 ||
             viewport.scrollHeight > viewport.clientHeight + 1);

        viewport.classList.toggle("can-pan", canPan);
        viewport.title = canPan ? "Click and drag to move the image" : "";
        if (previewImg) {
            previewImg.draggable = false;
        }
    }

    function startXRayPan(clientX, clientY, viewport) {
        xrayPanState.active = true;
        xrayPanState.viewport = viewport;
        xrayPanState.startX = clientX;
        xrayPanState.startY = clientY;
        xrayPanState.scrollLeft = viewport.scrollLeft;
        xrayPanState.scrollTop = viewport.scrollTop;
        viewport.classList.add("is-panning");
    }

    function moveXRayPan(clientX, clientY) {
        if (!xrayPanState.active || !xrayPanState.viewport) return;

        const dx = clientX - xrayPanState.startX;
        const dy = clientY - xrayPanState.startY;
        xrayPanState.viewport.scrollLeft = xrayPanState.scrollLeft - dx;
        xrayPanState.viewport.scrollTop = xrayPanState.scrollTop - dy;
    }

    function endXRayPan() {
        if (!xrayPanState.active) return;

        xrayPanState.viewport?.classList.remove("is-panning");
        xrayPanState.active = false;
        xrayPanState.viewport = null;
    }

    function updateXRayPreview(prefix) {
        const previewSection = document.getElementById(prefix + "_previewSection");
        const previewImg = document.getElementById(prefix + "_previewImg");
        const status = document.getElementById(prefix + "_fileStatus");
        const hiddenFileName = document.getElementById(prefix + "_fileName");
        const removedInput = document.getElementById(prefix + "_removed");

        if (!previewSection || !previewImg || !status) return;

        const removed = removedInput?.value === "true";
        let src = "";

        if (status.dataset.previewMode === "selected" && status.dataset.selectedPreviewUrl) {
            src = status.dataset.selectedPreviewUrl;
        } else if (!removed && status.dataset.previewMode === "server") {
            const fileName = (hiddenFileName?.value || status.dataset.existingFilename || "").trim();
            const downloadPrefix = status.dataset.downloadPrefix || prefix;
            if (fileName) {
                src = "/DentalXRay/DownloadXRayImage?prefix=" + encodeURIComponent(downloadPrefix) + "&fileName=" + encodeURIComponent(fileName);
            }
        }

        if (src) {
            previewImg.onload = function () {
                setXRayZoom(prefix, xrayZoomLevels[prefix] || 100);
                updateXRayPanAvailability(prefix);
            };
            previewImg.src = src;
            previewSection.style.display = "block";
            if (previewImg.complete) {
                setXRayZoom(prefix, xrayZoomLevels[prefix] || 100);
            }
        } else {
            previewImg.removeAttribute("src");
            previewSection.style.display = "none";
            delete xrayZoomLevels[prefix];
        }
    }

    function updateXRayFileUI(prefix) {
        const fileInput = document.querySelector(`.xray-file[data-prefix='${prefix}']`);
        const status = document.getElementById(prefix + "_fileStatus");
        const fileNameDisplay = document.getElementById(prefix + "_fileNameDisplay");
        const hiddenUploaded = document.getElementById(prefix + "_uploaded");
        const hiddenFileName = document.getElementById(prefix + "_fileName");
        const hiddenOriginalFileName = document.getElementById(prefix + "_originalFileName");
        const removedInput = document.getElementById(prefix + "_removed");

        if (!fileInput || !status || !fileNameDisplay || !hiddenUploaded || !hiddenFileName) return;

        const selectedFile = fileInput.files && fileInput.files.length > 0 ? fileInput.files[0] : null;
        const existingFileName = (status.dataset.existingFilename || "").trim();
        const existingOriginalFileName = (status.dataset.existingOriginalFilename || "").trim();
        const removedExisting = removedInput?.value === "true";

        if (selectedFile) {
            fileNameDisplay.textContent = selectedFile.name;
            status.style.display = "flex";
            hiddenUploaded.value = "true";
            hiddenFileName.value = "";
            if (hiddenOriginalFileName) hiddenOriginalFileName.value = selectedFile.name;
            if (removedInput) removedInput.value = "false";

            const prevUrl = status.dataset.selectedPreviewUrl;
            if (prevUrl) URL.revokeObjectURL(prevUrl);
            status.dataset.selectedPreviewUrl = URL.createObjectURL(selectedFile);
            status.dataset.previewMode = "selected";
            updateXRayPreview(prefix);
            return;
        }

        if (status.dataset.selectedPreviewUrl) {
            URL.revokeObjectURL(status.dataset.selectedPreviewUrl);
            status.dataset.selectedPreviewUrl = "";
        }

        if (existingFileName && !removedExisting) {
            fileNameDisplay.textContent = existingOriginalFileName || existingFileName;
            status.style.display = "flex";
            hiddenUploaded.value = "true";
            hiddenFileName.value = existingFileName;
            if (hiddenOriginalFileName) hiddenOriginalFileName.value = existingOriginalFileName;
            status.dataset.previewMode = "server";
            updateXRayPreview(prefix);
            return;
        }

        fileNameDisplay.textContent = "";
        status.style.display = "none";
        hiddenUploaded.value = "false";
        hiddenFileName.value = "";
        if (hiddenOriginalFileName) hiddenOriginalFileName.value = "";
        status.dataset.previewMode = "";
        updateXRayPreview(prefix);
    }

    function toggleReasonAndUpload(statusSelector, reasonContainer, uploadContainer, reasonSelector) {
        const status = $(statusSelector).val();
        $(reasonContainer).hide();
        $(uploadContainer).hide();
        $(reasonSelector).prop("required", false);

        if (status === "Not Completed") {
            $(reasonContainer).show();
            $(reasonSelector).prop("required", true);
        } else if (status === "Completed") {
            $(uploadContainer).show();
        }
    }

    function toggleBwxSection() {
        const status = $("#BwxStatus").val();
        $("#bwxReasonContainer").hide();
        $("#bwxUploadModeSection").hide();
        $("#bwxConsolidatedUploadContainer").hide();
        $("#bwxSeparateUploadContainer").hide();
        $("#BwxReason").prop("required", false);

        if (status === "Not Completed") {
            $("#bwxReasonContainer").show();
            $("#BwxReason").prop("required", true);
        } else if (status === "Completed") {
            $("#bwxUploadModeSection").show();
            toggleBwxUploadContainers();
        }
    }

    function toggleBwxUploadContainers() {
        if ($("#BwxStatus").val() !== "Completed") {
            return;
        }

        const mode = $("input[name='BwxUploadMode']:checked").val();
        $("#bwxConsolidatedUploadContainer").toggle(mode === "Consolidated");
        $("#bwxSeparateUploadContainer").toggle(mode === "Separate");
    }

    function getSelectedBwxUploadMode() {
        return $("input[name='BwxUploadMode']:checked").val() || "";
    }

    function isBwxUploadCompleteForStatus() {
        const mode = getSelectedBwxUploadMode();
        if (mode === "Consolidated") {
            return isUploadComplete("bwx_consolidated");
        }
        if (mode === "Separate") {
            return BWX_UPLOAD_PREFIXES.every(isUploadComplete);
        }
        return false;
    }

    function toggleQuestionnaireDetail(selectEl) {
        const $select = $(selectEl);
        const target = $select.data("detail");
        if (!target) return;
        const $detail = $(target);
        const $textarea = $detail.find("textarea");
        if ($select.val() === "Yes") {
            $detail.show();
            $textarea.prop("required", true);
        } else {
            $detail.hide();
            $textarea.prop("required", false).val("");
        }
    }

    function toggleTobaccoSection() {
        const isYes = $("#UseTobaccoOrVape").val() === "Yes";
        const $section = $("#tobaccoDetailsSection");
        $section.toggle(isYes);
        $section.find(".tobacco-used-select").prop("required", isYes);
        if (!isYes) {
            $section.find(".tobacco-used-select").val("No");
            $section.find(".tobacco-type-detail").hide();
            $section.find(".tobacco-frequency-input").prop("required", false).val("");
        } else {
            $(".tobacco-used-select").each(function () {
                toggleTobaccoTypeDetail(this);
            });
        }
    }

    function toggleTobaccoTypeDetail(selectEl) {
        const $select = $(selectEl);
        const index = $select.data("index");
        const $detail = $("#tobaccoTypeDetail_" + index);
        const $inputs = $detail.find(".tobacco-frequency-input");
        if ($("#UseTobaccoOrVape").val() !== "Yes") {
            $detail.hide();
            $inputs.prop("required", false);
            return;
        }
        if ($select.val() === "Yes") {
            $detail.show();
            $inputs.prop("required", true);
        } else {
            $detail.hide();
            $inputs.prop("required", false).val("");
        }
    }

    function toggleConditionDetail(checkboxEl) {
        const $item = $(checkboxEl).closest(".condition-item");
        const $detail = $item.find(".condition-detail");
        const $textarea = $detail.find("textarea");
        if ($(checkboxEl).is(":checked")) {
            $detail.show();
        } else {
            $detail.hide();
            $textarea.val("");
        }
    }

    function initConditionToggles() {
        $(".condition-checkbox").each(function () {
            toggleConditionDetail(this);
        });
    }

    function initQuestionnaireToggles() {
        $(".dental-q-detail-toggle").each(function () {
            toggleQuestionnaireDetail(this);
        });
        toggleTobaccoSection();
        initConditionToggles();
    }

    function togglePregnancyFlow() {
        if (!IS_FEMALE) {
            $("#clinicalStationSection").show();
            return;
        }

        const pregnant = $("#AreYouPregnant").val();
        $("#pregnancyApprovalSection").hide();
        $("#PregnancyApproval").prop("required", false);
        $("#clinicalStationSection").hide();

        if (pregnant === "Yes") {
            $("#pregnancyApprovalSection").show();
            $("#PregnancyApproval").prop("required", true);
            if ($("#PregnancyApproval").val() === "Approved") {
                $("#clinicalStationSection").show();
            }
        } else if (pregnant === "No") {
            $("#clinicalStationSection").show();
        }
    }

    let goToVitalStationClicked = false;

    function isGoToVitalStationSubmit(submitter) {
        return goToVitalStationClicked || (submitter && submitter.name === "GoToVitalStation");
    }

    const BWX_UPLOAD_PREFIXES = ["bwx_left_molar", "bwx_left_premolar", "bwx_right_molar", "bwx_right_premolar"];
    const BWX_UPLOAD_LABELS = {
        bwx_left_molar: "BW Left Molar",
        bwx_left_premolar: "BW Left Premolar",
        bwx_right_molar: "BW Right Molar",
        bwx_right_premolar: "BW Right Premolar"
    };

    function isUploadComplete(prefix) {
        const hiddenFileName = document.getElementById(prefix + "_fileName");
        const removedInput = document.getElementById(prefix + "_removed");
        const fileInput = document.querySelector(`.xray-file[data-prefix='${prefix}']`);

        if (fileInput?.files && fileInput.files.length > 0) return true;
        if (removedInput?.value === "true") return false;
        return !!(hiddenFileName?.value || "").trim();
    }

    function shouldValidateXRaySections() {
        return BWX_NEEDED && $("#xrayStationSection").is(":visible");
    }

    function validateXRayUploadsBeforeSave() {
        const errors = [];
        if (!shouldValidateXRaySections()) {
            return errors;
        }

        const bwxStatus = $("#BwxStatus").val();
        if (bwxStatus === "Completed") {
            const mode = getSelectedBwxUploadMode();
            if (!mode) {
                errors.push("BWX upload type selection is required.");
            } else if (mode === "Consolidated" && !isUploadComplete("bwx_consolidated")) {
                errors.push("BWX Status requires consolidated X-Ray image upload.");
            } else if (mode === "Separate") {
                const missingBwx = BWX_UPLOAD_PREFIXES.filter(function (prefix) {
                    return !isUploadComplete(prefix);
                }).map(function (prefix) {
                    return BWX_UPLOAD_LABELS[prefix];
                });

                if (missingBwx.length > 0) {
                    errors.push("BWX Status requires all 4 X-Ray uploads. Missing: " + missingBwx.join(", ") + ".");
                }
            }
        }

        const paStatus = $("#PaStatus").val();
        if (paStatus === "Completed") {
            const paCards = $(".pa-card:visible");
            if (paCards.length === 0) {
                errors.push("Periapical (PA) X-Rays Status requires at least one PA X-Ray image.");
            } else {
                const missingPa = [];
                paCards.each(function () {
                    const prefix = $(this).find(".xray-file").data("prefix");
                    if (prefix && !isUploadComplete(prefix)) {
                        missingPa.push("PA card " + (missingPa.length + 1));
                    }
                });
                if (missingPa.length > 0) {
                    errors.push("Periapical (PA) X-Rays Status requires an uploaded image on every PA card.");
                }
            }
        }

        return errors;
    }

    function isSectionDone(statusVal, reasonVal, uploadCheckFn) {
        if (!statusVal) return false;
        if (statusVal === "Not Completed") return !!reasonVal;
        if (statusVal === "Completed") return uploadCheckFn();
        return false;
    }

    function updateOverallStatus() {
        if (!$("#xrayStationSection").is(":visible")) {
            $("#StatusHidden").val("Pending");
            $("#Status").val("Pending");
            return;
        }

        let overallStatus = "Pending";

        if (BWX_NEEDED) {
            const bwxStatus = $("#BwxStatus").val();
            const paStatus = $("#PaStatus").val();

            if (bwxStatus && paStatus) {
                const bwxDone = isSectionDone(bwxStatus, $("#BwxReason").val(), isBwxUploadCompleteForStatus);
                const paDone = isSectionDone(paStatus, $("#PaReason").val(), function () {
                    return $(".pa-card:visible").length > 0 &&
                        $(".pa-card:visible").toArray().every(function (card) {
                            const prefix = $(card).find(".xray-file").data("prefix");
                            return isUploadComplete(prefix);
                        });
                });
                overallStatus = bwxDone && paDone ? "Completed" : "Pending";
            }
        }
        $("#StatusHidden").val(overallStatus);
        $("#Status").val(overallStatus);
    }

    function reindexPaCards() {
        $("#paCardsRow .pa-card").each(function (index) {
            const card = $(this);
            card.attr("data-index", index);
            card.find(".pa-sort-order").val(index);

            card.find("[name^='PaImages']").each(function () {
                const el = $(this);
                const name = el.attr("name");
                if (!name) return;
                el.attr("name", name.replace(/PaImages\[\d+\]/, "PaImages[" + index + "]"));
            });

            const prefix = "pa_" + index;
            card.find(".xray-file").attr("data-prefix", prefix).attr("onchange", "toggleXRayUploadDate(this, '" + prefix + "')");
            card.find(".open-xray-picker").attr("data-prefix", prefix);
            card.find(".preview-xray-file").attr("data-prefix", prefix);
            card.find(".remove-xray-file").attr("data-prefix", prefix);
            card.find(".xray-zoom-in, .xray-zoom-out, .xray-zoom-reset").attr("data-prefix", prefix);

            ["_fileStatus", "_uploaded", "_fileName", "_originalFileName", "_removed", "_uploadDate", "_fileNameDisplay",
             "_previewSection", "_previewViewport", "_previewImg", "_zoomLevel"].forEach(function (suffix) {
                const el = card.find("[id$='" + suffix + "']");
                if (el.length) el.attr("id", prefix + suffix);
            });

            updateXRayFileUI(prefix);
        });
        paCardIndex = $("#paCardsRow .pa-card").length;
        syncPaAddButton();
    }

    function buildPaCardHtml(index) {
        const prefix = "pa_" + index;
        return `
            <div class="card pa-card h-100 xray-upload-card" data-index="${index}">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="card-title mb-0">PA of tooth</h6>
                        <button type="button" class="btn btn-sm btn-outline-danger remove-pa-card" title="Remove">
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                        </button>
                    </div>
                    <input type="hidden" name="PaImages[${index}].Id" value="0" />
                    <input type="hidden" name="PaImages[${index}].SortOrder" value="${index}" class="pa-sort-order" />
                    <input type="file" class="xray-file d-none pa-file" name="PaImages[${index}].ImageFile"
                           data-prefix="${prefix}" accept=".jpg,.jpeg,image/jpeg"
                           onchange="toggleXRayUploadDate(this, '${prefix}')" />
                    <button type="button" class="btn btn-outline-primary btn-sm mt-1 open-xray-picker" data-prefix="${prefix}">
                        <i class="fas fa-upload" aria-hidden="true"></i> Upload
                    </button>
                    <div class="align-items-center gap-2 mt-2 xray-file-status" id="${prefix}_fileStatus"
                         style="display:none;" data-download-prefix="pa_tooth">
                        <span id="${prefix}_fileNameDisplay" class="small text-muted"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary preview-xray-file" data-prefix="${prefix}">Preview</button>
                        <button type="button" class="btn btn-sm btn-outline-danger remove-xray-file" data-prefix="${prefix}">Remove</button>
                    </div>
                    <input type="hidden" id="${prefix}_uploaded" name="PaImages[${index}].Uploaded" value="false" />
                    <input type="hidden" id="${prefix}_fileName" name="PaImages[${index}].FileName" value="" />
                    <input type="hidden" id="${prefix}_originalFileName" name="PaImages[${index}].OriginalFileName" value="" />
                    <input type="hidden" id="${prefix}_removed" name="PaImages[${index}].Removed" value="false" />
                    <input name="PaImages[${index}].UploadedDateTime" id="${prefix}_uploadDate"
                           class="form-control flatpickr mt-2" type="text" style="display:none;" readonly />
                    <div class="xray-preview-panel mt-3" id="${prefix}_previewSection" style="display:none;">
                        <label class="form-label fw-semibold mb-1">Image Preview:</label>
                        <div class="xray-preview-viewport" id="${prefix}_previewViewport">
                            <img id="${prefix}_previewImg" alt="X-Ray preview" />
                        </div>
                        <label class="form-label fw-semibold mt-2 mb-1">Zoom Controls:</label>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-sm btn-primary xray-zoom-in" data-prefix="${prefix}">
                                <i class="fas fa-search-plus" aria-hidden="true"></i> Zoom In
                            </button>
                            <button type="button" class="btn btn-sm btn-primary xray-zoom-out" data-prefix="${prefix}">
                                <i class="fas fa-search-minus" aria-hidden="true"></i> Zoom Out
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary xray-zoom-reset" data-prefix="${prefix}">
                                <i class="fas fa-undo" aria-hidden="true"></i> Reset
                            </button>
                        </div>
                        <p class="mb-0 small">Zoom Level: <span id="${prefix}_zoomLevel" class="text-primary fw-semibold">100%</span></p>
                    </div>
                </div>
            </div>`;
    }

    function initFlatpickrForUploadDates() {
        document.querySelectorAll(".flatpickr").forEach(function (el) {
            if (!el._flatpickr) {
                flatpickr(el, {
                    altInput: true,
                    altFormat: "m/d/Y h:i K",
                    dateFormat: "Y-m-d H:i",
                    allowInput: false,
                    enableTime: true,
                    time_24hr: true
                });
            }
            el.setAttribute("readonly", "readonly");
        });
    }

    $(document).ready(function () {
        initFlatpickrForUploadDates();

        BWX_UPLOAD_PREFIXES.forEach(updateXRayFileUI);
        updateXRayFileUI("bwx_consolidated");
        $(".pa-card .xray-file").each(function () {
            updateXRayFileUI($(this).data("prefix"));
        });

        if ($("#BwxReason").length && "@station.BwxReason") {
            $("#BwxReason").val("@station.BwxReason");
        }
        if ($("#PaReason").length && "@station.PaReason") {
            $("#PaReason").val("@station.PaReason");
        }
        initQuestionnaireToggles();
        togglePregnancyFlow();
        toggleBwxSection();
        toggleReasonAndUpload("#PaStatus", "#paReasonContainer", "#paUploadContainer", "#PaReason");
        updateOverallStatus();
        syncPaAddButton();

        $(".dental-q-detail-toggle").on("change", function () {
            toggleQuestionnaireDetail(this);
        });
        $("#UseTobaccoOrVape").on("change", toggleTobaccoSection);
        $(document).on("change", ".tobacco-used-select", function () {
            toggleTobaccoTypeDetail(this);
        });
        $(document).on("change", ".condition-checkbox", function () {
            toggleConditionDetail(this);
        });

        $("#AreYouPregnant, #PregnancyApproval").on("change", function () {
            togglePregnancyFlow();
            updateOverallStatus();
        });

        $("#BwxStatus").on("change", function () {
            toggleBwxSection();
            updateOverallStatus();
        });
        $("input[name='BwxUploadMode']").on("change", function () {
            toggleBwxUploadContainers();
            updateOverallStatus();
        });
        $("#PaStatus").on("change", function () {
            toggleReasonAndUpload("#PaStatus", "#paReasonContainer", "#paUploadContainer", "#PaReason");
            updateOverallStatus();
        });
        $("#BwxReason, #PaReason").on("change", updateOverallStatus);
    });

    $(document).on("change", ".xray-file", function () {
        const prefix = $(this).data("prefix");
        if (!prefix) return;
        updateXRayFileUI(prefix);
        updateOverallStatus();
    });

    $(document).on("click", ".open-xray-picker", function () {
        const prefix = $(this).data("prefix");
        const input = document.querySelector(`.xray-file[data-prefix='${prefix}']`);
        if (input) input.click();
    });

    $(document).on("click", ".remove-xray-file", function () {
        const prefix = $(this).data("prefix");
        const input = document.querySelector(`.xray-file[data-prefix='${prefix}']`);
        const status = document.getElementById(prefix + "_fileStatus");
        const removedInput = document.getElementById(prefix + "_removed");
        const datePicker = document.getElementById(prefix + "_uploadDate");

        if (input) input.value = "";
        if (status?.dataset.existingFilename) {
            status.dataset.existingFilename = "";
            status.dataset.existingOriginalFilename = "";
        }
        if (removedInput) removedInput.value = "true";

        if (datePicker) {
            datePicker.value = "";
            setFlatpickrVisibility(datePicker, false);
            if (datePicker._flatpickr) datePicker._flatpickr.clear();
        }

        updateXRayFileUI(prefix);
        updateOverallStatus();
    });

    $(document).on("click", ".xray-zoom-in", function () {
        const prefix = $(this).data("prefix");
        setXRayZoom(prefix, (xrayZoomLevels[prefix] || 100) + XRAY_ZOOM_STEP);
    });

    $(document).on("click", ".xray-zoom-out", function () {
        const prefix = $(this).data("prefix");
        setXRayZoom(prefix, (xrayZoomLevels[prefix] || 100) - XRAY_ZOOM_STEP);
    });

    $(document).on("click", ".xray-zoom-reset", function () {
        const prefix = $(this).data("prefix");
        setXRayZoom(prefix, 100);
    });

    $(document).on("mousedown", ".xray-preview-viewport.can-pan", function (e) {
        if (e.button !== 0) return;
        e.preventDefault();
        startXRayPan(e.clientX, e.clientY, this);
    });

    $(document).on("mousemove", function (e) {
        if (!xrayPanState.active) return;
        e.preventDefault();
        moveXRayPan(e.clientX, e.clientY);
    });

    $(document).on("mouseup", function () {
        endXRayPan();
    });

    $(document).on("touchstart", ".xray-preview-viewport.can-pan", function (e) {
        if (!e.touches || e.touches.length !== 1) return;
        const touch = e.touches[0];
        startXRayPan(touch.clientX, touch.clientY, this);
    });

    $(document).on("touchmove", function (e) {
        if (!xrayPanState.active || !e.touches || e.touches.length !== 1) return;
        e.preventDefault();
        moveXRayPan(e.touches[0].clientX, e.touches[0].clientY);
    });

    $(document).on("touchend touchcancel", function () {
        endXRayPan();
    });

    $(document).on("click", ".preview-xray-file", function () {
        const prefix = $(this).data("prefix");
        const status = document.getElementById(prefix + "_fileStatus");
        const hiddenFileName = document.getElementById(prefix + "_fileName");
        if (!status || !hiddenFileName) return;

        if (status.dataset.previewMode === "selected") {
            const localUrl = status.dataset.selectedPreviewUrl;
            if (localUrl) window.open(localUrl, "_blank");
            return;
        }

        const fileName = hiddenFileName.value || status.dataset.existingFilename;
        const downloadPrefix = status.dataset.downloadPrefix || prefix;
        if (!fileName) return;

        const url = "/DentalXRay/DownloadXRayImage?prefix=" + encodeURIComponent(downloadPrefix) + "&fileName=" + encodeURIComponent(fileName);
        window.open(url, "_blank");
    });

    $("#addPaCardBtn").on("click", function () {
        if ($("#paCardsRow .pa-card").length >= MAX_PA_CARDS) {
            return;
        }

        const index = paCardIndex;
        $("#paCardsRow").append(buildPaCardHtml(index));
        paCardIndex++;
        initFlatpickrForUploadDates();
        updateOverallStatus();
        syncPaAddButton();
    });

    $(document).on("click", ".remove-pa-card", function () {
        $(this).closest(".pa-card").remove();
        reindexPaCards();
        updateOverallStatus();
    });

    $(document).on("click", "#goToVitalStationBtn", function () {
        goToVitalStationClicked = true;
        $("#GoToVitalStationFlag").val("true");
    });

    $(document).on("click", "#SaveDentalXRayStation button[type='submit']:not(#goToVitalStationBtn)", function () {
        goToVitalStationClicked = false;
        $("#GoToVitalStationFlag").val("false");
    });

    $("#SaveDentalXRayStation").on("submit", function (e) {
        const submitter = e.originalEvent && e.originalEvent.submitter;
        if (isGoToVitalStationSubmit(submitter)) {
            $("#GoToVitalStationFlag").val("true");
            return true;
        }

        goToVitalStationClicked = false;
        updateOverallStatus();

        const uploadErrors = validateXRayUploadsBeforeSave();
        if (uploadErrors.length > 0) {
            e.preventDefault();
            Swal.fire({
                icon: "error",
                title: "Missing X-Ray Uploads",
                html: uploadErrors.join("<br>"),
                confirmButtonText: "OK",
                confirmButtonColor: "#FF0000",
                iconColor: "#FF0000"
            });
            return false;
        }
    });

    $('a.btn-back-confirm').on('click', async function (e) {
        e.preventDefault();
        const url = $(this).attr('href');
        const confirmed = await showYesNoModal("Are you sure you want to go back to main screen without saving changes?");
        if (confirmed) window.location.href = url;
    });
</script>
