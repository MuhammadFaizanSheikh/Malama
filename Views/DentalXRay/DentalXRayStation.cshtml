@using ExcelFilesCompiler.Controllers.Services
@using ExcelFilesCompiler.Utilities
@using Malama.Models
@using Malama.Utilities
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model DentalXRayStationPageViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dental X-Ray Station";

    var station = Model.Station;
    var questionnaire = Model.Questionnaire;
    var isQuestionnaireReadOnly = Model.IsQuestionnaireReadOnly;
    var sm = station.ServiceMembersChild;
    var isFemale = DentalXRayStationService.IsFemale(sm);
    var bwxNeeded = DentalXRayStationService.IsNeeded(sm?.BwxNeeded);
    var panoNeeded = DentalXRayStationService.IsNeeded(sm?.PanoNeeded);
    var paImages = station.PaImages?.OrderBy(p => p.SortOrder).ToList() ?? new List<DentalXRayPaImage>();
    if (!paImages.Any())
    {
        paImages.Add(new DentalXRayPaImage { SortOrder = 0 });
    }

    var vitalStationDto = ViewBag.VitalStation as VitalStationDto ?? new VitalStationDto
    {
        ServiceMembersChildId = station.ServiceMembersChildId,
        Status = "Pending"
    };
    var vitalsCompleted = ViewBag.VitalsCompleted as bool? ?? false;
    var canSaveDentalXRay = DashboardAuthorizationHelper.HasAccess(User, "DentalXRay_Save");

    var initialBwxUploadMode = station.BwxUploadMode;
    if (string.IsNullOrWhiteSpace(initialBwxUploadMode))
    {
        if (!string.IsNullOrWhiteSpace(station.BwxConsolidatedFileName))
        {
            initialBwxUploadMode = BwxUploadMode.Consolidated;
        }
        else if (!string.IsNullOrWhiteSpace(station.BwLeftMolarFileName)
            || !string.IsNullOrWhiteSpace(station.BwLeftPremolarFileName)
            || !string.IsNullOrWhiteSpace(station.BwRightMolarFileName)
            || !string.IsNullOrWhiteSpace(station.BwRightPremolarFileName))
        {
            initialBwxUploadMode = BwxUploadMode.Separate;
        }
    }
}

<style>
    #page-heading { text-align: center; margin: 20px auto; }
    .btn-general {
        background-color: rgba(80, 90, 201, 1);
        border-color: rgba(80, 90, 201, 1);
        color: white;
    }
    .btn-general:hover {
        background-color: rgba(60, 70, 180, 1);
        border-color: rgba(60, 70, 180, 1);
        color: white;
    }
    h2, h3 { color: rgba(80, 90, 201, 1); }
    .xray-cards-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }
    @@media (max-width: 992px) {
        .xray-cards-row { grid-template-columns: 1fr; }
    }
    .xray-upload-card { border: 1px solid #dee2e6; }
    .xray-upload-full-width { width: 100%; }
    .xray-preview-viewport-full { height: 360px; }
    .bwx-upload-mode-option { margin-bottom: 0.5rem; }
    .xray-preview-viewport {
        width: 100%;
        height: 280px;
        overflow: auto;
        border: 1px solid #ced4da;
        background: #f8f9fa;
    }
    .xray-preview-viewport.can-pan {
        cursor: grab;
    }
    .xray-preview-viewport.can-pan.is-panning {
        cursor: grabbing;
        user-select: none;
    }
    .xray-preview-viewport img {
        display: block;
        width: 100%;
        height: auto;
        max-width: none;
        transform-origin: top left;
        -webkit-user-drag: none;
        user-select: none;
    }
    .read-only-style {
        background-color: #f8f9fa;
        pointer-events: none;
        border-color: #ced4da;
    }
    .condition-detail { display: none; }
    .condition-item { margin-bottom: 0.75rem; }
</style>

<h2 id="page-heading">Edit Service Member at Dental X-Ray Station</h2>

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            Swal.fire({
                icon: '@TempData["ResponseStatus"]',
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor,
                iconColor: iconColor
            });
        });
    </script>
}

<form id="SaveDentalXRayStation" asp-action="SaveDentalXRayStation" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@station.Id" />
    <input type="hidden" name="ServiceMembersChildId" value="@station.ServiceMembersChildId" />
    <input type="hidden" name="IsQuestionnaireReadOnly" value="@(isQuestionnaireReadOnly ? "true" : "false")" />
    <input type="hidden" name="SubmissionToken" id="SubmissionToken" value="@Guid.NewGuid()" />
    <input type="hidden" name="GoToVitalStation" id="GoToVitalStationFlag" value="false" />

    <h3 class="mb-4">Personal Information</h3>
    <div class="card mb-4">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <p><span class="fw-bold">Full Name:</span> @sm?.FullName</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">DOD ID:</span> @sm?.DodId</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">Routing Sheet Barcode:</span> @sm?.Barcode</p>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <p><span class="fw-bold">DOB:</span> @sm?.Dob</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">Age:</span> @sm?.Age</p>
                </div>
                <div class="col-md-4">
                    <p><span class="fw-bold">Sex:</span> @sm?.Sex</p>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <p><span class="fw-bold">DRC:</span> @sm?.Drc</p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <h3 class="mb-4">Questionnaire</h3>
    @if (isQuestionnaireReadOnly)
    {
        <div class="alert alert-info">
            Questionnaire answers were saved previously and are shown in read-only mode.
        </div>
    }
    @{
        var questionnaireViewData = new ViewDataDictionary<DentalQuestionnaire>(ViewData, questionnaire);
        questionnaireViewData["IsQuestionnaireReadOnly"] = isQuestionnaireReadOnly;
    }
    @await Html.PartialAsync("_DentalXRayQuestionnaire", questionnaire, questionnaireViewData)

    @if (isFemale)
    {
        <div class="row mb-3" id="pregnancyQuestionSection">
            <div class="col-md-6 mb-3">
                <label class="form-label">12. Are you pregnant?</label>
                <select name="AreYouPregnant" id="AreYouPregnant" class="form-select @(isQuestionnaireReadOnly ? "read-only-style" : "")" @(isQuestionnaireReadOnly ? "disabled" : "required")>
                    <option value="No" selected="@(string.IsNullOrWhiteSpace(questionnaire.AreYouPregnant) || questionnaire.AreYouPregnant == "No")">No</option>
                    <option value="Yes" selected="@(questionnaire.AreYouPregnant == "Yes")">Yes</option>
                </select>
            </div>
        </div>

        <div class="row mb-4" id="pregnancyApprovalSection" style="display:none;">
            <div class="col-md-12">
                <p class="text-warning fw-bold">Approval is needed from Service Member before going to X-Ray</p>
                <select name="PregnancyApproval" id="PregnancyApproval" class="form-select @(isQuestionnaireReadOnly ? "read-only-style" : "")" @(isQuestionnaireReadOnly ? "disabled" : "")>
                    <option value=""></option>
                    <option value="Approved" selected="@(questionnaire.PregnancyApproval == "Approved")">Approved</option>
                    <option value="Declined" selected="@(questionnaire.PregnancyApproval == "Declined")">Declined</option>
                </select>
            </div>
        </div>
    }

    @{
        var healthConditionsQuestionNumber = isFemale ? 13 : 12;
        var savedHealthConditions = DentalQuestionnaireService.ParseHealthConditionsJson(questionnaire.ApplicableHealthConditionsJson);
        var savedByCondition = savedHealthConditions
            .Where(h => !string.IsNullOrWhiteSpace(h.Condition))
            .ToDictionary(h => h.Condition, h => h, StringComparer.OrdinalIgnoreCase);

        bool IsConditionSelected(string condition) => savedByCondition.ContainsKey(condition);
        string GetConditionDetail(string condition) =>
            savedByCondition.TryGetValue(condition, out var item) ? item.Detail ?? "" : "";
    }
    <div class="card mb-4">
        <div class="card-body">
            <label class="form-label fw-semibold">@healthConditionsQuestionNumber. Check the following conditions if they apply to you:</label>
            <div class="row condition-checkboxes">
                @for (var ci = 0; ci < DentalXRayQuestionnaire.HealthConditions.Length; ci++)
                {
                    var condition = DentalXRayQuestionnaire.HealthConditions[ci];
                    var isSelected = IsConditionSelected(condition);
                    var detail = GetConditionDetail(condition);
                    <div class="col-md-6 condition-item">
                        <input type="hidden" name="HealthConditionDetails[@ci].Condition" value="@condition" />
                        <div class="form-check">
                            <input class="form-check-input condition-checkbox" type="checkbox"
                                   name="ApplicableHealthConditions"
                                   value="@condition"
                                   id="condition_@ci"
                                   checked="@isSelected"
                                   @(isQuestionnaireReadOnly ? "disabled" : "") />
                            <label class="form-check-label" for="condition_@ci">@condition</label>
                        </div>
                        <div class="condition-detail ms-4 mt-1">
                            <textarea name="HealthConditionDetails[@ci].Detail"
                                      class="form-control condition-detail-text @(isQuestionnaireReadOnly ? "read-only-style" : "")"
                                      rows="3"
                                      placeholder="Please provide details"
                                      @(isQuestionnaireReadOnly ? "readonly" : "")>@detail</textarea>
                        </div>
                    </div>
                }
                @{
                    var otherIndex = DentalXRayQuestionnaire.HealthConditions.Length;
                    var otherCondition = DentalXRayQuestionnaire.OtherHealthCondition;
                    var otherSelected = IsConditionSelected(otherCondition);
                    var otherDetail = GetConditionDetail(otherCondition);
                }
                <div class="col-md-6 condition-item">
                    <input type="hidden" name="HealthConditionDetails[@otherIndex].Condition" value="@otherCondition" />
                    <div class="form-check">
                        <input class="form-check-input condition-checkbox" type="checkbox"
                               name="ApplicableHealthConditions"
                               value="@otherCondition"
                               id="condition_other"
                               checked="@otherSelected"
                               @(isQuestionnaireReadOnly ? "disabled" : "") />
                        <label class="form-check-label" for="condition_other">@otherCondition</label>
                    </div>
                    <div class="condition-detail ms-4 mt-1">
                        <textarea name="HealthConditionDetails[@otherIndex].Detail"
                                  class="form-control condition-detail-text @(isQuestionnaireReadOnly ? "read-only-style" : "")"
                                  rows="3"
                                  placeholder="Please provide details"
                                  @(isQuestionnaireReadOnly ? "readonly" : "")>@otherDetail</textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div id="clinicalStationSection" style="@(isFemale ? "display:none;" : "")">
        @{
            var vitalBpViewData = new ViewDataDictionary<VitalStationDto>(ViewData, vitalStationDto);
            vitalBpViewData["ShowVitalRedirect"] = !vitalsCompleted;
            vitalBpViewData["AllowVitalStationSubmit"] = canSaveDentalXRay;
            vitalBpViewData["BpCountdownIdPrefix"] = "dentalBpCountdown";
        }
        @await Html.PartialAsync("_VitalStationBpSummary", vitalStationDto, vitalBpViewData)

        <hr class="my-4" />

        <div id="xrayStationSection">
        <h3 class="mb-4">X-Ray Station</h3>

        @if (bwxNeeded)
        {
            <div class="card mb-4" id="bwxSection">
                <div class="card-body">
                    <div class="row mb-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">BWX Status</label>
                            <select name="BwxStatus" id="BwxStatus" class="form-select">
                                <option value=""></option>
                                <option value="Completed" selected="@(station.BwxStatus == "Completed")">Completed</option>
                                <option value="Not Completed" selected="@(station.BwxStatus == "Not Completed")">Not Completed</option>
                            </select>
                        </div>
                        @if (station.Id != 0 && station.BwxUploadedDateTime.HasValue)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Uploaded datetime</label>
                                <input type="text" class="form-control read-only-style"
                                       value="@station.BwxUploadedDateTime?.ToString("MM/dd/yyyy hh:mm tt")" readonly />
                            </div>
                        }
                    </div>

                    <div id="bwxReasonContainer" style="display:none;" class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Reason</label>
                            <select name="BwxReason" id="BwxReason" class="form-select">
                                <option value=""></option>
                                <option value="Insufficient Supplies">Insufficient Supplies</option>
                                <option value="Refused">Refused</option>
                                <option value="Contraindication">Contraindication</option>
                                <option value="Excused">Excused</option>
                                <option value="Proof of Service">Proof of Service</option>
                            </select>
                        </div>
                    </div>

                    <div id="bwxUploadModeSection" style="display:none;" class="mb-3">
                        <p class="mb-2">Do you want to upload BWX ray :</p>
                        <div class="bwx-upload-mode-option">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="BwxUploadMode" id="BwxModeConsolidated"
                                       value="@BwxUploadMode.Consolidated"
                                       checked="@(initialBwxUploadMode == BwxUploadMode.Consolidated)" />
                                <label class="form-check-label" for="BwxModeConsolidated">
                                    As a single JPG image file that consolidates all the BWX rays into one cohesive image?
                                </label>
                            </div>
                        </div>
                        <div class="bwx-upload-mode-option">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="BwxUploadMode" id="BwxModeSeparate"
                                       value="@BwxUploadMode.Separate"
                                       checked="@(initialBwxUploadMode == BwxUploadMode.Separate)" />
                                <label class="form-check-label" for="BwxModeSeparate">
                                    Upload each individual BWX ray separately?
                                </label>
                            </div>
                        </div>
                    </div>

                    <div id="bwxConsolidatedUploadContainer" style="display:none;">
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_consolidated",
                            Title = "Consolidated BWX",
                            FileInputName = "BwxConsolidatedFile",
                            UploadedFieldName = "BwxConsolidatedUploaded",
                            FileNameFieldName = "BwxConsolidatedFileName",
                            OriginalFileNameFieldName = "BwxConsolidatedOriginalFileName",
                            DateFieldName = "BwxConsolidatedUploadedDateTime",
                            RemovedFieldName = "BwxConsolidatedRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwxConsolidatedFileName),
                            StoredFileName = station.BwxConsolidatedFileName,
                            OriginalFileName = station.BwxConsolidatedOriginalFileName,
                            UploadedDateTime = station.BwxConsolidatedUploadedDateTime,
                            IsFullWidth = true
                        })
                    </div>

                    <div id="bwxSeparateUploadContainer" style="display:none;" class="xray-cards-row">
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_left_molar",
                            Title = "BW Left Molar",
                            FileInputName = "BwLeftMolarFile",
                            UploadedFieldName = "BwLeftMolarUploaded",
                            FileNameFieldName = "BwLeftMolarFileName",
                            OriginalFileNameFieldName = "BwLeftMolarOriginalFileName",
                            DateFieldName = "BwLeftMolarUploadedDateTime",
                            RemovedFieldName = "BwLeftMolarRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwLeftMolarFileName),
                            StoredFileName = station.BwLeftMolarFileName,
                            OriginalFileName = station.BwLeftMolarOriginalFileName,
                            UploadedDateTime = station.BwLeftMolarUploadedDateTime
                        })
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_left_premolar",
                            Title = "BW Left Premolar",
                            FileInputName = "BwLeftPremolarFile",
                            UploadedFieldName = "BwLeftPremolarUploaded",
                            FileNameFieldName = "BwLeftPremolarFileName",
                            OriginalFileNameFieldName = "BwLeftPremolarOriginalFileName",
                            DateFieldName = "BwLeftPremolarUploadedDateTime",
                            RemovedFieldName = "BwLeftPremolarRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwLeftPremolarFileName),
                            StoredFileName = station.BwLeftPremolarFileName,
                            OriginalFileName = station.BwLeftPremolarOriginalFileName,
                            UploadedDateTime = station.BwLeftPremolarUploadedDateTime
                        })
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_right_molar",
                            Title = "BW Right Molar",
                            FileInputName = "BwRightMolarFile",
                            UploadedFieldName = "BwRightMolarUploaded",
                            FileNameFieldName = "BwRightMolarFileName",
                            OriginalFileNameFieldName = "BwRightMolarOriginalFileName",
                            DateFieldName = "BwRightMolarUploadedDateTime",
                            RemovedFieldName = "BwRightMolarRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwRightMolarFileName),
                            StoredFileName = station.BwRightMolarFileName,
                            OriginalFileName = station.BwRightMolarOriginalFileName,
                            UploadedDateTime = station.BwRightMolarUploadedDateTime
                        })
                        @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                            Prefix = "bwx_right_premolar",
                            Title = "BW Right Premolar",
                            FileInputName = "BwRightPremolarFile",
                            UploadedFieldName = "BwRightPremolarUploaded",
                            FileNameFieldName = "BwRightPremolarFileName",
                            OriginalFileNameFieldName = "BwRightPremolarOriginalFileName",
                            DateFieldName = "BwRightPremolarUploadedDateTime",
                            RemovedFieldName = "BwRightPremolarRemoved",
                            Uploaded = !string.IsNullOrWhiteSpace(station.BwRightPremolarFileName),
                            StoredFileName = station.BwRightPremolarFileName,
                            OriginalFileName = station.BwRightPremolarOriginalFileName,
                            UploadedDateTime = station.BwRightPremolarUploadedDateTime
                        })
                    </div>
                </div>
            </div>

            <div class="card mb-4" id="paSection">
                <div class="card-body">
                    <div class="row mb-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Periapical (PA) X-Rays Status</label>
                            <select name="PaStatus" id="PaStatus" class="form-select">
                                <option value=""></option>
                                <option value="Completed" selected="@(station.PaStatus == "Completed")">Completed</option>
                                <option value="Not Completed" selected="@(station.PaStatus == "Not Completed")">Not Completed</option>
                            </select>
                        </div>
                        @if (station.Id != 0 && station.PaUploadedDateTime.HasValue)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Uploaded datetime</label>
                                <input type="text" class="form-control read-only-style"
                                       value="@station.PaUploadedDateTime?.ToString("MM/dd/yyyy hh:mm tt")" readonly />
                            </div>
                        }
                    </div>

                    <div id="paReasonContainer" style="display:none;" class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Reason</label>
                            <select name="PaReason" id="PaReason" class="form-select">
                                <option value=""></option>
                                <option value="Insufficient Supplies">Insufficient Supplies</option>
                                <option value="Refused">Refused</option>
                                <option value="Contraindication">Contraindication</option>
                                <option value="Excused">Excused</option>
                                <option value="Proof of Service">Proof of Service</option>
                            </select>
                        </div>
                    </div>

                    <div id="paUploadContainer" style="display:none;">
                        <div class="d-flex justify-content-end mb-2 gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="addPaCardBtn">
                                <i class="bi bi-plus"></i> Add PA Card
                            </button>
                        </div>
                        <div id="paCardsRow" class="xray-cards-row">
                            @for (var i = 0; i < paImages.Count; i++)
                            {
                                var pa = paImages[i];
                                var prefix = $"pa_{i}";
                                @await Html.PartialAsync("_XRayImageUpload", new DentalXRayImageUploadModel {
                                    Prefix = prefix,
                                    Title = "PA of tooth",
                                    FileInputName = $"PaImages[{i}].ImageFile",
                                    UploadedFieldName = $"PaImages[{i}].Uploaded",
                                    FileNameFieldName = $"PaImages[{i}].FileName",
                                    OriginalFileNameFieldName = $"PaImages[{i}].OriginalFileName",
                                    DateFieldName = $"PaImages[{i}].UploadedDateTime",
                                    RemovedFieldName = $"PaImages[{i}].Removed",
                                    DownloadPrefix = "pa_tooth",
                                    Uploaded = !string.IsNullOrWhiteSpace(pa.FileName),
                                    StoredFileName = pa.FileName,
                                    OriginalFileName = pa.OriginalFileName,
                                    UploadedDateTime = pa.UploadedDateTime,
                                    IsPaCard = true,
                                    PaCardIndex = i,
                                    PaImageId = pa.Id,
                                    ShowRemovePaCardButton = i > 0
                                })
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="mb-4" id="panoSection">
            <div class="card">
                <div class="card-body">
                    <label class="form-label" for="Comment">Comment</label>
                    <textarea name="Comment" id="Comment" class="form-control" rows="4">@station.Comment</textarea>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="Status" id="Status" class="form-select read-only-style" disabled>
                    <option value="Pending" selected="@(station.Status != "Completed")">Pending</option>
                    <option value="Completed" selected="@(station.Status == "Completed")">Completed</option>
                </select>
                <input type="hidden" name="Status" id="StatusHidden" value="@(string.IsNullOrWhiteSpace(station.Status) ? "Pending" : station.Status)" />
            </div>
        </div>

        <p class="fw-bold mb-4">
            @if (panoNeeded)
            {
                <text>Panorex (Pano) X-ray is Required for this Service member</text>
            }
            else
            {
                <text>Panorex (Pano) X-ray is NOT Required for this Service member</text>
            }
        </p>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4 gap-3">
        <button type="submit" class="btn btn-general btn-lg" @(DashboardAuthorizationHelper.HasAccess(User, "DentalXRay_Save") ? "" : "disabled")>
            <i class="bi bi-check-circle"></i> Save
        </button>
        <a asp-action="Index" class="btn btn-secondary btn-lg btn-back-confirm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</form>

<script>
    const IS_FEMALE = @Json.Serialize(isFemale);
    const BWX_NEEDED = @Json.Serialize(bwxNeeded);
    const MAX_PA_CARDS = 8;
    const XRAY_ZOOM_STEP = 25;
    const XRAY_ZOOM_MIN = 50;
    const XRAY_ZOOM_MAX = 300;
    let paCardIndex = @paImages.Count;
    const xrayZoomLevels = {};
    const xrayPanState = {
        active: false,
        viewport: null,
        startX: 0,
        startY: 0,
        scrollLeft: 0,
        scrollTop: 0
    };

    function syncPaAddButton() {
        const count = $("#paCardsRow .pa-card").length;
        const atMax = count >= MAX_PA_CARDS;
        $("#addPaCardBtn").prop("disabled", atMax);
        $("#addPaCardBtn").attr("title", atMax ? "Maximum of 8 PA X-Ray uploads allowed" : "");
    }

    function setFlatpickrVisibility(input, show) {
        if (!input) return;
        input.style.display = show ? "block" : "none";
        if (input._flatpickr?.altInput) {
            input._flatpickr.altInput.style.display = show ? "block" : "none";
        }
    }

    function getCurrentDateTimeValue() {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, "0");
        const day = String(now.getDate()).padStart(2, "0");
        const hour = String(now.getHours()).padStart(2, "0");
        const minute = String(now.getMinutes()).padStart(2, "0");
        return `${year}-${month}-${day} ${hour}:${minute}`;
    }

    function toggleXRayUploadDate(input, prefix) {
        const datePicker = document.getElementById(prefix + "_uploadDate");
        const hiddenUploaded = document.getElementById(prefix + "_uploaded");
        const now = getCurrentDateTimeValue();

        if (input.files && input.files.length > 0) {
            setFlatpickrVisibility(datePicker, true);
            hiddenUploaded.value = "true";
            datePicker.value = now;
            if (datePicker?._flatpickr) {
                datePicker._flatpickr.setDate(now, true, "Y-m-d H:i");
            }
        }
        updateXRayFileUI(prefix);
        updateOverallStatus();
    }

    function setXRayZoom(prefix, level) {
        const previewImg = document.getElementById(prefix + "_previewImg");
        const zoomLabel = document.getElementById(prefix + "_zoomLevel");
        if (!previewImg || !zoomLabel) return;

        const clamped = Math.max(XRAY_ZOOM_MIN, Math.min(XRAY_ZOOM_MAX, level));
        xrayZoomLevels[prefix] = clamped;

        // Zoom the image inside a fixed viewport; do not resize the viewer panel.
        previewImg.style.width = clamped + "%";
        previewImg.style.height = "auto";
        previewImg.style.transform = "";
        previewImg.draggable = false;
        zoomLabel.textContent = clamped + "%";
        requestAnimationFrame(function () {
            updateXRayPanAvailability(prefix);
        });
    }

    function updateXRayPanAvailability(prefix) {
        const viewport = document.getElementById(prefix + "_previewViewport");
        const previewImg = document.getElementById(prefix + "_previewImg");
        if (!viewport) return;

        const canPan = !!previewImg?.src &&
            (viewport.scrollWidth > viewport.clientWidth + 1 ||
             viewport.scrollHeight > viewport.clientHeight + 1);

        viewport.classList.toggle("can-pan", canPan);
        viewport.title = canPan ? "Click and drag to move the image" : "";
        if (previewImg) {
            previewImg.draggable = false;
        }
    }

    function startXRayPan(clientX, clientY, viewport) {
        xrayPanState.active = true;
        xrayPanState.viewport = viewport;
        xrayPanState.startX = clientX;
        xrayPanState.startY = clientY;
        xrayPanState.scrollLeft = viewport.scrollLeft;
        xrayPanState.scrollTop = viewport.scrollTop;
        viewport.classList.add("is-panning");
    }

    function moveXRayPan(clientX, clientY) {
        if (!xrayPanState.active || !xrayPanState.viewport) return;

        const dx = clientX - xrayPanState.startX;
        const dy = clientY - xrayPanState.startY;
        xrayPanState.viewport.scrollLeft = xrayPanState.scrollLeft - dx;
        xrayPanState.viewport.scrollTop = xrayPanState.scrollTop - dy;
    }

    function endXRayPan() {
        if (!xrayPanState.active) return;

        xrayPanState.viewport?.classList.remove("is-panning");
        xrayPanState.active = false;
        xrayPanState.viewport = null;
    }

    function updateXRayPreview(prefix) {
        const previewSection = document.getElementById(prefix + "_previewSection");
        const previewImg = document.getElementById(prefix + "_previewImg");
        const status = document.getElementById(prefix + "_fileStatus");
        const hiddenFileName = document.getElementById(prefix + "_fileName");
        const removedInput = document.getElementById(prefix + "_removed");

        if (!previewSection || !previewImg || !status) return;

        const removed = removedInput?.value === "true";
        let src = "";

        if (status.dataset.previewMode === "selected" && status.dataset.selectedPreviewUrl) {
            src = status.dataset.selectedPreviewUrl;
        } else if (!removed && status.dataset.previewMode === "server") {
            const fileName = (hiddenFileName?.value || status.dataset.existingFilename || "").trim();
            const downloadPrefix = status.dataset.downloadPrefix || prefix;
            if (fileName) {
                src = "/DentalXRay/DownloadXRayImage?prefix=" + encodeURIComponent(downloadPrefix) + "&fileName=" + encodeURIComponent(fileName);
            }
        }

        if (src) {
            previewImg.onload = function () {
                setXRayZoom(prefix, xrayZoomLevels[prefix] || 100);
                updateXRayPanAvailability(prefix);
            };
            previewImg.src = src;
            previewSection.style.display = "block";
            if (previewImg.complete) {
                setXRayZoom(prefix, xrayZoomLevels[prefix] || 100);
            }
        } else {
            previewImg.removeAttribute("src");
            previewSection.style.display = "none";
            delete xrayZoomLevels[prefix];
        }
    }

    function updateXRayFileUI(prefix) {
        const fileInput = document.querySelector(`.xray-file[data-prefix='${prefix}']`);
        const status = document.getElementById(prefix + "_fileStatus");
        const fileNameDisplay = document.getElementById(prefix + "_fileNameDisplay");
        const hiddenUploaded = document.getElementById(prefix + "_uploaded");
        const hiddenFileName = document.getElementById(prefix + "_fileName");
        const hiddenOriginalFileName = document.getElementById(prefix + "_originalFileName");
        const removedInput = document.getElementById(prefix + "_removed");

        if (!fileInput || !status || !fileNameDisplay || !hiddenUploaded || !hiddenFileName) return;

        const selectedFile = fileInput.files && fileInput.files.length > 0 ? fileInput.files[0] : null;
        const existingFileName = (status.dataset.existingFilename || "").trim();
        const existingOriginalFileName = (status.dataset.existingOriginalFilename || "").trim();
        const removedExisting = removedInput?.value === "true";

        if (selectedFile) {
            fileNameDisplay.textContent = selectedFile.name;
            status.style.display = "flex";
            hiddenUploaded.value = "true";
            hiddenFileName.value = "";
            if (hiddenOriginalFileName) hiddenOriginalFileName.value = selectedFile.name;
            if (removedInput) removedInput.value = "false";

            const prevUrl = status.dataset.selectedPreviewUrl;
            if (prevUrl) URL.revokeObjectURL(prevUrl);
            status.dataset.selectedPreviewUrl = URL.createObjectURL(selectedFile);
            status.dataset.previewMode = "selected";
            updateXRayPreview(prefix);
            return;
        }

        if (status.dataset.selectedPreviewUrl) {
            URL.revokeObjectURL(status.dataset.selectedPreviewUrl);
            status.dataset.selectedPreviewUrl = "";
        }

        if (existingFileName && !removedExisting) {
            fileNameDisplay.textContent = existingOriginalFileName || existingFileName;
            status.style.display = "flex";
            hiddenUploaded.value = "true";
            hiddenFileName.value = existingFileName;
            if (hiddenOriginalFileName) hiddenOriginalFileName.value = existingOriginalFileName;
            status.dataset.previewMode = "server";
            updateXRayPreview(prefix);
            return;
        }

        fileNameDisplay.textContent = "";
        status.style.display = "none";
        hiddenUploaded.value = "false";
        hiddenFileName.value = "";
        if (hiddenOriginalFileName) hiddenOriginalFileName.value = "";
        status.dataset.previewMode = "";
        updateXRayPreview(prefix);
    }

