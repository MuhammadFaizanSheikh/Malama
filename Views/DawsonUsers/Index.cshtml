@using Malama.Models
@model List<DawsonUserListDto>

@{
    ViewData["Title"] = "Dawson Users";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid">

    
</div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Dawson Users</h5>
        </div>

        <div class="card p-3 mb-4">
    <h5 class="text-center">Search Dawson Users</h5>

    <div class="container">
        <div class="row g-2">

            <div class="col-md-4">
                <input type="text" id="filterEmail" class="form-control" placeholder="Email">
            </div>

            <div class="col-md-4">
                <input type="text" id="filterRole" class="form-control" placeholder="Role">
            </div>

            <div class="col-md-4">
                <input type="text" id="filterEvent" class="form-control" placeholder="Event">
            </div>

            <div class="col-12 text-center mt-2">
                <button id="searchUsersBtn" type="button" class="btn btn-primary px-4">Search</button>
                <button id="resetUsersFiltersBtn" type="button" class="btn btn-secondary px-4 ms-2">Reset Filters</button>
            </div>

        </div>
    </div>

        <div class="card-body">
            <table class="table table-bordered table-hover align-middle" style="width:100%; table-layout:fixed;">
                <thead class="table-light">
                    <tr>
                        <th>Email</th>
                        <th>Role</th>
                        @* <th style="width:100px;">Status</th> *@
                        @* <th>Event Manager</th> *@
                        <th>Events</th>
                        <th style="width:340px;">Allowed Pages & Permissions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <!-- Email -->
                                <td class="email-cell">@user.Email</td>

                                <!-- Roles -->
                                <td class="role-cell" style="width:180px;">
                                    <div style="display:flex; flex-wrap:wrap;">
                                        @foreach (var r in user.Role.Split(','))
                                        {
                                            var roleTrimmed = r.Trim();
                                            var roleColor = roleTrimmed switch
                                            {
                                                "Super Admin" => "#dc3545",                    // Red
                                                "Event Manager" => "#0dcaf0",                  // Cyan
                                                "Project Manager & Program Manager" => "#6c757d", // Green
                                                "DAWSON Admin - Event Coordinator" => "#6c757d",  // Purple
                                                "DAWSON Admin - Staffing/Credentialing" => "#6c757d", // Orange
                                                "DAWSON Admin - System" => "#6c757d",         // Dark Purple
                                                "DAWSON Leadership" => "#6c757d",             // Teal
                                                "DAWSON Admin - Event Staff" => "#6c757d",    // Yellow
                                                _ => "#6c757d"                                // Default blue
                                            };

                                            <span style="background-color:@roleColor; color:white; padding:0.25rem 0.5rem; border-radius:0.25rem; margin-right:0.25rem; margin-bottom:0.25rem; font-size:0.85rem;">
                                                @roleTrimmed
                                            </span>
                                        }
                                    </div>
                                </td>


                                <!-- Status -->
                                @* <td style="text-align:center; vertical-align:middle;">
                                    @if (user.IsActive)
                                    {
                                        <span style="background-color:#198754; color:white; padding:0.25rem 0.5rem; border-radius:0.25rem; font-size:0.85rem; display:inline-block;">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="background-color:#dc3545; color:white; padding:0.25rem 0.5rem; border-radius:0.25rem; font-size:0.85rem; display:inline-block;">
                                            Inactive
                                        </span>
                                    }
                                </td> *@


                                <!-- Is Event Manager -->
                               @*  <td style="text-align:center; vertical-align:middle;">
                                    @if (user.IsEventManager)
                                    {
                                        <span style="background-color:#0dcaf0; color:white; padding:0.25rem 0.5rem; border-radius:0.25rem; font-size:0.85rem; display:inline-block;">
                                            Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="background-color:#6c757d; color:white; padding:0.25rem 0.5rem; border-radius:0.25rem; font-size:0.85rem; display:inline-block;">
                                            No
                                        </span>
                                    }
                                </td> *@


                                <!-- Events -->
                                <td class="event-cell">
                                    @if (user.Events != null && user.Events.Any())
                                    {
                                        <div style="display:flex; flex-wrap:wrap;">
                                            @foreach (var evt in user.Events)
                                            {
                                                <span style="background-color:#f8f9fa; color:#212529; border:1px solid #dee2e6; padding:0.25rem 0.5rem; border-radius:0.25rem; margin-right:0.25rem; margin-bottom:0.25rem; font-size:0.85rem;">
                                                    @evt
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <table style="width:100%; border-collapse:collapse;">
                                        <tbody>
                                            @foreach (Malama.Models.UserPagePermissionDto allowedPage in user.AllowedPages)
                                            {
                                                var access = allowedPage.Access;

                                                string badgeText;
                                                string badgeColor;

                                                if (access.HasFlag(PageAccessLevel.Add) && access.HasFlag(PageAccessLevel.Update))
                                                {
                                                    badgeText = "View, Add & Update";
                                                    badgeColor = "#28a745"; // Green
                                                }
                                                else if (access.HasFlag(PageAccessLevel.Add))
                                                {
                                                    badgeText = access.HasFlag(PageAccessLevel.View)
                                                    ? "View & Add"
                                                    : "Add Only";

                                                    badgeColor = "#17a2b8"; // Blue
                                                }
                                                else if (access.HasFlag(PageAccessLevel.Update))
                                                {
                                                    badgeText = access.HasFlag(PageAccessLevel.View)
                                                    ? "View & Update"
                                                    : "Update Only";

                                                    badgeColor = "#007bff"; // Dark Blue
                                                }
                                                else if (access.HasFlag(PageAccessLevel.View))
                                                {
                                                    badgeText = "View-Only";
                                                    badgeColor = "#fd7e14"; // Orange
                                                }
                                                else
                                                {
                                                    badgeText = "No Access";
                                                    badgeColor = "#6c757d"; // Gray
                                                }

                                                <tr>
                                                    <td style="padding:4px 6px; border-bottom:1px solid #e9ecef;">
                                                        @allowedPage.PageName
                                                    </td>

                                                    <td style="padding:4px 6px; border-bottom:1px solid #e9ecef; text-align:right;">
                                                        <span style="
background-color:@badgeColor;
color:white;
padding:0.15rem 0.6rem;
border-radius:0.25rem;
font-size:0.75rem;
display:inline-block;
min-width:110px;
text-align:center;
white-space:nowrap;">
                                                            @badgeText
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>





                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align:center; color:#6c757d;">No users found</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
<script>

    document.getElementById("searchUsersBtn").addEventListener("click", function () {

        let emailFilter = document.getElementById("filterEmail").value.toLowerCase();
        let roleFilter = document.getElementById("filterRole").value.toLowerCase();
        let eventFilter = document.getElementById("filterEvent").value.toLowerCase();

        let rows = document.querySelectorAll("table tbody tr");

        rows.forEach(row => {

            let email = row.querySelector(".email-cell")?.innerText.toLowerCase() || "";
            let role = row.querySelector(".role-cell")?.innerText.toLowerCase() || "";
            let event = row.querySelector(".event-cell")?.innerText.toLowerCase() || "";

            let match =
                (emailFilter === "" || email.includes(emailFilter)) &&
                (roleFilter === "" || role.includes(roleFilter)) &&
                (eventFilter === "" || event.includes(eventFilter));

            row.style.display = match ? "" : "none";

        });

    });

    document.getElementById("resetUsersFiltersBtn").addEventListener("click", function () {

        document.getElementById("filterEmail").value = "";
        document.getElementById("filterRole").value = "";
        document.getElementById("filterEvent").value = "";

        let rows = document.querySelectorAll("table tbody tr");

        rows.forEach(row => {
            row.style.display = "";
        });

    });

</script>