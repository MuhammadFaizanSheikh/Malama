@model ExcelFilesCompiler.Models.ContractViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml"; // Adjust the path to your layout file if necessary
    ViewData["Title"] = "Contract Details";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.11/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- DataTables CSS for Bootstrap 5 -->
<link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contract Form</title>



    <style>
        h2 {
            color: rgba(80, 90, 201, 1);
        }

        h3 {
            color: rgba(80, 90, 201, 1);
        }

        body {
            background-color: #f8f9fa;
        }

        #contractsTable {
            border: 1px solid #ddd;
            border-collapse: collapse;
            width: 100%;
        }

            #contractsTable th, #contractsTable td {
                border: 1px solid #ddd;
                padding: 8px;
                text-align: left;
            }

            #contractsTable th {
                background-color: #f4f4f4;
            }

            #contractsTable tbody tr {
                background-color: rgba(240, 245, 255, 1); /* Very lighter version */
            }

                #contractsTable tbody tr:hover {
                    background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
                }


    </style>
</head>


@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: '#4CAF50', // Optional: Customize button color
                iconColor: '#4CAF50' // Optional: Customize icon color
            });
        });
    </script>
}

<h2 class="text-center mt-4">Contract Details</h2>

<div class="container mt-4 mb-5">
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div class="alert alert-danger">
            <strong>Validation failed!</strong>
            <ul>
                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@modelError.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <button class="btn btn-primary" id="addContractBtn">Add Contract</button>
    <div id="datatableWrapper" class="datatable-wrapper">
    <table id="contractsTable" class="display">
        <thead>
            <tr>
                <th>Contract ID</th>
                <th>Contract Agency</th>
                <th>Contract Service Branch</th>
                <th>Contract Component</th>
                <th>Contract Client</th>
                <th>Contract Type</th>
                <th>Contract Dawson Role</th>
                <th>Contract Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Contracts != null && Model.Contracts.Any())
            {
                @foreach (var contract in Model.Contracts)
                {
                    <tr>
                        <td>@contract.ContractID</td>
                        <td>@contract.ContractAgency</td>
                        <td>@contract.ContractServiceBranch</td>
                        <td>@contract.ContractComponent</td>
                        <td>@contract.ContractClient</td>
                        <td>@contract.ContractType</td>
                        <td>@contract.DawsonRoleOnContract</td>
                        <td>@contract.ContractStatus</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = contract.Id })" class="btn btn-primary">Edit</a>
                            <a href="@Url.Action("Details", new { id = contract.Id })" class="btn btn-info">View</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">No contracts available</td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <div class="card-body" style="display: none;">
        <form asp-action="CreateContractDetails" method="post">
            <!-- Row 1 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.ContractID" class="form-label">Contract ID # (Dawson)</label>
                    <input asp-for="SingleContract.ContractID" class="form-control" placeholder="Enter Contract ID" maxLength="13" required />
                    <span asp-validation-for="SingleContract.ContractID" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.ContractAgency" class="form-label">Contract Agency</label>
                    <input asp-for="SingleContract.ContractAgency" class="form-control" placeholder="Enter Contract Agency" maxLength="50" required />
                    <span asp-validation-for="SingleContract.ContractAgency" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.ContractServiceBranch" class="form-label">Contract Service Branch</label>
                    <select asp-for="SingleContract.ContractServiceBranch" class="form-select" required>
                        <option value="">Select Branch</option>
                        <option>Army</option>
                        <option>Airforce</option>
                        <option>Navy</option>
                        <option>Marines</option>
                        <option>Coast Guard</option>
                        <option>Space Force</option>
                    </select>
                    @* <span asp-validation-for="SingleContract.ContractServiceBranch" class="text-danger"></span> *@
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.ContractComponent" class="form-label">Contract Component</label>
                    <select asp-for="SingleContract.ContractComponent" class="form-select" required>
                        <option value="">Select Component</option>
                        <option>Active Duty</option>
                        <option>National Guard</option>
                        <option>Reserve</option>
                    </select>
                    <span asp-validation-for="SingleContract.ContractComponent" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 3 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.ContractClient" class="form-label">Contract Client</label>
                    <select asp-for="SingleContract.ContractClient" class="form-select" required>
                        <option value="">Select Client</option>
                        <option>Command</option>
                        <option>State</option>
                    </select>
                    <span asp-validation-for="SingleContract.ContractClient" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.ContractType" class="form-label">Contract Type</label>
                    <select asp-for="SingleContract.ContractType" class="form-select" required>
                        <option value="">Select Type</option>
                        <option>FFP</option>
                        <option>CPFF</option>
                        <option>T&M</option>
                    </select>
                    <span asp-validation-for="SingleContract.ContractType" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 4 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonRoleOnContract" class="form-label">DAWSON Role on Contract</label>
                    <select asp-for="SingleContract.DawsonRoleOnContract" class="form-select" required>
                        <option value="">Select Role</option>
                        <option>Prime</option>
                        <option>Sub</option>
                    </select>
                    <span asp-validation-for="SingleContract.DawsonRoleOnContract" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.ContractStatus" class="form-label">Contract Status</label>
                    <select asp-for="SingleContract.ContractStatus" class="form-select" required>
                        <option value="">Select Status</option>
                        <option>Bidding</option>
                        <option>Active</option>
                        <option>Complete</option>
                    </select>
                    <span asp-validation-for="SingleContract.ContractStatus" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 5 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.ContractStartDate" class="form-label">Contract Start Date</label>
                    <input asp-for="SingleContract.ContractStartDate" type="date" class="form-control" required />
                    <span asp-validation-for="SingleContract.ContractStartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.ContractEndDate" class="form-label">Contract End Date</label>
                    <input asp-for="SingleContract.ContractEndDate" type="date" class="form-control" required />
                    <span asp-validation-for="SingleContract.ContractEndDate" class="text-danger"></span>
                </div>
            </div>

            <h3 class="mt-5 mb-3">Contract Officer (KO)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.KoLastName" class="form-label">Last Name</label>
                    <input asp-for="SingleContract.KoLastName" class="form-control" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.KoLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.KoFirstName" class="form-label">First Name</label>
                    <input asp-for="SingleContract.KoFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.KoFirstName" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.KOPhone" class="form-label">KO Phone</label>
                    <input asp-for="SingleContract.KOPhone" class="form-control" id="KoPhone" placeholder="xxx-xxx-xxxx" inputmode="numeric" maxlength="12" required />
                    <span asp-validation-for="SingleContract.KOPhone" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.KOPhone2" class="form-label">KO Phone 2</label>
                    <input asp-for="SingleContract.KOPhone2" class="form-control" id="KoPhone2" placeholder="xxx-xxx-xxxx" inputmode="numeric" maxlength="12" required />
                    <span asp-validation-for="SingleContract.KOPhone2" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.KOEmail" class="form-label">KO Email</label>
                    <input asp-for="SingleContract.KOEmail" class="form-control" type="email" placeholder="Enter KO Email" maxLength="50" required />
                    <span asp-validation-for="SingleContract.KOEmail" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.KONotes" class="form-label">KO Notes</label>
                    <textarea asp-for="SingleContract.KONotes" class="form-control" rows="4" placeholder="Enter KO Notes" maxLength="300" required></textarea>
                    <span asp-validation-for="SingleContract.KONotes" class="text-danger"></span>
                </div>
            </div>

            <!-- New Contract Officer Representative (COR) Section -->
            <h3 class="mt-5 mb-3">Contract Officer Representative (COR)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.CORLastName" class="form-label">Last Name</label>
                    <input asp-for="SingleContract.CORLastName" class="form-control" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.CORLastName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <!-- Label for CORFirstName -->
                    <label asp-for="SingleContract.CORFirstName" class="form-label">First Name</label>

                    <div class="input-group">
                        <!-- Dropdown for Prefix -->
                        <select asp-for="SingleContract.CORPrefix" class="form-select" id="CORPrefix" required>
                            <option value="">Select</option>
                            <option value="Mr">Mr</option>
                            <option value="Mrs">Mrs</option>
                            <option value="Ms">Ms</option>
                        </select>

                        <!-- Input for First Name -->
                        <input asp-for="SingleContract.CORFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
                    </div>

                    <span asp-validation-for="SingleContract.CORFirstName" class="text-danger"></span>
                </div>

            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.CORKORank" class="form-label">Rank</label>
                    <input asp-for="SingleContract.CORKORank" class="form-control" placeholder="Enter Rank" maxLength="50" required />
                    <span asp-validation-for="SingleContract.CORKORank" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.CORPhone" class="form-label">COR Phone</label>
                    <input asp-for="SingleContract.CORPhone" class="form-control" id="CorPhone" placeholder="xxx-xxx-xxxx" inputmode="numeric" maxlength="12" required />
                    <span asp-validation-for="SingleContract.CORPhone" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.CORPhone2" class="form-label">COR Phone 2</label>
                    <input asp-for="SingleContract.CORPhone2" class="form-control" id="CorPhone2" placeholder="xxx-xxx-xxxx" inputmode="numeric" maxlength="12" required />
                    <span asp-validation-for="SingleContract.CORPhone2" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.COREmail" class="form-label">COR Email</label>
                    <input asp-for="SingleContract.COREmail" class="form-control" type="email" placeholder="Enter COR Email" maxLength="50" required />
                    <span asp-validation-for="SingleContract.COREmail" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="SingleContract.CORNotes" class="form-label">COR Notes</label>
                    <textarea asp-for="SingleContract.CORNotes" class="form-control" rows="4" placeholder="Enter COR Notes" maxLength="300" required></textarea>
                    <span asp-validation-for="SingleContract.CORNotes" class="text-danger"></span>
                </div>
            </div>

            <h3 class="mt-5 mb-3">DAWSON Program Manager</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonProgramManagerLastName" class="form-label">Last Name</label>
                    <input asp-for="SingleContract.DawsonProgramManagerLastName" class="form-control" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonProgramManagerLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonProgramManagerFirstName" class="form-label">First Name</label>
                    <input asp-for="SingleContract.DawsonProgramManagerFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonProgramManagerFirstName" class="text-danger"></span>
                </div>
            </div>


            <h3 class="mt-5 mb-3">DAWSON Deputy Program Manager (DDPM)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonDeputyProgramManagerLastName" class="form-label">Last Name</label>
                    <input asp-for="SingleContract.DawsonDeputyProgramManagerLastName" class="form-control" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonDeputyProgramManagerLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonDeputyProgramManagerFirstName" class="form-label">First Name</label>
                    <input asp-for="SingleContract.DawsonDeputyProgramManagerFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonDeputyProgramManagerFirstName" class="text-danger"></span>
                </div>
            </div>


            <h3 class="mt-5 mb-3">DAWSON Project Manager (DPM)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonProjectManagerLastName" class="form-label">Last Name</label>
                    <input asp-for="SingleContract.DawsonProjectManagerLastName" class="form-control" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonProjectManagerLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonProjectManagerFirstName" class="form-label">First Name</label>
                    <input asp-for="SingleContract.DawsonProjectManagerFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonProjectManagerFirstName" class="text-danger"></span>
                </div>
            </div>


            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-success btn-lg me-2">
                    <i class="bi bi-check-circle"></i> Submit
                </button>
                <button type="reset" class="btn btn-secondary btn-lg">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </button>
            </div>
        </form>
    </div>
</div>
<script>


    $(document).ready(function () {
        $('.card-body').hide();
        $('#contractsTable').show();

        // Add Contract button click event
        $('#addContractBtn').click(function () {
            // Show the form and hide the table
            $('.card-body').show();
            $('#datatableWrapper').hide();
        });

        $('#contractsTable').DataTable({
            "paging": true,  // Enables pagination
            "lengthChange": true,  // Option to change number of records per page
            "searching": true,  // Enables search box
            "ordering": true,  // Enables column sorting
            "info": true,  // Shows table information (e.g., "Showing 1 to 10 of 50 entries")
            "autoWidth": true,  // Adjusts table width automatically
            "responsive": true,  // Makes the table responsive on small screens
            "language": {
                "search": "Search Contracts:"  // Customizing the search box label
            }
        });
    });
    
    const phoneFields = ['KoPhone', 'KoPhone2', 'CorPhone', 'CorPhone2'];
    phoneFields.forEach(function (fieldId) {
        applyPhoneNumberMask(document.getElementById(fieldId));
    });

    function applyPhoneNumberMask(inputElement) {
        inputElement.addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, ''); // Remove all non-digit characters
            if (value.length > 3 && value.length <= 6) {
                value = value.slice(0, 3) + '-' + value.slice(3);
            } else if (value.length > 6) {
                value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6, 10);
            }
            e.target.value = value;
        });
    }
</script>
