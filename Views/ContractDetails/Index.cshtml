@model Malama.Models.ContractViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Contract Details";
}

<style>
    .ccd-page {
        --ccd-indigo: rgba(80, 90, 201, 1);
        --ccd-indigo-soft: rgba(80, 90, 201, 0.12);
        --ccd-indigo-mid: rgba(80, 90, 201, 0.22);
        --ccd-text: #1f2430;
        --ccd-muted: #6b7285;
        --ccd-surface: #ffffff;
        --ccd-border: rgba(31, 36, 48, 0.08);
        --ccd-shadow: 0 10px 28px rgba(21, 24, 33, 0.06);
        --ccd-radius: 16px;
    }

    .ccd-page .btn-general {
        background: var(--ccd-indigo);
        border: 1px solid var(--ccd-indigo);
        color: #fff;
        border-radius: 10px;
        padding: 0.55rem 1.15rem;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .ccd-page .btn-general:hover {
        background: rgb(60, 70, 180);
        border-color: rgb(60, 70, 180);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(80, 90, 201, 0.25);
    }

    .ccd-page .btn-general:focus,
    .ccd-page .btn-general:active {
        box-shadow: 0 0 0 0.2rem rgba(80, 90, 201, 0.35);
        outline: none;
        color: #fff;
    }

    .ccd-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
        padding: 0.15rem 0.2rem 0.35rem;
    }

    .ccd-kicker {
        margin: 0 0 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ccd-indigo);
    }

    .ccd-title {
        margin: 0;
        font-size: clamp(1.55rem, 2.2vw, 2rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--ccd-text);
    }

    .ccd-subtitle {
        margin: 0.4rem 0 0;
        color: var(--ccd-muted);
        font-size: 0.95rem;
    }

    .ccd-table-panel {
        background: var(--ccd-surface);
        border: 1px solid var(--ccd-border);
        border-radius: var(--ccd-radius);
        box-shadow: var(--ccd-shadow);
        padding: 1rem 1rem 0.85rem;
        overflow: hidden;
    }

    .ccd-page #datatableWrapper {
        width: 100%;
        overflow-x: auto;
    }

    .ccd-page #contractsTable {
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0;
        border: none;
    }

    .ccd-page #contractsTable thead th {
        background: linear-gradient(180deg, #5a64d0 0%, rgba(80, 90, 201, 1) 100%) !important;
        color: #fff !important;
        border: none !important;
        padding: 0.85rem 0.75rem !important;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        white-space: nowrap;
        text-align: center;
        vertical-align: middle;
    }

    .ccd-page #contractsTable thead th:first-child {
        border-top-left-radius: 12px;
    }

    .ccd-page #contractsTable thead th:last-child {
        border-top-right-radius: 12px;
    }

    .ccd-page #contractsTable tbody td {
        border: none !important;
        border-bottom: 1px solid rgba(31, 36, 48, 0.06) !important;
        padding: 0.8rem 0.75rem !important;
        text-align: center;
        vertical-align: middle;
        color: var(--ccd-text);
        background: transparent !important;
        font-size: 0.9rem;
    }

    .ccd-page #contractsTable tbody tr {
        background: #fff !important;
        transition: background 0.18s ease;
    }

    .ccd-page #contractsTable tbody tr:nth-child(even) {
        background: rgba(247, 248, 252, 0.9) !important;
    }

    .ccd-page #contractsTable tbody tr:hover {
        background: rgba(80, 90, 201, 0.07) !important;
    }

    .ccd-page #contractsTable td .button-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.45rem;
    }

    .ccd-page .edit-btn,
    .ccd-page .view-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        padding: 0;
        border-radius: 10px;
        border: none;
        font-size: 0.9rem;
        line-height: 1;
        text-decoration: none;
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    .ccd-page .edit-btn {
        background: var(--ccd-indigo) !important;
        color: #fff !important;
    }

    .ccd-page .edit-btn:hover {
        background: rgb(60, 70, 180) !important;
        color: #fff !important;
        transform: translateY(-1px);
        box-shadow: 0 8px 16px rgba(80, 90, 201, 0.28);
    }

    .ccd-page .view-btn {
        background: #fff !important;
        color: var(--ccd-indigo) !important;
        border: 1px solid var(--ccd-indigo-mid) !important;
    }

    .ccd-page .view-btn:hover {
        background: var(--ccd-indigo-soft) !important;
        color: var(--ccd-indigo) !important;
        transform: translateY(-1px);
        box-shadow: 0 8px 16px rgba(80, 90, 201, 0.16);
    }

    .ccd-page .dataTables_wrapper .dataTables_filter input,
    .ccd-page .dataTables_wrapper .dataTables_length select {
        border-radius: 8px;
        border: 1px solid rgba(31, 36, 48, 0.12);
        padding: 0.35rem 0.55rem;
    }

    .ccd-page .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: var(--ccd-indigo) !important;
        border-color: var(--ccd-indigo) !important;
        color: #fff !important;
        border-radius: 8px;
    }

    .ccd-page .dataTables_wrapper .dataTables_info,
    .ccd-page .dataTables_wrapper .dataTables_length,
    .ccd-page .dataTables_wrapper .dataTables_filter {
        color: var(--ccd-muted);
        font-size: 0.88rem;
        margin-bottom: 0.65rem;
    }

    @@media (max-width: 900px) {
        .ccd-hero {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<section class="ccd-page">
    <div class="ccd-hero">
        <div>
            <p class="ccd-kicker">Contracts</p>
            <h1 class="ccd-title">Contract Details</h1>
        </div>
        <div>
            @if (Malama.Utilities.DashboardAuthorizationHelper.HasAccess(User, "ContractDetails_Save"))
            {
                <a asp-action="Create" class="btn btn-general" id="addContractBtn">
                    <i class="fas fa-plus" aria-hidden="true"></i> Add New Contract
                </a>
            }
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (TempData["ResponseMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
                var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

                Swal.fire({
                    icon: '@TempData["ResponseStatus"]',
                    title: '@TempData["ResponseTitle"]',
                    text: '@TempData["ResponseMessage"]',
                    confirmButtonText: 'OK',
                    confirmButtonColor: buttonColor,
                    iconColor: iconColor
                });
            });
        </script>
    }

    <div id="datatableWrapper" class="datatable-wrapper ccd-table-panel">
        <table id="contractsTable" class="display">
            <thead>
                <tr>
                    <th>Contract ID</th>
                    <th>Contract Agency</th>
                    <th>Dawson Contract Name</th>
                    <th>Contract Service Branch</th>
                    <th>Contract Component</th>
                    <th>Contract Client</th>
                    <th>Contract Type</th>
                    <th>Contract Dawson Role</th>
                    <th>Contract Status</th>
                    <th>Contract Start Date</th>
                    <th>Contract End Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Contracts != null && Model.Contracts.Any())
                {
                    @foreach (var contract in Model.Contracts)
                    {
                        <tr data-id="@contract.Id">
                            <td>@contract.ContractID</td>
                            <td>@contract.ContractAgency</td>
                            <td>@contract.ContractName</td>
                            <td>@contract.ContractServiceBranch</td>
                            <td>@contract.ContractComponent</td>
                            <td>@contract.ContractClient</td>
                            <td>@contract.ContractType</td>
                            <td>@contract.DawsonRoleOnContract</td>
                            <td>@contract.ContractStatus</td>
                            <td>@contract.ContractStartDate.ToString("MM-dd-yyyy")</td>
                            <td>@contract.ContractEndDate.ToString("MM-dd-yyyy")</td>
                            <td>
                                <div class="button-container">
                                    @if (Malama.Utilities.DashboardAuthorizationHelper.HasAccess(User, "ContractDetails_Save"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@contract.Id" class="edit-btn" title="Edit" aria-label="Edit">
                                            <i class="fas fa-edit" aria-hidden="true"></i>
                                        </a>
                                    }
                                    <a asp-action="ViewContract" asp-route-id="@contract.Id" class="view-btn" title="View" aria-label="View">
                                        <i class="fas fa-eye" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

<script>
    $(document).ready(function () {
        $('#contractsTable').DataTable({
            "paging": true,
            "lengthChange": true,
            "searching": true,
            "ordering": true,
            "info": true,
            "autoWidth": true,
            "responsive": true,
            "language": {
                "search": "Search:",
                "emptyTable": "No contracts available"
            },
            "order": [[0, 'desc']]
        });
    });
</script>
