                    <input asp-for="DawsonProgramManagerFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
        <span asp-validation-for="DawsonProgramManagerFirstName" class="text-danger"></span>
    </div>
</div>


           <h3 class="mt-5 mb-3">DAWSON Deputy Program Manager (DDPM)</h3>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonDeputyProgramManagerLastName" class="form-label">Last Name</label>
                    <input asp-for="DawsonDeputyProgramManagerLastName" class="form-control" placeholder="Enter Last Name" maxLength="50" required />
        <span asp-validation-for="DawsonDeputyProgramManagerLastName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonDeputyProgramManagerFirstName" class="form-label">First Name</label>
                    <input asp-for="DawsonDeputyProgramManagerFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
        <span asp-validation-for="DawsonDeputyProgramManagerFirstName" class="text-danger"></span>
    </div>
</div>


<h3 class="mt-5 mb-3">DAWSON Project Manager (DPM)</h3>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonProjectManagerLastName" class="form-label">Last Name</label>
                    <input asp-for="DawsonProjectManagerLastName" class="form-control" placeholder="Enter Last Name" maxLength="50" required />
        <span asp-validation-for="DawsonProjectManagerLastName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonProjectManagerFirstName" class="form-label">First Name</label>
                    <input asp-for="DawsonProjectManagerFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
        <span asp-validation-for="DawsonProjectManagerFirstName" class="text-danger"></span>
    </div>
</div>


            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-success btn-lg me-2">
                    <i class="bi bi-check-circle"></i> Submit
                </button>
                <button type="reset" class="btn btn-secondary btn-lg">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </button>
            </div>
            </form>
        </div>
</div>
<script>

    const phoneFields = ['KoPhone', 'KoPhone2', 'CorPhone', 'CorPhone2'];
    phoneFields.forEach(function (fieldId) {
        applyPhoneNumberMask(document.getElementById(fieldId));
    });

    function applyPhoneNumberMask(inputElement) {
        inputElement.addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, ''); // Remove all non-digit characters
            if (value.length > 3 && value.length <= 6) {
                value = value.slice(0, 3) + '-' + value.slice(3);
            } else if (value.length > 6) {
                value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6, 10);
            }
            e.target.value = value;
        });
    }
</script>