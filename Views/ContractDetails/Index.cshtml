@model ExcelFilesCompiler.Models.ContractDetailsDto

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml"; // Adjust the path to your layout file if necessary
    ViewData["Title"] = "Contract Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contract Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
    <style>
        h2 {
            color: rgba(80, 90, 201, 1);
        }

        h3 {
            color: rgba(80, 90, 201, 1);
        }

        body {
            background-color: #f8f9fa;
        }

        /* .form-label {
            font-weight: bold;
        } */
    </style>
</head>


<h2 class="text-center mt-4">Contract Details</h2>

<div class="container mt-4 mb-5">
        <div class="card-body">
            <form asp-action="YourActionName" method="post">
                <!-- Row 1 -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContractID" class="form-label">Contract ID # (Dawson)</label>
                        <input asp-for="ContractID" class="form-control" placeholder="Enter Contract ID" />
                        <span asp-validation-for="ContractID" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContractAgency" class="form-label">Contract Agency</label>
                        <input asp-for="ContractAgency" class="form-control" placeholder="Enter Contract Agency" />
                        <span asp-validation-for="ContractAgency" class="text-danger"></span>
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContractServiceBranch" class="form-label">Contract Service Branch</label>
                        <select asp-for="ContractServiceBranch" class="form-select">
                            <option value="">Select Branch</option>
                            <option>Army</option>
                            <option>Airforce</option>
                            <option>Navy</option>
                            <option>Marines</option>
                            <option>Coast Guard</option>
                            <option>Space Force</option>
                        </select>
                        <span asp-validation-for="ContractServiceBranch" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContractComponent" class="form-label">Contract Component</label>
                        <select asp-for="ContractComponent" class="form-select">
                            <option value="">Select Component</option>
                            <option>Active Duty</option>
                            <option>National Guard</option>
                            <option>Reserve</option>
                        </select>
                        <span asp-validation-for="ContractComponent" class="text-danger"></span>
                    </div>
                </div>

                <!-- Row 3 -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContractClient" class="form-label">Contract Client</label>
                        <select asp-for="ContractClient" class="form-select">
                            <option value="">Select Client</option>
                            <option>Command</option>
                            <option>State</option>
                        </select>
                        <span asp-validation-for="ContractClient" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContractType" class="form-label">Contract Type</label>
                        <select asp-for="ContractType" class="form-select">
                            <option value="">Select Type</option>
                            <option>FFP</option>
                            <option>CPFF</option>
                            <option>T&M</option>
                        </select>
                        <span asp-validation-for="ContractType" class="text-danger"></span>
                    </div>
                </div>

                <!-- Row 4 -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DawsonRoleOnContract" class="form-label">DAWSON Role on Contract</label>
                        <select asp-for="DawsonRoleOnContract" class="form-select">
                            <option value="">Select Role</option>
                            <option>Prime</option>
                            <option>Sub</option>
                        </select>
                        <span asp-validation-for="DawsonRoleOnContract" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContractStatus" class="form-label">Contract Status</label>
                        <select asp-for="ContractStatus" class="form-select">
                            <option value="">Select Status</option>
                            <option>Bidding</option>
                            <option>Active</option>
                            <option>Complete</option>
                        </select>
                        <span asp-validation-for="ContractStatus" class="text-danger"></span>
                    </div>
                </div>

                <!-- Row 5 -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContractStartDate" class="form-label">Contract Start Date</label>
                        <input asp-for="ContractStartDate" type="date" class="form-control" />
                        <span asp-validation-for="ContractStartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContractEndDate" class="form-label">Contract End Date</label>
                        <input asp-for="ContractEndDate" type="date" class="form-control" />
                        <span asp-validation-for="ContractEndDate" class="text-danger"></span>
                    </div>
                </div>

                <h3 class="mt-5 mb-3">Contract Officer (KO)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" placeholder="Enter Last Name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Enter First Name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="KOPhone" class="form-label">KO Phone</label>
                    <input asp-for="KOPhone" class="form-control" placeholder="Enter KO Phone" />
                    <span asp-validation-for="KOPhone" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="KOPhone2" class="form-label">KO Phone 2</label>
                    <input asp-for="KOPhone2" class="form-control" placeholder="Enter KO Phone 2" />
                    <span asp-validation-for="KOPhone2" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="KOEmail" class="form-label">KO Email</label>
                    <input asp-for="KOEmail" class="form-control" placeholder="Enter KO Email" />
                    <span asp-validation-for="KOEmail" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="KONotes" class="form-label">KO Notes</label>
                    <textarea asp-for="KONotes" class="form-control" rows="4" placeholder="Enter KO Notes"></textarea>
                    <span asp-validation-for="KONotes" class="text-danger"></span>
                </div>
            </div>

            <!-- New Contract Officer Representative (COR) Section -->
            <h3 class="mt-5 mb-3">Contract Officer Representative (COR)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CORLastName" class="form-label">Last Name</label>
                    <input asp-for="CORLastName" class="form-control" placeholder="Enter Last Name" required />
                    <span asp-validation-for="CORLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CORFirstName" class="form-label">First Name</label>
                    <input asp-for="CORFirstName" class="form-control" placeholder="Enter First Name" required />
                    <span asp-validation-for="CORFirstName" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CORKORank" class="form-label">Rank</label>
                    <input asp-for="CORKORank" class="form-control" placeholder="Enter Rank" required />
                    <span asp-validation-for="CORKORank" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CORPhone" class="form-label">COR Phone</label>
                    <input asp-for="CORPhone" class="form-control" placeholder="Enter COR Phone" required />
                    <span asp-validation-for="CORPhone" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CORPhone2" class="form-label">COR Phone 2</label>
                    <input asp-for="CORPhone2" class="form-control" placeholder="Enter COR Phone 2" required />
                    <span asp-validation-for="CORPhone2" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="COREmail" class="form-label">COR Email</label>
                    <input asp-for="COREmail" class="form-control" placeholder="Enter COR Email" required />
                    <span asp-validation-for="COREmail" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="CORNotes" class="form-label">COR Notes</label>
                    <textarea asp-for="CORNotes" class="form-control" rows="4" placeholder="Enter COR Notes" required></textarea>
                    <span asp-validation-for="CORNotes" class="text-danger"></span>
                </div>
            </div>

            <h3 class="mt-5 mb-3">DAWSON Program Manager</h3>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonProgramManagerLastName" class="form-label">Last Name</label>
        <input asp-for="DawsonProgramManagerLastName" class="form-control" placeholder="Enter Last Name" />
        <span asp-validation-for="DawsonProgramManagerLastName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonProgramManagerFirstName" class="form-label">First Name</label>
        <input asp-for="DawsonProgramManagerFirstName" class="form-control" placeholder="Enter First Name" />
        <span asp-validation-for="DawsonProgramManagerFirstName" class="text-danger"></span>
    </div>
</div>


           <h3 class="mt-5 mb-3">DAWSON Deputy Program Manager (DDPM)</h3>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonDeputyProgramManagerLastName" class="form-label">Last Name</label>
        <input asp-for="DawsonDeputyProgramManagerLastName" class="form-control" placeholder="Enter Last Name" />
        <span asp-validation-for="DawsonDeputyProgramManagerLastName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonDeputyProgramManagerFirstName" class="form-label">First Name</label>
        <input asp-for="DawsonDeputyProgramManagerFirstName" class="form-control" placeholder="Enter First Name" />
        <span asp-validation-for="DawsonDeputyProgramManagerFirstName" class="text-danger"></span>
    </div>
</div>


<h3 class="mt-5 mb-3">DAWSON Project Manager (DPM)</h3>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonProjectManagerLastName" class="form-label">Last Name</label>
        <input asp-for="DawsonProjectManagerLastName" class="form-control" placeholder="Enter Last Name" />
        <span asp-validation-for="DawsonProjectManagerLastName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DawsonProjectManagerFirstName" class="form-label">First Name</label>
        <input asp-for="DawsonProjectManagerFirstName" class="form-control" placeholder="Enter First Name" />
        <span asp-validation-for="DawsonProjectManagerFirstName" class="text-danger"></span>
    </div>
</div>


            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-success btn-lg me-2">
                    <i class="bi bi-check-circle"></i> Submit
                </button>
                <button type="reset" class="btn btn-secondary btn-lg">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </button>
            </div>
            </form>
        </div>
</div>
