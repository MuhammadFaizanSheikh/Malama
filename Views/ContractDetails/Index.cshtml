@model Malama.Models.ContractViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml"; // Adjust the path to your layout file if necessary
    ViewData["Title"] = "Contract Details";
}

<style>
    h2 {
        color: rgba(80, 90, 201, 1);
    }

    h3 {
        color: rgba(80, 90, 201, 1);
    }

    body {
        background-color: #f8f9fa;
    }

    #contractsTable {
        border: 1px solid #ddd;
        border-collapse: collapse;
        width: 100%;
    }

        #contractsTable th, #contractsTable td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        #contractsTable th {
            background-color: #f4f4f4;
        }

        #contractsTable tbody tr {
            background-color: rgba(240, 245, 255, 1); /* Very lighter version */
        }

            #contractsTable tbody tr:hover {
                background-color: rgba(245, 250, 255, 1); /* Even lighter version on hover */
            }

        #contractsTable td, #contractsTable th {
            text-align: center; /* Aligns the text in the middle of the cell */
        }

            #contractsTable td button, #contractsTable td a {
                display: inline-block; /* Makes the buttons appear side by side */
                margin-right: 5px; /* Optional: Adds space between the buttons */
            }

            #contractsTable td .button-container {
                display: flex;
                justify-content: center; /* Aligns buttons horizontally in the center */
            }

                #contractsTable td .button-container a {
                    margin-right: 5px; /* Optional: Adds space between the buttons */
                }

        #contractsTable thead th {
            background-color: rgba(120, 130, 221, 1); /* Header background color */
            color: white; /* Header text color */
            text-align: center; /* Optional: Center-align header text */
        }

    .read-only-style {
        background-color: #f8f9fa; /* Light gray background */
        pointer-events: none; /* Disable click and focus */
        border-color: #ced4da; /* Light border color */
    }
</style>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (TempData["ResponseMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
            var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

            Swal.fire({
                icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                title: '@TempData["ResponseTitle"]',
                text: '@TempData["ResponseMessage"]',
                confirmButtonText: 'OK',
                confirmButtonColor: buttonColor, // Conditional button color
                iconColor: iconColor // Conditional icon color
            });
        });
    </script>
}


<h2 class="text-center mb-4">@ViewData["Title"]</h2>


    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div class="alert alert-danger">
            <strong>Validation failed!</strong>
            <ul>
                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@modelError.ErrorMessage</li>
                }
            </ul>
        </div>
    }


    <div style="display: flex; justify-content: center; align-items: center;">
        <button class="btn btn-primary" id="addContractBtn"
                style="background-color: rgba(80, 90, 201, 1); border-color: rgba(80, 90, 201, 1);">
            Add New Contract
        </button>
    </div>
    <div id="datatableWrapper" class="datatable-wrapper">
        <table id="contractsTable" class="display">
            <thead>
                <tr>
                    <th>Contract ID</th>
                    <th>Contract Agency</th>
                    <th>Dawson Contract Name</th>
                    <th>Contract Service Branch</th>
                    <th>Contract Component</th>
                    <th>Contract Client</th>
                    <th>Contract Type</th>
                    <th>Contract Dawson Role</th>
                    <th>Contract Status</th>
                    <th>Contract Start Date</th>
                    <th>Contract End Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Contracts != null && Model.Contracts.Any())
                {
                    @foreach (var contract in Model.Contracts)
                    {
                        <tr data-id="@contract.Id">
                            <td>@contract.ContractID</td>
                            <td>@contract.ContractAgency</td>
                            <td>@contract.ContractName</td>
                            <td>@contract.ContractServiceBranch</td>
                            <td>@contract.ContractComponent</td>
                            <td>@contract.ContractClient</td>
                            <td>@contract.ContractType</td>
                            <td>@contract.DawsonRoleOnContract</td>
                            <td>@contract.ContractStatus</td>
                            <td>@contract.ContractStartDate.ToString("MM-dd-yyyy")</td>
                        <td>@contract.ContractEndDate.ToString("MM-dd-yyyy")</td>
                            <td>
                                <div class="button-container">
                                    <a href="javascript:void(0);" class="btn btn-primary edit-btn" data-id="@contract.Id" style="background-color: rgba(80, 90, 201, 1);">Edit</a>
                                    <a href="javascript:void(0);" class="btn btn-secondary view-btn" data-id="@contract.Id">View</a>
                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                        <td class="text-center">No data available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <div class="card-body" style="display: none;">
        <form id="contractForm" asp-action="CreateContractDetails" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SingleContract.Id" id="hiddenId" />
            <!-- Row 1 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContractID" class="form-label">Contract ID # (Dawson)</label>
                    <input id="ContractID" asp-for="SingleContract.ContractID" class="form-control" placeholder="Enter Contract ID" maxLength="13" required />
                    <span asp-validation-for="SingleContract.ContractID" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="ContractName" class="form-label">Dawson Contract Name</label>
                    <input id="ContractName" asp-for="SingleContract.ContractName" class="form-control" placeholder="Enter Contract Name" maxLength="32" required />
                    <span asp-validation-for="SingleContract.ContractName" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContractAgency" class="form-label">Contract Agency</label>
                    <input id="ContractAgency" asp-for="SingleContract.ContractAgency" class="form-control" placeholder="Enter Contract Agency" maxLength="50" required />
                    <span asp-validation-for="SingleContract.ContractAgency" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="ContractServiceBranch" class="form-label">Contract Service Branch</label>
                    <select id="ContractServiceBranch" asp-for="SingleContract.ContractServiceBranch" class="form-select" maxLength="20" required>
                        <option value="">Select Branch</option>
                        <option>Army</option>
                        <option>Airforce</option>
                        <option>Navy</option>
                        <option>Marines</option>
                        <option>Coast Guard</option>
                        <option>Space Force</option>
                    </select>
                </div>

            </div>

            <!-- Row 3 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContractComponent" class="form-label">Contract Component</label>
                    <select id="ContractComponent" asp-for="SingleContract.ContractComponent" class="form-select" maxLength="20" required>
                        <option value="">Select Component</option>
                        <option>Active Duty</option>
                        <option>National Guard</option>
                        <option>Reserve</option>
                    </select>
                    <span asp-validation-for="SingleContract.ContractComponent" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="ContractClient" class="form-label">Contract Client</label>
                    <select id="ContractClient" asp-for="SingleContract.ContractClient" class="form-select" maxLength="20" required>
                        <option value="">Select Client</option>
                        <option>Command</option>
                        <option>State</option>
                    </select>
                    <span asp-validation-for="SingleContract.ContractClient" class="text-danger"></span>
                </div>

            </div>

            <!-- Row 4 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContractType" class="form-label">Contract Type</label>
                    <select id="ContractType" asp-for="SingleContract.ContractType" class="form-select" maxLength="20" required>
                        <option value="">Select Type</option>
                        <option>FFP</option>
                        <option>CPFF</option>
                        <option>T&M</option>
                    </select>
                    <span asp-validation-for="SingleContract.ContractType" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="DawsonRoleOnContract" class="form-label">DAWSON Role on Contract</label>
                    <select id="DawsonRoleOnContract" asp-for="SingleContract.DawsonRoleOnContract" class="form-select" maxLength="20" required>
                        <option value="">Select Role</option>
                        <option>Prime</option>
                        <option>Sub</option>
                    </select>
                    <span asp-validation-for="SingleContract.DawsonRoleOnContract" class="text-danger"></span>
                </div>

            </div>

            <!-- Row 5 -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContractStatus" class="form-label">Contract Status</label>
                    <select id="ContractStatus" asp-for="SingleContract.ContractStatus" class="form-select" maxLength="20" required>
                        <option value="">Select Status</option>
                        <option>Bidding</option>
                        <option>Active</option>
                        <option>Complete</option>
                    </select>
                    <span asp-validation-for="SingleContract.ContractStatus" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="ContractStartDate" class="form-label">Contract Start Date</label>
                    <input id="ContractStartDate" asp-for="SingleContract.ContractStartDate" type="date" class="form-control" required />
                    <span asp-validation-for="SingleContract.ContractStartDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContractEndDate" class="form-label">Contract End Date</label>
                    <input id="ContractEndDate" asp-for="SingleContract.ContractEndDate" type="date" class="form-control" required />
                    <span asp-validation-for="SingleContract.ContractEndDate" class="text-danger"></span>
                </div>
            </div>

            <h3 class="mt-5 mb-3">Contract Officer (KO)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="KoLastName" class="form-label">Last Name</label>
                    <input id="KoLastName" asp-for="SingleContract.KoLastName" class="form-control" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.KoLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="KoFirstName" class="form-label">First Name</label>
                    <input id="KoFirstName" asp-for="SingleContract.KoFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.KoFirstName" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="KOPhone" class="form-label">KO Phone</label>
                    <input id="KOPhone" asp-for="SingleContract.KOPhone" class="form-control" placeholder="xxx-xxx-xxxx" inputmode="numeric" maxlength="12" required />
                    <span id="KOPhoneError" class="text-danger invalid-feedback" style="display: none;"></span>
                    <span asp-validation-for="SingleContract.KOPhone" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="KOPhone2" class="form-label">KO Phone 2</label>
                    <input id="KOPhone2" asp-for="SingleContract.KOPhone2" class="form-control" placeholder="xxx-xxx-xxxx" inputmode="numeric" maxlength="12" required />
                    <span id="KOPhone2Error" class="text-danger invalid-feedback" style="display: none;"></span>
                    <span asp-validation-for="SingleContract.KOPhone2" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="KOEmail" class="form-label">KO Email</label>
                    <input id="KOEmail" asp-for="SingleContract.KOEmail" class="form-control" type="email" placeholder="Enter KO Email" maxLength="50" required />
                    <span asp-validation-for="SingleContract.KOEmail" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="KONotes" class="form-label">KO Notes</label>
                    <textarea id="KONotes" asp-for="SingleContract.KONotes" class="form-control" rows="4" placeholder="Enter KO Notes" maxLength="300" required></textarea>
                    <span asp-validation-for="SingleContract.KONotes" class="text-danger"></span>
                </div>
            </div>

            <!-- New Contract Officer Representative (COR) Section -->
            <h3 class="mt-5 mb-3">Contract Officer Representative (COR)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="CORLastName" class="form-label">Last Name</label>
                    <input id="CORLastName" asp-for="SingleContract.CORLastName" class="form-control" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.CORLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.CORKORank" class="form-label">Rank</label>
                    <input asp-for="SingleContract.CORKORank" class="form-control" placeholder="Enter Rank" maxLength="50" id="CORKORank" required />
                    <span asp-validation-for="SingleContract.CORKORank" class="text-danger"></span>
                </div>
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.CORPrefix" class="form-label">Prefix</label>
                    <select id="CORPrefix" asp-for="SingleContract.CORPrefix" class="form-select" required>
                        <option value="">Select</option>
                        <option value="Mr">Mr</option>
                        <option value="Mrs">Mrs</option>
                        <option value="Ms">Ms</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="CORFirstName" class="form-label">First Name</label>
                    <input id="CORFirstName" asp-for="SingleContract.CORFirstName" class="form-control" placeholder="Enter First Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.CORFirstName" class="text-danger"></span>
                </div>
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.CORPhone" class="form-label">COR Phone</label>
                    <input asp-for="SingleContract.CORPhone" class="form-control" id="CorPhone" placeholder="xxx-xxx-xxxx" inputmode="numeric" maxlength="12" required />
                    <span id="CorPhoneError" class="text-danger invalid-feedback" style="display: none;"></span>
                    <span asp-validation-for="SingleContract.CORPhone" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.CORPhone2" class="form-label">COR Phone 2</label>
                    <input asp-for="SingleContract.CORPhone2" class="form-control" id="CorPhone2" placeholder="xxx-xxx-xxxx" inputmode="numeric" maxlength="12" required />
                    <span id="CorPhone2Error" class="text-danger invalid-feedback" style="display: none;"></span>
                    <span asp-validation-for="SingleContract.CORPhone2" class="text-danger"></span>
                </div>
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.COREmail" class="form-label">COR Email</label>
                    <input asp-for="SingleContract.COREmail" class="form-control" type="email" id="COREmail" placeholder="Enter COR Email" maxLength="50" required />
                    <span asp-validation-for="SingleContract.COREmail" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.CORNotes" class="form-label">COR Notes</label>
                    <textarea asp-for="SingleContract.CORNotes" class="form-control" id="CORNotes" rows="4" placeholder="Enter COR Notes" maxLength="300" required></textarea>
                    <span asp-validation-for="SingleContract.CORNotes" class="text-danger"></span>
                </div>
            </div>

            <h3 class="mt-5 mb-3">DAWSON Program Manager</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonProgramManagerLastName" class="form-label">Last Name</label>
                    <input asp-for="SingleContract.DawsonProgramManagerLastName" class="form-control" id="DawsonProgramManagerLastName" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonProgramManagerLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonProgramManagerFirstName" class="form-label">First Name</label>
                    <input asp-for="SingleContract.DawsonProgramManagerFirstName" class="form-control" id="DawsonProgramManagerFirstName" placeholder="Enter First Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonProgramManagerFirstName" class="text-danger"></span>
                </div>
            </div>

            <h3 class="mt-5 mb-3">DAWSON Deputy Program Manager (DDPM)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonDeputyProgramManagerLastName" class="form-label">Last Name</label>
                    <input asp-for="SingleContract.DawsonDeputyProgramManagerLastName" class="form-control" id="DawsonDeputyProgramManagerLastName" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonDeputyProgramManagerLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonDeputyProgramManagerFirstName" class="form-label">First Name</label>
                    <input asp-for="SingleContract.DawsonDeputyProgramManagerFirstName" class="form-control" id="DawsonDeputyProgramManagerFirstName" placeholder="Enter First Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonDeputyProgramManagerFirstName" class="text-danger"></span>
                </div>
            </div>

            <h3 class="mt-5 mb-3">DAWSON Project Manager (DPM)</h3>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonProjectManagerLastName" class="form-label">Last Name</label>
                    <input asp-for="SingleContract.DawsonProjectManagerLastName" class="form-control" id="DawsonProjectManagerLastName" placeholder="Enter Last Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonProjectManagerLastName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SingleContract.DawsonProjectManagerFirstName" class="form-label">First Name</label>
                    <input asp-for="SingleContract.DawsonProjectManagerFirstName" class="form-control" id="DawsonProjectManagerFirstName" placeholder="Enter First Name" maxLength="50" required />
                    <span asp-validation-for="SingleContract.DawsonProjectManagerFirstName" class="text-danger"></span>
                </div>
            </div>



            <div class="d-flex justify-content-end mt-4">
                <button type="submit" id="submitBtn" class="btn btn-success btn-lg me-3" name="action" value="Add">
                    <i class="bi bi-check-circle"></i> Submit
                </button>
                <button type="reset" id="resetBtn" class="btn btn-secondary btn-lg me-3">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </button>
                <button type="submit" class="btn btn-warning btn-lg me-3" id="updateBtn" style="display:none;" name="action" value="Update">
                    <i class="bi bi-pencil"></i> Update
                </button>
                <button id="backToTableBtn" type="button" class="btn btn-secondary">
                    Back to Contracts
                </button>
            </div>

        </form>
    </div>
<script>
    $(document).ready(function () {

        //     $('#ContractID').val('12345');
        // $('#ContractAgency').val('Department of Defense');
        // $('#ContractServiceBranch').val('Army');
        // $('#ContractComponent').val('Active Duty');
        // $('#ContractClient').val('State');
        // $('#ContractType').val('FFP');
        // $('#DawsonRoleOnContract').val('Prime');
        // $('#ContractStatus').val('Active');

        // $('#ContractStartDate').val('2024-01-01');
        // $('#ContractEndDate').val('2025-12-31');

        // // KO
        // // $('#KoLastName').val('Smith');
        // $('#KoFirstName').val('John');
        // $('#KOPhone').val('123-456-7890');
        // $('#KOPhone2').val('987-654-3210');
        // $('#KOEmail').val('john.smith@example.com');
        // $('#KONotes').val('Key contact for the project.');
        // $('#CORLastName').val('Johnson');
        // $('#CORPrefix').val('M.');
        // $('#CORFirstName').val('Alice');

        // $('#CORKORank').val('Colonel');
        // $('#CorPhone').val('123-456-7890');
        // $('#CorPhone2').val('987-654-3210');
        // $('#COREmail').val('alice.johnson@example.com');
        // $('#CORNotes').val('Responsible for oversight.');

        // $('#DawsonProgramManagerLastName').val('Taylor');
        // $('#DawsonProgramManagerFirstName').val('Michael');

        // $('#DawsonDeputyProgramManagerLastName').val('Brown');
        // $('#DawsonDeputyProgramManagerFirstName').val('Jessica');

        // $('#DawsonProjectManagerLastName').val('Williams');
        // $('#DawsonProjectManagerFirstName').val('David');


        $('.card-body').hide();
        $('#contractsTable').show();





        $('#addContractBtn').click(function () {

            const controlIds = [
                'hiddenId', 'ContractID', 'ContractName', 'ContractAgency', 'ContractServiceBranch',
                'ContractComponent', 'ContractClient', 'ContractType', 'DawsonRoleOnContract',
                'ContractStatus', 'ContractStartDate', 'ContractEndDate',
                'KoLastName', 'KoFirstName', 'KOPhone', 'KOPhone2', 'KOEmail',
                'KONotes', 'CORLastName', 'CORPrefix', 'CORFirstName', 'CORKORank',
                'CorPhone', 'CorPhone2', 'COREmail', 'CORNotes',
                'DawsonProgramManagerLastName', 'DawsonProgramManagerFirstName',
                'DawsonDeputyProgramManagerLastName', 'DawsonDeputyProgramManagerFirstName',
                'DawsonProjectManagerLastName', 'DawsonProjectManagerFirstName'
            ];

            controlIds.forEach(function (id) {
                const control = $('#' + id);

                if (control.is('select')) {
                    // Enable dropdowns
                    control.prop('disabled', false);
                } else {
                    // Remove readonly from input fields
                    control.prop('readonly', false);
                }

                // Optional: Remove styling for disabled or read-only fields
                control.removeClass('read-only-style');
            });

            // Show the form and hide the datatable
            $('.card-body').show();
            $('#datatableWrapper').hide();
            // Hide Update button and show Submit/Reset buttons
            $('#submitBtn').show();
            $('#resetBtn').show();
            $('#updateBtn').hide();
            $('#addContractBtn').hide();

            $('#hiddenId').val('');
            $('#ContractID').val('');
            $('#ContractName').val('');
            $('#ContractAgency').val('');
            $('#ContractServiceBranch').val('');
            $('#ContractComponent').val('');
            $('#ContractClient').val('');
            $('#ContractType').val('');
            $('#DawsonRoleOnContract').val('');
            $('#ContractStatus').val('');

            $('#ContractStartDate').val('');
            $('#ContractEndDate').val('');

            // KO
            $('#KoLastName').val('');
            $('#KoFirstName').val('');
            $('#KOPhone').val('');
            $('#KOPhone2').val('');
            $('#KOEmail').val('');
            $('#KONotes').val('');
            $('#CORLastName').val('');
            $('#CORPrefix').val('');
            $('#CORFirstName').val('');

            $('#CORKORank').val('');
            $('#CorPhone').val('');
            $('#CorPhone2').val('');
            $('#COREmail').val('');
            $('#CORNotes').val('');

            $('#DawsonProgramManagerLastName').val('');
            $('#DawsonProgramManagerFirstName').val('');

            $('#DawsonDeputyProgramManagerLastName').val('');
            $('#DawsonDeputyProgramManagerFirstName').val('');

            $('#DawsonProjectManagerLastName').val('');
            $('#DawsonProjectManagerFirstName').val('');
        });



        $('#backToTableBtn').click(function () {
            $('.card-body').hide();
            $('#datatableWrapper').show();
            $('#addContractBtn').show();

        });

        $('#contractsTable').DataTable({
            "paging": true,  // Enables pagination
            "lengthChange": true,  // Option to change number of records per page
            "searching": true,  // Enables search box
            "ordering": false,  // Enables column sorting
            "info": true,  // Shows table information (e.g., "Showing 1 to 10 of 50 entries")
            "autoWidth": true,  // Adjusts table width automatically
            "responsive": true,  // Makes the table responsive on small screens
            "language": {
                "search": "Search:"  // Customizing the search box label
            },
            "order": [[0, 'desc']]  // Set default sorting on the first column (ID) in descending order
        });


        $('#contractsTable').on('click', '.edit-btn, .view-btn', function () {
            debugger;
            var contractId = $(this).data('id');  // Get contract ID from data-id attribute
            var isViewButton = $(this).hasClass('view-btn');

            // AJAX call to fetch contract details by ID
            $.ajax({
                url: '/ContractDetails/GetContractById/' + contractId,  // Make sure the URL is correct
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        var contract = response.contractDetails;
                        $('#hiddenId').val(contract.id);
                        $('#ContractID').val(contract.contractID);
                        $('#ContractName').val(contract.contractName);
                        $('#ContractAgency').val(contract.contractAgency);
                        $('#ContractServiceBranch').val(contract.contractServiceBranch);
                        $('#ContractComponent').val(contract.contractComponent);
                        $('#ContractClient').val(contract.contractClient);
                        $('#ContractType').val(contract.contractType);
                        $('#DawsonRoleOnContract').val(contract.dawsonRoleOnContract);
                        $('#ContractStatus').val(contract.contractStatus);


                        let contractStartDate = new Date(contract.contractStartDate);
                        let formattedStartDate = contractStartDate.toLocaleDateString('en-CA');
                        $('#ContractStartDate').val(formattedStartDate);

                        let contractEndDate = new Date(contract.contractEndDate);
                        let formattedEndDate = contractEndDate.toLocaleDateString('en-CA');
                        $('#ContractEndDate').val(formattedEndDate);


                        //KO
                        $('#KoLastName').val(contract.koLastName);
                        $('#KoFirstName').val(contract.koFirstName);
                        $('#KOPhone').val(contract.koPhone);
                        $('#KOPhone2').val(contract.koPhone2);
                        $('#KOEmail').val(contract.koEmail);
                        $('#KONotes').val(contract.koNotes);
                        $('#CORLastName').val(contract.corLastName);
                        $('#CORPrefix').val(contract.corPrefix);
                        $('#CORFirstName').val(contract.corFirstName);

                        $('#CORKORank').val(contract.corkoRank);
                        $('#CorPhone').val(contract.corPhone);
                        $('#CorPhone2').val(contract.corPhone2);
                        $('#COREmail').val(contract.corEmail);
                        $('#CORNotes').val(contract.corEmail);

                        $('#DawsonProgramManagerLastName').val(contract.dawsonProgramManagerLastName);
                        $('#DawsonProgramManagerFirstName').val(contract.dawsonProgramManagerFirstName);

                        $('#DawsonDeputyProgramManagerLastName').val(contract.dawsonDeputyProgramManagerLastName);
                        $('#DawsonDeputyProgramManagerFirstName').val(contract.dawsonDeputyProgramManagerFirstName);

                        $('#DawsonProjectManagerLastName').val(contract.dawsonProjectManagerLastName);
                        $('#DawsonProjectManagerFirstName').val(contract.dawsonProjectManagerFirstName);



                        // Show the form and hide the table
                        $('#datatableWrapper').hide();
                        $('.card-body').show();
                        $('#submitBtn').hide();
                        $('#resetBtn').hide();
                        $('#addContractBtn').hide();

                        if (isViewButton) {
                            const controlIds = [
                                'hiddenId', 'ContractID', 'ContractName', 'ContractAgency', 'ContractServiceBranch',
                                'ContractComponent', 'ContractClient', 'ContractType', 'DawsonRoleOnContract',
                                'ContractStatus', 'ContractStartDate', 'ContractEndDate',
                                'KoLastName', 'KoFirstName', 'KOPhone', 'KOPhone2', 'KOEmail',
                                'KONotes', 'CORLastName', 'CORPrefix', 'CORFirstName', 'CORKORank',
                                'CorPhone', 'CorPhone2', 'COREmail', 'CORNotes',
                                'DawsonProgramManagerLastName', 'DawsonProgramManagerFirstName',
                                'DawsonDeputyProgramManagerLastName', 'DawsonDeputyProgramManagerFirstName',
                                'DawsonProjectManagerLastName', 'DawsonProjectManagerFirstName'
                            ];

                            // Make controls read-only
                            controlIds.forEach(function (id) {
                                const control = $('#' + id);
                                control.prop('readonly', true); // Make input read-only
                                control.addClass('read-only-style'); // Optional: Add a class for read-only styling
                            });

                            $('#updateBtn').hide();  // Hide the Update button when View button is clicked
                        } else {
                            const controlIds = [
                                'hiddenId', 'ContractAgency', 'ContractServiceBranch',
                                'ContractComponent', 'ContractClient', 'ContractType', 'DawsonRoleOnContract',
                                'ContractStatus', 'ContractStartDate', 'ContractEndDate',
                                'KoLastName', 'KoFirstName', 'KOPhone', 'KOPhone2', 'KOEmail',
                                'KONotes', 'CORLastName', 'CORPrefix', 'CORFirstName', 'CORKORank',
                                'CorPhone', 'CorPhone2', 'COREmail', 'CORNotes',
                                'DawsonProgramManagerLastName', 'DawsonProgramManagerFirstName',
                                'DawsonDeputyProgramManagerLastName', 'DawsonDeputyProgramManagerFirstName',
                                'DawsonProjectManagerLastName', 'DawsonProjectManagerFirstName'
                            ];

                            // Make controls editable
                            controlIds.forEach(function (id) {
                                const control = $('#' + id);
                                control.prop('readonly', false); // Remove readonly property
                                control.removeClass('read-only-style'); // Remove read-only styling class if applied
                            });

                            var control = $('#ContractID');
                            control.prop('readonly', true);
                            control.addClass('read-only-style');

                            var control = $('#ContractName');
                            control.prop('readonly', true);
                            control.addClass('read-only-style');
                            $('#updateBtn').show();  // Show the Update button when Edit button is clicked
                        }
                    } else {
                        alert(response.message);  // Show error message
                    }
                },
                error: function () {
                    alert('An error occurred while fetching contract data.');
                }
            });
        });

        const phoneFields = ['KOPhone', 'KOPhone2', 'CorPhone', 'CorPhone2'];
        phoneFields.forEach(function (fieldId) {
            applyPhoneNumberMask(document.getElementById(fieldId));
        });

        function applyPhoneNumberMask(inputElement) {
            inputElement.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, ''); // Remove all non-digit characters
                if (value.length > 3 && value.length <= 6) {
                    value = value.slice(0, 3) + '-' + value.slice(3);
                } else if (value.length > 6) {
                    value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6, 10);
                }
                e.target.value = value;
            });
        }
    });

    document.getElementById("submitBtn").addEventListener("click", function (event) {
        // Perform the default form validation first
        if (!validatePhoneFields()) {
            event.preventDefault(); // Stop form submission if validation fails
        }

        if (isContractIDExists) {
            Swal.fire({
                icon: 'error',
                title: 'Contract ID already exists',
                text: 'Please choose a different Contract ID.',
                confirmButtonColor: '#FF0000'
            });

            // Prevent form submission
            event.preventDefault();
        }

        if (isContractNameExists) {
            Swal.fire({
                icon: 'error',
                title: 'Contract Name already exists',
                text: 'Please choose a different Contract ID.',
                confirmButtonColor: '#FF0000'
            });

            // Prevent form submission
            event.preventDefault();
        }
    });

    function checkIfContractExists(contractID, contractName, checkType) {
        return new Promise(function (resolve, reject) {
            $.ajax({
                url: '/ContractDetails/CheckIfContractExists',
                type: 'GET',
                data: { contractId: contractID, contractName: contractName, checkType: checkType },
                success: function (response) {
                    console.log(response); // Check the response
                    if (response && response.exists) {
                        // If the contract exists (based on the API response)
                        resolve(true);
                    } else {
                        // If the contract does not exist
                        resolve(false);
                    }
                },
                error: function (xhr, status, error) {
                    reject(error);  // Reject the promise in case of an error
                }
            });
        });
    }


    function validatePhoneFields() {
        const phoneFields = ['KOPhone', 'KOPhone2', 'CorPhone', 'CorPhone2'];
        let isValid = true;

        phoneFields.forEach(function (fieldId) {
            const phoneInput = document.getElementById(fieldId);
            const errorMessage = document.getElementById(fieldId + 'Error');

            // Reset previous validation state
            phoneInput.classList.remove('is-invalid');
            errorMessage.style.display = 'none';

            const phoneValue = phoneInput.value.trim();
            const phonePattern = /^\d{3}-\d{3}-\d{4}$/;

            // Validate only if the field has a value
            if (phoneValue && !phonePattern.test(phoneValue)) {
                phoneInput.classList.add('is-invalid');
                errorMessage.textContent = 'Please enter a valid phone number.';
                errorMessage.style.display = 'block';
                isValid = false;
            }
        });

        return isValid;
    }

    document.getElementById("updateBtn").addEventListener("click", function (event) {
        if (!validatePhoneFields()) {
            event.preventDefault(); // Stop form submission if validation fails
        }

    });

    var isContractIDExists = false; // To track if ContractID exists
    var isContractNameExists = false; // To track if ContractName exists

    $('#ContractID, #ContractName').on('blur', function () {
        debugger;
        var inputField = $(this); // Get the current input field
        var inputValue = inputField.val().trim(); // Get and trim the input value
        var checkType = inputField.attr('id') === 'ContractID' ? 'id' : 'name'; // Determine the check type

        // Only call checkIfContractExists if the input value is not empty
        if (inputValue !== '') {
            checkIfContractExists(
                checkType === 'id' ? inputValue : null, // Pass ContractID if checking by ID
                checkType === 'name' ? inputValue : null, // Pass ContractName if checking by Name
                checkType // Indicate the type of check
            )
                .then(function (exists) {
                    if (exists) {
                        // Show SweetAlert error if the value already exists
                        Swal.fire({
                            icon: 'error',
                            title: checkType === 'id' ? 'Contract ID already exists' : 'Contract Name already exists',
                            text: 'Please choose a different ' + (checkType === 'id' ? 'Contract ID.' : 'Contract Name.'),
                            confirmButtonColor: '#FF0000'
                        });

                        // Add custom styling to highlight the field
                        inputField.addClass('is-invalid');

                        // Set the appropriate flag variable
                        if (checkType === 'id') {
                            isContractIDExists = true;
                        } else {
                            isContractNameExists = true;
                        }
                    } else {
                        // If the value doesn't exist, remove invalid class (if any)
                        inputField.removeClass('is-invalid');

                        // Reset the appropriate flag variable
                        if (checkType === 'id') {
                            isContractIDExists = false;
                        } else {
                            isContractNameExists = false;
                        }
                    }
                })
                .catch(function (error) {
                    // Handle errors in the API call
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred while checking the ' + (checkType === 'id' ? 'Contract ID.' : 'Contract Name.'),
                        confirmButtonColor: '#FF0000'
                    });
                });
        } else {
            // If input is empty, remove any invalid styling and reset the flag
            inputField.removeClass('is-invalid');
            if (checkType === 'id') {
                isContractIDExists = false;
            } else {
                isContractNameExists = false;
            }
        }
    });
</script>
