    function manageAffiliationRows(affiliation = []) {

        const container = document.querySelector('.form-container-Affiliation');
        container.innerHTML = '';

        const addAffiliationRowButton = document.getElementById('addAffiliationRowButton');
        const removeEventListenerButton = document.getElementById('addContractBtn'); // Another button

        if (!container || !addAffiliationRowButton) {
            console.error('Form container or addAffiliationRowButton not found');
            return;
        }

        // Function to create a new affiliation row
        function createAffiliationRow(rowIndex, affiliationData = null) {
            const newRow = document.createElement('div');
            newRow.classList.add('form-row', 'mb-3', 'd-flex', 'align-items-center', 'gap-3', 'affiliation-row');

            newRow.innerHTML = `
                    <div class="flex-grow-1">
                        <label for="Employers_${rowIndex}__SubContractorId" class="form-label">Employer/Subcontractor</label>
                        <select class="form-select select2" id="EmployerSubcontractor${rowIndex}"
                                name="SingleEventStaff.StaffContractAffiliation[${rowIndex}].SubContractorId" required>
                        </select>
                        <input type="hidden" id="EmployerSubcontractorText${rowIndex}"
                           name="SingleEventStaff.StaffContractAffiliation[${rowIndex}].SubContractorName" />
                    </div>
                    <div class="flex-grow-1">
                        <label for="Employers_${rowIndex}__ContractIds" class="form-label">Staff Contract Affiliation</label>
                        <select id="StaffContractAffiliation${rowIndex}"
                                name="SingleEventStaff.StaffContractAffiliation[${rowIndex}].StaffContractAffiliationTemp"
                                multiple class="form-control multi-select" required>
                        </select>

                    </div>
                    <div class="d-flex align-items-center" style="height: 100%; margin-top: 32px;">
                        <button type="button" class="btn btn-danger btn-sm remove-row" style="height: 38px;">Remove</button>
                    </div>
                `;

            // Add event listener for the "Remove" button to delete the row
            const removeButton = newRow.querySelector('.remove-row');
            removeButton.addEventListener('click', () => {
                const affiliationRows = document.querySelectorAll('.affiliation-row');
                if (affiliationRows.length > 1) {
                    newRow.remove();
                    updateAffiliationRowIndices();
                } else {
                    alert('You cannot remove the last row.');
                }
            });

            // Append the new row to the container
            container.appendChild(newRow);

            const employerDropdown = document.getElementById(`EmployerSubcontractor${rowIndex}`);
            const hiddenField = document.getElementById(`EmployerSubcontractorText${rowIndex}`);

            if (affiliationData) {
                // Populate Employer/Subcontractor dropdown
                const employerOption = document.createElement('option');
                employerOption.value = affiliationData.subContractorId;
                employerOption.textContent = affiliationData.subContractorName;
                employerOption.selected = true;
                employerDropdown.appendChild(employerOption);

                if (hiddenField) {
                    hiddenField.value = affiliationData.subContractorName;
                }
            }

            // Initialize multi-select dropdown for Staff Contract Affiliation
            const affiliationDropdown = document.getElementById(`StaffContractAffiliation${rowIndex}`);
            if (affiliationData && affiliationData.staffContractAffiliation) {
                affiliationData.staffContractAffiliation.forEach((affiliation) => {
                    const option = document.createElement('option');
                    option.value = affiliation.contractId;
                    option.textContent = affiliation.contractName;
                    option.selected = true; // Bind existing data as selected
                    affiliationDropdown.appendChild(option);
                });
            }

            // Initialize dropdowns with their respective libraries if required
            initializeDynamicDropdowns(rowIndex);
        }

        // Function to initialize dropdowns for a specific row
        function initializeDynamicDropdowns(rowIndex) {
            // Initialize searchable dropdown
            $(`#EmployerSubcontractor${rowIndex}`).select2({
                theme: 'bootstrap-5',
                width: '100%',
                ajax: {
                    url: '/SubContractorInfo/GetSubContractorByCompanyNameForSearching',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            companyName: params.term || ''
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data.map(function (SubContractor) {
                                return {
                                    id: SubContractor.id,
                                    text: SubContractor.text
                                };
                            })
                        };
                    },
                    cache: true
                },
                minimumInputLength: 1,
            });

            // Initialize multi-select dropdown
            $(`#StaffContractAffiliation${rowIndex}`).select2({
                placeholder: "Select options",
                allowClear: true
            });

            $(`#EmployerSubcontractor${rowIndex}`).change(function () {
                const selectedText = $(this).find("option:selected").text(); // Get the selected text
                if (!selectedText) return;
                const currentDropdown = this;
                let isDuplicate = false;
                const allEmployerDropdowns = document.querySelectorAll('.form-container-Affiliation select[id^="EmployerSubcontractor"]');

                allEmployerDropdowns.forEach(function (dropdown) {
                    // Skip the current dropdown (this one)
                    if (dropdown !== currentDropdown && $(dropdown).find("option:selected").text() === selectedText) {
                        isDuplicate = true;
                    }
                });

                // If duplicate is found
                if (isDuplicate) {
                    // Show SweetAlert for duplicate selection
                    Swal.fire({
                        title: 'Error',
                        text: 'Employer/Subcontractor can be used only once.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        // Only reset the dropdown value if it hasn't been reset already
                        if ($(this).val()) {
                            $(this).val(null).trigger('change'); // Reset and trigger change
                        }
                    });
                } else {

                    // If no duplicate, proceed with the AJAX call
                    const selectedValue = $(this).val(); // Get the selected value
                    if (selectedText) {
                        // Show the AJAX request after no duplication
                        $.ajax({
                            url: '/SubContractorInfo/GetContractIdsBySubContractorCompanyName',
                            type: 'GET',
                            data: { companyName: selectedText },
                            success: function (response) {
                                if (response.success) {
                                    $(`#EmployerSubcontractorText${rowIndex}`).val(selectedText);
                                    bindMultiSelectDropdown(`#StaffContractAffiliation${rowIndex}`, response.data.contractDetails);
                                } else {
                                    alert(response.message);
                                }
                            },
                            error: function () {
                                alert('An error occurred while fetching contract details.');
                            }
                        });
                    }
                }
            });
        }

        // Function to bind options to multi-select dropdown
        function bindMultiSelectDropdown(selector, contractDetails) {
            const dropdown = $(selector);
            dropdown.empty(); // Clear existing options
            if (contractDetails && contractDetails.length > 0) {
                contractDetails.forEach(function (detail) {
                    dropdown.append(new Option(detail.text, detail.id));
                });
            }
            dropdown.trigger('change'); // Notify select2 about the update
        }

        // Function to update row indices for model binding
        function updateAffiliationRowIndices() {
            const affiliationRows = document.querySelectorAll('.affiliation-row');
            affiliationRows.forEach((row, index) => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.name;
                    input.name = name.replace(/\[\d+\]/, `[${index}]`);
                    input.id = input.id.replace(/\d+/, index);
                });
            });
        }

        // Initialize rows on page load
        if (affiliation.length > 0) {
            affiliation.forEach((affiliationData, index) => {
                createAffiliationRow(index, affiliationData);
            });
        }
        else {
            createAffiliationRow(0);
        }

        // Add new row on button click
        function addAffiliationRowHandler() {
            const affiliationRows = document.querySelectorAll('.affiliation-row');
            if (affiliationRows.length < 5) {
                createAffiliationRow(affiliationRows.length);
            } else {
                alert('You can only add up to 5 rows.');
            }
        }

        if (removeEventListenerButton) {
            removeEventListenerButton.addEventListener('click', () => {
                addAffiliationRowButton.removeEventListener('click', addAffiliationRowHandler);
            });
        }

        addAffiliationRowButton.addEventListener('click', addAffiliationRowHandler);


    }



