    function togglePasswordVisibility(inputId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(`toggle${inputId.charAt(0).toUpperCase() + inputId.slice(1)}Icon`);

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    allowOnlyNumericInput("ssn");
    allowOnlyNumericInput("npi");
    allowOnlyNumericInput("staffDoDID");
    

    function allowOnlyNumericInput(inputId) {
        document.getElementById(inputId).addEventListener("keypress", function (event) {
            const charCode = event.which || event.keyCode;

            // Allow only numeric keys (48-57) and control keys (e.g., backspace)
            if (charCode < 48 || charCode > 57) {
                event.preventDefault();
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const phoneFields = ['ssn'];
        phoneFields.forEach(function (fieldId) {
            applySsnMask(document.getElementById(fieldId));
        });
    });

    function applySsnMask(inputElement) {
        inputElement.addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, ''); // Remove all non-digit characters
            if (value.length > 3 && value.length <= 5) {
                value = value.slice(0, 3) + '-' + value.slice(3); // XXX-XX
            } else if (value.length > 5) {
                value = value.slice(0, 3) + '-' + value.slice(3, 5) + '-' + value.slice(5, 9); // XXX-XX-XXXX
            }
            e.target.value = value;
        });
    }


    // Get references to the radio buttons and the "Select Event" field container
    const eventOnCallYes = document.getElementById('eventOnCallYes');
    const eventOnCallNo = document.getElementById('eventOnCallNo');
    const eventOnCallSelectContainer = document.getElementById('eventOnCallSelectContainer');
    const eventOnCallSelect = document.getElementById('eventOnCallSelect');

    // Add event listeners to radio buttons to detect change in selection
    eventOnCallYes.addEventListener('change', toggleSelectEventVisibility);
    eventOnCallNo.addEventListener('change', toggleSelectEventVisibility);

    function toggleSelectEventVisibility() {
        if (eventOnCallYes.checked) {
            eventOnCallSelectContainer.style.display = 'block'; // Show the input field
            eventOnCallSelect.setAttribute('required', 'true'); // Make it required
        } else {
            eventOnCallSelectContainer.style.display = 'none'; // Hide the input field
            eventOnCallSelect.removeAttribute('required'); // Remove required attribute
        }
    }



    const staffCACYes = document.getElementById('staffCACYes');
    const staffCACNo = document.getElementById('staffCACNo');
    const staffDoDContainer = document.getElementById('staffDoDContainer');
    const staffDoDID = document.getElementById('staffDoDID');

    function toggleStaffDoDID() {
        if (staffCACYes.checked) {
            staffDoDContainer.style.display = 'block'; // Show the Staff DoD ID field
            staffDoDID.setAttribute('required', 'required'); // Make it required
        } else {
            staffDoDContainer.style.display = 'none'; // Hide the Staff DoD ID field
            staffDoDID.removeAttribute('required'); // Remove the required attribute
        }
    }

    // Attach event listeners to radio buttons
    staffCACYes.addEventListener('change', toggleStaffDoDID);
    staffCACNo.addEventListener('change', toggleStaffDoDID);

    // Initial check on page load
    toggleStaffDoDID();



    const phoneFields = ['staffCellNumber', 'staffPhone2'];
    phoneFields.forEach(function (fieldId) {
        applyPhoneNumberMask(document.getElementById(fieldId));
    });

    function applyPhoneNumberMask(inputElement) {
        inputElement.addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, ''); // Remove all non-digit characters
            if (value.length > 3 && value.length <= 6) {
                value = value.slice(0, 3) + '-' + value.slice(3);
            } else if (value.length > 6) {
                value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6, 10);
            }
            e.target.value = value;
        });
    }


    $.getJSON('/data/statesAndCities.json', function (data) {
        const stateCityMap = {};
        const stateDropdowns = $('#primaryState, #secondaryState');

        stateDropdowns.empty().append('<option value="">Select State</option>');
        data.states.forEach(state => {
            stateDropdowns.append(`<option value="${state.Name}">${state.Name}</option>`);
            stateCityMap[state.Name] = state.Cities; // Map state name to its cities
        });

        stateDropdowns.on('change', function () {
            const stateName = $(this).val(); // Now this will be the state name

            const cityDropdownId = $(this).attr('id') === 'primaryState' ? '#primaryCity' : '#secondaryCity';
            const cityDropdown = $(cityDropdownId);

            cityDropdown.empty().append('<option value="">Select City</option>');

            if (stateName && stateCityMap[stateName]) {
                stateCityMap[stateName].forEach(city => {
                    cityDropdown.append(`<option value="${city.Name}">${city.Name}</option>`);
                });
            }
        });


        $('.city-dropdown').on('change', function () {
            const cityDropdownId = $(this).attr('id'); // Get the ID of the changed city dropdown
            const stateDropdownId = cityDropdownId === 'primaryCity' ? '#primaryState' : '#secondaryState';
            const zipCodeDropdownId = cityDropdownId === 'primaryCity' ? '#primaryZipCode' : '#secondaryZipCode';

            const stateName = $(stateDropdownId).val(); // Get the selected state for the respective city dropdown
            const cityName = $(this).val(); // Get the selected city name
            const zipCodeDropdown = $(zipCodeDropdownId); // Get the corresponding zip code dropdown

            // Clear the zip code dropdown and add a default option
            zipCodeDropdown.empty().append('<option value="">Select Zip Code</option>');

            if (stateName && cityName && stateCityMap[stateName]) {
                const selectedCity = stateCityMap[stateName].find(city => city.Name === cityName); // Find the city in the selected state

                if (selectedCity && selectedCity.Zipcodes) {
                    selectedCity.Zipcodes.forEach(zip => {
                        zipCodeDropdown.append(`<option value="${zip.ZipCode}">${zip.ZipCode}</option>`);
                    });
                }
            }
        });


    });
</script>
