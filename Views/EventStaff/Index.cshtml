                    <div class="col-md-3" style="flex: 1; margin-right: 15px;">
                        <div class="form-group">
                                    <input id="licenseNumber${index}" name="SingleEventStaff.Licenses[${index}].LicenseNumber" class="form-control" value="${license.licenseNumber}" required />
                        </div>
                    </div>
                    <div class="col-md-3" style="flex: 1; margin-right: 15px;">
                        <div class="form-group">
                                    <select id="licenseState${index}"  name="SingleEventStaff.Licenses[${index}].LicenseState" class="form-control" required>
                                <option value="">Select State</option>
                                <option value="State1" ${license.licenseState === "State1" ? "selected" : ""}>State1</option>
                                <option value="State2" ${license.licenseState === "State2" ? "selected" : ""}>State2</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3" style="flex: 1; margin-right: 15px;">
                        <div class="form-group">
                                    <select id="licenseType${index}" name="SingleEventStaff.Licenses[${index}].LicenseType" class="form-control" required>
                                <option value="">Select Type</option>
                                <option value="Type1" ${license.licenseType === "Type1" ? "selected" : ""}>Type1</option>
                                <option value="Type2" ${license.licenseType === "Type2" ? "selected" : ""}>Type2</option>
                            </select>
                        </div>
                    </div>
