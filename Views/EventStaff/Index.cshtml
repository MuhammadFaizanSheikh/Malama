        // Loop through all data records and categorize them
        data.forEach((item, index) => {
            if (item.type === 'Air') {
                createRow(false, 'Air', item, index); // For Air category
            } else if (item.type === 'Car') {
                createRow(false, 'Car', item, index); // For Car category
            } else if (item.type === 'Hotel') {
