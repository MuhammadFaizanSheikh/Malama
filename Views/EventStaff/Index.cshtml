let airCounter = 0;
let carCounter = 0;
let hotelCounter = 0;
let controlCount = 0;
const maxControls = 5;

function createRow(includeButton, category, item = {}, index = controlCount) {
    const container = document.getElementById(
        category === 'Air' ? 'dynamicControlsContainer' :
            category === 'Car' ? 'carDynamicControlsContainer' :
                category === 'Hotel' ? 'hotelDynamicControlsContainer' : ''
    );

    const rowDiv = document.createElement('div');
    rowDiv.classList.add('d-flex', 'align-items-center', 'mb-2');
    rowDiv.style.gap = '15px';

    const nameDiv = document.createElement('div');
    nameDiv.classList.add('d-flex', 'align-items-center');
    nameDiv.innerHTML = `
        <label class="form-label me-2 mb-0" style="width: 140px">${category} Name</label>
        <input type="text" class="form-control form-control-sm" name="SingleEventStaff.TravelHonorList[${index}].Name" value="${item.name || ''}" required />
    `;
    rowDiv.appendChild(nameDiv);

    const rewardDiv = document.createElement('div');
    rewardDiv.classList.add('d-flex', 'align-items-center');
    rewardDiv.innerHTML = `
        <label class="form-label me-2 mb-0">Rewards</label>
        <input type="text" class="form-control form-control-sm" name="SingleEventStaff.TravelHonorList[${index}].Rewards" value="${item.rewards || ''}" required />
    `;
    rowDiv.appendChild(rewardDiv);

    // Hidden field for Type (Air, Car, or Hotel)
    const typeHiddenDiv = document.createElement('div');
    typeHiddenDiv.classList.add('d-none');
    typeHiddenDiv.innerHTML = `
        <input type="hidden" name="SingleEventStaff.TravelHonorList[${index}].Type" value="${category}" />
    `;
    rowDiv.appendChild(typeHiddenDiv);

    // Add Remove button
    const removeButtonDiv = document.createElement('div');
    removeButtonDiv.classList.add('ms-4');
    removeButtonDiv.innerHTML = `
        <button type="button" class="btn btn-danger btn-sm">Remove</button>
    `;
    removeButtonDiv.querySelector('button').addEventListener('click', () => {
        if (category === 'Air') {
            airCounter--;
            if (airCounter === 0) {
            airlineCheckbox.checked = false; // Uncheck the airline checkbox if no rows remain
        }
        } else if (category === 'Car') {
            carCounter--;
            if (carCounter === 0) {
            carCheckbox.checked = false; // Uncheck the car checkbox if no rows remain
        }
        } else if (category === 'Hotel') {
            hotelCounter--;
            if (hotelCounter === 0) {
            hotelCheckbox.checked = false; // Uncheck the hotel checkbox if no rows remain
        }
        }
        rowDiv.remove();
        reindexControls(); // Reindex rows after removal
        updateAddRewardButton(); // Update the Add Reward button position
    });
    rowDiv.appendChild(removeButtonDiv);

    container.appendChild(rowDiv);
    updateAddRewardButton(); // Ensure Add Reward button is in the correct position
}

function reindexControls() {
    const airRows = document.querySelectorAll('#dynamicControlsContainer > div');
    const carRows = document.querySelectorAll('#carDynamicControlsContainer > div');
    const hotelRows = document.querySelectorAll('#hotelDynamicControlsContainer > div');
    const allRows = [...airRows, ...carRows, ...hotelRows];

    allRows.forEach((row, index) => {
        const nameField = row.querySelector('input[name*="Name"]');
        const rewardField = row.querySelector('input[name*="Rewards"]');
        const typeField = row.querySelector('input[name*="Type"]'); // For Type field

        if (nameField && rewardField) {
            nameField.setAttribute('name', `SingleEventStaff.TravelHonorList[${index}].Name`);
            rewardField.setAttribute('name', `SingleEventStaff.TravelHonorList[${index}].Rewards`);
        }

        if (typeField) {
            typeField.setAttribute('name', `SingleEventStaff.TravelHonorList[${index}].Type`);
        }

        row.setAttribute('id', `row-${index}`);
    });

    // Update controlCount
    controlCount = allRows.length - 1;
}

function updateAddRewardButton() {
    const airRows = document.querySelectorAll('#dynamicControlsContainer > div');
    const carRows = document.querySelectorAll('#carDynamicControlsContainer > div');
    const hotelRows = document.querySelectorAll('#hotelDynamicControlsContainer > div');

    const updateButtonForCategory = (rows) => {
        rows.forEach((row) => {
            const existingButton = row.querySelector('.add-reward-button');
            if (existingButton) {
                existingButton.remove();
            }
        });

        if (rows.length > 0) {
            const lastRow = rows[rows.length - 1];
            const rewardButtonDiv = document.createElement('div');
            rewardButtonDiv.classList.add('ms-4', 'add-reward-button');
            rewardButtonDiv.innerHTML = `
                <button type="button" class="btn btn-light d-flex align-items-center">
                    <img src="/images/PlusIcon.png" alt="Add" class="me-2" style="width: 24px; height: 24px;" />
                    <span>Add another reward</span>
                </button>
            `;

            rewardButtonDiv.querySelector('button').addEventListener('click', () => {
                if (rows === airRows && airCounter < maxControls) {
                    airCounter++;
                    controlCount++;
                    createRow(false, 'Air');
                } else if (rows === carRows && carCounter < maxControls) {
                    carCounter++;
                    controlCount++;
                    createRow(false, 'Car');
                } else if (rows === hotelRows && hotelCounter < maxControls) {
                    hotelCounter++;
                    controlCount++;
                    createRow(false, 'Hotel');
                } else {
                    alert('You can only add up to 5 rewards.');
                }
            });

            lastRow.appendChild(rewardButtonDiv);
        }
    };

    updateButtonForCategory(airRows);
    updateButtonForCategory(carRows);
    updateButtonForCategory(hotelRows);
}



    // Initialize category checkbox handling
    document.addEventListener('DOMContentLoaded', () => {
        const airlineCheckbox = document.getElementById('airlineCheckbox');
        const carCheckbox = document.getElementById('carCheckbox');
        const hotelCheckbox = document.getElementById('hotelCheckbox');

        airlineCheckbox.addEventListener('change', () => {
            const container = document.getElementById('dynamicControlsContainer');
            container.innerHTML = ''; // Clear existing fields
           

            if (airlineCheckbox.checked) {
                 airCounter++;
                 controlCount++;
                createRow(true, 'Air'); // Pass 'Air' category
            }
            else
            {
                airCounter = 0;
                reindexControls();
            }
        });

        carCheckbox.addEventListener('change', () => {
            const container = document.getElementById('carDynamicControlsContainer');
            container.innerHTML = ''; // Clear existing fields
            

            if (carCheckbox.checked) {
                carCounter++;
                controlCount++;
                createRow(true, 'Car'); // Pass 'Car' category
            }
            else
            {
                carCounter = 0;
                reindexControls();
            }
        });

        hotelCheckbox.addEventListener('change', () => {
            const container = document.getElementById('hotelDynamicControlsContainer');
            container.innerHTML = ''; // Clear existing fields
            

            if (hotelCheckbox.checked) {
                hotelCounter++;
                controlCount++;
                createRow(true, 'Hotel'); // Pass 'Car' category
            }
            else
            {
                hotelCounter = 0;
                reindexControls();
            }
        });
    });

    function toggleAdditionalControl() {
        const noRadioButton = document.getElementById("OnboardingTrainingCompleteNo");
        const additionalControl = document.getElementById("additionalControl");
        const reasonTextarea = document.getElementById("OutstandingTrainings");

        if (noRadioButton.checked) {
            additionalControl.style.display = "block";
            reasonTextarea.setAttribute("required", "required");
