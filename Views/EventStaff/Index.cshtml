    function validateStaffContractAffiliation() {
    var isValid = $('#StaffContractAffiliation').val() && $('#StaffContractAffiliation').val().length > 0;

    if (!isValid) {
        $('#staffContractError').text('Please select at least one option.').show(); // Show error message
        $('#StaffContractAffiliation').focus();
        return false;
    } else {
        $('#staffContractError').hide(); // Hide error message if valid
        return true;
    }

    return isValid; // Return validation result
}

    document.getElementById("submitBtn").addEventListener("click", function (event) {

