                            <span>Add another reward</span>
                        </button>
                    `;

                rewardButtonDiv.querySelector('button').addEventListener('click', () => {
                    if (rows === airRows && airCounter < maxControls) {
                        airCounter++;
                        controlCount++;
                        createRow(false, 'Air');
                    } else if (rows === carRows && carCounter < maxControls) {
                        carCounter++;
                        controlCount++;
                        createRow(false, 'Car');
                    } else if (rows === hotelRows && hotelCounter < maxControls) {
                        hotelCounter++;
                        controlCount++;
                        createRow(false, 'Hotel');
                    } else {
                        alert('You can only add up to 5 rewards.');
                    }
                });

                lastRow.appendChild(rewardButtonDiv);
            }
        };

        updateButtonForCategory(airRows);
        updateButtonForCategory(carRows);
        updateButtonForCategory(hotelRows);
    }



