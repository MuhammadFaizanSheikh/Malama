                });
            }
        } else {
            // Remove UI when unchecked
            $(`.license-container[data-role-id='${roleId}']`).remove();
            $(`.attribute-multiselect-container[data-role-id='${roleId}']`).remove();
            roleCheckbox.closest(".form-check").next(".add-row-button").remove();

            delete roleIndexMap[roleId];
            delete roleLicenseIndexMap[roleId];

            resetRoleIndexes();
