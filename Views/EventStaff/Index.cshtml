    function reindexControls() {
        const airRows = document.querySelectorAll('#dynamicControlsContainer > div');
        const carRows = document.querySelectorAll('#carDynamicControlsContainer > div');
        const hotelRows = document.querySelectorAll('#hotelDynamicControlsContainer > div');
        const allRows = [...airRows, ...carRows, ...hotelRows];

        allRows.forEach((row, index) => {
            const nameField = row.querySelector('input[name*="Name"]');
            const rewardField = row.querySelector('input[name*="Rewards"]');
            const typeField = row.querySelector('input[name*="Type"]'); // For Type field

            if (nameField && rewardField) {
                nameField.setAttribute('name', `SingleEventStaff.TravelHonorList[${index}].Name`);
                rewardField.setAttribute('name', `SingleEventStaff.TravelHonorList[${index}].Rewards`);
            }

            if (typeField) {
                typeField.setAttribute('name', `SingleEventStaff.TravelHonorList[${index}].Type`);
            }

            row.setAttribute('id', `row-${index}`);
        });

        // Update controlCount
        controlCount = allRows.length - 1;
    }

    function updateAddRewardButton() {
        const airRows = document.querySelectorAll('#dynamicControlsContainer > div');
        const carRows = document.querySelectorAll('#carDynamicControlsContainer > div');
        const hotelRows = document.querySelectorAll('#hotelDynamicControlsContainer > div');

        const updateButtonForCategory = (rows) => {
            rows.forEach((row) => {
                const existingButton = row.querySelector('.add-reward-button');
                if (existingButton) {
                    existingButton.remove();
                }
            });

            if (rows.length > 0) {
                const lastRow = rows[rows.length - 1];
                const rewardButtonDiv = document.createElement('div');
                rewardButtonDiv.classList.add('ms-4', 'add-reward-button');
                rewardButtonDiv.innerHTML = `
