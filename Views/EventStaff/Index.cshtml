    // Function to reset all license indexes for a role
    function resetLicenseIndexes(roleId, roleIndex) {
        let licenseRows = $(`.license-container[data-role-id='${roleId}'] .license-row`);
        roleLicenseIndexMap[roleId] = 0; // Reset index for this role

        licenseRows.each(function (index) {
            let newLicenseIndex = index; // Reassign sequential index
            $(this)
                .find("[name]")
                .each(function () {
                    let nameAttr = $(this).attr("name");
                    let updatedName = nameAttr.replace(/\[\d+\]\.StaffLicenseDetails\[\d+\]/, `[${roleIndex}].StaffLicenseDetails[${newLicenseIndex}]`);
                    $(this).attr("name", updatedName);
                });

            roleLicenseIndexMap[roleId]++; // Correctly increment index
        });
    }


    function resetRoleIndexes() {
        let checkedRoles = $(".role-checkbox:checked");
        roleIndexMap = {}; // Reset role index map

        checkedRoles.each(function (index) {
            let roleId = $(this).attr("id");
            roleIndexMap[roleId] = index; // Assign new consecutive index
        });

        // Update the name attributes of license fields with new role indexes
        $(".license-container").each(function () {
            let roleId = $(this).data("role-id");
            if (roleId in roleIndexMap) {
                let newRoleIndex = roleIndexMap[roleId];

                $(this)
                    .find("[name]")
                    .each(function () {
                        let nameAttr = $(this).attr("name");
                        let updatedName = nameAttr.replace(/\[\d+\]/, `[${newRoleIndex}]`);
                        $(this).attr("name", updatedName);
                    });
            }
        });

        // 🔁 Now also update attribute field names
        $(".attribute-multiselect-container").each(function () {
            let roleId = $(this).data("role-id");
            if (roleId in roleIndexMap) {
                let newRoleIndex = roleIndexMap[roleId];

                $(this)
                    .find("[name]")
                    .each(function () {
                        let nameAttr = $(this).attr("name");
                        let updatedName = nameAttr.replace(/\[\d+\]/, `[${newRoleIndex}]`);
                        $(this).attr("name", updatedName);
                    });
            }
        });
    }


