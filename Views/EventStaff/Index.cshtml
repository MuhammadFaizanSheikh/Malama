    function validateCertificationFields() {
        const blsDate = document.getElementById('BLSCertDate').value;
        const blsNumber = document.getElementById('BLSCertNumber').value;
        const aclsDate = document.getElementById('ACLSCertDate').value;
        const aclsNumber = document.getElementById('ACLSCertNumber').value;

        const isBLSFilled = blsDate && blsNumber;
        const isACLSFilled = aclsDate && aclsNumber;

        const blsErrorSpan = document.getElementById('BLSCertError');
        const aclsErrorSpan = document.getElementById('ACLSCertError');

        // Hide errors first
        blsErrorSpan.classList.remove('d-block');
        blsErrorSpan.classList.add('d-none');

        aclsErrorSpan.classList.remove('d-block');
        aclsErrorSpan.classList.add('d-none');

        if (!isBLSFilled && !isACLSFilled) {
            const errorMessage = 'Either BLS or ACLS certification must be completed.';

            blsErrorSpan.textContent = errorMessage;
            blsErrorSpan.classList.remove('d-none');
            blsErrorSpan.classList.add('d-block');

            aclsErrorSpan.textContent = errorMessage;
            aclsErrorSpan.classList.remove('d-none');
            aclsErrorSpan.classList.add('d-block');

            return false;
        }

        return true;
    }


