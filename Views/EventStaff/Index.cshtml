    function attachValidation(roleIndex, licenseIndex) {
        const activeInput = document.getElementById(`licenseActive${roleIndex}_${licenseIndex}`);
        const expiryInput = document.getElementById(`licenseExpiry${roleIndex}_${licenseIndex}`);

        if (activeInput && expiryInput) {
            activeInput.addEventListener("change", validateDates);
            expiryInput.addEventListener("change", validateDates);
        }

        function validateDates() {
            const activeDate = getDateOnlyGlobal(activeInput.value);   // YYYY-MM-DD
            const expiryDate = getDateOnlyGlobal(expiryInput.value);   // YYYY-MM-DD

            if (activeDate && expiryDate) {
                if (expiryDate < activeDate) {  // string comparison works for YYYY-MM-DD
                    alert("Active date should be smaller than expiry date");
                    expiryInput.value = ""; // Clear expiry date
                }
            }
        }
    }



    function generateAttributeDropdown(roleId, roleIndex, attributes) {
        if (!attributes || attributes.length === 0) return '';

        const options = attributes.map(attr => `<option value="${attr}">${attr}</option>`).join('');
        return `
            <div class="mb-2 attribute-multiselect-container" data-role-id="${roleId}">
                <label><strong>Select Attribute(s)</strong></label>
                                            <select class="form-select attribute-multiselect multi-select" name="SingleEventStaff.StaffQualification[${roleIndex}].StaffAttributeTemp" multiple data-role-id="${roleId}" required>
                    ${options}
                </select>
            </div>
        `;
    }
    function getRoleValueById(roleId) {
        let role = rolesData.find(r => r.id === roleId);
        return role ? role.name : roleId; // Fallback to roleId if value is not found
