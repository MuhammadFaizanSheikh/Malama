    function populateForm(data) {

        // Clear existing rows for each category before populating new data
        const airContainer = document.getElementById('dynamicControlsContainer');
        const carContainer = document.getElementById('carDynamicControlsContainer');
        const hotelContainer = document.getElementById('hotelDynamicControlsContainer');

        airContainer.innerHTML = '';
        carContainer.innerHTML = '';
        hotelContainer.innerHTML = '';

        // Loop through all data records and categorize them
        data.forEach((item, index) => {
            if (item.type === 'Air') {
                createRow(false, 'Air', item, index); // For Air category
            } else if (item.type === 'Car') {
                createRow(false, 'Car', item, index); // For Car category
            } else if (item.type === 'Hotel') {
                createRow(false, 'Hotel', item, index); // For Hotel category
            }
        });

        airCounter = airContainer.children.length;
        carCounter = carContainer.children.length;
        hotelCounter = hotelContainer.children.length;

        const totalRows = airCounter + carCounter + hotelCounter;
        controlCount = totalRows - 1; 
    }


        function formatDateField(dateValue) {
                if (!dateValue) {
                    return '';
                }

                var date = new Date(dateValue); // Convert the value to Date object
                if (isNaN(date.getTime())) {
                    return ''; // Return empty if the date is invalid
                }

                // Format the date as mm/dd/yyyy
                var formattedDate = (date.getMonth() + 1).toString().padStart(2, '0') + '/' + 
                                    date.getDate().toString().padStart(2, '0') + '/' + 
                                    date.getFullYear();

                return formattedDate;
            }


