    function fetchRolesByCategory() {
        $.ajax({
            url: '/Roles/GetRolesByCategory',
            type: "GET",
            data: { category: "EventStaffRole" }, // Pass category if required
            success: function (roles) {
                let staffRolesContainer = $("#StaffRoles");
                staffRolesContainer.empty(); // Clear existing roles before appending new ones

                if (!roles || roles.length === 0) {
                    staffRolesContainer.append('<p class="text-muted">No roles available</p>');
                    return;
                }
                
                rolesData = roles;

                roles.forEach(role => {
                    let roleElement = `
                        <div class="form-check me-3">
                            <input class="role-checkbox" type="checkbox" id="${role.id}" value="${role.name}">
                            <label class="form-check-label" for="${role.id}">${role.name}</label>
                        </div>`;
                    staffRolesContainer.append(roleElement);
                });
            },
            error: function (xhr, status, error) {
                console.error("Error fetching roles:", error);
                $("#StaffRoles").html('<p class="text-danger">Failed to load roles.</p>');
            }
        });
    }




