    function waitForCheckbox(roleId, callback, attempts = 100) {
        let roleCheckbox = $(`#${roleId}`);

        if (roleCheckbox.length) {
            callback(roleCheckbox);
        } else if (attempts > 0) {
            setTimeout(() => waitForCheckbox(roleId, callback, attempts - 1), 100); // Retry every 100ms
        } else {
            console.warn(`Checkbox with ID "${roleId}" not found after multiple attempts.`);
        }
    }

    function bindLicenseOnEditMode(staffLicenses) {
    staffLicenses.forEach((staffLicense, roleIndex) => {
        let roleId = staffLicense.roleId;

        // Wait for checkbox to be available
        waitForCheckbox(roleId, function (roleCheckbox) {
            roleCheckbox.prop("checked", true).trigger("change"); // Trigger change event to generate the first row

            let roleIndex = roleIndexMap[roleId]; // Get the role index assigned in checkbox change event

            // Wait for the first row to be generated before adding more rows
            setTimeout(() => {
                staffLicense.staffLicenseDetails.forEach((license, licenseIndex) => {
                    if (licenseIndex > 0) {
                        // Click "Add another license" button to generate additional rows
                        $(`.license-container[data-role-id='${roleId}']`).next(".add-row-button").click();
                    }
                });

                // Wait for additional rows to be generated before setting values
                setTimeout(() => {
                    staffLicense.staffLicenseDetails.forEach((license, licenseIndex) => {
                        $(`#licenseNumber${roleIndex}_${licenseIndex}`).val(license.licenseNumber);
                        $(`#licenseState${roleIndex}_${licenseIndex}`).val(license.licenseState);
                        $(`#licenseType${roleIndex}_${licenseIndex}`).val(license.licenseType);
                        $(`#licenseActive${roleIndex}_${licenseIndex}`).val(license.licenseActiveDate.split("T")[0]); // Remove time part
                        $(`#licenseExpiry${roleIndex}_${licenseIndex}`).val(license.licenseExpiryDate.split("T")[0]); // Remove time part
                    });
                }, 500); // Give time for rows to be generated

            }, 500); // Ensure first row is created before clicking "Add another license"
        });
    });
}

