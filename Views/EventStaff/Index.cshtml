<body>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (TempData["ResponseMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var iconColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';
                var buttonColor = '@TempData["ResponseStatus"]' === 'error' ? '#FF0000' : '#4CAF50';

                Swal.fire({
                    icon: '@TempData["ResponseStatus"]', // success, error, warning, info, or question
                    title: '@TempData["ResponseTitle"]',
                    text: '@TempData["ResponseMessage"]',
                    confirmButtonText: 'OK',
                    confirmButtonColor: buttonColor, // Conditional button color
                    iconColor: iconColor // Conditional icon color
                });
            });
        </script>
    }

    <h2 class="text-center mb-4">@ViewData["Title"]</h2>

     @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
            <div class="alert alert-danger">
                <strong>Validation failed!</strong>
                <ul>
                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                            <li>@modelError.ErrorMessage</li>
                }
                </ul>
            </div>
    }

    <div style="display: flex; justify-content: center; align-items: center;">
        <button class="btn btn-primary" id="addContractBtn"
                style="background-color: rgba(80, 90, 201, 1); border-color: rgba(80, 90, 201, 1);">
            Add New Event Staff
        </button>
    </div>
     <div id="datatableWrapper" class="datatable-wrapper">
        <table id="contractsTable" class="display">
            <thead>
                <tr>
                    <th>Staff Id</th>
                    <th>Start Date</th>
                    <th>Staff Status</th>
                    <th>Staff Last Name</th>
                    <th>Staff First Name</th>
                    <th>Staff Middle Initial</th>
                    <th>Staff DOB</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.EventStaff != null && Model.EventStaff.Any())
                {
                    @foreach (var contract in Model.EventStaff)
                    {
                        <tr data-id="@contract.Id">
                            <td>@contract.StaffID</td>
                            <td>@contract.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@contract.StaffStatus</td>
                            <td>@contract.StaffLastName</td>
                            <td>@contract.StaffFirstName</td>
                            <td>@contract.StaffMiddleInitial</td>
                            <td>@contract.StaffDOB.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="button-container">
                                    <a href="javascript:void(0);" class="btn btn-primary edit-btn" data-id="@contract.Id" style="background-color: rgba(80, 90, 201, 1);">Edit</a>
                                    <a href="javascript:void(0);" class="btn btn-secondary view-btn" data-id="@contract.Id">View</a>
                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                        <td  class="text-center">No data available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-body" style="display: none;">
        <form asp-action="CreateEventStaff" method="post">
            <input type="hidden" asp-for="SingleEventStaff.Id" id="hiddenId" />

                <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.StaffID" class="form-label">Staff ID</label>
            <input asp-for="SingleEventStaff.StaffID" id="StaffID" class="form-control" maxLength="6" readonly required />
        </div>
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.StartDate" class="form-label">Start Date</label>
            <input asp-for="SingleEventStaff.StartDate" id="StartDate" type="date" class="form-control" required />
        </div>
    </div>

                <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.StaffStatus" class="form-label">Staff Status</label>
            <select asp-for="SingleEventStaff.StaffStatus" id="StaffStatus" maxLength="20" class="form-control" required>
                <option value="Active">Active</option>
                <option value="InProgress">In Progress</option>
                <option value="RecruitCred">Recruit - Cred</option>
                <option value="RecruitInit">Recruit - Init.</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.StaffLastName" class="form-label">Staff Last Name</label>
                    <input asp-for="SingleEventStaff.StaffLastName" id="StaffLastName" maxLength="50"  class="form-control" required />
        </div>
    </div>

                <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.StaffFirstName" class="form-label">Staff First Name</label>
            <input asp-for="SingleEventStaff.StaffFirstName" id="StaffFirstName" maxLength="50" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.StaffMiddleInitial" class="form-label">Staff Middle Initial</label>
            <input asp-for="SingleEventStaff.StaffMiddleInitial" id="StaffMiddleInitial" maxLength="50" class="form-control" />
        </div>
    </div>

                <div class="row mb-3">
        <!-- SSN Section -->
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.StaffSSN" class="form-label">Staff SSN</label>
            <div class="input-group">
                <input type="password" asp-for="SingleEventStaff.StaffSSN" id="StaffSSN" minLength="11" class="form-control"
                       placeholder="xxx-xx-xxxx" inputmode="numeric" maxlength="11" required />
                <span class="input-group-text" onclick="togglePasswordVisibility('StaffSSN', 'toggleSsnIcon')" style="cursor: pointer;">
                    <i id="toggleSsnIcon" class="fas fa-eye"></i>
                </span>
            </div>
        </div>

        <!-- DOB Section -->
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.StaffDOB" class="form-label">Staff DOB</label>
            <input asp-for="SingleEventStaff.StaffDOB" id="StaffDOB" type="date" class="form-control" required />
        </div>
    </div>



                <div class="row mb-3">
        <div class="col-md-6">
            <label for="StaffRoles" class="form-label">Select Staff Roles</label>
            <div id="StaffRoles">
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="contractManager" value="Contract Manager">
                    <label class="form-check-label" for="contractManager">Contract Manager</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="physicians" value="Physicians">
                    <label class="form-check-label" for="physicians">Physicians</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="optometrist" value="Optometrist">
                    <label class="form-check-label" for="optometrist">Optometrist</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="audiologist" value="Audiologist">
                    <label class="form-check-label" for="audiologist">Audiologist</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="physicianAssistant" value="Physician Assistant">
                    <label class="form-check-label" for="physicianAssistant">Physician Assistant</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="behaviorHealthCounselor" value="Behavior Health Counselor">
                    <label class="form-check-label" for="behaviorHealthCounselor">Behavior Health Counselor</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="nursePractitioner" value="Nurse Practitioner">
                    <label class="form-check-label" for="nursePractitioner">Nurse Practitioner</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="registeredNurse" value="Registered Nurse">
                    <label class="form-check-label" for="registeredNurse">Registered Nurse</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="medicalAssistant" value="Medical Assistant">
                    <label class="form-check-label" for="medicalAssistant">Medical Assistant</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="hearingTechnician" value="Hearing Technician">
                    <label class="form-check-label" for="hearingTechnician">Hearing Technician</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="optometryTechnician" value="Optometry Technician">
                    <label class="form-check-label" for="optometryTechnician">Optometry Technician</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="admins" value="Admins">
                    <label class="form-check-label" for="admins">Admins</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="dentist" value="Dentist">
                    <label class="form-check-label" for="dentist">Dentist</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="dentalHygienist" value="Dental Hygienist">
                    <label class="form-check-label" for="dentalHygienist">Dental Hygienist</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="dentalAssistant" value="Dental Assistant">
                    <label class="form-check-label" for="dentalAssistant">Dental Assistant</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="dentalXray" value="Dental Xray">
                    <label class="form-check-label" for="dentalXray">Dental Xray</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="immunizationPersonnel" value="Immunization Personnel">
                    <label class="form-check-label" for="immunizationPersonnel">Immunization Personnel</label>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Event On Call Staff</label>
                    <div class="form-check">
                        <input asp-for="SingleEventStaff.EventOnCallStaff" type="radio" id="eventOnCallYes" value="true" class="form-check-input" required />
                        <label class="form-check-label" for="eventOnCallYes">Yes</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="SingleEventStaff.EventOnCallStaff" type="radio" id="eventOnCallNo" value="false" class="form-check-input" required />
                        <label class="form-check-label" for="eventOnCallNo">No</label>
                    </div>

                    <div class="col-md-6" id="eventOnCallSelectContainer" style="display: none;">
                        <label asp-for="SingleEventStaff.EventOnCallStaffEvent" class="form-label">Select Event</label>
                        <input asp-for="SingleEventStaff.EventOnCallStaffEvent" id="EventOnCallStaffEvent" maxLength="50" class="form-control" />
                    </div>
            <h4 class="mt-4">States Licenses</h4>
                    <div class="form-container" style="max-width: 100%; display: flex; flex-direction: column; align-items: flex-start;">
                        <div class="form-row license-row" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                            <div class="col-md-3" style="flex: 1; margin-right: 15px;">
                                <div class="form-group">
                                    <label asp-for="SingleEventStaff.Licenses[0].LicenseNumber" class="form-label">License Number</label>
                                    <input asp-for="SingleEventStaff.Licenses[0].LicenseNumber" id="licenseNumber0" class="form-control" placeholder="License Number" required />
                                </div>
                            </div>
                            <div class="col-md-3" style="flex: 1; margin-right: 15px;">
                                <div class="form-group">
                                    <label asp-for="SingleEventStaff.Licenses[0].LicenseState" class="form-label">License State</label>
                                    <select asp-for="SingleEventStaff.Licenses[0].LicenseState" id="licenseState0" class="form-control" required>
                                        <option value="">Select State</option>
                                        <option value="State1">State1</option>
                                        <option value="State2">State2</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3" style="flex: 1; margin-right: 15px;">
                                <div class="form-group">
                                    <label asp-for="SingleEventStaff.Licenses[0].LicenseType" class="form-label">License Type</label>
                                    <select asp-for="SingleEventStaff.Licenses[0].LicenseType" id="licenseType0" class="form-control" required>
                                        <option value="">Select Type</option>
                                        <option value="Type1">Type1</option>
                                        <option value="Type2">Type2</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3" style="flex: 1; margin-right: 0;">
                                <div class="form-group">
                                    <label asp-for="SingleEventStaff.Licenses[0].LicenseExpiryDate" class="form-label">License Expiry</label>
                                    <input asp-for="SingleEventStaff.Licenses[0].LicenseExpiryDate" id="licenseExpiry0" type="date" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <button type="button" class="add-row-button" id="addRowButton">
                                <img src="/images/PlusIcon.png" alt="Add Row" class="plus-icon" />
                                <span class="button-text">Add Another License</span>
                            </button>
                        </div>
                    </div>

            <div class="form-group">
                <label asp-for="SingleEventStaff.NPI" class="form-label">NPI</label>
                <input asp-for="SingleEventStaff.NPI" id="npi" class="form-control" minlength="10" maxlength="10" inputmode="numeric" pattern="\d*" />
            </div>
            <div class="form-group">
                <label asp-for="SingleEventStaff.DAE" class="form-label">DAE</label>
                <input asp-for="SingleEventStaff.DAE" id="dae" class="form-control" minlength="8" maxLength="8" required />
            </div>
        </div>
    </div>


                <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.CredentialingProcessDate" class="form-label">Credentialing Process Date</label>
                    <input asp-for="SingleEventStaff.CredentialingProcessDate" id="CredentialingProcessDate" type="date" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.HistoricalCredentialingDate" class="form-label">Historical Credentialing Date</label>
                    <input asp-for="SingleEventStaff.HistoricalCredentialingDate" id="HistoricalCredentialingDate" type="date" class="form-control" />
        </div>
    </div>

                <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.DAWSONInternalCredentialingCompleteDate" class="form-label">DAWSON Internal Credentialing Complete Date</label>
                    <input asp-for="SingleEventStaff.DAWSONInternalCredentialingCompleteDate" id="DAWSONInternalCredentialingCompleteDate" type="date" class="form-control" required />
        </div>
                <div class="col-md-6">
                    <label class="form-label">Onboarding/Training Complete</label>
                    <div class="form-check">
                        <input asp-for="SingleEventStaff.OnboardingTrainingComplete" id="OnboardingTrainingCompleteYes" type="radio" value="true" class="form-check-input" required onclick="toggleAdditionalControl()" />
                        <label class="form-check-label" for="OnboardingTrainingCompleteYes">Yes</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="SingleEventStaff.OnboardingTrainingComplete" id="OnboardingTrainingCompleteNo" type="radio" value="false" class="form-check-input" required onclick="toggleAdditionalControl()" />
                        <label class="form-check-label" for="OnboardingTrainingCompleteNo">No</label>
                    </div>
                </div>
    </div>

                <div class="row mb-3">
                <div class="col-md-6" id="additionalControl" style="display: none;">
                    <label class="form-label">Outstanding Trainings</label>
                    <textarea class="form-control" asp-for="SingleEventStaff.OutstandingTrainings" maxLength="100" id="OutstandingTrainings" rows="3"></textarea>
                </div>
        <div class="col-md-6">
            <label asp-for="SingleEventStaff.BackgroundCheckConcerns" maxLength="100" class="form-label">Background Check Concerns</label>
            <textarea asp-for="SingleEventStaff.BackgroundCheckConcerns" id ="BackgroundCheckConcerns" class="form-control" rows="3"></textarea>
        </div>
    </div>

                <div class="row mb-3">
        <div class="col-md-6">
            <div class="d-flex align-items-center mb-2">
                <label asp-for="SingleEventStaff.BLSCertDate" class="col-form-label" style="width: 150px;">BLS Cert. Date</label>
                <div class="d-flex flex-grow-1">
                    <input asp-for="SingleEventStaff.BLSCertDate" id="BLSCertDate" type="date" class="form-control" />
                    <input asp-for="SingleEventStaff.BLSCertNumber" id="BLSCertNumber" maxLength="100" class="form-control" placeholder="Cert Number" />
                </div>
                        <span id="BLSCertError" class="text-danger invalid-feedback" style="display: none;"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex align-items-center mb-2">
                <label asp-for="SingleEventStaff.ACLSCertDate" class="col-form-label" style="width: 150px;">ACLS Cert. Date</label>
                <div class="d-flex flex-grow-1">
                    <input asp-for="SingleEventStaff.ACLSCertDate" id="ACLSCertDate" type="date" class="form-control" />
                    <input asp-for="SingleEventStaff.ACLSCertNumber" id="ACLSCertNumber" maxLength="100"  class="form-control" placeholder="Cert Number" />
                </div>
                        <span id="ACLSCertError" class="text-danger invalid-feedback" style="display: none;"></span>
            </div>
