    function manageLicenseRows(licenses = []) {
        const container = document.querySelector('.form-container');
        const licenseRows = document.querySelectorAll('.license-row');

        // If we are adding new rows and there are fewer than 5, allow adding new rows
        if (licenses.length === 0 && licenseRows.length < 5) {
            const rowIndex = licenseRows.length;
            const newRow = document.createElement('div');
            newRow.classList.add('form-row', 'license-row');
            newRow.style.display = 'flex';
            newRow.style.justifyContent = 'space-between';
            newRow.style.alignItems = 'center';
            newRow.style.width = '100%';

            newRow.innerHTML = `
                <div class="col-md-3" style="flex: 1; margin-right: 15px;">
                    <div class="form-group">
                                <input id="licenseNumber${rowIndex}" name="SingleEventStaff.Licenses[${rowIndex}].LicenseNumber" class="form-control" placeholder="License Number" required />
                    </div>
                </div>
                <div class="col-md-3" style="flex: 1; margin-right: 15px;">
                    <div class="form-group">
                                <select id="licenseState${rowIndex}" name="SingleEventStaff.Licenses[${rowIndex}].LicenseState" class="form-control" required>
                            <option value="">Select State</option>
                            <option value="State1">State1</option>
                            <option value="State2">State2</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3" style="flex: 1; margin-right: 15px;">
                    <div class="form-group">
                                <select id="licenseType${rowIndex}" name="SingleEventStaff.Licenses[${rowIndex}].LicenseType" class="form-control" required>
                            <option value="">Select Type</option>
                            <option value="Type1">Type1</option>
                            <option value="Type2">Type2</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3" style="flex: 1; margin-right: 0;">
                    <div class="form-group">
                                <input id="licenseExpiry${rowIndex}" name="SingleEventStaff.Licenses[${rowIndex}].LicenseExpiryDate" type="date" class="form-control" required />
                    </div>
                </div>
            `;

            // Insert the new row before the "Add Another License" button
            container.insertBefore(newRow, document.getElementById('addRowButton').parentElement);
        }
        else if (licenses.length > 0) {
            // If licenses data exists (editing scenario), populate the rows with the data
            // Clear existing rows
            licenseRows.forEach(row => row.remove());

            licenses.forEach((license, index) => {
                const newRow = document.createElement('div');
                newRow.classList.add('form-row', 'license-row');
                newRow.style.display = 'flex';
                newRow.style.justifyContent = 'space-between';
                newRow.style.alignItems = 'center';
