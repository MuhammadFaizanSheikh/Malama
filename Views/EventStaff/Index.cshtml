    let roleIndexMap = {}; // Stores role indices
    let roleLicenseIndexMap = {}; // Stores license indices per role

    $(document).on("change", ".role-checkbox", function () {
        let roleCheckbox = $(this);
        let roleId = roleCheckbox.attr("id");
        let roleName = roleCheckbox.val();

        // Skip Admin roles for license requirements
        let requiredLicense = true;
        if (roleName === "Admin" || roleName === "Admin (CAC'd)") {
            requiredLicense = false;
        }

        // Get attributes for this role
        const attributes = qualificationsAttributesAndTypes[roleName]?.attributes || [];


        if (roleCheckbox.is(":checked")) {
            // Track role index
            if (!(roleId in roleIndexMap)) {
                roleIndexMap[roleId] = Object.keys(roleIndexMap).length;
            }

            if (!(roleId in roleLicenseIndexMap)) {
                roleLicenseIndexMap[roleId] = 0;
            }

            // Find role from rolesData
            let role = rolesData.find(r => r.id === roleId);
            if (role) {
                let roleIndex = roleIndexMap[roleId];
                let licenseIndex = roleLicenseIndexMap[roleId]++;

                // Generate UI
                let attributeDropdown = generateAttributeDropdown(roleId, roleIndex, attributes);
                let licenseFields = generateLicenseFields(requiredLicense, roleId, roleName, roleIndex, licenseIndex, role.types);

                let $insertedElements = $(attributeDropdown + licenseFields);
                roleCheckbox.closest(".form-check").after($insertedElements);

                // ✅ Initialize Flatpickr ONLY on newly added date fields
                $insertedElements.find('.license-active-date:not(.flatpickr-input)').flatpickr({
                    altInput: true, altFormat: 'm/d/Y', dateFormat: 'Y-m-d', allowInput: true
