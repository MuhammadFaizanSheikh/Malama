    function fetchRolesByCategory() {
    roleIndexMap = {};
    roleLicenseIndexMap = {};
    $('#StaffQualification').empty();

    const staffRolesContainer = $("#StaffQualification");

    // Create rolesData from qualificationsAttributesAndTypes to mimic backend structure
    rolesData = Object.keys(qualificationsAttributesAndTypes).map(roleName => {
        // Generate a safe ID for HTML and DB by replacing all non-alphanumeric chars with "_"
        const roleId = roleName.replace(/[^a-zA-Z0-9_]/g, "_"); 
        return {
            id: roleId,        // safe qualificationId to save in DB
            name: roleName,    // human-readable role name
            attributes: qualificationsAttributesAndTypes[roleName].attributes,
            types: qualificationsAttributesAndTypes[roleName].types
        };
    });

    const roles = Object.keys(qualificationsAttributesAndTypes);

    if (!roles || roles.length === 0) {
        staffRolesContainer.append('<p class="text-muted">No roles available</p>');
        return;
    }

    // Sort roles alphabetically
    roles.sort((a, b) => a.localeCompare(b));

    // Generate checkboxes for roles
    roles.forEach(roleName => {
        const roleId = roleName.replace(/[^a-zA-Z0-9_]/g, "_"); // same safe ID used in rolesData

        const roleElement = `
            <div class="form-check me-3 role-item" data-role="${roleName}">
                <input class="role-checkbox" type="checkbox" id="${roleId}" value="${roleName}">
                <label class="form-check-label" for="${roleId}">${roleName}</label>
            </div>
        `;

        staffRolesContainer.append(roleElement);
    });

    // Hide Admin (CAC'd) if needed
    $(".role-item[data-role=\"Admin (CAC'd)\"]").hide();

    // Existing toggle logic
    toggleAdminRoles();
}


