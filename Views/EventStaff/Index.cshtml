        $.ajax({
            url: '/SubContractorInfo/GetContractIdsBySubContractorCompanyName',
            type: 'GET',
            data: { companyName: selectedText }, // Send selected text as a parameter
            success: function (response) {
                if (response.success) {
                    bindMultiSelectDropdown(response.data.contractDetails); // Pass the contract details to the binding function
                    setStaffIdTextbox(response.data.staffId); // Update the StaffID textbox
                } else {
                    alert(response.message); // Show the error message
                }
            },
            error: function () {
                alert('An error occurred while fetching contract details.');
            }
        });
    }
});

function bindMultiSelectDropdown(data) {
    var dropdown = $('#StaffContractAffiliation');
