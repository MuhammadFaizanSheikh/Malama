                    } else {
                        $licenseContainer.next(".add-row-button").click();
                        $newRow = $licenseContainer.find('.license-row').last();
                    }

                    // 1️⃣ Initialize Flatpickr and set the date in same step
                    const $activeInput = $newRow.find('.license-active-date');
                    const $expiryInput = $newRow.find('.license-expiry-date');

                    $activeInput.flatpickr({
                        altInput: true,
                        altFormat: 'm/d/Y',
                        dateFormat: 'Y-m-d',
                        allowInput: true,
                        defaultDate: getDateOnlyGlobal(license.licenseActiveDate)
                    });

                    $expiryInput.flatpickr({
                        altInput: true,
                        altFormat: 'm/d/Y',
                        dateFormat: 'Y-m-d',
                        allowInput: true,
                        defaultDate: getDateOnlyGlobal(license.licenseExpiryDate)
                    });

                    // 2️⃣ Set other fields
                    $newRow.find(`#licenseNumber${roleIndex}_${licenseIndex}`).val(license.licenseNumber);
                    $newRow.find(`#licenseState${roleIndex}_${licenseIndex}`).val(license.licenseState);
                    $newRow.find(`#licenseType${roleIndex}_${licenseIndex}`).val(license.licenseType);
                });

                // 3️⃣ Set attributes
                const attributeValues = staffLicense.staffAttributeDetails.map(attr => attr.attribute);
                const $attributeSelect = $(`select[name='SingleEventStaff.StaffQualification[${roleIndex}].StaffAttributeTemp']`);
                if ($attributeSelect.length && attributeValues.length > 0) {
                    $attributeSelect.val(attributeValues).trigger("change");
                }
            });
        });
    }

    function populateForm(data) {

        // Clear existing rows for each category before populating new data
        const airContainer = document.getElementById('dynamicControlsContainer');
